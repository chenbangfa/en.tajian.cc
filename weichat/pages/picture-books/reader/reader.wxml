<view class="container">

  <!-- Swiper 翻页 -->
  <swiper
    wx:if="{{pages.length > 0}}"
    class="page-swiper"
    style="height:{{swiperHeight}}px"
    current="{{currentPageIndex}}"
    bindchange="onSwiperChange"
    duration="300"
  >
    <swiper-item wx:for="{{pages}}" wx:key="id">
      <scroll-view scroll-y class="page-scroll" style="height:{{swiperHeight}}px">
        <view class="page-center {{isLandscape ? 'page-center-ls' : ''}}">
          <view class="image-wrap" style="width:{{imageWrapWidth}}px;">
            <image
              class="page-img page-img-fit-top"
              src="{{item.image_url}}"
              mode="widthFix"
              bindload="onImageLoad"
              data-index="{{index}}"
            />
            <!-- 热点 -->
            <view
              wx:for="{{item.hotspots}}"
              wx:for-item="hotspot"
              wx:for-index="hIdx"
              wx:key="id"
              class="hotspot {{currentPageIndex === index && currentHotspotIndex === hIdx ? 'hotspot-active' : ''}}"
              style="left:{{hotspot.position_x}}%;top:{{hotspot.position_y}}%;width:{{hotspot.width}}%;height:{{hotspot.height}}%;"
              catchtap="onHotspotTap"
              data-page-index="{{index}}"
              data-hotspot-index="{{hIdx}}"
              data-hotspot="{{hotspot}}"
            ></view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- 加载中 -->
  <view wx:if="{{!book}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- 页码 + 翻译条开关 -->
  <view
    class="page-tools {{isLandscape ? 'page-tools-landscape' : ''}}"
    style="{{isLandscape ? '' : ('bottom:' + pageToolsBottom + 'px;')}}"
    wx:if="{{pages.length > 0 && (!currentPage || !currentPage.is_cover)}}"
  >
    <view class="float-toggle {{showTranslation ? 'on' : ''}}" catchtap="toggleFloatBar">
      <text>{{showTranslation ? '译' : '原'}}</text>
    </view>
    <view class="tool-btn {{narrationPlaying ? 'playing' : ''}}" catchtap="toggleNarrationPlay">
      <image wx:if="{{narrationPlaying}}" class="tool-icon" src="/assets/icons/icon-pause-white.svg" />
      <image wx:else class="tool-icon" src="/assets/icons/icon-play-white.svg" />
    </view>
    <view class="page-badge">
      <text>{{currentPageIndex + 1}} / {{pages.length}}</text>
    </view>
  </view>

  <!-- 封面标题 -->
  <view class="cover-title-bar" wx:if="{{currentPage && currentPage.is_cover && book}}">
    <text class="cover-title-en">{{book.title_en || ''}}</text>
    <text class="cover-title-cn">{{book.title || ''}}</text>
  </view>

  <!-- 本页阅读文案（英文分词可点击 + 中文） -->
  <view
    class="story-bar {{isLandscape ? 'story-bar-ls' : ''}}"
    wx:if="{{currentPage && !currentPage.is_cover && (currentPage.text_en || currentPage.text_cn)}}"
  >
    <view class="story-content">
      <view class="story-texts">
        <view class="story-tokens" wx:if="{{currentPage.tokens && currentPage.tokens.length > 0}}">
          <block wx:for="{{currentPage.tokens}}" wx:key="index">
            <text
              wx:if="{{item.hasWord}}"
              class="story-word"
              catchtap="showWordDetail"
              data-tidx="{{index}}"
            >{{item.text}}</text>
            <text wx:else class="story-plain">{{item.text}}</text>
          </block>
        </view>
        <text class="story-en" wx:elif="{{currentPage.text_en}}">{{currentPage.text_en}}</text>
        <text class="story-cn" wx:if="{{showTranslation && currentPage.text_cn}}">{{currentPage.text_cn}}</text>
      </view>
    </view>
  </view>

  <!-- 单词释义弹窗 -->
  <view wx:if="{{wordPopup}}" class="wp-mask" catchtap="closeWordPopup">
    <view class="wp-popup" catchtap="noop">
      <view class="wp-close" catchtap="closeWordPopup">✕</view>
      <text class="wp-word">{{wordPopup.word}}</text>
      <view class="wp-meta">
        <text class="wp-phonetic" wx:if="{{wordPopup.phonetic}}">{{wordPopup.phonetic}}</text>
        <text class="wp-pos" wx:if="{{wordPopup.pos}}">{{wordPopup.pos}}</text>
      </view>
      <text class="wp-translation">{{wordPopup.translation}}</text>
      <view wx:if="{{wordPopup.audio_url}}" class="wp-play-btn" catchtap="playWordAudio">
        <image class="wp-play-icon" src="/assets/icons/icon-play-white.svg" />
        <text>播放发音</text>
      </view>
    </view>
  </view>

  <!-- 底部悬浮翻译条：竖屏 -->
  <view class="float-bar" wx:if="{{currentHotspot && !isLandscape}}">
    <view class="float-content">
      <view class="float-text-area">
        <text class="float-en">{{currentHotspot.text_en}}</text>
        <text class="float-zh" wx:if="{{showTranslation}}">{{currentHotspot.translation || ''}}</text>
      </view>
      <view class="float-actions">
        <view class="float-play-btn {{isPlaying ? 'playing' : ''}}" catchtap="togglePlay">
          <image wx:if="{{isPlaying}}" class="float-icon" src="/assets/icons/icon-pause-white.svg" />
          <image wx:else class="float-icon" src="/assets/icons/icon-play-white.svg" />
        </view>
      </view>
    </view>
  </view>

  <!-- 底部悬浮翻译条：横屏（只显示翻译） -->
  <view class="float-bar-ls" wx:if="{{currentHotspot && isLandscape}}"
    style="width:{{imageWrapWidth}}px;left:50%;margin-left:-{{imageWrapWidth / 2}}px">
    <text class="ls-zh">{{showTranslation ? (currentHotspot.translation || '') : (currentHotspot.text_en || '')}}</text>
    <view class="ls-actions">
      <view class="ls-play {{isPlaying ? 'playing' : ''}}" catchtap="togglePlay">
        <image wx:if="{{isPlaying}}" class="ls-icon" src="/assets/icons/icon-pause-white.svg" />
        <image wx:else class="ls-icon" src="/assets/icons/icon-play-white.svg" />
      </view>
    </view>
  </view>

</view>
