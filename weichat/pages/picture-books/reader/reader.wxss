page {
  background: #F0F1F5;
}

.container {
  padding: 0 !important;
  height: 100vh;
  background: #F0F1F5;
  position: relative;
  overflow: hidden;
}

/* ===== Swiper ===== */
.page-swiper {
  width: 100%;
  background: #F0F1F5;
}

/* scroll-view 承载滚动，高度由 JS 设为视口高度 */
.page-scroll {
  width: 100%;
}

.page-center {
  width: 100%;
  min-height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

/* 横屏：图片比视口矮时垂直居中；比视口高时 min-height 失效、自然可滚动 */
.page-center-ls {
  align-items: center;
}

.image-wrap {
  position: relative;
  width: 100vw;
  overflow: hidden;
  margin: 0 auto;
}

.page-img {
  width: 100%;
  display: block;
}

.page-img-fit-top {
  width: 100%;
  height: auto;
}

/* ===== 热点（默认完全透明，不可见） ===== */
.hotspot {
  position: absolute;
  border: 2rpx solid transparent;
  border-radius: 4rpx;
  background: transparent;
}

/* 点击后才显示边框 */
.hotspot-active {
  border-color: rgba(78, 205, 196, 0.8);
  background: rgba(78, 205, 196, 0.1);
  box-shadow: 0 0 10rpx rgba(78, 205, 196, 0.4);
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #ddd;
  border-top-color: #4ECDC4;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 页码 + 横屏按钮 ===== */
.page-tools {
  position: fixed;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-badge {
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.float-toggle {
  width: 52rpx;
  height: 52rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.float-toggle.on {
  background: rgba(78, 205, 196, 0.7);
  color: #fff;
}

.tool-btn {
  width: 52rpx;
  height: 52rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-btn.playing {
  background: rgba(255, 107, 107, 0.78);
}

.tool-icon {
  width: 24rpx;
  height: 24rpx;
}

/* ===== 封面标题 ===== */
.cover-title-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 28rpx 40rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

.cover-title-en {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.cover-title-cn {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

/* ===== 本页阅读文案 ===== */
.story-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 24rpx calc(env(safe-area-inset-bottom) + 10rpx);
  border-radius: 20rpx 20rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.story-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.story-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.story-bar-ls {
  left: 0;
  right: 0;
  top: 16rpx;
  bottom: auto;
  padding: 10rpx 16rpx;
  border-radius: 0 0 12rpx 12rpx;
  gap: 2rpx;
}

.story-tokens {
  line-height: 2;
}

.story-word {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 600;
  border-bottom: 2rpx dashed #c7d2dd;
}

.story-plain {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 600;
}

.story-en {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 600;
  line-height: 1.4;
}

.story-cn {
  font-size: 20rpx;
  color: #6b7280;
  line-height: 1.45;
}

.story-bar-ls .story-tokens { line-height: 1.8; }
.story-bar-ls .story-word { font-size: 19rpx; }
.story-bar-ls .story-plain { font-size: 19rpx; }
.story-bar-ls .story-en { font-size: 19rpx; }
.story-bar-ls .story-cn { font-size: 16rpx; }

/* ===== 底部悬浮翻译条 ===== */
.float-bar {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 108rpx);
  left: 0;
  right: 0;
  z-index: 40;
  padding: 0 24rpx 16rpx;
  background: transparent;
  pointer-events: none;
}

.float-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.15);
  pointer-events: auto;
}

.float-text-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.float-en {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.float-zh {
  font-size: 22rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.float-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.float-play-btn {
  width: 64rpx;
  height: 64rpx;
  background: #4ECDC4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(78, 205, 196, 0.4);
}

.float-play-btn.playing {
  background: #FF6B6B;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.float-voice-btn {
  width: 52rpx;
  height: 52rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.float-icon {
  width: 28rpx;
  height: 28rpx;
}

.float-icon-sm {
  width: 28rpx;
  height: 28rpx;
}

/* ===== 横屏工具栏：位置还原 + 缩小 ===== */
.page-tools-landscape {
  bottom: 28rpx !important;
}

.page-tools-landscape .page-badge {
  font-size: 18rpx;
  padding: 6rpx 14rpx;
}

.page-tools-landscape .float-toggle {
  width: 40rpx;
  height: 40rpx;
  font-size: 18rpx;
}

/* ===== 横屏翻译条：单行紧凑 ===== */
.float-bar-ls {
  position: fixed;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 8rpx 20rpx;
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.ls-zh {
  font-size: 18rpx;
  color: #555;
  flex: 1;
  min-width: 0;
  line-height: 1.3;
}

.ls-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.ls-play {
  width: 44rpx;
  height: 44rpx;
  background: #4ECDC4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ls-play.playing {
  background: #FF6B6B;
}

.ls-voice {
  width: 36rpx;
  height: 36rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ls-icon {
  width: 20rpx;
  height: 20rpx;
}

/* ===== 单词释义弹窗 ===== */
.wp-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.wp-popup {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
  position: relative;
}

.wp-close {
  position: absolute;
  top: 32rpx;
  right: 40rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #F1F2F6;
  color: #636E72;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wp-word {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 12rpx;
  padding-right: 80rpx;
}

.wp-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.wp-phonetic {
  font-size: 28rpx;
  color: #4ECDC4;
}

.wp-pos {
  font-size: 22rpx;
  color: #b2bec3;
  font-style: italic;
  background: #F8F9FA;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.wp-translation {
  display: block;
  font-size: 38rpx;
  color: #636E72;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.wp-play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #2D3436;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.25);
}

.wp-play-icon {
  width: 36rpx;
  height: 36rpx;
}
