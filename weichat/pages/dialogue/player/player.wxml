<!-- pages/dialogue/player/player.wxml -->
<view class="container">

  <!-- ===== loading ===== -->
  <view class="loading-screen" wx:if="{{phase === 'loading'}}">
    <view class="loading-dot-row">
      <view class="dot"></view><view class="dot"></view><view class="dot"></view>
    </view>
  </view>

  <!-- ===== intro ===== -->
  <view class="intro-screen" wx:elif="{{phase === 'intro'}}">
    <!-- 封面 -->
    <view class="intro-cover">
      <image wx:if="{{scene.cover_image}}" class="cover-img" src="{{scene.cover_image}}" mode="aspectFill"/>
      <view wx:else class="cover-placeholder"><text>💬</text></view>
      <!-- VIP 遮罩 -->
      <view class="vip-overlay" wx:if="{{locked}}">
        <text class="vip-lock-big">🔒</text>
        <text class="vip-lock-label">VIP 专属场景</text>
        <text class="vip-lock-hint">开通会员解锁全部对话练习</text>
        <view class="vip-btn" bindtap="goVip">立即开通 VIP</view>
      </view>
    </view>

    <!-- 场景信息 -->
    <view class="intro-body">
      <view class="intro-tag-row">
        <view class="difficulty-tag diff-{{scene.difficulty}}">
          {{scene.difficulty === 1 ? '入门' : scene.difficulty === 2 ? '进阶' : '挑战'}}
        </view>
        <view class="vip-tag" wx:if="{{scene.is_vip}}">VIP</view>
      </view>
      <text class="intro-title">{{scene.title}}</text>
      <text class="intro-title-en" wx:if="{{scene.title_en}}">{{scene.title_en}}</text>

      <!-- 情境描述 -->
      <view class="intro-desc-box" wx:if="{{scene.description}}">
        <text class="intro-desc">{{scene.description}}</text>
      </view>

      <!-- 角色说明 -->
      <view class="role-row">
        <view class="role-card user-role">
          <text class="role-emoji">🙋</text>
          <text class="role-label">你扮演</text>
          <text class="role-name">{{scene.user_role}}</text>
        </view>
        <view class="role-vs">VS</view>
        <view class="role-card guide-role">
          <text class="role-emoji">🧑‍💼</text>
          <text class="role-label">对方</text>
          <text class="role-name">{{scene.guide_role}}</text>
        </view>
      </view>

      <!-- 台词数 -->
      <view class="line-count-row">
        <text class="line-count-text">共 {{lines.length}} 句对话</text>
      </view>
    </view>

    <!-- 开始按钮 -->
    <view class="intro-footer">
      <view
        class="start-btn {{locked ? 'disabled' : ''}}"
        bindtap="{{locked ? 'goVip' : 'startListen'}}"
      >
        {{locked ? '🔒 开通 VIP 解锁' : '开始学习 →'}}
      </view>
    </view>
  </view>

  <!-- ===== listen ===== -->
  <view class="listen-screen" wx:elif="{{phase === 'listen'}}">

    <!-- 进度提示 -->
    <view class="listen-header">
      <text class="listen-title">先听一遍</text>
      <text class="listen-hint">熟悉对话内容，点击气泡可单独播放</text>
    </view>

    <!-- 对话气泡列表 -->
    <scroll-view class="bubbles-scroll" scroll-y>
      <view class="bubbles-list">
        <view
          wx:for="{{lines}}" wx:key="id"
          class="bubble-wrap {{item.role === 'user' ? 'user-wrap' : 'guide-wrap'}}"
        >
          <!-- guide 气泡（左） -->
          <view wx:if="{{item.role === 'guide'}}" class="bubble-row guide-row">
            <view class="avatar guide-avatar">
              <text class="avatar-text">{{scene.guide_role[0]}}</text>
            </view>
            <view
              class="bubble guide-bubble {{listenPlayingId === item.id ? 'playing' : ''}} {{item.audio_url ? '' : 'no-audio'}}"
              bindtap="tapLine"
              data-id="{{item.id}}"
              data-audio="{{item.audio_url}}"
            >
              <text class="bubble-en">{{item.line_en}}</text>
              <text class="bubble-cn">{{item.line_cn}}</text>
              <view class="play-dot" wx:if="{{item.audio_url}}">
                {{listenPlayingId === item.id ? '■' : '▶'}}
              </view>
            </view>
          </view>

          <!-- user 气泡（右） -->
          <view wx:if="{{item.role === 'user'}}" class="bubble-row user-row">
            <view
              class="bubble user-bubble {{listenPlayingId === item.id ? 'playing' : ''}} {{item.audio_url ? '' : 'no-audio'}}"
              bindtap="tapLine"
              data-id="{{item.id}}"
              data-audio="{{item.audio_url}}"
            >
              <text class="bubble-en">{{item.line_en}}</text>
              <text class="bubble-cn">{{item.line_cn}}</text>
              <view class="play-dot" wx:if="{{item.audio_url}}">
                {{listenPlayingId === item.id ? '■' : '▶'}}
              </view>
            </view>
            <view class="avatar user-avatar">
              <text class="avatar-text">我</text>
            </view>
          </view>
        </view>

        <!-- 底部占位 -->
        <view style="height: 200rpx;"></view>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="listen-footer">
      <view
        class="auto-play-btn {{listenAutoPlaying ? 'playing' : ''}}"
        bindtap="autoPlayAll"
      >
        {{listenAutoPlaying ? '⏹ 停止播放' : '▶ 全部播放'}}
      </view>
      <view class="practice-btn" bindtap="startPractice">
        开始练习 →
      </view>
    </view>
  </view>

  <!-- ===== practice ===== -->
  <view class="practice-screen" wx:elif="{{phase === 'practice'}}">

    <!-- 进度条 -->
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{lines.length > 0 ? (practiceStep + 1) * 100 / lines.length : 0}}%"></view>
    </view>
    <view class="progress-text-row">
      <text class="progress-text">{{practiceStep + 1}} / {{lines.length}}</text>
    </view>

    <!-- 当前台词展示 -->
    <view class="practice-lines">
      <!-- 显示前几条做上文（最多3条） -->
      <view
        wx:for="{{lines}}" wx:key="id"
        wx:if="{{index >= (practiceStep > 2 ? practiceStep - 2 : 0) && index <= practiceStep}}"
        class="practice-bubble-wrap {{lines[index].role === 'user' ? 'user-wrap' : 'guide-wrap'}}"
      >
        <!-- guide 气泡 -->
        <view wx:if="{{lines[index].role === 'guide'}}" class="bubble-row guide-row">
          <view class="avatar guide-avatar sm">
            <text class="avatar-text">{{scene.guide_role[0]}}</text>
          </view>
          <view class="bubble guide-bubble {{index === practiceStep ? 'current' : 'prev'}}">
            <text class="bubble-en">{{lines[index].line_en}}</text>
            <text class="bubble-cn" wx:if="{{index < practiceStep}}">{{lines[index].line_cn}}</text>
          </view>
        </view>

        <!-- user 气泡（当前轮到的） -->
        <view wx:if="{{lines[index].role === 'user' && index === practiceStep}}" class="user-turn-box">
          <view class="user-turn-label">
            <text class="turn-emoji">🎤</text>
            <text class="turn-text">轮到你说了</text>
          </view>

          <!-- 提示文字（可显隐） -->
          <view class="hint-box {{showHint ? 'visible' : ''}}">
            <text wx:if="{{showHint}}" class="hint-en">{{lines[index].line_en}}</text>
            <text wx:if="{{showHint}}" class="hint-cn">{{lines[index].line_cn}}</text>
            <text wx:if="{{!showHint}}" class="hint-placeholder">••• 点击查看提示</text>
          </view>

          <!-- 评测结果 -->
          <view class="assess-result-box" wx:if="{{assessResult}}">
            <view class="score-row">
              <text class="big-score {{assessResult.overall_score >= 85 ? 'excellent' : assessResult.overall_score >= 70 ? 'good' : 'poor'}}">
                {{assessResult.overall_score}}
              </text>
              <text class="score-unit">分</text>
              <text class="score-label {{assessResult.overall_score >= 70 ? 'passed' : 'failed'}}">
                {{assessResult.overall_score >= 70 ? '✓ 不错' : '✗ 再试试'}}
              </text>
            </view>
            <view class="score-details">
              <text class="score-detail-item">发音 {{assessResult.pronunciation_score || '-'}}</text>
              <text class="score-detail-item">流利 {{assessResult.fluency_score || '-'}}</text>
              <text class="score-detail-item">完整 {{assessResult.integrity_score || '-'}}</text>
            </view>
          </view>
        </view>

        <!-- 已说过的 user 气泡（历史） -->
        <view wx:if="{{lines[index].role === 'user' && index < practiceStep}}" class="bubble-row user-row">
          <view class="bubble user-bubble prev">
            <text class="bubble-en">{{lines[index].line_en}}</text>
          </view>
          <view class="avatar user-avatar sm">
            <text class="avatar-text">我</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作区 -->
    <view class="practice-footer">
      <!-- 当前是 user 轮次 -->
      <block wx:if="{{lines[practiceStep] && lines[practiceStep].role === 'user'}}">
        <!-- 有评测结果 -->
        <view class="result-actions" wx:if="{{assessResult}}">
          <view class="hint-toggle-btn" bindtap="toggleHint">
            {{showHint ? '隐藏提示' : '查看提示'}}
          </view>
          <view class="retry-btn" bindtap="retryLine">再说一次</view>
          <view class="next-btn" bindtap="nextLine">
            {{practiceStep >= lines.length - 1 ? '完成 🎉' : '下一句 →'}}
          </view>
        </view>

        <!-- 等待录音 -->
        <view class="record-actions" wx:else>
          <view class="hint-toggle-btn" bindtap="toggleHint">
            {{showHint ? '隐藏提示' : '查看提示'}}
          </view>
          <view
            class="mic-btn {{isRecording ? 'recording' : ''}} {{isAssessing ? 'assessing' : ''}}"
            bindtouchstart="startRecord"
            bindtouchend="stopRecord"
            catchtap="noop"
          >
            <image
              class="mic-icon {{isAssessing ? 'spin' : ''}}"
              src="/assets/icons/{{isAssessing ? 'icon-refresh.svg' : (isRecording ? 'icon-stop.svg' : 'icon-mic.svg')}}"
            />
            <text class="mic-label">
              {{isAssessing ? '评测中...' : (isRecording ? '松开停止 · ' + recordingTime + 's' : '按住说话')}}
            </text>
          </view>
        </view>
      </block>

      <!-- 当前是 guide 轮次（等待自动播放） -->
      <view class="guide-playing-hint" wx:elif="{{lines[practiceStep] && lines[practiceStep].role === 'guide'}}">
        <view class="guide-wave">
          <view class="wave-bar"></view><view class="wave-bar"></view>
          <view class="wave-bar"></view><view class="wave-bar"></view>
          <view class="wave-bar"></view>
        </view>
        <text class="guide-hint-text">{{scene.guide_role}} 正在说...</text>
      </view>
    </view>
  </view>

  <!-- ===== done ===== -->
  <view class="done-screen" wx:elif="{{phase === 'done'}}">
    <view class="done-body">
      <!-- 星级 -->
      <view class="stars-row">
        <text class="star {{stars >= 1 ? 'lit' : ''}}">★</text>
        <text class="star {{stars >= 2 ? 'lit' : ''}}">★</text>
        <text class="star {{stars >= 3 ? 'lit' : ''}}">★</text>
      </view>
      <text class="done-score">{{avgScore}} 分</text>
      <text class="done-label">
        {{stars === 3 ? '🎉 太棒了！发音非常准确' : stars === 2 ? '👍 不错！继续练习更完美' : '💪 继续加油，多练习几次'}}
      </text>

      <!-- 每句得分明细 -->
      <view class="score-list">
        <view
          wx:for="{{lineScores}}" wx:key="lineId"
          class="score-item {{item.passed ? 'passed' : 'failed'}}"
        >
          <text class="score-item-label">第 {{index + 1}} 句</text>
          <text class="score-item-score">{{item.score !== null ? item.score + '分' : '未评测'}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="done-actions">
        <view class="re-practice-btn" bindtap="replayPractice">再练一次</view>
        <view class="back-listen-btn" bindtap="backToListen">重新听一遍</view>
      </view>
    </view>
  </view>

</view>
