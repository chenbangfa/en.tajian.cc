<!--pages/vip/vip.wxml-->
<view class="container">
  <!-- 用户信息卡片 (黑金风格) -->
  <view class="header-card">
    <view class="user-row">
      <image class="avatar" src="{{userInfo.avatar_url || '/assets/images/default-avatar.png'}}"></image>
      <view class="info">
        <text class="nickname">{{userInfo.nickname || '学习小达人'}}</text>
        <view class="vip-status" wx:if="{{userInfo.vip_expire_date}}">
           <image class="crown-icon" src="/assets/icons/icon-crown.svg"></image>
           <text>VIP会员有效期至 {{userInfo.vip_expire_date}}</text>
        </view>
        <view class="vip-status inactive" wx:else>
           <text>当前未开通VIP会员</text>
        </view>
        <view class="points-balance">
           <text>当前积分: </text>
           <text class="points-val">{{userInfo.points || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 会员订阅 -->
  <view class="section-title">会员订阅 (含积分赠送)</view>
  <view class="plans-container">
    <view class="plan-item {{selectedType === 'vip' && selectedPlanIndex === index ? 'selected' : ''}}" 
          wx:for="{{plans}}" wx:key="id"
          bindtap="selectVipPlan" data-index="{{index}}">
      <view class="plan-tag" wx:if="{{item.recommend}}">超值推荐</view>
      <view class="plan-name">{{item.name}}</view>
      <view class="plan-points-grant">{{item.pointsGrant}}</view>
      <view class="plan-price">
        <text class="currency">¥</text>
        <text class="amount">{{item.price}}</text>
      </view>
      <view class="plan-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</view>
      <view class="plan-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
    </view>
  </view>

  <!-- 积分加油包 -->
  <view class="section-title">积分加油包</view>
  <view class="plans-container points-container">
    <view class="plan-item points-item {{selectedType === 'point' && selectedPointIndex === index ? 'selected' : ''}}" 
          wx:for="{{pointPackages}}" wx:key="id"
          bindtap="selectPointPackage" data-index="{{index}}">
      <view class="plan-name">{{item.points}} 积分</view>
      <view class="plan-price">
        <text class="currency">¥</text>
        <text class="amount">{{item.price}}</text>
      </view>
      <view class="plan-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
    </view>
  </view>

  <!-- 会员权益 -->
  <view class="section-title">会员权益</view>
  <view class="benefits-grid">
    <view class="benefit-item" wx:for="{{benefits}}" wx:key="name">
      <view class="benefit-icon-bg">
        <image class="benefit-icon" src="{{item.icon}}"></image>
      </view>
      <text class="benefit-name">{{item.name}}</text>
      <text class="benefit-desc">{{item.desc}}</text>
    </view>
  </view>

  <!-- 底部支付栏 -->
  <view class="footer-bar">
    <view class="total-price">
      <text class="total-label">总计:</text>
      <text class="total-currency">¥</text>
      <text class="total-amount">{{currentPrice}}</text>
    </view>
    <button class="pay-btn" bindtap="handleSubscribe" disabled="{{loading}}">立即支付</button>
  </view>
</view>
