/* pages/profile/profile.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* 顶部个人卡片 */
.user-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
}

.user-main {
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #F8F9FA;
  margin-right: 24rpx;
  background: #F1F2F6;
}

.user-info {
  flex: 1;
}

.user-edit {
  padding: 16rpx;
  margin-right: -16rpx;
}

.edit-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
  margin-right: 12rpx;
}

.vip-badge {
  font-size: 20rpx;
  background: #FFEAA7;
  color: #D35400;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 800;
}

.user-id {
  font-size: 24rpx;
  color: #B2BEC3;
}

/* 积分概览 */
.points-overview {
  display: flex;
  border-top: 2rpx solid #F8F9FA;
  padding: 24rpx 0;
}

.points-box {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.points-val {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
}

.vip-text {
  color: #FF9F43;
}

.points-lbl {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
}

.points-divider {
  width: 2rpx;
  background: #F8F9FA;
}

/* 登录卡片 */
.login-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.login-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #B2BEC3;
  margin-bottom: 32rpx;
}

.login-btn {
  background: #2D3436;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 64rpx;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.2);
}

/* 数据统计卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2D3436;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 4rpx;
}

.stat-name {
  font-size: 22rpx;
  color: #B2BEC3;
}

/* 菜单列表 */
.menu-list {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F8F9FA;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.menu-icon.icon-blue { background: #E6F7FF; }
.menu-icon.icon-purple { background: #F3E8FF; }
.menu-icon.icon-orange { background: #FFF7E6; }
.menu-icon.icon-gold { background: #FFF2CC; }
.menu-icon.icon-gray { background: #F1F2F6; }

.menu-name {
  font-size: 30rpx;
  color: #2D3436;
  font-weight: 600;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-tip {
  font-size: 24rpx;
  color: #FF9F43;
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #DFE6E9;
  margin-left: 8rpx;
}

.version-info {
  text-align: center;
  font-size: 22rpx;
  color: #ced6e0;
  padding-bottom: 20rpx;
}
