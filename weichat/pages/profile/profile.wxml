<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 顶部个人卡片 -->
  <view class="user-card" wx:if="{{userInfo}}">
    <view class="user-main">
      <image class="user-avatar" src="{{userInfo.avatar_url || '/assets/images/default-avatar.png'}}"></image>
      <view class="user-info">
        <view class="name-row">
          <text class="user-name">{{userInfo.nickname || '学习小达人'}}</text>
          <view class="vip-badge" wx:if="{{userInfo.vip_level > 0}}">VIP</view>
        </view>
        <view class="user-id">ID: {{userInfo.id || '888888'}}</view>
      </view>
      <view class="user-edit" bindtap="goToProfileEdit">
        <image class="edit-icon" src="/assets/icons/icon-settings.svg"></image>
      </view>
    </view>
    
    <!-- 积分概览 -->
    <view class="points-overview">
      <view class="points-box">
        <text class="points-val">{{userInfo.points || 0}}</text>
        <text class="points-lbl">我的积分</text>
      </view>
      <view class="points-divider"></view>
      <view class="points-box" bindtap="goToVip">
        <text class="points-val vip-text">{{userInfo.vip_expire_date ? '已开通' : '未开通'}}</text>
        <text class="points-lbl">会员状态</text>
      </view>
    </view>
  </view>

  <!-- 未登录 -->
  <view class="login-card" wx:else>
    <view class="login-content">
      <view class="login-title">欢迎来到趣学英语</view>
      <view class="login-desc">登录后同步学习进度，开启英语之旅</view>
      <button class="login-btn" bindtap="handleLogin">立即登录</button>
    </view>
  </view>

  <!-- 学习数据卡片 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">学习数据</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-num">{{stats.wordsLearned || 0}}</text>
        <text class="stat-name">已学单词</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.masteredWords || 0}}</text>
        <text class="stat-name">已掌握</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.checkinDays || 0}}</text>
        <text class="stat-name">打卡天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.consecutiveDays || 0}}</text>
        <text class="stat-name">连续坚持</text>
      </view>
    </view>
  </view>

  <!-- 常用功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToCheckinHistory">
      <view class="menu-left">
        <view class="menu-icon icon-blue">
          <image class="menu-icon-img" src="/assets/icons/icon-calendar.svg"></image>
        </view>
        <text class="menu-name">打卡记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goToAssessmentHistory">
      <view class="menu-left">
        <view class="menu-icon icon-purple">
          <image class="menu-icon-img" src="/assets/icons/icon-mic.svg"></image>
        </view>
        <text class="menu-name">评测记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToPoints">
      <view class="menu-left">
        <view class="menu-icon icon-orange">
          <image class="menu-icon-img" src="/assets/icons/icon-coins.svg"></image>
        </view>
        <text class="menu-name">积分明细</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  
  <!-- 设置与其他 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToVip">
      <view class="menu-left">
        <view class="menu-icon icon-gold">
          <image class="menu-icon-img" src="/assets/icons/icon-crown.svg"></image>
        </view>
        <text class="menu-name">会员中心</text>
      </view>
      <view class="menu-right">
        <text class="menu-tip" wx:if="{{!userInfo.vip_level}}">开通解锁更多</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-left">
        <view class="menu-icon icon-gray">
          <image class="menu-icon-img" src="/assets/icons/icon-settings.svg"></image>
        </view>
        <text class="menu-name">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-left">
        <view class="menu-icon icon-gray">
          <image class="menu-icon-img" src="/assets/icons/icon-info.svg"></image>
        </view>
        <text class="menu-name">关于我们</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  
  <view class="version-info">v1.0.0</view>
</view>
