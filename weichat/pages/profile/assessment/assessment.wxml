<!--pages/profile/assessment/assessment.wxml-->
<view class="container">

  <!-- 统计概览卡片 -->
  <view class="stats-card">
    <view class="stats-header">
      <text class="stats-title">评测概览</text>
      <text class="stats-month">本月 {{stats.month_count || 0}} 次</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-num">{{stats.total_count || 0}}</text>
        <text class="stat-label">总评测</text>
      </view>
      <view class="stat-item">
        <text class="stat-num score-green">{{stats.avg_score || 0}}</text>
        <text class="stat-label">平均分</text>
      </view>
      <view class="stat-item">
        <text class="stat-num score-gold">{{stats.max_score || 0}}</text>
        <text class="stat-label">最高分</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.total_days || 0}}</text>
        <text class="stat-label">打卡天数</text>
      </view>
    </view>
  </view>

  <!-- 日历热力图 -->
  <view class="calendar-card">
    <view class="calendar-nav">
      <view class="cal-arrow" bindtap="prevMonth">‹</view>
      <text class="cal-month-text">{{calendarTitle}}</text>
      <view class="cal-arrow" bindtap="nextMonth">›</view>
    </view>
    <view class="cal-weekdays">
      <text class="cal-wd" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="cal-days">
      <view wx:for="{{calendarDays}}" wx:key="index"
            class="cal-day {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.empty ? 'empty' : ''}} heat-{{item.heat || 0}}"
            bindtap="onDayTap"
            data-date="{{item.date}}"
            data-empty="{{item.empty}}">
        <text class="cal-day-num" wx:if="{{!item.empty}}">{{item.day}}</text>
        <view class="cal-dot" wx:if="{{item.count > 0}}"></view>
      </view>
    </view>
    <view class="cal-legend">
      <text class="legend-text">少</text>
      <view class="legend-box heat-1"></view>
      <view class="legend-box heat-2"></view>
      <view class="legend-box heat-3"></view>
      <view class="legend-box heat-4"></view>
      <text class="legend-text">多</text>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-tab {{activeFilter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部</view>
    <view class="filter-tab {{activeFilter === '90' ? 'active' : ''}}" bindtap="setFilter" data-filter="90">90+</view>
    <view class="filter-tab {{activeFilter === '80' ? 'active' : ''}}" bindtap="setFilter" data-filter="80">80-89</view>
    <view class="filter-tab {{activeFilter === '60' ? 'active' : ''}}" bindtap="setFilter" data-filter="60">60-79</view>
    <view class="filter-tab {{activeFilter === 'low' ? 'active' : ''}}" bindtap="setFilter" data-filter="low">60以下</view>
  </view>

  <!-- 选中日期提示 -->
  <view class="date-hint" wx:if="{{selectedDate}}">
    <text class="date-hint-text">{{selectedDate}} 的评测记录</text>
    <text class="date-hint-clear" bindtap="clearDateFilter">清除</text>
  </view>

  <!-- 评测记录列表 -->
  <view class="record-list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <!-- 分数圆环 -->
        <view class="score-ring {{item.scoreClass}}">
          <text class="ring-score">{{item.overall_score}}</text>
        </view>
      </view>
      <view class="record-center">
        <text class="record-word">{{item.reference_text}}</text>
        <view class="record-scores">
          <text class="mini-score">发音 {{item.pronunciation_score}}</text>
          <text class="mini-divider">·</text>
          <text class="mini-score">流利 {{item.fluency_score}}</text>
          <text class="mini-divider">·</text>
          <text class="mini-score">完整 {{item.integrity_score}}</text>
        </view>
        <text class="record-time">{{item.timeText}}</text>
      </view>
      <view class="record-right">
        <!-- 播放录音按钮 -->
        <view class="play-record-btn {{playingId === item.id ? 'playing' : ''}}"
              bindtap="playAudio"
              data-id="{{item.id}}"
              data-url="{{item.audio_url}}">
          <text class="play-icon">{{playingId === item.id ? '■' : '▶'}}</text>
        </view>
        <text class="type-tag {{item.content_type === 'word' ? 'tag-word' : 'tag-sentence'}}">{{item.content_type === 'word' ? '单词' : '句子'}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-icon">🎤</text>
    <text class="empty-text">暂无评测记录</text>
    <text class="empty-sub">去「看图识字」页面开始练习吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loadingMore}}">
    <view class="loading-dot-wrapper">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>
  <view class="no-more" wx:if="{{noMore && records.length > 0}}">
    <text class="no-more-text">— 已加载全部记录 —</text>
  </view>

  <!-- 底部分享按钮 -->
  <view class="share-bar" wx:if="{{stats.total_count > 0}}">
    <view class="share-btn" bindtap="generatePoster">
      <text class="share-btn-text">分享学习成就</text>
    </view>
  </view>

  <!-- 海报预览弹窗 -->
  <view class="poster-modal" wx:if="{{showPoster}}" bindtap="closePoster">
    <view class="poster-content" catchtap="">
      <canvas canvas-id="posterCanvas" class="poster-canvas" style="width:600rpx;height:900rpx;"></canvas>
      <view class="poster-actions">
        <view class="poster-btn save-btn" bindtap="savePoster">保存到相册</view>
        <button class="poster-btn share-btn-wx" open-type="share">分享给好友</button>
      </view>
      <view class="poster-close" bindtap="closePoster">✕</view>
    </view>
  </view>

</view>
