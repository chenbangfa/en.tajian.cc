<!--pages/profile/assessment/share.wxml-->
<view class="container">

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dot-wrapper">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="empty-state" wx:if="{{!loading && error}}">
    <text class="empty-icon">😔</text>
    <text class="empty-text">{{error}}</text>
  </view>

  <!-- 内容区域 -->
  <block wx:if="{{!loading && !error && shareData}}">

    <!-- 用户信息卡片 -->
    <view class="user-share-card">
      <image class="share-avatar" src="{{shareData.avatar_url || '/assets/images/default-avatar.png'}}"></image>
      <view class="share-user-info">
        <text class="share-nickname">{{shareData.nickname || '学习小达人'}}</text>
        <text class="share-filter">{{shareData.filter_desc}}</text>
      </view>
      <text class="share-date">{{shareTime}}</text>
    </view>

    <!-- 统计概览 -->
    <view class="stats-card">
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-num">{{shareData.total_count || 0}}</text>
          <text class="stat-label">总评测</text>
        </view>
        <view class="stat-item">
          <text class="stat-num score-green">{{shareData.avg_score || 0}}</text>
          <text class="stat-label">平均分</text>
        </view>
        <view class="stat-item">
          <text class="stat-num score-gold">{{shareData.max_score || 0}}</text>
          <text class="stat-label">最高分</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{shareData.total_days || 0}}</text>
          <text class="stat-label">打卡天数</text>
        </view>
      </view>
    </view>

    <!-- 评测记录列表 -->
    <view class="section-title-bar" wx:if="{{records.length > 0}}">
      <text class="section-label">评测记录</text>
      <text class="section-count">共 {{records.length}} 条</text>
    </view>

    <view class="record-list" wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-left">
          <view class="score-ring {{item.scoreClass}}">
            <text class="ring-score">{{item.overall_score}}</text>
          </view>
        </view>
        <view class="record-center">
          <text class="record-word">{{item.reference_text}}</text>
          <view class="record-scores">
            <text class="mini-score">发音 {{item.pronunciation_score}}</text>
            <text class="mini-divider">·</text>
            <text class="mini-score">流利 {{item.fluency_score}}</text>
            <text class="mini-divider">·</text>
            <text class="mini-score">完整 {{item.integrity_score}}</text>
          </view>
          <text class="record-time">{{item.timeText}}</text>
        </view>
        <view class="record-right">
          <view class="play-record-btn {{playingId === item.id ? 'playing' : ''}}"
                wx:if="{{item.audio_url}}"
                bindtap="playAudio"
                data-id="{{item.id}}"
                data-url="{{item.audio_url}}">
            <text class="play-icon">{{playingId === item.id ? '■' : '▶'}}</text>
          </view>
          <text class="type-tag {{item.content_type === 'word' ? 'tag-word' : 'tag-sentence'}}">{{item.content_type === 'word' ? '单词' : '句子'}}</text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="share-footer">
      <text class="footer-text">我也要学英语</text>
      <view class="footer-btn" bindtap="goHome">开始学习</view>
    </view>

  </block>
</view>
