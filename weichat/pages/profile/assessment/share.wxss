/* pages/profile/assessment/share.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-dot-wrapper {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #B2BEC3;
  animation: dotBounce 1.4s infinite;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 24rpx;
  color: #B2BEC3;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #636E72;
  font-weight: 600;
}

/* 用户信息卡片 */
.user-share-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.share-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  border: 4rpx solid #F8F9FA;
  margin-right: 20rpx;
  background: #F1F2F6;
}

.share-user-info {
  flex: 1;
}

.share-nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 6rpx;
}

.share-filter {
  display: block;
  font-size: 24rpx;
  color: #636E72;
  background: #F1F2F6;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  display: inline;
}

.share-date {
  font-size: 22rpx;
  color: #B2BEC3;
}

/* 统计卡片 */
.stats-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 4rpx;
}

.stat-num.score-green { color: #00B894; }
.stat-num.score-gold { color: #FF9F43; }

.stat-label {
  font-size: 22rpx;
  color: #B2BEC3;
}

/* 区段标题 */
.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.section-count {
  font-size: 24rpx;
  color: #B2BEC3;
}

/* 记录列表 */
.record-list {
  margin-bottom: 24rpx;
}

.record-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02);
}

.record-left {
  margin-right: 24rpx;
}

.score-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid;
}

.score-ring.score-excellent { border-color: #00B894; background: rgba(0,184,148,0.08); }
.score-ring.score-good { border-color: #0984E3; background: rgba(9,132,227,0.08); }
.score-ring.score-medium { border-color: #FF9F43; background: rgba(255,159,67,0.08); }
.score-ring.score-low { border-color: #FF6B6B; background: rgba(255,107,107,0.08); }

.ring-score {
  font-size: 30rpx;
  font-weight: 800;
}

.score-excellent .ring-score { color: #00B894; }
.score-good .ring-score { color: #0984E3; }
.score-medium .ring-score { color: #FF9F43; }
.score-low .ring-score { color: #FF6B6B; }

.record-center {
  flex: 1;
  min-width: 0;
}

.record-word {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.record-scores {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.mini-score {
  font-size: 22rpx;
  color: #636E72;
}

.mini-divider {
  font-size: 20rpx;
  color: #DFE6E9;
  margin: 0 8rpx;
}

.record-time {
  font-size: 20rpx;
  color: #B2BEC3;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-left: 16rpx;
}

.play-record-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #F1F2F6;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.play-record-btn:active { transform: scale(0.9); }

.play-record-btn.playing {
  background: #FF6B6B;
}

.play-icon {
  font-size: 22rpx;
  color: #636E72;
}

.play-record-btn.playing .play-icon {
  color: #FFFFFF;
}

.type-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.tag-word { background: #E6F7FF; color: #0984E3; }
.tag-sentence { background: #FFF7E6; color: #FF9F43; }

/* 底部提示 */
.share-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx 0 32rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #B2BEC3;
}

.footer-btn {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #2D3436;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(45,52,54,0.15);
}

.footer-btn:active {
  transform: scale(0.96);
}
