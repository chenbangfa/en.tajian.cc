/* pages/points/points.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #FF9F43 0%, #FF6B6B 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.3);
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.points-value {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
}

.filter-section {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-tabs {
  display: flex;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 8rpx;
  flex: 1;
  margin-right: 24rpx;
  margin-bottom: 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #B2BEC3;
  padding: 12rpx 0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #FFFFFF;
  color: #2D3436;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.filter-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
}

.filter-btn.active {
  background: #FFF2CC;
  color: #FF9F43;
}

.filter-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.filter-text {
  font-size: 26rpx;
  color: #2D3436;
  font-weight: 500;
}

.filter-btn.active .filter-text {
  color: #FF9F43;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.filter-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx;
  z-index: 101;
  transform: translateY(0);
  transition: transform 0.3s;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 48rpx;
  text-align: center;
}

.date-range-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 64rpx;
}

.modal-date-input {
  background: #F8F9FA;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #2D3436;
  min-width: 240rpx;
  text-align: center;
}

.modal-date-input.placeholder {
  color: #B2BEC3;
}

.modal-date-divider {
  color: #B2BEC3;
  margin: 0 16rpx;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
}

.modal-btn {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
}

.modal-btn.reset {
  background: #F1F2F6;
  color: #2D3436;
  margin-right: 24rpx;
}

.modal-btn.confirm {
  background: #2D3436;
  color: #FFFFFF;
}

/* 列表容器 */
.list-container {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  min-height: 400rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 24rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #FF9F43;
  line-height: 1.2;
}

/* 列表项 */
.points-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F8F9FA;
}

.points-item:last-child {
  border-bottom: none;
}

.item-left {
  flex: 1;
  margin-right: 20rpx;
}

.item-desc {
  font-size: 30rpx;
  color: #2D3436;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.item-date {
  font-size: 24rpx;
  color: #B2BEC3;
}

.item-right {
  font-size: 36rpx;
  font-weight: 700;
}

.item-right.positive {
  color: #FF9F43;
}

.item-right.negative {
  color: #2D3436;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #B2BEC3;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #B2BEC3;
}
