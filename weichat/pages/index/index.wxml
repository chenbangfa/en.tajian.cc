<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部个人状态卡片 -->
  <view class="header-card">
    <view class="greeting">
      <view class="hello">Hi, {{userInfo.nickname || '同学'}} 👋</view>
      <view class="subtitle">今天也要开心学习哦！</view>
    </view>
    
    <view class="stats-row">
      <view class="stat-box">
        <view class="stat-num">{{stats.wordsLearned || 0}}</view>
        <view class="stat-label">已学单词</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-box">
        <view class="stat-num">{{userInfo.points || 0}}</view>
        <view class="stat-label">我的积分</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-box">
        <view class="stat-num">{{stats.checkinDays || 0}}</view>
        <view class="stat-label">坚持天数</view>
      </view>
    </view>
  </view>

  <!-- 功能大卡片区 (2x2布局) -->
  <view class="main-grid">
    <view class="grid-card card-orange" bindtap="goToVocabulary">
      <view class="card-content">
        <view class="card-title">看图识字</view>
        <view class="card-desc">图片联想记忆</view>
      </view>
      <image class="card-icon-img" src="/assets/icons/icon-vocab.svg"></image>
    </view>

    <view class="grid-card card-blue" bindtap="goToScene">
      <view class="card-content">
        <view class="card-title">场景学习</view>
        <view class="card-desc">身临其境</view>
      </view>
      <image class="card-icon-img" src="/assets/icons/icon-scene.svg"></image>
    </view>

    <view class="grid-card card-green" bindtap="goToCamera">
      <view class="card-content">
        <view class="card-title">故事绘本</view>
        <view class="card-desc">英语小故事</view>
      </view>
      <image class="card-icon-img" src="/assets/icons/icon-camera.svg"></image>
    </view>

    <view class="grid-card card-purple" bindtap="goToAssessment">
      <view class="card-content">
        <view class="card-title">磨耳朵</view>
        <view class="card-desc">练听力，连续播放</view>
      </view>
      <image class="card-icon-img" src="/assets/icons/icon-mic.svg"></image>
    </view>
  </view>

  <!-- 今日任务 -->
  <view class="section-box" bindtap="goToCheckin">
    <view class="box-header">
      <view class="box-title-row">
        <image class="title-icon" src="/assets/icons/icon-calendar.svg"></image>
        <text class="box-title">今日任务</text>
      </view>
      <view class="check-btn {{todayChecked ? 'checked' : ''}}">
        {{todayChecked ? '✓ 已打卡' : '去打卡 ›'}}
      </view>
    </view>
    <!-- 进度条 -->
    <view class="task-progress-bar">
      <view class="task-progress-fill" style="width: {{taskProgress}}%"></view>
    </view>
    <view class="task-modules-row">
      <text class="task-module-pill">📖 {{taskCompleted}}/{{taskTotal}}</text>
      <text class="task-streak-info" wx:if="{{stats.checkinDays > 0}}">🔥 连续 {{stats.checkinDays}} 天</text>
    </view>
  </view>

  <!-- 每日推荐 -->
  <view class="section-box">
    <view class="box-header">
      <view class="box-title-row">
        <image class="title-icon" src="/assets/icons/icon-star.svg"></image>
        <text class="box-title">每日推荐</text>
      </view>
      <text class="see-all" bindtap="goToPodcast">更多 ></text>
    </view>
    <scroll-view class="scroll-view" scroll-x>
      <view class="recommend-card" wx:for="{{recommendWords}}" wx:key="id" bindtap="goToWordDetail" data-id="{{item.id}}">
        <image class="rec-img" src="{{item.image_url}}" mode="aspectFill"></image>
        <view class="rec-info">
          <text class="rec-word">{{item.word}}</text>
          <text class="rec-trans">{{item.translation}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
