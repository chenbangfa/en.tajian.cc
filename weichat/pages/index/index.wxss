/* pages/index/index.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* 顶部个人状态卡片 */
.header-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 40rpx;
}

.greeting {
  margin-bottom: 32rpx;
}

.hello {
  font-size: 40rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #B2BEC3;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-box {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
}

.stat-label {
  font-size: 22rpx;
  color: #636E72;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 40rpx;
  background: #F1F2F6;
}

/* 2x2 功能大卡片网格 */
.main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.grid-card {
  height: 220rpx;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  transition: transform 0.1s;
}

.grid-card:active {
  transform: scale(0.98);
}

.card-content {
  z-index: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 22rpx;
  opacity: 0.7;
}

.card-icon-img {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 96rpx;
  height: 96rpx;
  opacity: 0.9;
}

.box-title-row {
  display: flex;
  align-items: center;
}

.title-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

/* 卡片配色方案 */
/* 橙色主题 */
.card-orange {
  background: #FFF7E6;
}
.card-orange .card-title { color: #FF9F43; }
.card-orange .card-desc { color: #FF9F43; }

/* 蓝色主题 */
.card-blue {
  background: #E6F7FF;
}
.card-blue .card-title { color: #54A0FF; }
.card-blue .card-desc { color: #54A0FF; }

/* 绿色主题 */
.card-green {
  background: #E8FBF0;
}
.card-green .card-title { color: #2ED573; }
.card-green .card-desc { color: #2ED573; }

/* 紫色主题 */
.card-purple {
  background: #F3E8FF;
}
.card-purple .card-title { color: #A55EEA; }
.card-purple .card-desc { color: #A55EEA; }

/* 通用板块容器 */
.section-box {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 32rpx;
}

.box-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.box-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

/* 今日任务 */
.check-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #2ED573;
  color: #fff;
  font-weight: 600;
}

.check-btn.checked {
  background: #E8F5E9;
  color: #00B894;
}

.task-progress-bar {
  height: 12rpx;
  background: #F1F2F6;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.task-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2ED573, #00B894);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.task-modules-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-module-pill {
  font-size: 24rpx;
  color: #636E72;
  font-weight: 600;
}

.task-streak-info {
  font-size: 22rpx;
  color: #FF9F43;
  font-weight: 700;
}

/* 每日推荐滚动 */
.see-all {
  font-size: 24rpx;
  color: #B2BEC3;
}

.scroll-view {
  width: 100%;
  white-space: nowrap;
  /* 增加高度防止被裁切，或让其自动撑开 */
  min-height: 300rpx; 
}

.recommend-card {
  display: inline-block;
  width: 200rpx;
  margin-right: 24rpx;
  vertical-align: top; /* 顶部对齐 */
  padding-bottom: 20rpx; /* 底部留白 */
}

.rec-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #f0f0f0;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: block; /* 防止图片底部空隙 */
}

.rec-info {
  display: flex;
  flex-direction: column;
}

.rec-word {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rec-trans {
  font-size: 22rpx;
  color: #B2BEC3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
