/* pages/checkin/share/share.wxss */
.container {
  min-height: 100vh;
  background: #F8F9FA;
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载和错误 */
.loading-box, .error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-text { font-size: 28rpx; color: #B2BEC3; }
.error-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.error-text { font-size: 28rpx; color: #636E72; margin-bottom: 30rpx; }
.error-btn {
  padding: 16rpx 48rpx;
  background: #2ED573;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid #F1F2F6;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 4rpx;
}

.user-date {
  display: block;
  font-size: 24rpx;
  color: #B2BEC3;
}

.streak-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFF3E0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.streak-fire { font-size: 24rpx; }
.streak-num { font-size: 24rpx; font-weight: 700; color: #FF6B6B; }

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2D3436, #636E72);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.15);
}

/* 任务列表 */
.task-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 20rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F2F6;
}

.task-item:last-child {
  border-bottom: none;
}

.task-left {
  margin-right: 16rpx;
}

.task-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.task-type-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #F1F2F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.task-middle {
  flex: 1;
  min-width: 0;
}

.task-word {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-detail {
  display: block;
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
}

.task-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 12rpx;
}

.score-ring {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid;
}

.score-ring.excellent { border-color: #2ED573; background: #F0FFF4; }
.score-ring.good { border-color: #3498DB; background: #EBF5FB; }
.score-ring.medium { border-color: #F39C12; background: #FFF8E1; }
.score-ring.low { border-color: #FF6B6B; background: #FFF5F5; }

.ring-score {
  font-size: 22rpx;
  font-weight: 800;
  color: #2D3436;
}

.task-pending-tag {
  font-size: 20rpx;
  color: #B2BEC3;
  padding: 4rpx 12rpx;
  background: #F1F2F6;
  border-radius: 8rpx;
}

.play-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F1F2F6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn.playing {
  background: #2ED573;
}

.play-icon {
  font-size: 20rpx;
  color: #636E72;
}

.play-btn.playing .play-icon {
  color: #fff;
}

/* 底部引导 */
.footer-guide {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.guide-text {
  display: block;
  font-size: 26rpx;
  color: #B2BEC3;
  margin-bottom: 16rpx;
}

.guide-btn {
  display: inline-block;
  padding: 20rpx 64rpx;
  background: linear-gradient(135deg, #2ED573, #26C6DA);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(46, 213, 115, 0.3);
}
