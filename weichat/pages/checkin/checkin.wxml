<!--pages/checkin/checkin.wxml-->
<view class="container">

  <!-- ===== 顶部统计横幅 ===== -->
  <view class="streak-banner">
    <view class="streak-left">
      <image class="streak-icon" src="/assets/icons/icon-sparkle.svg"></image>
      <view class="streak-info">
        <text class="streak-num">{{streakDays}}</text>
        <text class="streak-label">天连续</text>
      </view>
    </view>
    <view class="streak-right">
      <view class="mode-tag" bindtap="showModeSelector">
        <image class="mode-icon" src="/assets/icons/icon-crown.svg" wx:if="{{currentMode === 'challenge'}}"></image>
        <image class="mode-icon" src="/assets/icons/icon-book.svg" wx:elif="{{currentMode === 'standard'}}"></image>
        <image class="mode-icon" src="/assets/icons/icon-dacha.svg" wx:else></image>
        <text>{{modeText}}</text>
        <image class="mode-arrow" src="/assets/icons/icon-chevron-down.svg"></image>
      </view>
      <view class="path-tag" bindtap="showPathSelector">
        <image class="mode-icon" src="/assets/icons/icon-vocab.svg"></image>
        <text>{{pathSummary}}</text>
      </view>
      <text class="multiplier-tag" wx:if="{{multiplier > 1}}">x{{multiplier}} 积分加成</text>
    </view>
  </view>

  <!-- ===== 进度条 ===== -->
  <view class="progress-card">
    <view class="progress-header">
      <text class="progress-title">今日进度</text>
      <text class="progress-count">{{completedCount}}/{{totalCount}}</text>
    </view>
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="progress-modules">
      <view class="module-pill {{wordDone ? 'done' : ''}}" wx:if="{{plan.word_target > 0}}">
        <image class="pill-icon" src="/assets/icons/icon-book.svg"></image>
        <text class="pill-text">单词 {{plan.word_completed || 0}}/{{plan.word_target || 0}}</text>
      </view>
      <view class="module-pill {{sceneDone ? 'done' : ''}}" wx:if="{{plan.scene_target > 0}}">
        <image class="pill-icon" src="/assets/icons/icon-scene.svg"></image>
        <text class="pill-text">场景 {{plan.scene_completed || 0}}/{{plan.scene_target || 0}}</text>
      </view>
      <view class="module-pill {{podcastDone ? 'done' : ''}}" wx:if="{{plan.podcast_target > 0}}">
        <image class="pill-icon" src="/assets/icons/icon-mic.svg"></image>
        <text class="pill-text">播客 {{plan.podcast_completed || 0}}/{{plan.podcast_target || 0}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 任务列表（默认视图） ===== -->
  <view class="task-list" wx:if="{{!activeTask && !allComplete}}">

    <!-- 单词任务组 -->
    <view class="task-group" wx:if="{{wordTasks.length > 0}}">
      <view class="group-header">
        <view class="group-title-wrap">
          <image class="group-icon" src="/assets/icons/icon-book.svg"></image>
          <text class="group-title">看图识字</text>
        </view>
        <view class="group-refresh" bindtap="refreshTasks" data-type="word" wx:if="{{!wordDone}}">
          <image class="refresh-icon" src="/assets/icons/icon-refresh.svg"></image>
          <text>{{checkinStrategy === 'curriculum' ? '课程内换题' : '换一批'}}</text>
        </view>
      </view>
      <view class="task-card {{item.status === 'completed' ? 'completed' : ''}}"
            wx:for="{{wordTasks}}" wx:key="id"
            bindtap="startTask" data-task-id="{{item.id}}" data-task-type="word">
        <image class="task-img" src="{{item.extra_info.image_url}}" mode="aspectFill" wx:if="{{item.extra_info.image_url}}"></image>
        <view class="task-img task-img-placeholder" wx:else>
          <image class="placeholder-icon" src="/assets/icons/icon-book.svg"></image>
        </view>
        <view class="task-body">
          <text class="task-word">{{item.extra_info.word || item.reference_text}}</text>
          <text class="task-sub">{{item.extra_info.phonetic}} · {{item.extra_info.translation}}</text>
        </view>
        <view class="task-status-icon">
          <view class="status-done" wx:if="{{item.status === 'completed'}}">
            <text class="done-score">{{item.score}}</text>
          </view>
          <view class="status-pending" wx:else>
            <text>去跟读</text>
            <image class="arrow-icon" src="/assets/icons/icon-next.svg"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 场景任务组 -->
    <view class="task-group" wx:if="{{sceneTasks.length > 0}}">
      <view class="group-header">
        <view class="group-title-wrap">
          <image class="group-icon" src="/assets/icons/icon-scene.svg"></image>
          <text class="group-title">场景跟读</text>
        </view>
        <view class="group-refresh" bindtap="refreshTasks" data-type="scene" wx:if="{{!sceneDone}}">
          <image class="refresh-icon" src="/assets/icons/icon-refresh.svg"></image>
          <text>{{checkinStrategy === 'curriculum' ? '课程内换题' : '换一批'}}</text>
        </view>
      </view>
      <view class="task-card {{item.status === 'completed' ? 'completed' : ''}}"
            wx:for="{{sceneTasks}}" wx:key="id"
            bindtap="startTask" data-task-id="{{item.id}}" data-task-type="scene">
        <view class="task-img task-scene-icon">
          <image class="placeholder-icon" src="/assets/icons/icon-scene.svg"></image>
        </view>
        <view class="task-body">
          <text class="task-word">{{item.extra_info.label || item.reference_text}}</text>
          <text class="task-sub">{{item.extra_info.scene_name}} · {{item.extra_info.translation}}</text>
        </view>
        <view class="task-status-icon">
          <view class="status-done" wx:if="{{item.status === 'completed'}}">
            <text class="done-score">{{item.score}}</text>
          </view>
          <view class="status-pending" wx:else>
            <text>去跟读</text>
            <image class="arrow-icon" src="/assets/icons/icon-next.svg"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 播客任务组 -->
    <view class="task-group" wx:if="{{podcastTasks.length > 0}}">
      <view class="group-header">
        <view class="group-title-wrap">
          <image class="group-icon" src="/assets/icons/icon-mic.svg"></image>
          <text class="group-title">磨耳朵跟读</text>
        </view>
        <view class="group-refresh" bindtap="refreshTasks" data-type="podcast" wx:if="{{!podcastDone}}">
          <image class="refresh-icon" src="/assets/icons/icon-refresh.svg"></image>
          <text>{{checkinStrategy === 'curriculum' ? '课程内换题' : '换一批'}}</text>
        </view>
      </view>
      <view class="task-card task-card-podcast {{item.status === 'completed' ? 'completed' : ''}}"
            wx:for="{{podcastTasks}}" wx:key="id"
            bindtap="startTask" data-task-id="{{item.id}}" data-task-type="podcast">
        <view class="task-img task-podcast-icon">
          <image class="placeholder-icon" src="/assets/icons/icon-mic.svg"></image>
        </view>
        <view class="task-body">
          <text class="task-word">{{item.extra_info.title || '播客内容'}}</text>
          <view class="difficulty-tag diff-{{item.extra_info.difficulty_level || 1}}">
            {{item.extra_info.difficulty_level == 1 ? '简单' : (item.extra_info.difficulty_level == 2 ? '中等' : '困难')}}
          </view>
        </view>
        <view class="task-status-icon">
          <view class="status-done" wx:if="{{item.status === 'completed'}}">
            <text class="done-score">{{item.score}}</text>
          </view>
          <view class="status-pending" wx:else>
            <text>去跟读</text>
            <image class="arrow-icon" src="/assets/icons/icon-next.svg"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态提示 -->
    <view class="empty-tasks" wx:if="{{wordTasks.length === 0 && sceneTasks.length === 0 && podcastTasks.length === 0}}">
      <image class="empty-icon-img" src="/assets/icons/icon-book.svg"></image>
      <text class="empty-title">暂无可用任务</text>
      <text class="empty-desc">请先在后台添加学习内容（单词/场景/播客），然后返回刷新</text>
      <view class="empty-refresh-btn" bindtap="loadPlan">点击刷新</view>
    </view>
  </view>

  <!-- ===== 任务执行视图 ===== -->
  <view class="task-exec" wx:if="{{activeTask && !allComplete}}">
    <view class="exec-back" bindtap="exitTask">
      <image class="back-icon" src="/assets/icons/icon-arrow-left.svg"></image>
      <text>返回任务列表</text>
    </view>

    <!-- 单词类型 -->
    <block wx:if="{{activeTask.task_type === 'word'}}">
      <view class="exec-card">
        <image class="exec-img" src="{{activeTask.extra_info.image_url}}" mode="aspectFill" wx:if="{{activeTask.extra_info.image_url}}"></image>
        <view class="exec-word">{{activeTask.extra_info.word}}</view>
        <view class="exec-phonetic">{{activeTask.extra_info.phonetic}}</view>
        <view class="exec-trans">{{activeTask.extra_info.translation}}</view>
      </view>
    </block>

    <!-- 场景类型 -->
    <block wx:if="{{activeTask.task_type === 'scene'}}">
      <view class="exec-card">
        <view class="exec-scene-label">
           <image class="label-icon" src="/assets/icons/icon-scene.svg"></image>
           <text>{{activeTask.extra_info.scene_name}}</text>
        </view>
        <view class="exec-sentence">{{activeTask.extra_info.label || activeTask.reference_text}}</view>
        <view class="exec-trans">{{activeTask.extra_info.translation}}</view>
      </view>
    </block>

    <!-- 播客类型 -->
    <block wx:if="{{activeTask.task_type === 'podcast'}}">
      <view class="exec-card exec-card-podcast">
        <view class="exec-podcast-header">
           <image class="podcast-icon" src="/assets/icons/icon-mic.svg"></image>
           <view class="exec-podcast-title">{{activeTask.extra_info.title}}</view>
        </view>
        <view class="exec-podcast-text">{{activeTask.extra_info.content_text}}</view>
        <view class="exec-podcast-trans">{{activeTask.extra_info.translation}}</view>
      </view>
    </block>

    <!-- 播放示范 -->
    <view class="exec-play-row">
      <view class="play-demo-btn" bindtap="playDemo" data-gender="female">
        <image class="demo-icon" src="/assets/icons/icon-female.svg"></image>
        <text class="demo-label">女声示范</text>
      </view>
      <view class="play-demo-btn male" bindtap="playDemo" data-gender="male">
        <image class="demo-icon" src="/assets/icons/icon-male.svg"></image>
        <text class="demo-label">男声示范</text>
      </view>
    </view>

    <!-- 录音区域 -->
    <view class="exec-record">
      <text class="record-hint">{{isRecording ? '松开结束录音' : (isAssessing ? '评测中...' : '按住开始跟读')}}</text>
      <view class="record-btn-big {{isRecording ? 'recording' : ''}} {{isAssessing ? 'assessing' : ''}}"
            bindtouchstart="startRecord" bindtouchend="stopRecord">
        <image class="rec-icon-img" src="/assets/icons/icon-stop.svg" wx:if="{{isRecording}}"></image>
        <image class="rec-icon-img" src="/assets/icons/icon-mic.svg" wx:else></image>
      </view>
      <text class="record-time" wx:if="{{isRecording}}">{{recordTime}}s</text>
    </view>
  </view>

  <!-- ===== 全部完成 / 打卡记录回顾 ===== -->
  <view class="celebrate" wx:if="{{allComplete}}">

    <!-- 顶部统计 -->
    <view class="complete-header">
      <image class="complete-icon" src="/assets/icons/icon-party.svg"></image>
      <text class="complete-title">今日打卡完成！</text>
    </view>

    <view class="celebrate-stats">
      <view class="c-stat">
        <text class="c-num">{{plan.avg_score || 0}}</text>
        <text class="c-label">平均分</text>
      </view>
      <view class="c-stat">
        <text class="c-num">{{plan.total_points || 0}}</text>
        <text class="c-label">获得积分</text>
      </view>
      <view class="c-stat">
        <text class="c-num">{{streakDays}}</text>
        <text class="c-label">连续天数</text>
      </view>
    </view>

    <!-- 新成就 -->
    <view class="achievement-pop" wx:for="{{newAchievements}}" wx:key="key">
      <image class="ach-icon" src="/assets/icons/icon-crown.svg"></image>
      <text class="ach-name">{{item.name}}</text>
      <text class="ach-desc">{{item.desc}}</text>
    </view>

    <!-- 打卡记录列表 -->
    <view class="record-section">
      <view class="record-title-wrap">
         <image class="record-title-icon" src="/assets/icons/icon-check.svg"></image>
         <text class="record-title">打卡记录</text>
      </view>

      <!-- 单词记录 -->
      <view class="record-item" wx:for="{{wordTasks}}" wx:key="id">
        <image class="record-img" wx:if="{{item.extra_info.image_url}}" src="{{item.extra_info.image_url}}" mode="aspectFill"></image>
        <view class="record-img record-placeholder" wx:else>
           <image class="record-placeholder-icon" src="/assets/icons/icon-book.svg"></image>
        </view>
        <view class="record-body">
          <text class="record-word">{{item.extra_info.word || item.reference_text}}</text>
          <text class="record-sub">{{item.extra_info.phonetic}} · {{item.extra_info.translation}}</text>
        </view>
        <view class="record-right">
          <view class="record-score {{item.score >= 90 ? 'excellent' : (item.score >= 80 ? 'good' : (item.score >= 60 ? 'medium' : 'low'))}}" wx:if="{{item.score}}">
            <text class="score-val">{{item.score}}</text>
          </view>
          <view class="record-play-btn {{recordPlayingId === item.id ? 'playing' : ''}}" 
                wx:if="{{item.audio_url && item.status === 'completed'}}"
                bindtap="playRecordAudio" data-id="{{item.id}}" data-url="{{item.audio_url}}">
            <image class="play-icon" src="/assets/icons/icon-pause.svg" wx:if="{{recordPlayingId === item.id}}"></image>
            <image class="play-icon" src="/assets/icons/icon-play.svg" wx:else></image>
          </view>
        </view>
      </view>

      <!-- 场景记录 -->
      <view class="record-item" wx:for="{{sceneTasks}}" wx:key="id">
        <view class="record-img record-placeholder">
          <image class="record-placeholder-icon" src="/assets/icons/icon-scene.svg"></image>
        </view>
        <view class="record-body">
          <text class="record-word">{{item.extra_info.label || item.reference_text}}</text>
          <text class="record-sub">{{item.extra_info.scene_name}} · {{item.extra_info.translation}}</text>
        </view>
        <view class="record-right">
          <view class="record-score {{item.score >= 90 ? 'excellent' : (item.score >= 80 ? 'good' : (item.score >= 60 ? 'medium' : 'low'))}}" wx:if="{{item.score}}">
            <text class="score-val">{{item.score}}</text>
          </view>
          <view class="record-play-btn {{recordPlayingId === item.id ? 'playing' : ''}}" 
                wx:if="{{item.audio_url && item.status === 'completed'}}"
                bindtap="playRecordAudio" data-id="{{item.id}}" data-url="{{item.audio_url}}">
            <image class="play-icon" src="/assets/icons/icon-pause.svg" wx:if="{{recordPlayingId === item.id}}"></image>
            <image class="play-icon" src="/assets/icons/icon-play.svg" wx:else></image>
          </view>
        </view>
      </view>

      <!-- 播客记录 -->
      <view class="record-item" wx:for="{{podcastTasks}}" wx:key="id">
        <view class="record-img record-placeholder">
           <image class="record-placeholder-icon" src="/assets/icons/icon-mic.svg"></image>
        </view>
        <view class="record-body">
          <text class="record-word">{{item.extra_info.title || '播客内容'}}</text>
          <text class="record-sub">{{item.extra_info.translation || ''}}</text>
        </view>
        <view class="record-right">
          <view class="record-score {{item.score >= 90 ? 'excellent' : (item.score >= 80 ? 'good' : (item.score >= 60 ? 'medium' : 'low'))}}" wx:if="{{item.score}}">
            <text class="score-val">{{item.score}}</text>
          </view>
          <view class="record-play-btn {{recordPlayingId === item.id ? 'playing' : ''}}" 
                wx:if="{{item.audio_url && item.status === 'completed'}}"
                bindtap="playRecordAudio" data-id="{{item.id}}" data-url="{{item.audio_url}}">
             <image class="play-icon" src="/assets/icons/icon-pause.svg" wx:if="{{recordPlayingId === item.id}}"></image>
            <image class="play-icon" src="/assets/icons/icon-play.svg" wx:else></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="complete-actions">
      <button class="share-btn-green" open-type="share">
         <image class="btn-icon" src="/assets/icons/icon-chat.svg"></image>
         <text>转发给好友</text>
      </button>
      <view class="poster-btn" bindtap="generatePoster">
         <image class="btn-icon" src="/assets/icons/icon-camera.svg"></image>
         <text>生成海报分享</text>
      </view>
      <view class="back-home-btn" bindtap="goHome">返回首页</view>
    </view>

    <!-- 海报弹窗 -->
    <view class="poster-modal" wx:if="{{showPoster}}" catchtap="closePoster">
      <view class="poster-box" catchtap="">
        <canvas canvas-id="checkinPoster" class="poster-canvas"></canvas>
        <view class="poster-actions">
          <view class="poster-action-btn save" catchtap="savePoster">保存到相册</view>
          <view class="poster-action-btn close" catchtap="closePoster">关闭</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 评测结果弹窗 ===== -->
  <view class="result-modal" wx:if="{{showResult}}" bindtap="closeResult">
    <view class="result-card" catchtap="noop">
      <text class="result-emoji">{{resultData.score >= 90 ? '🌟' : (resultData.score >= 80 ? '👍' : (resultData.score >= 60 ? '😊' : '💪'))}}</text>
      <text class="result-score {{resultData.score >= 90 ? 'excellent' : (resultData.score >= 80 ? 'good' : (resultData.score >= 60 ? 'medium' : 'low'))}}">{{resultData.score}}</text>
      <text class="result-label">分</text>

      <view class="result-detail">
        <view class="r-item">
          <text class="r-val">{{resultData.pronunciation_score}}</text>
          <text class="r-lbl">发音</text>
        </view>
        <view class="r-item">
          <text class="r-val">{{resultData.fluency_score}}</text>
          <text class="r-lbl">流利</text>
        </view>
        <view class="r-item">
          <text class="r-val">{{resultData.integrity_score}}</text>
          <text class="r-lbl">完整</text>
        </view>
      </view>

      <text class="result-points">+{{resultData.points_earned}} 积分</text>

      <view class="result-actions">
        <view class="result-btn outline" bindtap="retryTask" wx:if="{{resultData.score < 60}}">再试一次</view>
        <view class="result-btn primary" bindtap="closeResult">{{resultData.all_complete ? '查看成就' : '下一个'}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 模式选择弹窗 ===== -->
  <view class="mode-modal" wx:if="{{showModeModal}}" bindtap="closeModeModal">
    <view class="mode-content" catchtap="noop">
      <text class="mode-title">选择学习模式</text>
      <view class="mode-option {{currentMode === 'easy' ? 'active' : ''}}" bindtap="selectMode" data-mode="easy">
        <text class="mode-name">☕ 轻松模式</text>
        <text class="mode-desc">2个单词 + 1个场景</text>
      </view>
      <view class="mode-option {{currentMode === 'standard' ? 'active' : ''}}" bindtap="selectMode" data-mode="standard">
        <text class="mode-name">📚 标准模式</text>
        <text class="mode-desc">3个单词 + 2个场景 + 1个播客</text>
      </view>
      <view class="mode-option {{currentMode === 'challenge' ? 'active' : ''}}" bindtap="selectMode" data-mode="challenge">
        <text class="mode-name">🔥 挑战模式</text>
        <text class="mode-desc">5个单词 + 3个场景 + 1个播客</text>
      </view>
      <text class="mode-note">注意：切换模式会立即重置今天任务</text>
    </view>
  </view>

  <!-- ===== 学习路径弹窗 ===== -->
  <view class="mode-modal" wx:if="{{showPathModal}}" bindtap="closePathModal">
    <view class="mode-content" catchtap="noop">
      <text class="mode-title">学习路径</text>
      <view class="mode-option {{pathStrategyDraft === 'random' ? 'active' : ''}}" bindtap="selectPathStrategy" data-strategy="random">
        <text class="mode-name">随机练习</text>
        <text class="mode-desc">按难度随机推荐，适合日常练习</text>
      </view>
      <view class="mode-option {{pathStrategyDraft === 'curriculum' ? 'active' : ''}}" bindtap="selectPathStrategy" data-strategy="curriculum">
        <text class="mode-name">课程学习</text>
        <text class="mode-desc">按课程顺序推进，学习更连贯</text>
      </view>

      <view class="path-panel" wx:if="{{pathStrategyDraft === 'curriculum'}}">
        <text class="path-subtitle">选择课程</text>
        <scroll-view scroll-y class="course-list">
          <view class="course-item {{pathCourseIdDraft == item.id ? 'active' : ''}}" wx:for="{{curriculumCourses}}" wx:key="id" bindtap="chooseCourse" data-id="{{item.id}}">
            <view class="course-name">{{item.name}}</view>
            <view class="course-meta">L{{item.level}} {{item.description || ''}}</view>
          </view>
        </scroll-view>
      </view>

      <view class="path-panel">
        <text class="path-subtitle">当前等级：{{pathLevelDraft}}</text>
        <slider min="1" max="9" step="1" value="{{pathLevelDraft}}" show-value bindchange="onLevelChange" activeColor="#2ED573"></slider>
      </view>

      <view class="path-actions">
        <view class="path-btn path-btn-ghost" bindtap="closePathModal">取消</view>
        <view class="path-btn path-btn-primary" bindtap="savePathConfig">保存</view>
      </view>
      <text class="mode-note">注意：路径和等级会立即生效</text>
    </view>
  </view>

</view>
