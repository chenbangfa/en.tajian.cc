/* pages/checkin/checkin.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 60rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* ===== 连续打卡横幅 ===== */
.streak-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #2D3436 0%, #636E72 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(45,52,54,0.15);
}

.streak-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.streak-icon {
  width: 64rpx;
  height: 64rpx;
}

.streak-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.streak-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.streak-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.mode-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(4px);
}

.path-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  max-width: 300rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  background: rgba(255,255,255,0.12);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}

.mode-icon {
  width: 28rpx;
  height: 28rpx;
}

.mode-arrow {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.6;
}

.multiplier-tag {
  font-size: 20rpx;
  color: #FFEAA7;
  font-weight: 700;
  background: rgba(46, 213, 115, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* ===== 进度卡片 ===== */
.progress-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.progress-count {
  font-size: 30rpx;
  font-weight: 800;
  color: #2ED573;
}

.progress-bar-bg {
  height: 16rpx;
  background: #F1F2F6;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #2ED573, #00B894);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progress-modules {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.module-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F8F9FA;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid transparent;
}

.module-pill.done {
  background: #E8F5E9;
  border-color: #2ED573;
}

.pill-icon {
  width: 24rpx;
  height: 24rpx;
}

.pill-text {
  font-size: 24rpx;
  color: #636E72;
  font-weight: 600;
}

.module-pill.done .pill-text {
  color: #00B894;
}

/* ===== 任务列表 ===== */
.task-group {
  margin-bottom: 40rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.group-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-icon {
  width: 40rpx;
  height: 40rpx;
}

.group-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.group-refresh {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #0984E3;
  font-weight: 500;
  padding: 8rpx 16rpx;
  background: #E6F7FF;
  border-radius: 24rpx;
}

.refresh-icon {
  width: 24rpx;
  height: 24rpx;
}

.task-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  transition: all 0.2s;
  border: 1rpx solid #F8F9FA;
}

.task-card:active {
  transform: scale(0.98);
}

.task-card.completed {
  opacity: 0.7;
  background: #FAFAFA;
}

.task-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  background: #F1F2F6;
  flex-shrink: 0;
}

.task-img-placeholder, .task-scene-icon, .task-podcast-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.4;
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-word {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-sub {
  font-size: 24rpx;
  color: #B2BEC3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-status-icon {
  margin-left: 20rpx;
}

.status-pending {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(90deg, #2ED573, #26de81);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(46, 213, 115, 0.3);
}

.arrow-icon {
  width: 20rpx;
  height: 20rpx;
}

.status-done {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.done-score {
  font-size: 26rpx;
  font-weight: 800;
  color: #00B894;
}

/* 难度标签 */
.difficulty-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.diff-1 { background: #E8F5E9; color: #00B894; }
.diff-2 { background: #FFF3E0; color: #FF9F43; }
.diff-3 { background: #FFEBEE; color: #FF6B6B; }

/* ===== 任务执行视图 ===== */
.task-exec {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.exec-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #636E72;
  font-weight: 600;
  margin-bottom: 24rpx;
  padding: 12rpx 0;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.exec-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.04);
  margin-bottom: 32rpx;
  border: 1rpx solid #F8F9FA;
}

.exec-img {
  width: 400rpx;
  height: 400rpx;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

.exec-word {
  font-size: 64rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.exec-phonetic {
  font-size: 32rpx;
  color: #636E72;
  font-family: monospace;
  margin-bottom: 20rpx;
  background: #F1F2F6;
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.exec-trans {
  font-size: 32rpx;
  color: #2D3436;
  opacity: 0.8;
}

.exec-scene-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #0984E3;
  background: #E6F7FF;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.label-icon {
  width: 28rpx;
  height: 28rpx;
}

.exec-sentence {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D3436;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.exec-card-podcast {
  text-align: left;
}

.exec-podcast-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.podcast-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 12rpx;
  background: #E6F7FF;
  border-radius: 20rpx;
}

.exec-podcast-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
  flex: 1;
}

.exec-podcast-text {
  font-size: 32rpx;
  color: #2D3436;
  line-height: 1.8;
  margin-bottom: 24rpx;
  background: #F8F9FA;
  padding: 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid #F1F2F6;
}

.exec-podcast-trans {
  font-size: 28rpx;
  color: #636E72;
  line-height: 1.6;
}

/* 播放示范 */
.exec-play-row {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.play-demo-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 40rpx;
  background: #FFF7E6;
  border-radius: 40rpx;
  border: 2rpx solid #FFEAA7;
  transition: all 0.2s;
}

.play-demo-btn:active {
  transform: scale(0.95);
}

.play-demo-btn.male {
  background: #E6F7FF;
  border-color: #74B9FF;
}

.demo-icon {
  width: 36rpx;
  height: 36rpx;
}

.demo-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

/* 录音区域 */
.exec-record {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

.record-hint {
  font-size: 28rpx;
  color: #B2BEC3;
  margin-bottom: 32rpx;
}

.record-btn-big {
  width: 180rpx;
  height: 180rpx;
  border-radius: 90rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.08);
  border: 4rpx solid #F1F2F6;
  transition: all 0.2s;
}

.rec-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.record-btn-big.recording {
  background: #FF6B6B;
  border-color: #FF6B6B;
  transform: scale(1.1);
  box-shadow: 0 24rpx 56rpx rgba(255,107,107,0.3);
}

.rec-icon-img {
  transition: all 0.2s;
}

.record-btn-big.recording .rec-icon-img {
  filter: brightness(100);
}

.record-btn-big.assessing {
  background: #74B9FF;
  border-color: #74B9FF;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(116, 185, 255, 0.4); }
  70% { box-shadow: 0 0 0 30rpx rgba(116, 185, 255, 0); }
  100% { box-shadow: 0 0 0 0 rgba(116, 185, 255, 0); }
}

.record-time {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 700;
  font-family: monospace;
}

/* ===== 庆祝视图 ===== */
.celebrate {
  animation: fadeIn 0.5s ease;
}

.complete-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.complete-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
}

.complete-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2D3436;
}

.celebrate-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
  padding: 32rpx 0;
  border-top: 2rpx solid #F1F2F6;
  border-bottom: 2rpx solid #F1F2F6;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.c-stat {
  text-align: center;
}

.c-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #2ED573;
}

.c-label {
  font-size: 24rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
}

/* 成就弹出 */
.achievement-pop {
  background: linear-gradient(135deg, #FFF7E6, #FFEAA7);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  animation: popIn 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 67, 0.15);
}

@keyframes popIn {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.ach-icon {
  width: 64rpx;
  height: 64rpx;
}

.ach-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #D35400;
}

.ach-desc {
  font-size: 24rpx;
  color: #636E72;
  flex: 1;
}

.share-btn-green {
  width: 100%;
  height: 104rpx;
  background: #2ED573;
  color: #FFFFFF;
  border-radius: 52rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(46,213,115,0.3);
  border: none;
  padding: 0;
  transition: all 0.2s;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.share-btn-green:active {
  transform: scale(0.98);
  background: #26de81;
}

.back-home-btn {
  font-size: 28rpx;
  color: #B2BEC3;
  margin-top: 32rpx;
  padding: 16rpx;
}

/* 海报按钮 */
.poster-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #F1F2F6;
  color: #636E72;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

/* ===== 评测结果弹窗 ===== */
.result-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.result-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  animation: popIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.result-emoji {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.result-score {
  font-size: 72rpx;
  font-weight: 800;
  display: inline;
}

.result-score.excellent { color: #00B894; }
.result-score.good { color: #0984E3; }
.result-score.medium { color: #FF9F43; }
.result-score.low { color: #FF6B6B; }

.result-label {
  font-size: 28rpx;
  color: #B2BEC3;
  margin-left: 8rpx;
}

.result-detail {
  display: flex;
  justify-content: space-around;
  margin: 28rpx 0;
  padding: 20rpx 0;
  border-top: 2rpx solid #F1F2F6;
  border-bottom: 2rpx solid #F1F2F6;
}

.r-item {
  text-align: center;
}

.r-val {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.r-lbl {
  font-size: 22rpx;
  color: #B2BEC3;
}

.result-points {
  display: block;
  font-size: 28rpx;
  color: #2ED573;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.result-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.result-btn.outline {
  background: #F1F2F6;
  color: #636E72;
}

.result-btn.primary {
  background: #2D3436;
  color: #FFFFFF;
}

/* ===== 模式选择弹窗 ===== */
.mode-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.mode-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.mode-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #2D3436;
  text-align: center;
  margin-bottom: 32rpx;
}

.mode-option {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
  border: 3rpx solid #F1F2F6;
  transition: all 0.2s;
}

.mode-option.active {
  border-color: #2ED573;
  background: #F0FFF4;
}

.mode-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 6rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: #B2BEC3;
}

.mode-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 16rpx;
}

.path-panel {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
}

.path-subtitle {
  display: block;
  font-size: 24rpx;
  color: #636E72;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.course-list {
  max-height: 280rpx;
}

.course-item {
  padding: 16rpx;
  border-radius: 14rpx;
  border: 2rpx solid #EAECEF;
  background: #FFF;
  margin-bottom: 10rpx;
}

.course-item.active {
  border-color: #2ED573;
  background: #F0FFF4;
}

.course-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D3436;
}

.course-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #98A0A6;
}

.path-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.path-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.path-btn-ghost {
  background: #F1F2F6;
  color: #636E72;
}

.path-btn-primary {
  background: #2ED573;
  color: #fff;
}

/* 空状态 */
.empty-tasks {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-icon-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.2;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #B2BEC3;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-refresh-btn {
  padding: 20rpx 64rpx;
  background: #2ED573;
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(46,213,115,0.2);
}

/* 打卡记录列表 */
.record-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.record-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F8F9FA;
}

.record-title-icon {
  width: 36rpx;
  height: 36rpx;
}

.record-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F8F9FA;
}

.record-item:last-child {
  border-bottom: none;
}

.record-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  object-fit: cover;
}

.record-placeholder {
  background: #F1F2F6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-placeholder-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.4;
}

.play-icon {
  width: 32rpx;
  height: 32rpx;
}

.record-body {
  flex: 1;
  min-width: 0;
}

.record-word {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-sub {
  display: block;
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
}

.record-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 12rpx;
}

.record-score {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid;
}

.record-score.excellent { border-color: #2ED573; background: #F0FFF4; }
.record-score.good { border-color: #3498DB; background: #EBF5FB; }
.record-score.medium { border-color: #F39C12; background: #FFF8E1; }
.record-score.low { border-color: #FF6B6B; background: #FFF5F5; }

.score-val {
  font-size: 20rpx;
  font-weight: 800;
  color: #2D3436;
}

.record-play-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F1F2F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.record-play-btn.playing {
  background: #2ED573;
}

/* 操作按钮区 */
.complete-actions {
  text-align: center;
  margin-top: 24rpx;
}

/* 海报按钮 */
.poster-btn {
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #636E72;
  font-weight: 600;
  margin-top: 12rpx;
}

/* 海报弹窗 */
.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  max-width: 90vw;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-canvas {
  width: 300px;
  height: 450px;
}

.poster-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  width: 100%;
}

.poster-action-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.poster-action-btn.save {
  background: #2ED573;
  color: #fff;
}

.poster-action-btn.close {
  background: #F1F2F6;
  color: #636E72;
}
