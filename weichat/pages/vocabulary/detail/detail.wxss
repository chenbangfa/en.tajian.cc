/* pages/vocabulary/detail/detail.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 200rpx; /* safe area for bottom bar */
}

.container {
  padding: 0;
}

/* 单词大图卡片 */
.card-hero {
  position: relative;
  /* height: 500rpx; removed to adapt to image height */
  background: #F1F2F6;
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-image {
  width: 100%;
  height: auto;
  display: block;
}

/* 单词信息卡片 */
.info-card {
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.word-text {
  font-size: 64rpx;
  font-weight: 800;
  color: #2D3436;
}

/* 行内声音按钮组 */
.voice-actions-inline {
  display: flex;
  gap: 16rpx;
}

.v-btn-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.v-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.v-btn-circle:active {
  transform: scale(0.95);
}

.v-btn-circle.female {
  background: #FFF7E6; /* 浅橙色背景 */
  border: 2rpx solid #FFEAA7;
}

.v-btn-circle.male {
  background: #E6F7FF; /* 浅蓝色背景 */
  border: 2rpx solid #74B9FF;
}

.sub-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.word-phonetic {
  font-size: 28rpx;
  color: #B2BEC3;
  margin-right: 16rpx;
  font-family: monospace;
}

.tag {
  font-size: 20rpx;
  background: #F1F2F6;
  color: #636E72;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.word-trans {
  font-size: 32rpx;
  color: #636E72;
  line-height: 1.5;
}

/* 通用板块卡片 */
.section-card {
  margin: 0 32rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 24rpx;
}

.title-left {
  display: flex;
  align-items: center;
}

.title-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.play-sm {
  font-size: 24rpx;
  color: #0984E3;
  background: #E6F7FF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.sm-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.example-box {
  background: #F8F9FA;
  padding: 24rpx;
  border-radius: 20rpx;
}

.ex-en {
  font-size: 30rpx;
  color: #2D3436;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.ex-zh {
  font-size: 26rpx;
  color: #B2BEC3;
}

/* 例句声音选择 */
.voice-actions-sm {
  display: flex;
  gap: 16rpx;
}

.play-sm.male {
  background: #E6F0FF;
  color: #4A90E2;
}

/* 语法解析 */
.grammar-box {
  background: linear-gradient(135deg, #f8f9ff 0%, #fff5f5 100%);
  padding: 24rpx;
  border-radius: 20rpx;
  border-left: 6rpx solid #6B7AE8;
}

.grammar-text {
  font-size: 28rpx;
  color: #4A4A4A;
  line-height: 1.8;
}

/* 反义词滚动 */
.antonym-scroll {
  white-space: nowrap;
}

.antonym-pill {
  display: inline-block;
  background: #F8F9FA;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.at-word {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
  margin-right: 8rpx;
}

.at-trans {
  font-size: 24rpx;
  color: #B2BEC3;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
}

.nav-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #F1F2F6;
  color: #636E72;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

/* 录音按钮 */
.record-btn {
  flex: 1;
  height: 88rpx;
  background: #2ED573; /* 绿色背景 */
  color: #FFFFFF;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(46, 213, 115, 0.3);
  transition: all 0.2s;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.btn-icon-sm {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.btn-icon-sm-w {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.record-btn.recording {
  background: #FF6B6B;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.record-btn.assessing {
  background: #74B9FF;
}

/* 评测结果弹窗 */
.result-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.result-card {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 40rpx;
  position: relative;
  animation: popIn 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

@keyframes popIn {
  0% { transform: scale(0.9); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.close-icon {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  color: #B2BEC3;
  padding: 10rpx;
}

.close-img {
  width: 48rpx;
  height: 48rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.result-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #2D3436;
}

.result-date {
  font-size: 24rpx;
  color: #B2BEC3;
}

.score-display {
  background: #F8F9FA;
  border-radius: 32rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 40rpx;
}

.score-main {
  text-align: center;
  margin-bottom: 32rpx;
}

.score-num {
  display: block;
  font-size: 80rpx;
  font-weight: 800;
  color: #2ED573;
  line-height: 1;
  margin-bottom: 8rpx;
}

.score-txt {
  font-size: 24rpx;
  color: #B2BEC3;
}

.score-grid {
  display: flex;
  justify-content: space-around;
  border-top: 2rpx solid #E0E0E0;
  padding-top: 32rpx;
}

.s-item {
  text-align: center;
}

.s-val {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.s-lbl {
  font-size: 22rpx;
  color: #B2BEC3;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.outline {
  background: #F1F2F6;
  color: #636E72;
}

.modal-btn.primary {
  background: #2D3436;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.2);
}

/* 导航按钮占位符（打卡模式隐藏左右切换时保持布局） */
.nav-btn-placeholder {
  width: 80rpx;
  height: 80rpx;
}

/* 打卡模式额外信息 */
.checkin-result-info {
  margin: 20rpx 0 0;
  text-align: center;
}

.checkin-points {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.points-icon {
  font-size: 32rpx;
}

.points-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #F39C12;
}

.checkin-complete-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #F0FFF4;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.complete-emoji {
  font-size: 28rpx;
}

.complete-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #2ED573;
}
