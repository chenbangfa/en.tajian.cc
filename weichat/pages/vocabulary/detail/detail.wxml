<!--pages/vocabulary/detail/detail.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <block wx:if="{{!loading && word}}">
    <!-- 单词大图卡片 -->
    <view class="card-hero">
      <image class="hero-image" src="{{word.image_url || '/assets/images/placeholder.png'}}" mode="widthFix"></image>
    </view>

    <!-- 单词主要信息 -->
    <view class="info-card">
      <view class="main-row">
        <text class="word-text">{{word.word}}</text>
        <!-- 直接播放按钮组 -->
        <view class="voice-actions-inline">
           <view class="v-btn-circle female" bindtap="playVoice" data-voice="female">
             <image class="v-icon-img" src="/assets/icons/icon-female.svg"></image>
           </view>
           <view class="v-btn-circle male" bindtap="playVoice" data-voice="male">
             <image class="v-icon-img" src="/assets/icons/icon-male.svg"></image>
           </view>
        </view>
      </view>
      
      <view class="sub-row">
        <text class="word-phonetic" wx:if="{{word.phonetic}}">{{word.phonetic}}</text>
        <view class="word-type tag" wx:if="{{word.word_type}}">{{word.word_type}}</view>
      </view>
      
      <view class="word-trans">{{word.translation}}</view>
    </view>

    <!-- 例句 -->
    <view class="section-card" wx:if="{{word.example_sentence}}">
      <view class="section-title">
        <view class="title-left">
          <image class="title-icon" src="/assets/icons/icon-note.svg"></image>
          <text>例句</text>
        </view>
        <view class="voice-actions-sm">
          <view class="play-sm" bindtap="playExampleSentence" data-voice="female">
            <image class="sm-icon" src="/assets/icons/icon-female.svg"></image> 女声
          </view>
          <view class="play-sm male" bindtap="playExampleSentence" data-voice="male">
            <image class="sm-icon" src="/assets/icons/icon-male.svg"></image> 男声
          </view>
        </view>
      </view>
      <view class="example-box">
        <view class="ex-en">{{word.example_sentence}}</view>
        <view class="ex-zh">{{word.example_translation}}</view>
      </view>
    </view>

    <!-- 语法解析 -->
    <view class="section-card" wx:if="{{word.grammar_explanation}}">
      <view class="section-title">
        <view class="title-left">
          <image class="title-icon" src="/assets/icons/icon-book.svg"></image>
          <text>语法解析</text>
        </view>
      </view>
      <view class="grammar-box">
        <text class="grammar-text">{{word.grammar_explanation}}</text>
      </view>
    </view>

    <!-- 反义词 -->
    <view class="section-card" wx:if="{{word.antonyms && word.antonyms.length > 0}}">
      <view class="section-title">
        <view class="title-left">
          <image class="title-icon" src="/assets/icons/icon-exchange.svg"></image>
          <text>反义词</text>
        </view>
      </view>
      <scroll-view class="antonym-scroll" scroll-x>
        <view class="antonym-pill" wx:for="{{word.antonyms}}" wx:key="id" bindtap="goToWord" data-id="{{item.id}}">
          <text class="at-word">{{item.word}}</text>
          <text class="at-trans">{{item.translation}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 底部操作栏 -->
    <view class="action-bar safe-bottom">
      <view class="nav-btn left" bindtap="prevWord" wx:if="{{!checkinMode}}">←</view>
      <view class="nav-btn-placeholder" wx:if="{{checkinMode}}"></view>
      
      <view 
        class="record-btn {{isRecording ? 'recording' : ''}} {{isAssessing ? 'assessing' : ''}}"
        bindtap="toggleRecord">
        <block wx:if="{{isRecording}}">
           <view class="wave-anim">
             <image class="btn-icon" src="/assets/icons/icon-stop.svg"></image>
           </view> 
           <text>停止录音 {{recordingTime}}s</text>
        </block>
        <block wx:elif="{{isAssessing}}">
           <view class="loading-spinner"></view>
           <text>智能评分中...</text>
        </block>
        <block wx:else>
           <image class="btn-icon" src="/assets/icons/icon-mic.svg"></image>
           <text>{{checkinMode ? '跟读打卡' : '点击跟读评测'}}</text>
        </block>
      </view>
      
      <view class="nav-btn right" bindtap="nextWord" wx:if="{{!checkinMode}}">→</view>
      <view class="nav-btn-placeholder" wx:if="{{checkinMode}}"></view>
    </view>

    <!-- 评测结果弹窗 -->
    <view class="result-modal" wx:if="{{showResult}}" catchtap="closeResult">
      <view class="result-card" catchtap="noop">
        <view class="close-icon" bindtap="closeResult">
          <image class="close-img" src="/assets/icons/icon-close.svg"></image>
        </view>
        <view class="result-header">
           <text class="result-title">{{checkinMode ? '打卡评测' : '评测报告'}}</text>
           <text class="result-date">刚刚</text>
        </view>
        
        <view class="score-display">
          <view class="score-main">
            <text class="score-num">{{assessResult.overall_score || 0}}</text>
            <text class="score-txt">总分</text>
          </view>
          
          <view class="score-grid">
            <view class="s-item">
              <text class="s-val">{{assessResult.pronunciation_score || 0}}</text>
              <text class="s-lbl">发音</text>
            </view>
            <view class="s-item">
              <text class="s-val">{{assessResult.fluency_score || 0}}</text>
              <text class="s-lbl">流利</text>
            </view>
            <view class="s-item">
              <text class="s-val">{{assessResult.integrity_score || 0}}</text>
              <text class="s-lbl">完整</text>
            </view>
          </view>
        </view>

        <!-- 打卡模式额外信息 -->
        <view class="checkin-result-info" wx:if="{{checkinMode && checkinResult}}">
          <view class="checkin-points">
            <text class="points-icon">⭐</text>
            <text class="points-text">+{{checkinResult.points_earned}} 积分</text>
          </view>
          <view class="checkin-complete-tip" wx:if="{{checkinResult.all_complete}}">
            <text class="complete-emoji">🎉</text>
            <text class="complete-text">今日任务全部完成！</text>
          </view>
        </view>

        <view class="modal-actions">
          <view class="modal-btn outline" catchtap="playUserRecording" wx:if="{{audioPath}}">
             <image class="btn-icon-sm" src="/assets/icons/icon-sound.svg"></image> 听我的录音
          </view>
          <block wx:if="{{checkinMode}}">
            <view class="modal-btn primary" catchtap="checkinGoBack">
               返回任务列表
            </view>
          </block>
          <block wx:else>
            <view class="modal-btn primary" catchtap="tryAgain">
               <image class="btn-icon-sm-w" src="/assets/icons/icon-refresh.svg"></image> 再试一次
            </view>
          </block>
        </view>
      </view>
    </view>
  </block>
</view>
