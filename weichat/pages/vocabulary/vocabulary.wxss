/* pages/vocabulary/vocabulary.wxss */
page {
  background-color: #F8F9FA;
}

.container {
  padding: 24rpx 32rpx;
}

/* 顶部标题区 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding-top: 16rpx;
}

.header-left {
  flex: 1;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #B2BEC3;
}

/* 筛选按钮（右上角） */
.filter-btn {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  margin-top: 8rpx;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #2D3436;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  opacity: 0.5;
}

/* Category Scroll - deprecated, replaced by drawer */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.category-list {
  display: inline-flex;
  padding-right: 32rpx; /* 滚动尽头留白 */
}

.category-pill {
  display: inline-block;
  padding: 14rpx 32rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #636E72;
  margin-right: 20rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s;
}

.category-pill.active {
  background: #2D3436; /* 黑色选中态，更简约高级 */
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(45, 52, 54, 0.3);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.filter-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.filter-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.filter-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.filter-sub {
  font-size: 28rpx;
  color: #0984E3;
  margin-left: 8rpx;
}

.filter-arrow {
  padding: 8rpx;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* 抽屉遮罩 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.drawer-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 抽屉面板 */
.drawer-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 70vh;
}

.drawer-panel.show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #F1F2F6;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.drawer-close {
  padding: 12rpx;
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.drawer-body {
  display: flex;
  height: 500rpx;
}

/* 左侧一级分类 */
.parent-list {
  width: 35%;
  background: #F8F9FA;
  height: 100%;
}

.parent-item {
  padding: 32rpx 28rpx;
  font-size: 28rpx;
  color: #636E72;
  border-left: 6rpx solid transparent;
  transition: all 0.2s;
}

.parent-item.active {
  background: #FFFFFF;
  color: #2D3436;
  font-weight: 600;
  border-left-color: #0984E3;
}

/* 右侧二级分类 */
.child-list {
  width: 65%;
  height: 100%;
  padding: 16rpx;
}

.child-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  margin: 8rpx;
  background: #F8F9FA;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #636E72;
  transition: all 0.2s;
}

.child-item.active {
  background: #0984E3;
  color: #FFFFFF;
}

.child-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #B2BEC3;
  font-size: 26rpx;
}

/* Word Grid */
.word-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.word-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  display: flex;
  flex-direction: column;
}

.card-img-box {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.word-image {
  width: 100%;
  height: 100%;
  background: #F1F2F6;
}

.play-btn {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transition: transform 0.1s;
}

.play-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.play-btn:active {
  transform: scale(0.9);
}

.word-info {
  padding: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.word-main {
  margin-bottom: 8rpx;
}

.word-text {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3436;
}

.word-phonetic {
  display: block;
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
}

.word-translation {
  font-size: 26rpx;
  color: #636E72;
}

/* 状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.empty-img {
  width: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-state text {
  font-size: 28rpx;
  color: #B2BEC3;
}

.loading-state {
  text-align: center;
  padding: 32rpx;
  color: #B2BEC3;
  font-size: 24rpx;
}

/* 上滑加载更多 */
.loading-more-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #B2BEC3;
  font-size: 24rpx;
}

.loading-dots {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #B2BEC3;
  margin: 0 4rpx;
  animation: dotBounce 1.2s infinite ease-in-out;
}

.dot1 { animation-delay: 0s; }
.dot2 { animation-delay: 0.2s; }
.dot3 { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* 已到底 */
.no-more {
  text-align: center;
  padding: 40rpx 32rpx;
  color: #DFE6E9;
  font-size: 24rpx;
}

/* 播放按钮生成中动画 */
.play-btn.generating {
  background: rgba(9, 132, 227, 0.15);
}

.generating-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #0984E3;
  border-top-color: transparent;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
