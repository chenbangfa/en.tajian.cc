<view class="day-page task-page">
  <view class="task-top" wx:if="{{day.id}}">
    <view>
      <view class="day-kicker">Day {{day.day_number}}</view>
      <view class="task-top-title">{{currentModule.title}}</view>
    </view>
    <view class="done-badge {{currentModule.progress.completed ? 'ok' : ''}}">{{currentModule.progress.completed ? '已完成' : currentModule.estimated_minutes + '分钟'}}</view>
  </view>

  <view class="pass-score-box task-score-setting" wx:if="{{currentModule.id}}">
    <text>跟读过关分</text>
    <view class="pass-score-options">
      <view class="pass-score-chip {{passScore == item ? 'active' : ''}}" wx:for="{{passScoreOptions}}" wx:key="*this" bindtap="changePassScore" data-score="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <view class="module-card" wx:if="{{currentModule.id}}">
    <view class="module-head">
      <view>
        <view class="module-type">{{currentModule.type_label || currentModule.module_type}}</view>
        <view class="module-title">{{currentModule.title}}</view>
        <view class="module-task-count" wx:if="{{currentModule.item_summary}}">
          任务 {{currentModule.item_summary.completed_required}} / {{currentModule.item_summary.required_count}}
        </view>
      </view>
      <view class="done-badge {{currentModule.progress.completed ? 'ok' : ''}}">{{currentModule.progress.completed ? '已完成' : currentModule.estimated_minutes + '分钟'}}</view>
    </view>

    <block wx:if="{{currentModule.module_type === 'goal'}}">
      <view class="quote">{{currentModule.content.summary}}</view>
      <view class="check-list">
        <view wx:for="{{currentModule.content.can_do}}" wx:key="*this" class="check-row">✓ {{item}}</view>
      </view>
      <view class="target-output">{{currentModule.content.target_output}}</view>
    </block>

    <block wx:elif="{{currentModule.module_type === 'vocabulary'}}">
      <view class="method-row">
        <text wx:for="{{currentModule.content.method}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="task-guide">下面按 {{currentModule.item_summary.total || currentModule.items.length}} 个单词逐个听、跟读和过关。</view>
    </block>

    <block wx:elif="{{currentModule.module_type === 'listening' || currentModule.module_type === 'podcast_listening' || currentModule.module_type === 'shadowing'}}">
      <view wx:if="{{currentModule.podcast_content}}" class="podcast-bind-card">
        <view class="podcast-bind-kicker">磨耳朵文章</view>
        <view class="podcast-bind-title">{{currentModule.podcast_content.title}}</view>
        <view class="podcast-bind-sub">
          {{currentModule.podcast_content.sentence_count || 0}} 句 · 逐句听力 · 点词释义 · 跟读评测
        </view>
        <view class="podcast-bind-actions">
          <view class="podcast-bind-btn primary" bindtap="openPodcastPlayer">打开文章</view>
          <view class="podcast-bind-btn" bindtap="openPodcastAssess">开始评测</view>
        </view>
      </view>
      <block wx:else>
        <view class="listen-text">{{currentModule.content.text}}</view>
        <view class="listen-cn">{{currentModule.content.translation}}</view>
        <view class="steps">
          <view wx:for="{{currentModule.content.steps}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="action-btn secondary {{ttsPlaying ? 'disabled' : ''}}" bindtap="playListening">{{ttsPlaying ? '播放中...' : '播放听力'}}</view>
      </block>
    </block>

    <block wx:elif="{{currentModule.module_type === 'speaking' || currentModule.module_type === 'speaking_output'}}">
      <view wx:if="{{currentModule.podcast_content}}" class="podcast-bind-card speaking">
        <view class="podcast-bind-kicker">口语整篇朗读</view>
        <view class="podcast-bind-title">{{currentModule.podcast_content.title}}</view>
        <view class="podcast-bind-sub">
          读完整篇文章并完成口语评测，达到 {{currentModule.items[0].pass_score || passScore}} 分即可通关。
        </view>
        <view class="speaking-article-preview">{{currentModule.podcast_content.content_text}}</view>
        <view class="podcast-bind-actions">
          <view class="podcast-bind-btn" bindtap="openPodcastPlayer">先看文章</view>
          <view class="podcast-bind-btn primary {{isAssessing ? 'disabled' : ''}} {{isRecording ? 'recording' : ''}}" bindtap="toggleRecord">
            {{isRecording ? '停止录音 ' + recordingTime + 's' : (isAssessing ? '评测中...' : '整篇朗读评测')}}
          </view>
        </view>
      </view>
      <view wx:else class="empty-bind-card">本口语任务需要先在后台绑定磨耳朵文章。</view>
      <view class="score-card" wx:if="{{speakingResult.overall_score}}">
        <text class="score-num">{{speakingResult.overall_score}}</text>
        <text>分</text>
      </view>
    </block>

    <block wx:elif="{{currentModule.module_type === 'writing' || currentModule.module_type === 'sentence_builder' || currentModule.module_type === 'typing_writing'}}">
      <view wx:if="{{currentModule.podcast_content}}" class="podcast-bind-card writing">
        <view class="podcast-bind-kicker">文章写作</view>
        <view class="podcast-bind-title">{{currentModule.podcast_content.title}}</view>
        <view class="podcast-bind-sub">
          这个写作任务自动绑定磨耳朵文章。请根据文章完成英文复述、改写或总结。
        </view>
        <view class="writing-source-card">
          <view class="writing-source-label">英文文章</view>
          <view class="writing-source-text">{{currentModule.podcast_content.content_text}}</view>
          <view class="writing-source-label cn" wx:if="{{currentModule.podcast_content.translation}}">中文理解</view>
          <view class="writing-source-cn" wx:if="{{currentModule.podcast_content.translation}}">{{currentModule.podcast_content.translation}}</view>
        </view>
        <textarea class="writing-box article" placeholder="在这里根据文章写英文，可以复述、改写或总结" value="{{writingText}}" bindinput="onWritingInput" maxlength="3000"></textarea>
        <view class="action-btn secondary {{isAssessing ? 'disabled' : ''}}" bindtap="submitWritingTask">
          {{isAssessing ? '保存中...' : (currentModule.items[0].completed ? '已提交写作' : '提交写作')}}
        </view>
      </view>
      <view wx:else class="empty-bind-card">本写作任务需要先在后台绑定磨耳朵文章。</view>
    </block>

    <view
      class="podcast-pass-card"
      wx:if="{{currentModule.podcast_content && currentModule.items && currentModule.items.length}}"
    >
      <view class="podcast-pass-left">
        <view class="podcast-pass-title">{{(currentModule.module_type === 'speaking' || currentModule.module_type === 'speaking_output') ? '口语整篇朗读通关' : ((currentModule.module_type === 'writing' || currentModule.module_type === 'sentence_builder' || currentModule.module_type === 'typing_writing') ? '写作提交通关' : '听力跟读通关')}}</view>
        <view class="podcast-pass-desc">
          {{(currentModule.module_type === 'speaking' || currentModule.module_type === 'speaking_output') ? '录完整篇文章并达到' : ((currentModule.module_type === 'writing' || currentModule.module_type === 'sentence_builder' || currentModule.module_type === 'typing_writing') ? '根据绑定文章完成一篇英文写作即可通关。' : '进入磨耳朵文章逐句评测，全部句子完成且平均分达到')}} <text wx:if="{{!(currentModule.module_type === 'writing' || currentModule.module_type === 'sentence_builder' || currentModule.module_type === 'typing_writing')}}">{{currentModule.items[0].pass_score || passScore}} 分即可通关。</text>
        </view>
      </view>
      <view class="podcast-pass-status {{currentModule.items[0].completed ? 'passed' : 'pending'}}">
        {{currentModule.items[0].completed ? '✓ 已过关' : '未通过'}}
      </view>
    </view>

    <view class="task-panel" wx:elif="{{currentModule.items && currentModule.items.length}}">
      <view class="task-panel-title">本模块通关任务</view>
      <view class="task-row {{item.completed ? 'done' : ''}}" wx:for="{{currentModule.items}}" wx:key="key">
        <view class="task-main-row">
          <view class="task-copy">
            <view class="task-title-line">
              <view class="task-title-left">
                <text class="task-title">{{item.title}}</text>
                <text class="task-phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
              </view>
              <view class="task-status-badge {{item.completed ? 'passed' : 'pending'}}">
                {{item.completed ? '✓ 已过关' : '未通过'}}
              </view>
            </view>
            <view class="task-sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
            <view class="task-prompt" wx:if="{{item.prompt && !item.example_text}}">{{item.prompt}}</view>
            <view class="task-example" wx:if="{{item.example_text || item.example_translation}}">
              <view class="task-example-en" wx:if="{{item.example_text}}">{{item.example_text}}</view>
              <view class="task-example-cn" wx:if="{{item.example_translation}}">{{item.example_translation}}</view>
            </view>
            <view class="task-actions">
              <view wx:if="{{item.can_play}}" class="task-mini-btn listen {{playingItemKey === item.key + ':main' ? 'active' : ''}}" catchtap="playItem" data-key="{{item.key}}" data-kind="main">
                {{playingItemKey === item.key + ':main' ? '播放中' : ((currentModule.module_type === 'vocabulary' || currentModule.module_type === 'pronunciation') ? '单词听' : '听')}}
              </view>
              <view wx:if="{{item.can_assess}}" class="task-mini-btn record {{item.main_passed ? 'passed' : ''}} {{recordingItemKey === item.key + ':main' ? 'recording' : ''}} {{assessingItemKey === item.key + ':main' ? 'disabled' : ''}}" catchtap="toggleItemRecord" data-key="{{item.key}}" data-kind="main">
                {{recordingItemKey === item.key + ':main' ? '停止' : (assessingItemKey === item.key + ':main' ? '评测中' : (item.main_passed ? ((currentModule.module_type === 'vocabulary' || currentModule.module_type === 'pronunciation') ? '单词已过' : '已过') : ((currentModule.module_type === 'vocabulary' || currentModule.module_type === 'pronunciation') ? '单词跟读' : '跟读')))}}
              </view>
              <view wx:if="{{item.can_example_play}}" class="task-mini-btn listen example {{playingItemKey === item.key + ':example' ? 'active' : ''}}" catchtap="playItem" data-key="{{item.key}}" data-kind="example">
                {{playingItemKey === item.key + ':example' ? '播放中' : '例句听'}}
              </view>
              <view wx:if="{{item.can_example_assess}}" class="task-mini-btn record example {{item.example_passed ? 'passed' : ''}} {{recordingItemKey === item.key + ':example' ? 'recording' : ''}} {{assessingItemKey === item.key + ':example' ? 'disabled' : ''}}" catchtap="toggleItemRecord" data-key="{{item.key}}" data-kind="example">
                {{recordingItemKey === item.key + ':example' ? '停止' : (assessingItemKey === item.key + ':example' ? '评测中' : (item.example_passed ? '例句已过' : '例句跟读'))}}
              </view>
              <view wx:if="{{!item.completed && !item.can_assess && !item.can_example_assess}}" class="task-btn" catchtap="completeItem" data-key="{{item.key}}">过关</view>
            </view>
            <view class="task-score" wx:if="{{item.progress.score || item.last_score}}">
              评测 {{item.progress.score || item.last_score}} 分 / {{item.pass_score}} 分过关
            </view>
          </view>
        </view>
        <view class="task-grammar" wx:if="{{item.grammar_explanation}}">
          <text class="task-grammar-label">语法</text>
          <text>{{item.grammar_explanation}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
