<view class="ielts-page">
  <view class="hero">
    <view class="hero-kicker">零基础开始 · 长期冲刺更高分</view>
    <view class="hero-title">{{course.title || 'IELTS General Training'}}</view>
    <view class="hero-sub">单词、发音、句型、听力、口语和写作一步一步来。</view>
    <view class="hero-meta">
      <text>30 天</text>
      <text>每天约 1 小时</text>
      <text>基础薄弱可学</text>
    </view>
    <view class="hero-btn" bindtap="startOrContinue">{{enrolled ? '查看 Day ' + currentDay + ' 任务' : '开始学习'}}</view>
  </view>

  <view class="today-section" wx:if="{{enrolled && modules.length}}">
    <view class="today-head">
      <view>
        <view class="today-kicker">TODAY TASKS</view>
        <view class="today-title">{{day.title || '今日目标'}}</view>
        <view class="today-sub" wx:if="{{day.objective}}">{{day.objective}}</view>
      </view>
      <view class="today-count">{{summary.completed_required}}/{{summary.required_count}}</view>
    </view>

    <view class="today-progress">
      <view class="today-progress-fill" style="width: {{summary.required_count > 0 ? summary.completed_required * 100 / summary.required_count : 0}}%"></view>
    </view>

    <view class="module-entry {{item.progress.completed ? 'done' : ''}}" wx:for="{{modules}}" wx:key="id" bindtap="openModuleTask" data-id="{{item.id}}">
      <view class="module-entry-left">
        <view class="module-entry-index {{item.progress.completed ? 'done' : ''}}">{{item.sort_order}}</view>
        <view class="module-entry-copy">
          <view class="module-entry-title">{{item.title}}</view>
          <view class="module-entry-meta">
            <text>{{item.type_label || item.module_type}}</text>
            <text wx:if="{{item.item_summary}}"> · 任务 {{item.item_summary.completed_required}}/{{item.item_summary.required_count}}</text>
            <text> · {{item.estimated_minutes || 0}} 分钟</text>
          </view>
        </view>
      </view>
      <view class="module-entry-status {{item.progress.completed ? 'done' : ''}}">
        {{item.progress.completed ? '已完成' : '进入'}}
      </view>
    </view>

    <view class="next-card" wx:if="{{summary.complete && day.preview_next}}">
      <view class="next-title">今日已合格</view>
      <view class="next-text">{{day.preview_next}}</view>
    </view>
  </view>

  <view class="today-section locked-preview" wx:elif="{{!enrolled}}">
    <view class="today-head">
      <view>
        <view class="today-kicker">TODAY TASKS</view>
        <view class="today-title">开始后直接进入今日任务</view>
        <view class="today-sub">开启计划后，单词、发音、语法、听力、口语和写作都会在本页展示。</view>
      </view>
    </view>
    <view class="hero-btn inline" bindtap="startOrContinue">开启 IELTS 计划</view>
  </view>

  <view class="goal-card" wx:if="{{course.metadata && course.metadata.month_goal}}">
    <view class="section-title">第 1 个月目标</view>
    <view class="goal-grid">
      <view class="goal-item"><text class="goal-label">单词</text><text>{{course.metadata.month_goal.words}}</text></view>
      <view class="goal-item"><text class="goal-label">口语</text><text>{{course.metadata.month_goal.speaking}}</text></view>
      <view class="goal-item"><text class="goal-label">听力</text><text>{{course.metadata.month_goal.listening}}</text></view>
      <view class="goal-item"><text class="goal-label">写作</text><text>{{course.metadata.month_goal.writing}}</text></view>
    </view>
  </view>

  <view class="day-section">
    <view class="section-row">
      <view class="section-title">每日课程</view>
      <view class="section-hint">按天推进，完成模块才算过关</view>
    </view>

    <view class="day-card {{item.locked ? 'locked' : ''}} {{selectedDayNumber == item.day_number ? 'active' : ''}}" wx:for="{{days}}" wx:key="id" bindtap="goDay" data-day="{{item.day_number}}" data-locked="{{item.locked}}">
      <view class="day-left">
        <view class="day-badge">Day {{item.day_number}}</view>
        <view class="day-title">{{item.title}}</view>
        <view class="day-objective">{{item.objective}}</view>
        <view class="day-progress">
          <view class="day-bar"><view class="day-bar-fill" style="width: {{item.module_count > 0 ? item.completed_count * 100 / item.module_count : 0}}%"></view></view>
          <text>{{item.completed_count}}/{{item.module_count}} 模块</text>
        </view>
      </view>
      <view class="day-arrow">{{item.locked ? '锁定' : '进入 ›'}}</view>
    </view>
  </view>
</view>
