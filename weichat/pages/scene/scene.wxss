/* pages/scene/scene.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* 顶部标题区 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding-top: 16rpx;
}

.header-left {
  flex: 1;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #B2BEC3;
}

/* 筛选按钮（右上角） */
.filter-btn {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  margin-top: 8rpx;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #2D3436;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  opacity: 0.5;
}

/* 抽屉遮罩 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.drawer-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 抽屉面板 */
.drawer-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 70vh;
}

.drawer-panel.show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #F1F2F6;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.drawer-close {
  padding: 12rpx;
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.drawer-body {
  display: flex;
  height: 500rpx;
}

/* 左侧一级分类 */
.parent-list {
  width: 35%;
  background: #F8F9FA;
  height: 100%;
}

.parent-item {
  padding: 32rpx 28rpx;
  font-size: 28rpx;
  color: #636E72;
  border-left: 6rpx solid transparent;
  transition: all 0.2s;
}

.parent-item.active {
  background: #FFFFFF;
  color: #2D3436;
  font-weight: 600;
  border-left-color: #0984E3;
}

/* 右侧二级分类 */
.child-list {
  width: 65%;
  height: 100%;
  padding: 16rpx;
}

.child-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  margin: 8rpx;
  background: #F8F9FA;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #636E72;
  transition: all 0.2s;
}

.child-item.active {
  background: #0984E3;
  color: #FFFFFF;
}

.child-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #B2BEC3;
  font-size: 26rpx;
}

/* 场景卡片网格 */
.scene-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.scene-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.03);
  transition: transform 0.2s;
  position: relative;
}

.scene-card:active {
  transform: scale(0.98);
}

.card-image-box {
  position: relative;
  height: 240rpx;
  overflow: hidden;
}

.scene-image {
  width: 100%;
  height: 100%;
  transition: transform 0.5s;
}

.scene-card:active .scene-image {
  transform: scale(1.05);
}

.scene-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.05));
}

.play-indicator {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(4px);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.indicator-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.scene-info {
  padding: 24rpx;
}

.scene-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 4rpx;
}

.scene-name-en {
  display: block;
  font-size: 24rpx;
  color: #B2BEC3;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  font-weight: 600;
}

/* 状态样式 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.empty-img {
  width: 240rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #B2BEC3;
}

.loading-state {
  text-align: center;
  padding: 32rpx;
  color: #B2BEC3;
  font-size: 24rpx;
}
