/* pages/scene/detail/detail.wxss */
page {
  background-color: #f8f9fa;
  height: 100%;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* 可滚动的图片区域 */
.scene-scroll {
  flex: 1;
  width: 100%;
  background-color: #e9ecef;
  overflow: hidden;
}

.image-wrapper {
  position: relative;
  min-width: 100%;
}

.scene-img {
  width: 100%;
  display: block;
}

/* 热点层 - 必须覆盖整个图片 */
.hotspot-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hotspot-item {
  position: absolute;
  pointer-events: auto;
  
  /* 蓝色实线边框 */
  border: 4rpx solid #339af0;
  background-color: rgba(51, 154, 240, 0.15);
  box-sizing: border-box;
}

/* 激活时的加强效果 */
.hotspot-item.active {
  border: 6rpx solid #1c7ed6;
  background-color: rgba(51, 154, 240, 0.35);
  box-shadow: 0 0 20rpx rgba(28, 126, 214, 0.6);
  z-index: 10;
}

/* 固定在底部的功能卡片 */
.bottom-card {
  flex-shrink: 0;
  background-color: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

/* 单词信息 */
.word-info-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  min-height: 120rpx;
}

.word-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.word-en {
  font-size: 56rpx;
  font-weight: 800;
  color: #212529;
  letter-spacing: 2rpx;
  margin-right: 16rpx;
}

.sound-icon-lg {
  width: 48rpx;
  height: 48rpx;
  padding: 10rpx;
  background-color: #e7f5ff;
  border-radius: 50%;
}

.word-details {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.phonetic {
  font-size: 28rpx;
  color: #868e96;
  font-family: 'Times New Roman', serif;
  margin-bottom: 6rpx;
}

.translation {
  font-size: 32rpx;
  color: #495057;
  font-weight: 500;
}

/* 空状态提示 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #adb5bd;
  min-height: 120rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
  opacity: 0.5;
}

/* 控制栏 */
.control-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #f1f3f5;
}

.nav-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8f9fa;
  border-radius: 50%;
  transition: opacity 0.3s;
}

.nav-btn.disabled {
  opacity: 0.3;
  pointer-events: none;
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
}

.record-btn-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-btn {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4dabf7, #339af0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(51, 154, 240, 0.4);
  margin-bottom: 8rpx;
  transition: transform 0.2s;
}

.record-btn:active {
  transform: scale(0.95);
}

.record-btn.recording {
  background: #fa5252;
  box-shadow: 0 10rpx 30rpx rgba(250, 82, 82, 0.4);
  animation: breathe 1s infinite alternate;
}

.mic-icon {
  width: 60rpx;
  height: 60rpx;
}

.record-tip {
  font-size: 24rpx;
  color: #868e96;
}

@keyframes breathe {
  from { transform: scale(1); box-shadow: 0 0 0 rgba(250, 82, 82, 0.4); }
  to { transform: scale(1.1); box-shadow: 0 0 30rpx rgba(250, 82, 82, 0.6); }
}

/* 评分显示 */
.score-display {
  width: 120rpx;
  height: 120rpx;
  background-color: #fff9db;
  border: 4rpx solid #fab005;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f08c00;
  flex-direction: column;
}

.score-num {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}

.score-unit {
  font-size: 20rpx;
}
