<!--pages/scene/detail/detail.wxml-->
<view class="container">

  <!-- 图片 + 热点 -->
  <view wx:if="{{scene}}"
    class="image-wrap"
    style="height:{{imageWrapperHeight}}px"
  >
    <image
      class="main-img"
      src="{{scene.image_url}}"
      mode="widthFix"
      bindload="onImageLoad"
    />

    <!-- 热点框（按面积从大到小渲染，小热点在上层优先响应点击） -->
    <view
      wx:for="{{sortedHotspots}}"
      wx:key="objIndex"
      class="hotspot {{currentIndex === item.objIndex ? 'hotspot-active' : ''}}"
      style="left:{{item.position_x}}%; top:{{item.position_y}}%; width:{{item.label_width || 10}}%; height:{{item.label_height || 5}}%;"
      catchtap="onHotspotTap"
      data-index="{{item.objIndex}}"
    ></view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{!scene}}" class="loading-wrap">
    <view class="loading-spinner"></view>
  </view>

  <!-- 未选中时提示 -->
  <view wx:if="{{scene && !currentWord}}" class="hint-bar">
    <text class="hint-text">点击图片中的物品开始学习</text>
    <text class="hint-count">共 {{scene.objects.length}} 个词条</text>
  </view>

  <!-- 词条面板 -->
  <view wx:if="{{currentWord}}" class="word-panel {{assessResult ? 'has-assess' : ''}}">

    <!-- 词条内容 + 操作区（水平布局） -->
    <view class="word-row">
      <!-- 左侧：单词信息 -->
      <view class="word-info">
        <view class="word-title-row">
          <text class="word-en">{{currentWord.word || currentWord.custom_label}}</text>
        </view>
        <text wx:if="{{currentWord.phonetic}}" class="word-phonetic">/{{currentWord.phonetic}}/</text>
        <text class="word-zh">{{currentWord.translation || ''}}</text>
        <!-- 播放按钮 -->
        <view class="voice-actions">
          <view class="v-btn female {{isRecording ? 'disabled' : ''}}" bindtap="playAudio" data-voice="female">
            <image class="v-icon" src="/assets/icons/icon-female.svg"></image>
            <text>女声</text>
          </view>
          <view class="v-btn male {{isRecording ? 'disabled' : ''}}" bindtap="playAudio" data-voice="male">
            <image class="v-icon" src="/assets/icons/icon-male.svg"></image>
            <text>男声</text>
          </view>
        </view>
      </view>

      <!-- 右侧：录音按钮 -->
      <view class="record-area">
        <view
          class="record-btn {{isRecording ? 'recording' : ''}} {{isAssessing ? 'assessing' : ''}}"
          bindtap="toggleRecord"
        >
          <image class="record-icon {{isAssessing ? 'spin' : ''}}" src="/assets/icons/{{isAssessing ? 'icon-refresh.svg' : (isRecording ? 'icon-stop.svg' : 'icon-mic.svg')}}"></image>
          <text class="record-time" wx:if="{{isRecording}}">{{recordingTime}}s</text>
        </view>
        <text class="record-label">{{isAssessing ? '评测中' : (isRecording ? '点击停止' : '点击跟读')}}</text>
      </view>
    </view>
  </view>

  <!-- 场景翻页导航（固定底部） -->
  <view wx:if="{{scene}}" class="scene-nav-bar">
    <view class="scene-nav-btn {{!scene.prev_id ? 'disabled' : ''}}" bindtap="onPrev">
      <text class="nav-arrow">‹</text>
      <text>上一页</text>
    </view>
    <text class="scene-nav-page">{{scene.name || ''}}</text>
    <view class="scene-nav-btn {{!scene.next_id ? 'disabled' : ''}}" bindtap="onNext">
      <text>下一页</text>
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <!-- 评测结果面板（固定底部弹出） -->
  <view class="assess-panel" wx:if="{{assessResult}}">
    <view class="assess-panel-body {{assessResult.overall_score >= 80 ? 'passed' : 'failed'}}">
      <!-- 分数区 -->
      <view class="assess-score-wrap">
        <view class="assess-close-btn" bindtap="closeAssessPanel">✕</view>
        <view class="assess-verdict-badge {{assessResult.overall_score >= 80 ? 'passed' : 'failed'}}">
          {{assessResult.overall_score >= 80 ? '✓ 不错' : '✗ 加油'}}
        </view>
        <text class="assess-big-score">{{assessResult.overall_score}}<text class="assess-score-unit">分</text></text>
        <!-- 播放用户发音 -->
        <view class="user-audio-btn {{isPlayingUserAudio ? 'playing' : ''}}" bindtap="playUserAudio">
          <image class="icon-sound" src="/assets/icons/icon-sound.svg"></image>
          <text class="user-audio-label">{{isPlayingUserAudio ? '播放中...' : '我的发音'}}</text>
        </view>
      </view>
      <!-- 三项明细 -->
      <view class="assess-detail-row">
        <view class="r-item">
          <text class="r-val">{{assessResult.pronunciation_score || '-'}}</text>
          <text class="r-lbl">发音</text>
        </view>
        <view class="r-divider"></view>
        <view class="r-item">
          <text class="r-val">{{assessResult.fluency_score || '-'}}</text>
          <text class="r-lbl">流利</text>
        </view>
        <view class="r-divider"></view>
        <view class="r-item">
          <text class="r-val">{{assessResult.integrity_score || '-'}}</text>
          <text class="r-lbl">完整</text>
        </view>
      </view>
      <!-- 操作按钮 -->
      <view class="result-actions">
        <view class="result-btn-retry" bindtap="retryRecord">重新评测</view>
        <view class="result-btn-close" bindtap="closeAssessPanel">继续学习</view>
      </view>
    </view>
  </view>

</view>
