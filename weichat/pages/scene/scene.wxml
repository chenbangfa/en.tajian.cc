<!--pages/scene/scene.wxml-->
<view class="container">
  <!-- 顶部标题区 -->
  <view class="page-header">
    <view class="header-left">
      <text class="page-title">场景学习</text>
      <text class="page-subtitle">探索生活中的单词</text>
    </view>
    <!-- 筛选按钮 -->
    <view class="filter-btn" bindtap="openDrawer">
      <image class="filter-icon" src="/assets/icons/icon-filter.svg"></image>
      <text class="filter-label">{{currentCategoryName || '全部'}}</text>
      <image class="filter-arrow" src="/assets/icons/icon-chevron-down.svg"></image>
    </view>
  </view>

  <!-- 分类抽屉 -->
  <view class="drawer-mask {{showDrawer ? 'show' : ''}}" bindtap="closeDrawer"></view>
  <view class="drawer-panel {{showDrawer ? 'show' : ''}}">
    <view class="drawer-header">
      <text class="drawer-title">选择分类</text>
      <view class="drawer-close" bindtap="closeDrawer">
        <image class="close-icon" src="/assets/icons/icon-close.svg"></image>
      </view>
    </view>
    <view class="drawer-body">
      <!-- 左侧一级分类 -->
      <scroll-view class="parent-list" scroll-y>
        <view 
          class="parent-item {{selectedParent === 0 ? 'active' : ''}}"
          bindtap="selectParent"
          data-id="0">
          全部
        </view>
        <view 
          class="parent-item {{selectedParent === item.id ? 'active' : ''}}"
          wx:for="{{parentCategories}}"
          wx:key="id"
          bindtap="selectParent"
          data-id="{{item.id}}"
          data-name="{{item.name}}">
          {{item.name}}
        </view>
      </scroll-view>
      <!-- 右侧二级分类 -->
      <scroll-view class="child-list" scroll-y>
        <view 
          class="child-item {{currentCategory === selectedParent && !currentSubCategory ? 'active' : ''}}"
          bindtap="selectChild"
          data-id="0"
          wx:if="{{selectedParent > 0}}">
          全部{{selectedParentName}}
        </view>
        <view 
          class="child-item {{currentSubCategory === item.id ? 'active' : ''}}"
          wx:for="{{childCategories}}"
          wx:key="id"
          bindtap="selectChild"
          data-id="{{item.id}}"
          data-name="{{item.name}}">
          {{item.name}}
        </view>
        <view class="child-empty" wx:if="{{selectedParent === 0}}">
          <text>请先选择左侧分类</text>
        </view>
        <view class="child-empty" wx:if="{{selectedParent > 0 && childCategories.length === 0}}">
          <text>该分类暂无子分类</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 场景列表 -->
  <view class="scene-grid">
    <view class="scene-card" wx:for="{{scenes}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="card-image-box">
        <image class="scene-image" src="{{item.image_url || '/assets/images/placeholder.png'}}" mode="aspectFill"></image>
        <view class="scene-overlay"></view>
        <view class="play-indicator">
          <image class="indicator-icon-img" src="/assets/icons/icon-hand.svg"></image>
        </view>
      </view>
      <view class="scene-info">
        <text class="scene-name">{{item.name}}</text>
        <text class="scene-name-en">{{item.name_en}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{!loading && scenes.length === 0}}">
    <image class="empty-img" src="/assets/images/empty_box.png" mode="widthFix"></image>
    <text class="empty-text">暂无场景数据</text>
  </view>
  
  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
