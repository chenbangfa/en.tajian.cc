/* pages/podcast/player/player.wxss */
page {
  background-color: #F8F9FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  padding: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部封面区 */
.player-header {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.cover-box {
  width: 320rpx;
  height: 320rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  transition: transform 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.cover-box.playing {
  transform: scale(1.05);
  box-shadow: 0 24rpx 64rpx rgba(45, 52, 54, 0.15);
}

.cover-icon-img {
 width: 140rpx;
 height: 140rpx;
}

.player-title {
 font-size: 40rpx;
 font-weight: 800;
 color: #2D3436;
 margin-bottom: 12rpx;
 text-align: center;
 padding: 0 40rpx;
}

.player-subtitle {
 font-size: 26rpx;
 color: #B2BEC3;
}

/* 滚动文稿区 */
.transcript-scroll {
 flex: 1;
 background: #FFFFFF;
 border-radius: 48rpx 48rpx 0 0;
 box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.02);
 margin-top: 24rpx;
 overflow: hidden;
}

.transcript-content {
  padding: 48rpx 40rpx;
  padding-bottom: 300rpx; /* space for control panel */
}

.text-en {
 font-size: 34rpx;
 color: #2D3436;
 line-height: 1.8;
 margin-bottom: 24rpx;
}

.text-zh {
 font-size: 28rpx;
 color: #636E72;
 line-height: 1.6;
 padding-bottom: 32rpx;
 border-bottom: 2rpx dashed #F1F2F6;
 margin-bottom: 32rpx;
}

.empty-text {
 text-align: center;
 color: #B2BEC3;
 margin-top: 100rpx;
}

/* 底部控制栏 */
.control-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.05);
  z-index: 100;
}

/* 进度条 */
.progress-bar {
  margin-bottom: 16rpx;
}

slider {
  margin: 0;
  margin-bottom: 4rpx;
}

.time-labels {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B2BEC3;
  font-variant-numeric: tabular-nums;
  padding: 0 4rpx;
}

/* 按钮组 */
.btn-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.control-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F1F2F6;
  color: #636E72;
  transition: transform 0.1s;
  flex-shrink: 0;
}

.control-btn.sm {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.control-btn.sm.active {
  background: #2D3436;
  color: #FFFFFF;
}

.control-btn.md {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
}

.ctrl-icon-md {
  width: 44rpx;
  height: 44rpx;
}

.play-btn-lg {
  flex: 1;
  height: 88rpx;
  background: #2D3436;
  color: #FFFFFF;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.25);
  transition: transform 0.15s;
}

.play-btn-lg:active {
  transform: scale(0.97);
}

.play-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
}

.play-icon-lg {
  width: 48rpx;
  height: 48rpx;
}

.play-btn-lg.playing .play-icon {
  margin-left: 0;
}

.play-btn-lg.playing .play-icon-lg {
  width: 44rpx;
  height: 44rpx;
}

/* ── 句子模式 header ── */
.header-compact { padding: 20rpx 32rpx; }
.cover-sm { width: 100rpx !important; height: 100rpx !important; border-radius: 24rpx !important; margin-bottom: 16rpx !important; }
.cover-icon-img { width: 140rpx; height: 140rpx; }
.cover-sm .cover-icon-img { width: 60rpx; height: 60rpx; }
.header-pills { display: flex; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; justify-content: center; }
.pill { padding: 8rpx 24rpx; border-radius: 32rpx; font-size: 24rpx; background: #f0f0f0; color: #555; }
.pill-active { background: #2D3436; color: #fff; }

/* ── 句子卡片 ── */
.sentence-card {
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  border-left: 6rpx solid transparent;
}
.sentence-active {
  background: #EBF5FF;
  border-left-color: #0984E3;
}
.sentence-tokens { line-height: 1.9; }
.word-key {
  color: #0984E3;
  font-weight: 600;
  border-bottom: 2rpx solid #0984E3;
  font-size: 30rpx;
}
.word-plain { color: #2D3436; font-size: 30rpx; }
.sentence-zh {
  display: block;
  color: #636E72;
  font-size: 26rpx;
  margin-top: 10rpx;
  line-height: 1.5;
}
.grammar-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #666;
}

/* ── 弹窗通用遮罩 ── */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

/* ── 单词弹窗 ── */
.word-popup {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
  position: relative;
}
.wp-close {
  position: absolute;
  top: 32rpx;
  right: 40rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #F1F2F6;
  color: #636E72;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wp-word {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 12rpx;
  padding-right: 80rpx; /* avoid overlap with close btn */
}
.wp-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.wp-phonetic { font-size: 28rpx; color: #0984E3; }
.wp-pos {
  font-size: 22rpx;
  color: #b2bec3;
  font-style: italic;
  background: #F8F9FA;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.wp-translation {
  display: block;
  font-size: 38rpx;
  color: #636E72;
  margin-bottom: 40rpx;
  line-height: 1.5;
}
.wp-play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #2D3436;
  color: #fff;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.25);
}
.wp-play-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 6rpx; /* visual balance for play triangle */
}

/* ── 语法弹窗 ── */
.grammar-popup {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
  position: relative;
}
.gp-close {
  position: absolute;
  top: 32rpx;
  right: 40rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #F1F2F6;
  color: #636E72;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gp-title { font-size: 32rpx; font-weight: 700; color: #2D3436; display: block; margin-bottom: 20rpx; padding-right: 80rpx; }
.gp-sentence { font-size: 30rpx; color: #2D3436; line-height: 1.6; display: block; margin-bottom: 12rpx; }
.gp-divider { height: 1rpx; background: #f0f0f0; margin: 16rpx 0; }
.gp-label { font-size: 22rpx; color: #b2bec3; display: block; margin-bottom: 6rpx; }
.gp-grammar { font-size: 28rpx; color: #0984E3; line-height: 1.6; display: block; margin-bottom: 8rpx; }
.gp-translation { font-size: 28rpx; color: #636E72; line-height: 1.6; display: block; }

/* ── 评测按钮（底部控制栏内） ── */
.assess-btn {
  width: 100rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #0984E3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(9,132,227,0.30);
  transition: transform 0.15s;
}

.assess-btn:active { transform: scale(0.95); }

.assess-btn.assess-excellent { background: #00B894; box-shadow: 0 6rpx 18rpx rgba(0,184,148,0.30); }
.assess-btn.assess-good      { background: #0984E3; }

.assess-btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 2rpx;
}

.assess-btn-label {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1;
}

.assess-btn-score {
  font-size: 18rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1;
}
