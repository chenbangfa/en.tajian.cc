/* pages/podcast/player/player.wxss */
page {
  background-color: #F8F9FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  padding: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部封面区 */
.player-header {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.cover-box {
  width: 320rpx;
  height: 320rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  transition: transform 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.cover-box.playing {
  transform: scale(1.05);
  box-shadow: 0 24rpx 64rpx rgba(45, 52, 54, 0.15);
}

.cover-icon-img {
 width: 140rpx;
 height: 140rpx;
}

.player-title {
 font-size: 40rpx;
 font-weight: 800;
 color: #2D3436;
 margin-bottom: 12rpx;
 text-align: center;
 padding: 0 40rpx;
}

.player-subtitle {
 font-size: 26rpx;
 color: #B2BEC3;
}

/* 滚动文稿区 */
.transcript-scroll {
 flex: 1;
 background: #FFFFFF;
 border-radius: 48rpx 48rpx 0 0;
 box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.02);
 margin-top: 24rpx;
 overflow: hidden;
}

.transcript-content {
 padding: 48rpx 40rpx;
 padding-bottom: 400rpx; /* space for control panel */
}

.text-en {
 font-size: 34rpx;
 color: #2D3436;
 line-height: 1.8;
 margin-bottom: 24rpx;
}

.text-zh {
 font-size: 28rpx;
 color: #636E72;
 line-height: 1.6;
 padding-bottom: 32rpx;
 border-bottom: 2rpx dashed #F1F2F6;
 margin-bottom: 32rpx;
}

.empty-text {
 text-align: center;
 color: #B2BEC3;
 margin-top: 100rpx;
}

/* 底部控制栏 */
.control-panel {
 position: absolute;
 bottom: 0;
 left: 0;
 right: 0;
 background: rgba(255,255,255,0.95);
 backdrop-filter: blur(20px);
 padding: 32rpx 40rpx;
 padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
 box-shadow: 0 -16rpx 64rpx rgba(0,0,0,0.05);
 z-index: 100;
}

/* 进度条 */
.progress-bar {
  margin-bottom: 40rpx;
}

slider {
  margin: 0;
  margin-bottom: 8rpx;
}

.time-labels {
 font-display: flex;
 justify-content: space-between;
 font-size: 22rpx;
 color: #B2BEC3;
 font-variant-numeric: tabular-nums;
 padding: 0 8rpx;
}

/* 按钮组 */
.btn-row {
 display: flex;
 align-items: center;
 justify-content: space-between;
}

.control-btn {
 display: flex;
 align-items: center;
 justify-content: center;
 background: #F8F9FA;
 color: #2D3436;
 transition: all 0.2s;
}

.control-btn.sm {
 width: 80rpx;
 height: 80rpx;
 border-radius: 32rpx;
 font-size: 26rpx;
 font-weight: 600;
}

.control-btn.sm.active {
 background: #2D3436;
 color: #FFFFFF;
}

.control-btn.md {
 width: 96rpx;
 height: 96rpx;
 border-radius: 40rpx;
}

.ctrl-icon-md {
  width: 48rpx;
  height: 48rpx;
}

.play-btn-lg {
 width: 144rpx;
 height: 144rpx;
 background: #2D3436;
 color: #FFFFFF;
 border-radius: 64rpx;
 display: flex;
 align-items: center;
 justify-content: center;
 box-shadow: 0 16rpx 48rpx rgba(45, 52, 54, 0.3);
 transition: transform 0.2s;
}

.play-btn-lg:active {
 transform: scale(0.95);
}

.play-icon {
 display: flex;
 align-items: center;
 justify-content: center;
 margin-left: 8rpx; /* visual center fix for play icon */
}

.play-icon-lg {
  width: 64rpx;
  height: 64rpx;
}

.play-btn-lg.playing .play-icon {
 margin-left: 0;
}

.play-btn-lg.playing .play-icon-lg {
  width: 56rpx;
  height: 56rpx;
}
