<!--pages/podcast/player/player.wxml-->
<view class="container">

  <!-- ── 顶部封面/标题 ── -->
  <view class="player-header {{mode === 'sentences' ? 'header-compact' : ''}}"> 
    <text class="player-title">{{content.title}}</text>
    <!-- 句子模式：声音 & 译文 & 语法 切换 -->
    <view wx:if="{{mode === 'sentences'}}" class="header-pills">
      <view class="pill {{voice === 'female' ? 'pill-active' : ''}}" bindtap="setVoice" data-v="female">♀ 女声</view>
      <view class="pill {{voice === 'male' ? 'pill-active' : ''}}" bindtap="setVoice" data-v="male">♂ 男声</view>
      <view class="pill {{showTranslation ? 'pill-active' : ''}}" bindtap="toggleTranslation">译文</view>
      <view class="pill {{showGrammar ? 'pill-active' : ''}}" bindtap="toggleGrammar">语法</view>
    </view>
    <text wx:else class="player-subtitle">{{isPlaying ? '正在播放' : '暂停中'}}</text>
  </view>

  <!-- ── 句子模式文稿 ── -->
  <scroll-view
    wx:if="{{mode === 'sentences'}}"
    class="transcript-scroll"
    scroll-y
    scroll-into-view="s{{currentSentenceIdx}}"
    scroll-with-animation
  >
    <view class="transcript-content">
      <view
        wx:for="{{sentences}}"
        wx:for-item="sentence"
        wx:key="index"
        id="s{{sentence.index}}"
        class="sentence-card {{currentSentenceIdx === sentence.index ? 'sentence-active' : ''}}"
        bindtap="onSentenceTap"
        data-index="{{sentence.index}}"
      >
        <!-- 英文分词（关键词可点击） -->
        <view class="sentence-tokens">
          <block wx:for="{{sentence.tokens}}" wx:for-item="token" wx:key="index">
            <text
              wx:if="{{token.isKey}}"
              class="word-key"
              catchtap="showWordDetail"
              data-sidx="{{sentence.index}}"
              data-widx="{{index}}"
            >{{token.text}}</text>
            <text wx:else class="word-plain">{{token.text}}</text>
          </block>
        </view>

        <!-- 中文翻译 -->
        <text wx:if="{{showTranslation && sentence.translation}}" class="sentence-zh">{{sentence.translation}}</text>

        <!-- 语法按钮（showGrammar 开启 且 是当前活跃句子才显示） -->
        <view
          wx:if="{{showGrammar && currentSentenceIdx === sentence.index && sentence.grammar}}"
          class="grammar-btn"
          catchtap="showGrammarPopup"
          data-index="{{sentence.index}}"
        >📝 语法分析</view>
      </view>
    </view>
  </scroll-view>

  <!-- ── 全文模式文稿 ── -->
  <scroll-view wx:else class="transcript-scroll" scroll-y>
    <view class="transcript-content">
      <block wx:if="{{content.content_text}}">
        <view class="text-en">{{content.content_text}}</view>
        <view class="text-zh" wx:if="{{!!content.translation}}">{{content.translation}}</view>
      </block>
      <view class="empty-text" wx:else>暂无文稿</view>
    </view>
  </scroll-view>

  <!-- ── 底部控制栏 ── -->
  <view class="control-panel safe-bottom">
    <!-- 进度条 -->
    <view class="progress-bar">
      <slider
        min="0" max="100"
        value="{{progress}}"
        activeColor="#0984E3"
        backgroundColor="#E1E1E1"
        block-size="12"
        bindchanging="onSliderChanging"
        bindchange="onSliderChange"
      />
      <view class="time-labels">
        <text wx:if="{{mode === 'sentences'}}">句 {{currentSentenceIdx + 1}}/{{sentences.length}}</text>
        <text wx:else>{{currentTimeStr}}</text>
        <text>{{durationStr}}</text>
      </view>
    </view>

    <!-- 按钮行 -->
    <view class="btn-row">
      <!-- 上一句 / 上一首 -->
      <view class="control-btn md" bindtap="playPrevSentence" wx:if="{{mode === 'sentences'}}">
        <image class="ctrl-icon-md" src="/assets/icons/icon-prev.svg"></image>
      </view>
      <view class="control-btn md" style="opacity:0.4;" wx:else>
        <image class="ctrl-icon-md" src="/assets/icons/icon-prev.svg"></image>
      </view>

      <!-- 播放/暂停 -->
      <view class="play-btn-lg {{isPlaying ? 'playing' : ''}}" bindtap="togglePlay">
        <view class="play-icon">
          <image class="play-icon-lg" src="{{isPlaying ? '/assets/icons/icon-pause-white.svg' : '/assets/icons/icon-play-white.svg'}}"></image>
        </view>
      </view>

      <!-- 下一句 / 下一首 -->
      <view class="control-btn md" bindtap="playNextSentence" wx:if="{{mode === 'sentences'}}">
        <image class="ctrl-icon-md" src="/assets/icons/icon-next.svg"></image>
      </view>
      <view class="control-btn md" style="opacity:0.4;" wx:else>
        <image class="ctrl-icon-md" src="/assets/icons/icon-next.svg"></image>
      </view>
    </view>
  </view>

  <!-- ── 单词详情弹窗 ── -->
  <view wx:if="{{wordPopup}}" class="popup-mask" catchtap="closeWordPopup">
    <view class="word-popup" catchtap="">
      <!-- 关闭按钮 -->
      <view class="wp-close" catchtap="closeWordPopup">✕</view>
      <!-- 单词 -->
      <text class="wp-word">{{wordPopup.word}}</text>
      <!-- 音标 + 词性 -->
      <view class="wp-meta">
        <text class="wp-phonetic" wx:if="{{wordPopup.phonetic}}">{{wordPopup.phonetic}}</text>
        <text class="wp-pos" wx:if="{{wordPopup.pos}}">{{wordPopup.pos}}</text>
      </view>
      <!-- 中文释义 -->
      <text class="wp-translation">{{wordPopup.translation}}</text>
      <!-- 播放按钮 -->
      <view wx:if="{{wordPopup.audio_url}}" class="wp-play-btn" catchtap="playWordAudio">
        <image class="wp-play-icon" src="/assets/icons/icon-play-white.svg"></image>
        <text>播放发音</text>
      </view>
    </view>
  </view>

  <!-- ── 语法分析弹窗 ── -->
  <view wx:if="{{grammarPopup}}" class="popup-mask" catchtap="closeGrammarPopup">
    <view class="grammar-popup" catchtap="">
      <text class="gp-title">语法分析</text>
      <text class="gp-sentence">{{grammarPopup.text}}</text>
      <view class="gp-divider"></view>
      <text class="gp-label">结构</text>
      <text class="gp-grammar">{{grammarPopup.grammar}}</text>
      <view class="gp-divider"></view>
      <text class="gp-label">翻译</text>
      <text class="gp-translation">{{grammarPopup.translation}}</text>
    </view>
  </view>

</view>
