/* pages/podcast/podcast.wxss */
page {
  background-color: #F8F9FA;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx 32rpx;
}

/* 顶部标题区 (复用 Scene 样式) */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding-top: 16rpx;
}

.header-left {
  flex: 1;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #2D3436;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #B2BEC3;
}

/* 筛选按钮 */
.filter-btn {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
  margin-top: 8rpx;
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #2D3436;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  opacity: 0.5;
}

/* 抽屉遮罩 & 面板 (完全复用 Scene) */
.drawer-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  opacity: 0; visibility: hidden;
  transition: all 0.3s;
}

.drawer-mask.show {
  opacity: 1; visibility: visible;
}

.drawer-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  max-height: 70vh;
}

.drawer-panel.show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #F1F2F6;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
}

.drawer-close { padding: 12rpx; }
.close-icon { width: 32rpx; height: 32rpx; opacity: 0.5; }

.drawer-body { display: flex; height: 500rpx; }

/* 左侧一级分类 */
.parent-list {
  width: 35%;
  background: #F8F9FA;
  height: 100%;
}

.parent-item {
  padding: 32rpx 28rpx;
  font-size: 28rpx;
  color: #636E72;
  border-left: 6rpx solid transparent;
  transition: all 0.2s;
}

.parent-item.active {
  background: #FFFFFF;
  color: #2D3436;
  font-weight: 600;
  border-left-color: #0984E3;
}

/* 右侧二级分类 */
.child-list {
  width: 65%;
  height: 100%;
  padding: 16rpx;
}

.child-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  margin: 8rpx;
  background: #F8F9FA;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #636E72;
  transition: all 0.2s;
}

.child-item.active {
  background: #0984E3;
  color: #FFFFFF;
}

.child-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #B2BEC3;
  font-size: 26rpx;
}

/* 内容列表 (Podcast 特有样式) */
.content-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.content-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  transition: transform 0.2s;
}

.content-card:active {
  transform: scale(0.98);
}

/* 左侧图标容器 */
.icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-box.blue { background: #E1F0FF; }
.icon-box.orange { background: #FFF0E1; }
.icon-box.green { background: #E1F8E8; }
.icon-box.purple { background: #F3E5F5; }

.content-icon-img {
  width: 50rpx;
  height: 50rpx;
}

/* 中间信息 */
.content-info {
  flex: 1;
  overflow: hidden;
}

.content-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.difficulty-tag {
  font-size: 20rpx;
  color: #0984E3;
  background: #E1F0FF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.vip-tag {
  font-size: 20rpx;
  color: #FF7675;
  background: #FFF0F0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.duration-text {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-left: auto;
}

/* 右侧播放按钮 */
.play-btn-small {
  width: 64rpx;
  height: 64rpx;
  background: #F8F9FA; /* #6C5CE7 */
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.play-small-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

/* 状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.empty-img {
  width: 240rpx;
  margin-bottom: 24rpx;
}

.loading-state text {
  font-size: 24rpx;
  color: #B2BEC3;
}
