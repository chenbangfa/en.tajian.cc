# 环境变量配置

# 服务器配置
PORT=3003
ADMIN_PORT=3004
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=english_learning

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Vertex AI 配置
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/vertex-ai-sa.json
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_REGION=us-central1

# 有道API配置
YOUDAO_APP_KEY=your_youdao_app_key
YOUDAO_APP_SECRET=your_youdao_app_secret

# 语音引擎配置
# TTS 引擎: google | tencent | youdao | volcengine
TTS_ENGINE=youdao
# 中文 TTS 可单独指定：youdao | google | tencent | volcengine
CHINESE_TTS_ENGINE=volcengine
# 火山引擎 / 豆包 TTS V3 SSE
VOLCENGINE_TTS_APP_ID=your_volcengine_tts_app_id
VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_tts_access_token
VOLCENGINE_TTS_ACCESS_KEY=your_volcengine_tts_access_key
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-1.0
VOLCENGINE_TTS_SPEAKER=zh_female_yingyujiaoyu_mars_bigtts
VOLCENGINE_TTS_SPEAKER_ZH=zh_female_yingyujiaoyu_mars_bigtts
VOLCENGINE_TTS_SPEAKER_FEMALE=en_female_candice_emo_v2_mars_bigtts
VOLCENGINE_TTS_SPEAKER_MALE=en_male_glen_emo_v2_mars_bigtts
# 评测引擎: tencent | youdao
ASSESS_ENGINE=tencent

# 腾讯云语音评测配置
TENCENT_APPID=your_tencent_appid
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_CB_ENV=your_cloudbase_env_id
TENCENT_HUNYUAN_IMAGE_MODEL=hunyuan-image
TENCENT_HUNYUAN_IMAGE_VERSION=v1.9
TENCENT_HUNYUAN_IMAGE_SIZE=1024x768
TENCENT_REGION=ap-guangzhou

# Google AI 中转代理（腾讯云服务器填美国服务器地址，美国服务器留空）
PROXY_BASE_URL=https://api.tajian.cc
PROXY_API_KEY=your_proxy_api_key_here
PROXY_PORT=3005

# 腾讯云 COS 对象存储
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=your-bucket-name-appid
COS_REGION=ap-guangzhou
COS_BASE_URL=https://your-bucket-name-appid.cos.ap-guangzhou.myqcloud.com

# 文件上传配置（本地兜底，COS 未配置时使用）
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 小程序配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
WECHAT_OA_APPID=your_wechat_official_account_appid
WECHAT_OA_SECRET=your_wechat_official_account_secret
MINIAPP_WXACODE_PAGE=pages/entry/entry

# 微信支付 v3 配置
WX_MCH_ID=your_wechat_pay_mch_id
WX_CERT_SERIAL=your_wechat_pay_cert_serial
WX_API_V3_KEY=your_32_byte_api_v3_key
WX_CERT_KEY_PATH=/www/wwwroot/english/server/certs/apiclient_key.pem
WX_NOTIFY_URL=https://english.tajian.cc/api/pay/notify
