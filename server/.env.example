# 环境变量配置

# 服务器配置
PORT=3003
ADMIN_PORT=3004
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=english_learning

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Vertex AI 配置
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/vertex-ai-sa.json
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_REGION=us-central1

# 有道API配置
YOUDAO_APP_KEY=your_youdao_app_key
YOUDAO_APP_SECRET=your_youdao_app_secret

# 语音引擎配置
# TTS 引擎: google | tencent | youdao
TTS_ENGINE=youdao
# 评测引擎: tencent | youdao
ASSESS_ENGINE=tencent

# 腾讯云语音评测配置
TENCENT_APPID=your_tencent_appid
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_REGION=ap-guangzhou

# Google AI 中转代理（腾讯云服务器填美国服务器地址，美国服务器留空）
PROXY_BASE_URL=https://api.tajian.cc
PROXY_API_KEY=your_proxy_api_key_here
PROXY_PORT=3005

# 腾讯云 COS 对象存储
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=your-bucket-name-appid
COS_REGION=ap-guangzhou
COS_BASE_URL=https://your-bucket-name-appid.cos.ap-guangzhou.myqcloud.com

# 文件上传配置（本地兜底，COS 未配置时使用）
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 小程序配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
