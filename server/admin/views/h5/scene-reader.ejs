<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= scene.name || scene.name_en || 'Scene Reader' %> - BookMelo</title>
    <meta name="description" content="BookMelo H5 场景点读：点击图片里的物品，听标准发音，学习单词、音标和中文释义。">
    <meta name="theme-color" content="#eef7ed">
    <% if (scene.image_url) { %>
    <meta property="og:image" content="<%= scene.image_url %>">
    <% } %>
    <style>
        :root {
            --leaf: #3d8b4f;
            --leaf-dark: #1f6236;
            --mint: #eef7ed;
            --cream: #fffaf0;
            --ink: #172033;
            --muted: #6f7b8d;
            --line: rgba(31, 98, 54, 0.14);
            --card: rgba(255, 255, 255, 0.86);
        }

        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            color: var(--ink);
            font-family: Avenir Next, Nunito, ui-rounded, "PingFang SC", "Hiragino Sans GB", sans-serif;
            background:
                radial-gradient(circle at 12% 5%, rgba(128, 180, 118, 0.22), transparent 30%),
                radial-gradient(circle at 90% 12%, rgba(241, 203, 120, 0.20), transparent 24%),
                linear-gradient(180deg, #f7fbf3 0%, #eef7ed 48%, #fffaf0 100%);
            -webkit-font-smoothing: antialiased;
        }

        button { font: inherit; }

        .page {
            width: min(100%, 520px);
            margin: 0 auto;
            min-height: 100vh;
            padding: max(14px, env(safe-area-inset-top)) 14px max(18px, env(safe-area-inset-bottom));
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 12px;
            border: 1px solid rgba(255, 255, 255, 0.72);
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.62);
            box-shadow: 0 18px 40px rgba(41, 80, 52, 0.10);
            backdrop-filter: blur(18px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            color: white;
            font-weight: 900;
            letter-spacing: -0.08em;
            background: linear-gradient(135deg, #6eb878, #2d7a42);
            box-shadow: inset 0 1px rgba(255,255,255,0.45), 0 10px 20px rgba(45, 122, 66, 0.22);
        }

        .brand-title {
            min-width: 0;
        }

        .brand-title strong {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 16px;
            line-height: 1.15;
        }

        .brand-title span {
            display: block;
            color: var(--muted);
            font-size: 12px;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .top-actions { display: flex; gap: 8px; flex-shrink: 0; }
        .icon-btn {
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 14px;
            color: var(--leaf-dark);
            background: rgba(61, 139, 79, 0.11);
            cursor: pointer;
        }

        .scene-shell {
            position: relative;
            overflow: hidden;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.78);
            background: rgba(255, 255, 255, 0.58);
            box-shadow: 0 28px 80px rgba(42, 70, 48, 0.18);
        }

        .image-wrap {
            position: relative;
            width: 100%;
            background: linear-gradient(145deg, #f9fff6, #eef7ed);
        }

        .scene-image {
            width: 100%;
            display: block;
            user-select: none;
            -webkit-user-drag: none;
        }

        .hotspot-layer {
            position: absolute;
            inset: 0;
        }

        .hotspot {
            position: absolute;
            border: 0;
            padding: 0;
            background: rgba(61, 139, 79, 0.03);
            border-radius: 18px;
            cursor: pointer;
            touch-action: manipulation;
        }

        .hotspot.active {
            outline: 3px solid rgba(61, 139, 79, 0.76);
            background: rgba(61, 139, 79, 0.12);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.72), 0 0 0 8px rgba(61, 139, 79, 0.08);
        }

        .reader-card {
            position: sticky;
            bottom: max(14px, env(safe-area-inset-bottom));
            z-index: 5;
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, 0.76);
            background: var(--card);
            box-shadow: 0 24px 70px rgba(42, 70, 48, 0.18);
            backdrop-filter: blur(20px);
            padding: 16px;
        }

        .reader-head {
            display: flex;
            justify-content: space-between;
            align-items: start;
            gap: 12px;
        }

        .reader-word {
            font-size: clamp(30px, 8vw, 44px);
            line-height: 1;
            font-weight: 900;
            letter-spacing: -0.05em;
            color: var(--ink);
        }

        .reader-phonetic {
            margin-top: 7px;
            color: var(--muted);
            font-size: 17px;
        }

        .reader-cn {
            margin-top: 10px;
            color: #286d3c;
            font-size: 18px;
            font-weight: 800;
        }

        .reader-progress {
            min-width: 56px;
            padding: 8px 10px;
            border-radius: 999px;
            text-align: center;
            color: var(--leaf-dark);
            background: rgba(61, 139, 79, 0.10);
            font-size: 13px;
            font-weight: 800;
        }

        .reader-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 9px;
            margin-top: 15px;
        }

        .action-btn {
            min-height: 46px;
            border: 0;
            border-radius: 16px;
            color: var(--leaf-dark);
            background: rgba(61, 139, 79, 0.10);
            font-weight: 800;
            cursor: pointer;
        }

        .action-btn.primary {
            color: white;
            background: linear-gradient(135deg, #5eaa66, #26723b);
            box-shadow: 0 12px 24px rgba(38, 114, 59, 0.22);
        }

        .empty-state {
            padding: 36px 20px;
            text-align: center;
            color: var(--muted);
            background: rgba(255,255,255,0.7);
            border-radius: 26px;
        }

        .toast {
            position: fixed;
            left: 50%;
            bottom: calc(24px + env(safe-area-inset-bottom));
            transform: translateX(-50%) translateY(18px);
            opacity: 0;
            pointer-events: none;
            color: white;
            background: rgba(23, 32, 51, 0.9);
            padding: 10px 14px;
            border-radius: 999px;
            font-size: 13px;
            transition: opacity 180ms ease, transform 180ms ease;
            z-index: 30;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

        @media (min-width: 860px) {
            .page { width: min(100%, 1060px); display: grid; grid-template-columns: minmax(360px, 560px) 360px; align-items: start; padding-top: 24px; }
            .topbar { grid-column: 1 / -1; }
            .reader-card { position: sticky; top: 96px; bottom: auto; }
        }

        @media (prefers-reduced-motion: no-preference) {
            .scene-shell { animation: floatIn 520ms ease both; }
            .reader-card { animation: riseIn 620ms 80ms ease both; }
            @keyframes floatIn { from { opacity: 0; transform: translateY(12px) scale(0.985); } to { opacity: 1; transform: none; } }
            @keyframes riseIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
        }
    </style>
</head>
<body>
    <main class="page">
        <header class="topbar">
            <div class="brand">
                <div class="brand-mark">BM</div>
                <div class="brand-title">
                    <strong><%= scene.name_en || scene.name || 'Scene Reader' %></strong>
                    <span><%= scene.name || scene.category_name || 'Tap, listen, and learn.' %></span>
                </div>
            </div>
            <div class="top-actions">
                <button class="icon-btn" type="button" onclick="copyLink()" aria-label="复制链接">↗</button>
                <button class="icon-btn" id="autoPlayBtn" type="button" onclick="toggleAutoPlay()" aria-label="连续播放">▶</button>
            </div>
        </header>

        <section class="scene-shell">
            <% if (scene.image_url) { %>
            <div class="image-wrap" id="imageWrap">
                <img class="scene-image" src="<%= scene.image_url %>" alt="<%= scene.name || scene.name_en || 'Scene image' %>" draggable="false">
                <div class="hotspot-layer" id="hotspotLayer"></div>
            </div>
            <% } else { %>
            <div class="empty-state">这个场景还没有图片，保存场景图后即可生成 H5 点读页。</div>
            <% } %>
        </section>

        <section class="reader-card" id="readerCard">
            <div class="reader-head">
                <div>
                    <div class="reader-word" id="readerWord">Ready?</div>
                    <div class="reader-phonetic" id="readerPhonetic">Tap a hotspot to listen</div>
                    <div class="reader-cn" id="readerCn">点击图片中的数字开始点读</div>
                </div>
                <div class="reader-progress" id="readerProgress">0 / 0</div>
            </div>
            <div class="reader-actions">
                <button class="action-btn" type="button" onclick="prevObject()">上一项</button>
                <button class="action-btn primary" id="femaleVoiceBtn" type="button" onclick="setVoice('female', true)">女声</button>
                <button class="action-btn" id="maleVoiceBtn" type="button" onclick="setVoice('male', true)">男声</button>
                <button class="action-btn" type="button" onclick="nextObject()">下一项</button>
            </div>
        </section>
    </main>
    <div class="toast" id="toast"></div>

    <script>
        const SCENE = <%- sceneJson %>;
        const objects = (SCENE.objects || []).map((item, index) => ({
            ...item,
            index,
            label: item.custom_label || item.word || item.text_en || `Word ${index + 1}`,
            x: Number(item.position_x || 0),
            y: Number(item.position_y || 0),
            w: Math.max(Number(item.label_width || item.width || 12), 4),
            h: Math.max(Number(item.label_height || item.height || 6), 4)
        })).filter(item => item.label && item.x >= 0 && item.y >= 0);
        let activeIndex = objects.length ? 0 : -1;
        let currentAudio = null;
        let currentVoice = 'female';
        let autoPlaying = false;
        let playRunId = 0;

        function clamp(value, min, max) {
            return Math.min(Math.max(value, min), max);
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            clearTimeout(showToast.timer);
            showToast.timer = setTimeout(() => toast.classList.remove('show'), 1800);
        }

        function renderHotspots() {
            const layer = document.getElementById('hotspotLayer');
            if (!layer) return;
            layer.innerHTML = objects.map((obj, index) => `
                <button class="hotspot" data-hotspot-index="${index}"
                    aria-label="${escapeHtml(obj.label)}"
                    style="left:${clamp(obj.x, 0, 99)}%;top:${clamp(obj.y, 0, 99)}%;width:${clamp(obj.w, 4, 100)}%;height:${clamp(obj.h, 4, 100)}%;"
                    onclick="selectObject(${index}, true)"></button>
            `).join('');
        }

        function escapeHtml(value = '') {
            return String(value).replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
        }

        function formatPhonetic(value = '') {
            const text = String(value || '').trim();
            if (!text) return 'Listen and repeat';
            const clean = text.replace(/^\/+|\/+$/g, '').trim();
            return clean ? `/${clean}/` : 'Listen and repeat';
        }

        function updateVoiceButtons() {
            document.getElementById('femaleVoiceBtn')?.classList.toggle('primary', currentVoice === 'female');
            document.getElementById('maleVoiceBtn')?.classList.toggle('primary', currentVoice === 'male');
        }

        function updateAutoPlayButton() {
            const btn = document.getElementById('autoPlayBtn');
            if (!btn) return;
            btn.textContent = autoPlaying ? 'Ⅱ' : '▶';
            btn.style.background = autoPlaying ? 'linear-gradient(135deg, #5eaa66, #26723b)' : 'rgba(61, 139, 79, 0.11)';
            btn.style.color = autoPlaying ? '#fff' : 'var(--leaf-dark)';
        }

        function selectObject(index, autoplay = false) {
            if (!objects.length) return;
            activeIndex = clamp(index, 0, objects.length - 1);
            const obj = objects[activeIndex];
            document.getElementById('readerWord').textContent = obj.label;
            document.getElementById('readerPhonetic').textContent = formatPhonetic(obj.phonetic);
            document.getElementById('readerCn').textContent = obj.translation || '跟读这个词，建立图像记忆';
            document.getElementById('readerProgress').textContent = `${activeIndex + 1} / ${objects.length}`;
            document.querySelectorAll('.hotspot').forEach(el => el.classList.toggle('active', Number(el.dataset.hotspotIndex) === activeIndex));
            if (autoplay) playObject(obj, currentVoice);
        }

        function getAudioUrl(obj, voice = 'female') {
            if (!obj) return '';
            if (voice === 'male') return obj.audio_url_male || obj.audio_url_female || obj.word_audio_url || '';
            return obj.audio_url_female || obj.audio_url_male || obj.word_audio_url || '';
        }

        async function playObject(obj, voice = currentVoice, options = {}) {
            currentVoice = voice || currentVoice;
            updateVoiceButtons();
            const runId = ++playRunId;
            const url = getAudioUrl(obj, voice);
            if (currentAudio) {
                currentAudio.pause();
                currentAudio = null;
            }
            const finish = () => {
                if (options.continueAfter && autoPlaying && runId === playRunId) {
                    playNextInSequence();
                }
            };
            if (url) {
                currentAudio = new Audio(url);
                currentAudio.onended = finish;
                currentAudio.onerror = finish;
                try {
                    await currentAudio.play();
                    return;
                } catch (err) {
                    console.warn('audio play failed', err);
                }
            }
            if ('speechSynthesis' in window && obj?.label) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(obj.label);
                utter.lang = 'en-US';
                utter.rate = 0.82;
                utter.onend = finish;
                window.speechSynthesis.speak(utter);
            } else {
                showToast('这个词还没有音频');
                finish();
            }
        }

        function playCurrent(voice = currentVoice) {
            if (activeIndex < 0) return showToast('暂无可点读内容');
            playObject(objects[activeIndex], voice);
        }

        function setVoice(voice, playNow = false) {
            currentVoice = voice === 'male' ? 'male' : 'female';
            updateVoiceButtons();
            if (playNow) playCurrent(currentVoice);
        }

        function toggleAutoPlay() {
            if (!objects.length) return showToast('暂无可点读内容');
            autoPlaying = !autoPlaying;
            updateAutoPlayButton();
            if (autoPlaying) {
                playObject(objects[activeIndex], currentVoice, { continueAfter: true });
            } else if (currentAudio) {
                currentAudio.pause();
                currentAudio = null;
                window.speechSynthesis?.cancel?.();
            }
        }

        function playNextInSequence() {
            if (!objects.length) return;
            if (activeIndex >= objects.length - 1) {
                autoPlaying = false;
                updateAutoPlayButton();
                showToast('自动播放完成');
                return;
            }
            selectObject(activeIndex + 1, false);
            playObject(objects[activeIndex], currentVoice, { continueAfter: true });
        }

        function prevObject() {
            if (!objects.length) return;
            selectObject((activeIndex - 1 + objects.length) % objects.length, true);
        }

        function nextObject() {
            if (!objects.length) return;
            selectObject((activeIndex + 1) % objects.length, true);
        }

        async function copyLink() {
            const url = window.location.href;
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(url);
                } else {
                    const input = document.createElement('input');
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand('copy');
                    input.remove();
                }
                showToast('H5 点读链接已复制');
            } catch (err) {
                showToast('复制失败，请手动复制地址栏链接');
            }
        }

        renderHotspots();
        updateVoiceButtons();
        updateAutoPlayButton();
        selectObject(activeIndex, false);
    </script>
</body>
</html>
