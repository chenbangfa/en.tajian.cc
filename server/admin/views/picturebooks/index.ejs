<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <h2 class="text-2xl font-bold bg-gradient-to-r from-green-700 to-emerald-600 bg-clip-text text-transparent">
                绘本管理</h2>
            <p class="text-gray-500 mt-1">创建和管理绘本故事内容</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/picturebook-videos"
                class="flex items-center space-x-2 bg-white border border-pink-200 text-pink-700 hover:bg-pink-50 px-5 py-3 rounded-xl transition-all duration-300">
                <i class="fas fa-film"></i>
                <span>视频工坊</span>
            </a>
            <a href="/picture-books/batch-audio"
                class="flex items-center space-x-2 bg-white border border-pink-200 text-pink-700 hover:bg-pink-50 px-5 py-3 rounded-xl transition-all duration-300">
                <i class="fas fa-headphones"></i>
                <span>批量配音</span>
            </a>
            <a href="/picture-books/batch-vocab"
                class="flex items-center space-x-2 bg-white border border-indigo-200 text-indigo-700 hover:bg-indigo-50 px-5 py-3 rounded-xl transition-all duration-300">
                <i class="fas fa-spell-check"></i>
                <span>词汇分析</span>
            </a>
            <a href="/picture-books/batch-images"
                class="flex items-center space-x-2 bg-white border border-green-200 text-green-700 hover:bg-green-50 px-5 py-3 rounded-xl transition-all duration-300">
                <i class="fas fa-images"></i>
                <span>批量生图</span>
            </a>
            <a href="/picture-books/edit/new"
                class="flex items-center space-x-2 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white px-6 py-3 rounded-xl shadow-lg shadow-green-200 transition-all duration-300 hover:-translate-y-0.5">
                <i class="fas fa-plus"></i>
                <span>新建绘本</span>
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex items-center space-x-4">
        <div class="flex items-center space-x-2 text-gray-600">
            <i class="fas fa-filter"></i>
            <span>筛选:</span>
        </div>
        <select id="categoryFilter" onchange="loadBooks()"
            class="px-4 py-2 border border-gray-200 rounded-lg outline-none focus:border-green-500 bg-gray-50">
            <option value="">全部分类</option>
        </select>
        <select id="stageFilter" onchange="loadBooks()"
            class="px-4 py-2 border border-gray-200 rounded-lg outline-none focus:border-green-500 bg-gray-50">
            <option value="all">全部阶段</option>
            <option value="v1">V1 启蒙</option>
            <option value="v2">V2 进阶</option>
            <option value="v3_start">V3 入门</option>
            <option value="v3">V3 主题</option>
        </select>
        <div class="relative flex-1 max-w-md">
            <input type="text" id="searchInput" onkeyup="if(event.key==='Enter') loadBooks()" placeholder="搜索绘本标题..."
                class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-lg outline-none focus:border-green-500 bg-gray-50">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
    </div>

    <!-- Book Grid -->
    <div id="bookGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="col-span-full text-center py-12 text-gray-500">
            <i class="fas fa-spinner fa-spin text-3xl mb-4 text-green-500"></i>
            <p>加载绘本中...</p>
        </div>
    </div>

    <!-- 生成视频对话框 -->
    <div id="genVideoModal" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <i class="fas fa-film text-pink-500"></i> 生成绘本视频
                </h3>
                <button onclick="closeGenVideoDialog()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <div class="text-sm text-gray-500">绘本：<span id="genVideoTitle" class="font-medium text-gray-800"></span></div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">字幕模式</label>
                <select id="cfgSubtitle" class="border rounded-lg px-3 py-2 text-sm w-full">
                    <option value="bilingual">双语（英文 + 中文）</option>
                    <option value="english_only">仅英文</option>
                </select>
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">时长模式</label>
                <select id="cfgDuration" class="border rounded-lg px-3 py-2 text-sm w-full">
                    <option value="shorts_60">短视频版 ≤60s（适合全平台）</option>
                    <option value="full_75">完整版 ≤75s（除 YouTube Shorts 外）</option>
                </select>
            </div>
            <div class="text-xs text-gray-400">配音：使用绘本已有女声音频</div>
            <div class="flex justify-end gap-3 pt-2 border-t">
                <button onclick="closeGenVideoDialog()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">取消</button>
                <button id="genVideoSubmit" onclick="submitGenVideo()" class="bg-gradient-to-r from-pink-600 to-purple-600 text-white px-5 py-2 rounded-lg hover:opacity-90">开始生成</button>
            </div>
        </div>
    </div>

    <!-- 视频预览 -->
    <div id="videoPreviewModal" class="hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4" onclick="if(event.target===this)closeVideoPreview()">
        <div class="rounded-xl overflow-hidden bg-black" style="max-height: 85vh; aspect-ratio: 9/16;">
            <video id="videoPreviewPlayer" controls class="w-full h-full"></video>
        </div>
        <button onclick="closeVideoPreview()" class="absolute top-6 right-6 text-white/80 hover:text-white text-2xl"><i class="fas fa-times"></i></button>
    </div>
</div>

<script>
async function loadCategories() {
    try {
        const res = await fetch('/picture-books/categories/api/list');
        const result = await res.json();
        if (result.success) {
            const select = document.getElementById('categoryFilter');
            result.data.forEach(cat => {
                if (cat.is_active) {
                    select.innerHTML += `<option value="${cat.id}">${cat.icon || ''} ${cat.name}</option>`;
                }
            });
        }
    } catch (e) {
        console.error(e);
    }
}

// 缓存视频任务状态：{book_id: {status, video_url, cover_url, ...}}
let _videoStatusMap = {};

async function loadBooks() {
    const categoryId = document.getElementById('categoryFilter').value;
    const readerStage = document.getElementById('stageFilter').value;
    const keyword = document.getElementById('searchInput').value;

    let url = '/picture-books/api/list?';
    if (categoryId) url += `category_id=${categoryId}&`;
    if (readerStage && readerStage !== 'all') url += `reader_stage=${encodeURIComponent(readerStage)}&`;
    if (keyword) url += `keyword=${encodeURIComponent(keyword)}&`;

    try {
        const res = await fetch(url);
        const result = await res.json();
        const books = result.data || [];
        // 批量查询视频状态
        if (books.length) {
            try {
                const st = await fetch('/picturebook-videos/api/books/status-batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ book_ids: books.map(b => b.id) })
                }).then(r => r.json());
                _videoStatusMap = (st && st.success) ? (st.data || {}) : {};
            } catch (e) { _videoStatusMap = {}; }
        }
        renderBooks(books);
    } catch (err) {
        showToast('加载失败', 'error');
    }
}

function renderBooks(books) {
    const container = document.getElementById('bookGrid');
    if (books.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center py-12 text-gray-400 bg-white rounded-2xl border border-gray-100 border-dashed">
            <i class="fas fa-book-open text-3xl mb-3 opacity-50"></i>
            <p>暂无绘本数据</p>
        </div>`;
        return;
    }

    container.innerHTML = books.map(book => {
        const vs = _videoStatusMap[book.id];
        let videoBadge = '';
        if (vs) {
            if (vs.status === 'done') {
                videoBadge = `<button onclick="previewBookVideo(${book.id})" class="absolute bottom-2 left-2 bg-green-500/90 text-white text-xs px-2 py-1 rounded-full hover:bg-green-600 flex items-center gap-1" title="点击预览"><i class="fas fa-play"></i> 视频已生成</button>`;
            } else if (vs.status === 'processing') {
                videoBadge = `<div class="absolute bottom-2 left-2 bg-yellow-500/90 text-white text-xs px-2 py-1 rounded-full animate-pulse"><i class="fas fa-spinner fa-spin"></i> 生成中 ${vs.progress || 0}%</div>`;
            } else if (vs.status === 'pending') {
                videoBadge = `<div class="absolute bottom-2 left-2 bg-gray-500/90 text-white text-xs px-2 py-1 rounded-full"><i class="fas fa-clock"></i> 排队中</div>`;
            } else if (vs.status === 'failed') {
                videoBadge = `<div class="absolute bottom-2 left-2 bg-red-500/90 text-white text-xs px-2 py-1 rounded-full" title="${(vs.error_message||'').replace(/"/g,'&quot;')}"><i class="fas fa-times-circle"></i> 生成失败</div>`;
            }
        }
        return `
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden group hover:shadow-lg transition-all duration-300">
            <!-- Cover -->
            <div class="relative h-48 bg-gradient-to-br from-green-50 to-emerald-50 overflow-hidden">
                ${book.cover_url
                    ? `<img src="${book.cover_url}" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500" alt="${book.title}">`
                    : `<div class="w-full h-full flex items-center justify-center text-6xl opacity-30">📖</div>`
                }
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-between p-4">
                    <span class="text-white text-xs font-medium bg-black/30 px-2 py-1 rounded backdrop-blur-sm">
                        ${'★'.repeat(book.difficulty_level)}${'☆'.repeat(5 - book.difficulty_level)}
                    </span>
                    <span class="text-white text-xs font-medium bg-black/30 px-2 py-1 rounded backdrop-blur-sm">
                        ${book.page_count} 页
                    </span>
                </div>
                ${!book.is_active ? '<div class="absolute top-2 right-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full">已下架</div>' : ''}
                ${!book.is_free ? '<div class="absolute top-2 left-2 bg-yellow-500 text-white text-xs px-2 py-1 rounded-full">VIP</div>' : ''}
                ${videoBadge}
            </div>

            <!-- Content -->
            <div class="p-4">
                <h3 class="font-bold text-gray-800 text-lg mb-1 truncate">${book.title}</h3>
                <p class="text-sm text-gray-500 mb-2 truncate">${book.title_en || ''}</p>
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <span class="text-xs font-semibold px-2 py-1 rounded-full ${getStageBadgeClass(book.reader_stage)}">
                        ${escapeHtml(book.reader_stage_name || 'V3 主题阅读')}
                    </span>
                </div>
                <div class="flex items-center justify-between mt-4">
                    <span class="text-xs text-gray-400 bg-gray-50 px-2 py-1 rounded">
                        <i class="fas fa-folder mr-1"></i> ${book.category_name || '未分类'}
                    </span>
                    <div class="flex space-x-2">
                        <button onclick="openGenVideoDialog(${book.id}, '${(book.title||'').replace(/'/g,"\\'")}')" class="p-2 text-pink-600 hover:bg-pink-50 rounded-lg transition-colors" title="生成视频">
                            <i class="fas fa-film"></i>
                        </button>
                        <a href="/picture-books/edit/${book.id}" class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="编辑">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button onclick="deleteBook(${book.id})" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="删除">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    `}).join('');
}

function getStageBadgeClass(stage) {
    if (stage === 'v1') return 'bg-emerald-50 text-emerald-700';
    if (stage === 'v2') return 'bg-blue-50 text-blue-700';
    if (stage === 'v3_start') return 'bg-amber-50 text-amber-700';
    return 'bg-purple-50 text-purple-700';
}

function escapeHtml(value) {
    return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

// ===== 视频生成对话框 =====
function openGenVideoDialog(bookId, title) {
    const modal = document.getElementById('genVideoModal');
    modal.dataset.bookId = bookId;
    document.getElementById('genVideoTitle').textContent = title || `绘本 #${bookId}`;
    modal.classList.remove('hidden');
}

function closeGenVideoDialog() {
    document.getElementById('genVideoModal').classList.add('hidden');
}

async function submitGenVideo() {
    const modal = document.getElementById('genVideoModal');
    const bookId = parseInt(modal.dataset.bookId);
    const subtitle_mode = document.getElementById('cfgSubtitle').value;
    const duration_mode = document.getElementById('cfgDuration').value;
    const btn = document.getElementById('genVideoSubmit');
    btn.disabled = true;
    btn.innerText = '创建中...';
    try {
        const res = await fetch('/picturebook-videos/api/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ book_id: bookId, subtitle_mode, duration_mode, voice: 'female' })
        }).then(r => r.json());
        if (res.success) {
            showToast('任务已创建');
            closeGenVideoDialog();
            loadBooks();
        } else {
            alert(res.message || '创建失败');
        }
    } catch (e) {
        alert('请求失败: ' + e.message);
    }
    btn.disabled = false;
    btn.innerText = '开始生成';
}

// ===== 视频预览 =====
async function previewBookVideo(bookId) {
    const vs = _videoStatusMap[bookId];
    if (!vs || !vs.video_url) {
        showToast('视频不存在', 'error');
        return;
    }
    const modal = document.getElementById('videoPreviewModal');
    const player = document.getElementById('videoPreviewPlayer');
    player.src = vs.video_url;
    modal.classList.remove('hidden');
    try { await player.play(); } catch (e) { /* autoplay blocked */ }
}

function closeVideoPreview() {
    const player = document.getElementById('videoPreviewPlayer');
    player.pause();
    player.src = '';
    document.getElementById('videoPreviewModal').classList.add('hidden');
}

async function deleteBook(id) {
    if (!confirm('确定要删除该绘本吗？所有页面和热点数据将一并删除！')) return;
    try {
        const res = await fetch(`/picture-books/api/${id}`, { method: 'DELETE' });
        const result = await res.json();
        if (result.success) {
            showToast('删除成功');
            loadBooks();
        } else {
            showToast('删除失败', 'error');
        }
    } catch (e) {
        showToast('请求错误', 'error');
    }
}

loadCategories();
loadBooks();
</script>
