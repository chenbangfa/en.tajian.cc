<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <h2 class="text-2xl font-bold bg-gradient-to-r from-green-700 to-emerald-600 bg-clip-text text-transparent">
                绘本分类管理</h2>
            <p class="text-gray-500 mt-1">管理绘本故事的分类</p>
        </div>
        <button onclick="openModal()"
            class="flex items-center space-x-2 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white px-6 py-3 rounded-xl shadow-lg shadow-green-200 transition-all duration-300 hover:-translate-y-0.5">
            <i class="fas fa-plus"></i>
            <span>新增分类</span>
        </button>
    </div>

    <!-- Category List -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div id="categoryList" class="space-y-3">
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-spinner fa-spin text-3xl mb-4 text-green-500"></i>
                <p>加载分类中...</p>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div id="editModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800" id="modalTitle">新增分类</h3>
            <button onclick="closeModal()"
                class="text-gray-400 hover:text-gray-600 w-8 h-8 rounded-full hover:bg-white flex items-center justify-center">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <form id="editForm" class="p-6 space-y-5">
            <input type="hidden" name="id">

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">分类名称</label>
                    <input type="text" name="name" required
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500/20 focus:border-green-500 outline-none"
                        placeholder="如：启蒙认知">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">英文名称</label>
                    <input type="text" name="name_en"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500/20 focus:border-green-500 outline-none"
                        placeholder="如：Early Learning">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">图标 (Emoji/URL)</label>
                    <input type="text" name="icon"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500/20 focus:border-green-500 outline-none"
                        placeholder="如：📖">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">排序</label>
                    <input type="number" name="sort_order" value="0"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-green-500/20 focus:border-green-500 outline-none">
                </div>
            </div>

            <div class="flex items-center space-x-2 pt-2">
                <input type="checkbox" name="is_active" id="is_active"
                    class="w-4 h-4 text-green-600 rounded border-gray-300 focus:ring-green-500" checked>
                <label for="is_active" class="text-sm text-gray-700">启用该分类</label>
            </div>
        </form>

        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end space-x-3">
            <button onclick="closeModal()"
                class="px-5 py-2.5 text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 font-medium">取消</button>
            <button onclick="saveCategory()"
                class="px-5 py-2.5 bg-green-600 text-white rounded-xl hover:bg-green-700 shadow-lg shadow-green-200 font-medium">保存</button>
        </div>
    </div>
</div>

<script>
let categories = [];

async function loadCategories() {
    try {
        const res = await fetch('/picture-books/categories/api/list');
        const data = await res.json();
        if (data.success) {
            categories = data.data;
            renderCategories();
        }
    } catch (err) {
        showToast('加载失败', 'error');
    }
}

function renderCategories() {
    const container = document.getElementById('categoryList');
    if (categories.length === 0) {
        container.innerHTML = '<div class="text-center py-8 text-gray-400">暂无分类数据</div>';
        return;
    }

    const totalBooks = categories.reduce((sum, cat) => sum + Number(cat.book_count || 0), 0);

    container.innerHTML = categories.map(cat => `
        <div class="flex items-center justify-between p-4 rounded-2xl border border-gray-200 hover:border-green-200 hover:bg-green-50/30 transition-all group ${!cat.is_active ? 'opacity-50' : ''}">
            <div class="flex items-center space-x-4 min-w-0">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-green-100 to-emerald-100 flex items-center justify-center text-2xl shadow-sm shrink-0">${cat.icon || '📖'}</div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="font-bold text-gray-800 truncate">${cat.name}</h3>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-green-50 text-green-700 border border-green-100">${Number(cat.book_count || 0)} 本绘本</span>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">排序 ${cat.sort_order}</span>
                        ${!cat.is_active ? '<span class="text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-600">已禁用</span>' : ''}
                    </div>
                    <p class="text-xs text-gray-500 mt-1">${cat.name_en || ''}</p>
                    <p class="text-[11px] text-gray-400 mt-1">分类 ID: ${cat.id}</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick='editCategory(${JSON.stringify(cat)})' class="text-blue-500 hover:text-blue-700 p-2 rounded-lg hover:bg-blue-50">
                    <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteCategory(${cat.id})" class="text-red-400 hover:text-red-600 p-2 rounded-lg hover:bg-red-50">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </div>
        </div>
    `).join('');

    container.innerHTML = `
        <div class="flex items-center justify-between px-1 pb-2">
            <div>
                <p class="text-sm font-semibold text-gray-700">分类总览</p>
                <p class="text-xs text-gray-400 mt-1">按分类查看绘本内容规模</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-600">${categories.length} 个分类</span>
                <span class="text-xs px-2.5 py-1 rounded-full bg-green-100 text-green-700">${totalBooks} 本绘本</span>
            </div>
        </div>
        ${container.innerHTML}
    `;
}

function openModal() {
    document.getElementById('editForm').reset();
    document.querySelector('#editForm input[name="id"]').value = '';
    document.getElementById('modalTitle').textContent = '新增分类';
    document.getElementById('editModal').classList.remove('hidden');
}

function editCategory(cat) {
    openModal();
    document.getElementById('modalTitle').textContent = '编辑分类';
    const form = document.getElementById('editForm');
    form.querySelector('input[name="id"]').value = cat.id;
    form.querySelector('input[name="name"]').value = cat.name;
    form.querySelector('input[name="name_en"]').value = cat.name_en || '';
    form.querySelector('input[name="icon"]').value = cat.icon || '';
    form.querySelector('input[name="sort_order"]').value = cat.sort_order;
    form.querySelector('input[name="is_active"]').checked = cat.is_active;
}

function closeModal() {
    document.getElementById('editModal').classList.add('hidden');
}

async function saveCategory() {
    const form = document.getElementById('editForm');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    data.is_active = form.querySelector('input[name="is_active"]').checked ? 1 : 0;
    data.sort_order = parseInt(data.sort_order) || 0;

    const id = data.id;
    delete data.id;

    const url = id ? `/picture-books/categories/api/${id}` : '/picture-books/categories/api/create';
    const method = id ? 'PUT' : 'POST';

    try {
        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
            showToast('保存成功');
            closeModal();
            loadCategories();
        } else {
            showToast(result.message, 'error');
        }
    } catch (err) {
        showToast('请求失败', 'error');
    }
}

async function deleteCategory(id) {
    if (!confirm('确定要删除该分类吗？')) return;
    try {
        const res = await fetch(`/picture-books/categories/api/${id}`, { method: 'DELETE' });
        const result = await res.json();
        if (result.success) {
            showToast('删除成功');
            loadCategories();
        } else {
            showToast(result.message, 'error');
        }
    } catch (err) {
        showToast('请求失败', 'error');
    }
}

loadCategories();
</script>
