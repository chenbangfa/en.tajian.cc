<div class="space-y-6">
  <!-- Header -->
  <div class="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
    <div>
      <h2 class="text-2xl font-bold text-gray-800">对话场景分类</h2>
      <p class="text-gray-500 mt-1">管理对话场景的分类，按分组归类展示</p>
    </div>
    <button onclick="openAdd()" class="flex items-center space-x-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white px-6 py-3 rounded-xl shadow-lg transition-all hover:-translate-y-0.5">
      <i class="fas fa-plus"></i><span>添加分类</span>
    </button>
  </div>

  <!-- 分组列表 -->
  <div id="catGroups" class="space-y-4">
    <div class="text-center py-12 text-gray-400"><i class="fas fa-spinner fa-spin text-2xl"></i></div>
  </div>
</div>

<!-- 弹窗 -->
<div id="modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center">
  <div class="bg-white rounded-2xl p-8 w-full max-w-md mx-4 shadow-2xl">
    <h3 class="text-xl font-bold text-gray-800 mb-6" id="modalTitle">添加分类</h3>
    <input type="hidden" id="editId">
    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">图标 Emoji</label>
        <input id="fIcon" type="text" value="💬" maxlength="4" class="w-full border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:border-purple-500 text-2xl">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">分类名称 <span class="text-red-500">*</span></label>
        <input id="fName" type="text" placeholder="如：餐厅点餐" class="w-full border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:border-purple-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">所属分组 <span class="text-red-500">*</span></label>
        <input id="fGroup" type="text" list="groupList" placeholder="如：餐饮美食" class="w-full border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:border-purple-500">
        <datalist id="groupList"></datalist>
        <p class="text-xs text-gray-400 mt-1">可输入已有分组或新建分组</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">排序（数字越小越靠前）</label>
        <input id="fSort" type="number" value="0" class="w-full border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:border-purple-500">
      </div>
    </div>
    <div class="flex justify-end gap-3 mt-8">
      <button onclick="closeModal()" class="px-6 py-2 rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50">取消</button>
      <button onclick="saveCategory()" class="px-6 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700">保存</button>
    </div>
  </div>
</div>

<script>
let allCats = [];

async function loadCats() {
  const res = await fetch(`${API_BASE}/dialogue/categories`);
  const r = await res.json();
  const container = document.getElementById('catGroups');
  if (!r.success || !r.data.length) {
    container.innerHTML = `<div class="text-center py-12 text-gray-400">暂无分类</div>`;
    return;
  }
  allCats = r.data;

  // 填充 datalist 分组选项
  const groups = [...new Set(allCats.map(c => c.group_name).filter(Boolean))];
  document.getElementById('groupList').innerHTML = groups.map(g => `<option value="${g}">`).join('');

  // 按分组聚合
  const grouped = {};
  allCats.forEach(c => {
    const g = c.group_name || '未分组';
    if (!grouped[g]) grouped[g] = [];
    grouped[g].push(c);
  });

  container.innerHTML = Object.entries(grouped).map(([group, cats]) => `
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="bg-gradient-to-r from-purple-50 to-indigo-50 px-6 py-3 border-b border-gray-100 flex items-center justify-between">
        <span class="font-semibold text-purple-700 text-sm">${group}</span>
        <span class="text-xs text-gray-400">${cats.length} 个分类</span>
      </div>
      <table class="w-full">
        <tbody>
          ${cats.map(c => `
            <tr class="border-b border-gray-50 last:border-0 hover:bg-gray-50 transition-colors">
              <td class="px-6 py-3 text-2xl w-12">${c.icon_emoji || '💬'}</td>
              <td class="px-6 py-3 font-medium text-gray-800">${c.name}</td>
              <td class="px-6 py-3 text-gray-400 text-sm">排序 ${c.sort_order}</td>
              <td class="px-6 py-3 text-right">
                <button onclick='openEdit(${JSON.stringify(c)})' class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg mr-1"><i class="fas fa-edit"></i></button>
                <button onclick="deleteCat(${c.id})" class="p-2 text-red-500 hover:bg-red-50 rounded-lg"><i class="fas fa-trash-alt"></i></button>
              </td>
            </tr>`).join('')}
        </tbody>
      </table>
    </div>`).join('');
}

function openAdd() {
  document.getElementById('editId').value = '';
  document.getElementById('modalTitle').textContent = '添加分类';
  document.getElementById('fIcon').value = '💬';
  document.getElementById('fName').value = '';
  document.getElementById('fGroup').value = '';
  document.getElementById('fSort').value = '0';
  document.getElementById('modal').classList.remove('hidden');
}

function openEdit(c) {
  document.getElementById('editId').value = c.id;
  document.getElementById('modalTitle').textContent = '编辑分类';
  document.getElementById('fIcon').value = c.icon_emoji || '💬';
  document.getElementById('fName').value = c.name;
  document.getElementById('fGroup').value = c.group_name || '';
  document.getElementById('fSort').value = c.sort_order;
  document.getElementById('modal').classList.remove('hidden');
}

function closeModal() { document.getElementById('modal').classList.add('hidden'); }

async function saveCategory() {
  const id = document.getElementById('editId').value;
  const body = {
    name: document.getElementById('fName').value.trim(),
    icon_emoji: document.getElementById('fIcon').value.trim() || '💬',
    group_name: document.getElementById('fGroup').value.trim(),
    sort_order: parseInt(document.getElementById('fSort').value) || 0
  };
  if (!body.name) { showToast('请输入名称', 'error'); return; }
  if (!body.group_name) { showToast('请输入所属分组', 'error'); return; }
  const url = id ? `${API_BASE}/dialogue/categories/${id}` : `${API_BASE}/dialogue/categories`;
  const method = id ? 'PUT' : 'POST';
  const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
  const r = await res.json();
  if (r.success) { showToast(id ? '更新成功' : '添加成功'); closeModal(); loadCats(); }
  else showToast(r.message, 'error');
}

async function deleteCat(id) {
  if (!confirm('确定删除此分类？该分类下的场景将变为"未分类"')) return;
  const res = await fetch(`${API_BASE}/dialogue/categories/${id}`, { method: 'DELETE' });
  const r = await res.json();
  if (r.success) { showToast('删除成功'); loadCats(); }
  else showToast(r.message, 'error');
}

loadCats();
</script>
