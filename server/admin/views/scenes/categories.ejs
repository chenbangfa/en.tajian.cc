<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <h2 class="text-2xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent">
                场景分类管理</h2>
            <p class="text-gray-500 mt-1">管理场景学习的层级结构（支持二级分类）</p>
        </div>
        <button onclick="openModal()"
            class="flex items-center space-x-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-6 py-3 rounded-xl shadow-lg shadow-blue-200 transition-all duration-300 hover:-translate-y-0.5">
            <i class="fas fa-plus"></i>
            <span>新增分类</span>
        </button>
    </div>

    <!-- Category List -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div id="categoryList" class="space-y-4">
            <!-- Loading -->
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-spinner fa-spin text-3xl mb-4 text-blue-500"></i>
                <p>加载分类中...</p>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div id="editModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl transform transition-all scale-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800" id="modalTitle">新增分类</h3>
            <button onclick="closeModal()"
                class="text-gray-400 hover:text-gray-600 transition-colors w-8 h-8 rounded-full hover:bg-white flex items-center justify-center">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <form id="editForm" class="p-6 space-y-5">
            <input type="hidden" name="id">

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">分类名称</label>
                    <input type="text" name="name" required
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                        placeholder="如：家庭">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">英文名称</label>
                    <input type="text" name="name_en"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                        placeholder="如：Family">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">上级分类</label>
                <select name="parent_id"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all bg-white">
                    <option value="0">顶级分类</option>
                    <!-- Options populated by JS -->
                </select>
                <p class="text-xs text-gray-400 mt-1">选择顶级分类则创建一级分类，否则创建为该分类的子分类</p>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">图标 (Emoji)</label>
                    <input type="text" name="icon"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                        placeholder="如：👨‍👩‍👧‍👦">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">排序</label>
                    <input type="number" name="sort_order" value="0"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
                </div>
            </div>

            <div id="itemsGroup" class="hidden">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">内容词汇 (英文，逗号分隔)</label>
                <textarea name="items" rows="3"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all text-sm"
                    placeholder="如：apple, banana, orange, pear, grape"></textarea>
                <p class="text-xs text-gray-400 mt-1">用于 AI 生成场景图时的物品列表，仅二级分类需要填写</p>
            </div>

            <div class="flex items-center space-x-2 pt-2">
                <input type="checkbox" name="is_active" id="is_active"
                    class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" checked>
                <label for="is_active" class="text-sm text-gray-700">启用该分类</label>
            </div>
        </form>

        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end space-x-3">
            <button onclick="closeModal()"
                class="px-5 py-2.5 text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors font-medium">取消</button>
            <button onclick="saveCategory()"
                class="px-5 py-2.5 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-200 font-medium">保存</button>
        </div>
    </div>
</div>

<script>
    let categories = [];
    let topCategories = [];

    // Load Categories
    async function loadCategories() {
        try {
            const res = await fetch(`${API_BASE}/scene_categories`);
            const data = await res.json();
            if (data.success) {
                categories = data.data;
                topCategories = categories; // Used for dropdown
                renderCategories();
            }
        } catch (err) {
            showToast('加载失败', 'error');
        }
    }

    // Render Categories Tree
    function renderCategories() {
        const container = document.getElementById('categoryList');
        if (categories.length === 0) {
            container.innerHTML = '<div class="text-center py-8 text-gray-400">暂无分类数据</div>';
            return;
        }

        let html = '';
        categories.forEach(cat => {
            // Parent Category
            html += `
            <div class="border border-gray-200 rounded-xl overflow-hidden mb-4 bg-white shadow-sm hover:shadow-md transition-all">
                <div class="flex items-center justify-between p-4 bg-gray-50/50">
                    <div class="flex items-center space-x-3">
                        <span class="text-2xl">${cat.icon || '📁'}</span>
                        <div>
                            <h3 class="font-bold text-gray-800 text-lg">${cat.name}</h3>
                            <p class="text-xs text-gray-500">${cat.name_en || ''}</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-500">排序: ${cat.sort_order}</span>
                        <div class="h-4 w-px bg-gray-300 mx-2"></div>
                        <button onclick='editCategory(${JSON.stringify(cat)})' class="text-blue-500 hover:text-blue-700 p-2 rounded-lg hover:bg-blue-50 transition-colors" title="编辑">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteCategory(${cat.id})" class="text-red-400 hover:text-red-600 p-2 rounded-lg hover:bg-red-50 transition-colors" title="删除">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        <button onclick="openModal(${cat.id})" class="ml-2 bg-white border border-gray-200 text-gray-600 hover:text-blue-600 hover:border-blue-200 px-3 py-1.5 rounded-lg text-sm shadow-sm transition-all flex items-center space-x-1">
                            <i class="fas fa-plus text-xs"></i>
                            <span>添加子分类</span>
                        </button>
                    </div>
                </div>
        `;

            // Sub Categories
            if (cat.children && cat.children.length > 0) {
                html += `<div class="p-2 bg-white border-t border-gray-100 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">`;
                cat.children.forEach(sub => {
                    html += `
                    <div class="flex flex-col p-3 rounded-lg border border-gray-100 hover:border-blue-100 hover:bg-blue-50/30 transition-all group">
                        <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <span class="text-xl">${sub.icon || '📄'}</span>
                            <div>
                                <div class="font-medium text-gray-700">${sub.name}</div>
                                <div class="text-xs text-gray-400">${sub.name_en || ''}</div>
                            </div>
                        </div>
                        <div class="flex items-center space-x-1 opacity-60 group-hover:opacity-100 transition-opacity">
                            <button onclick='editCategory(${JSON.stringify(sub)})' class="text-blue-500 hover:text-blue-700 p-1.5 rounded hover:bg-white transition-colors">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteCategory(${sub.id})" class="text-red-400 hover:text-red-600 p-1.5 rounded hover:bg-white transition-colors">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                        </div>
                        ${sub.items ? `<div class="mt-2 text-xs text-gray-400 truncate" title="${sub.items}"><i class="fas fa-tags mr-1"></i>${sub.items}</div>` : ''}
                    </div>
                `;
                });
                html += `</div>`;
            } else {
                html += `<div class="px-4 py-3 text-sm text-gray-400 italic bg-white border-t border-gray-100">暂无子分类</div>`;
            }

            html += `</div>`;
        });

        container.innerHTML = html;
    }

    // Modal Logic
    function openModal(parentId = 0) {
        document.getElementById('editForm').reset();
        document.querySelector('input[name="id"]').value = '';
        document.getElementById('modalTitle').textContent = '新增分类';
        document.getElementById('editModal').classList.remove('hidden');

        // Update Parent Select
        const select = document.querySelector('select[name="parent_id"]');
        select.innerHTML = '<option value="0">顶级分类</option>';
        topCategories.forEach(cat => {
            select.innerHTML += `<option value="${cat.id}">${cat.name}</option>`;
        });

        select.value = parentId;
        toggleItemsField(parentId);

        // 监听上级分类变化，动态显示/隐藏 items 字段
        select.onchange = function() {
            toggleItemsField(parseInt(this.value));
        };
    }

    function toggleItemsField(parentId) {
        const itemsGroup = document.getElementById('itemsGroup');
        if (parentId > 0) {
            itemsGroup.classList.remove('hidden');
        } else {
            itemsGroup.classList.add('hidden');
        }
    }

    function editCategory(cat) {
        openModal(cat.parent_id);
        document.getElementById('modalTitle').textContent = '编辑分类';

        const form = document.getElementById('editForm');
        form.querySelector('input[name="id"]').value = cat.id;
        form.querySelector('input[name="name"]').value = cat.name;
        form.querySelector('input[name="name_en"]').value = cat.name_en || '';
        form.querySelector('select[name="parent_id"]').value = cat.parent_id;
        form.querySelector('input[name="icon"]').value = cat.icon || '';
        form.querySelector('textarea[name="items"]').value = cat.items || '';
        form.querySelector('input[name="sort_order"]').value = cat.sort_order;
        form.querySelector('input[name="is_active"]').checked = cat.is_active;
        toggleItemsField(cat.parent_id);
    }

    function closeModal() {
        document.getElementById('editModal').classList.add('hidden');
    }

    async function saveCategory() {
        const form = document.getElementById('editForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.is_active = form.querySelector('input[name="is_active"]').checked ? 1 : 0;

        const id = data.id;
        const method = id ? 'PUT' : 'POST';
        const url = id ? `${API_BASE}/scene_categories/${id}` : `${API_BASE}/scene_categories`;

        try {
            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();

            if (result.success) {
                showToast('保存成功');
                closeModal();
                loadCategories();
            } else {
                showToast(result.message, 'error');
            }
        } catch (err) {
            showToast('请求失败', 'error');
        }
    }

    async function deleteCategory(id) {
        if (!confirm('确定要删除该分类吗？')) return;

        try {
            const res = await fetch(`${API_BASE}/scene_categories/${id}`, {
                method: 'DELETE'
            });
            const result = await res.json();

            if (result.success) {
                showToast('删除成功');
                loadCategories();
            } else {
                showToast(result.message, 'error');
            }
        } catch (err) {
            showToast('请求失败', 'error');
        }
    }

    // Init
    loadCategories();
</script>