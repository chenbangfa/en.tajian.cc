        // 计时器：每秒更新按钮文字显示已等待时间
        let seconds = 0;
        const timer = setInterval(() => {
            seconds++;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i> AI 生成中... (${seconds}s)`;
        }, 1000);

        try {
            const res = await fetch(`${API_BASE}/scenes/generate-image`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    prompt,
                    ai_style: currentAiStyle === 'scene' ? 'custom' : currentAiStyle,
                    name: document.querySelector('input[name="name"]').value,
