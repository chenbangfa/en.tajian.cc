<div class="grid grid-cols-12 gap-6 h-[calc(100vh-140px)]">
    <!-- Left Column: Settings -->
    <div class="col-span-3 bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
        <div class="p-5 border-b border-gray-100">
            <h2 class="font-bold text-lg text-gray-800">
                <a href="/scenes" class="text-gray-400 hover:text-gray-600 mr-2"><i class="fas fa-arrow-left"></i></a>
                场景设置
            </h2>
        </div>

        <form id="sceneForm" class="p-5 flex-1 overflow-y-auto space-y-5">
            <input type="hidden" name="id" id="sceneId" value="<%= typeof scene !== 'undefined' ? scene.id : '' %>">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">场景名称</label>
                <input type="text" name="name" required value="<%= typeof scene !== 'undefined' ? scene.name : '' %>"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">英文名称</label>
                <input type="text" name="name_en" value="<%= typeof scene !== 'undefined' ? scene.name_en : '' %>"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">所属分类</label>
                <select name="category_id" id="categorySelect"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all bg-white">
                    <option value="">选择分类</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">难度等级 (1-5)</label>
                <div class="flex items-center space-x-4">
                    <input type="range" name="difficulty_level" min="1" max="5"
                        value="<%= typeof scene !== 'undefined' ? scene.difficulty_level : 1 %>"
                        oninput="this.nextElementSibling.innerText = this.value + '级'" class="flex-1">
                    <span class="text-blue-600 font-bold bg-blue-50 px-2 py-1 rounded text-sm w-10 text-center">
                        <%= typeof scene !=='undefined' ? scene.difficulty_level : 1 %>级
                    </span>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">场景图片</label>

                <!-- Toggle Tabs -->
                <div class="flex bg-gray-100 p-1 rounded-xl mb-3 text-sm font-medium">
                    <button type="button" onclick="switchImageTab('upload')" id="tab-upload"
                        class="flex-1 py-1.5 rounded-lg bg-white shadow-sm text-gray-800 transition-all">本地上传</button>
                    <button type="button" onclick="switchImageTab('ai')" id="tab-ai"
                        class="flex-1 py-1.5 rounded-lg text-gray-500 hover:text-gray-800 transition-all">AI生成</button>
                </div>

                <!-- Upload Panel -->
                <div id="panel-upload" class="block">
                    <div class="border-2 border-dashed border-gray-200 rounded-xl p-4 text-center hover:border-blue-300 transition-colors cursor-pointer relative"
                        onclick="document.getElementById('fileInput').click()">
                        <input type="file" id="fileInput" accept="image/*" class="hidden"
                            onchange="handleFileUpload(this)">
                        <i class="fas fa-cloud-upload-alt text-2xl text-gray-300 mb-2"></i>
                        <p class="text-xs text-gray-500">点击上传图片 (JPG/PNG)</p>
                    </div>
                </div>

                <!-- AI Panel -->
                <div id="panel-ai" class="hidden space-y-2">
                    <!-- Style Selector -->
                    <div class="flex bg-purple-50 p-1 rounded-lg text-xs font-medium">
                        <button type="button" onclick="switchAiStyle('poster')" id="style-poster"
                            class="flex-1 py-1.5 rounded-md bg-purple-600 text-white transition-all">
                            <i class="fas fa-th mr-1"></i>英文海报
                        </button>
                        <button type="button" onclick="switchAiStyle('scene')" id="style-scene"
                            class="flex-1 py-1.5 rounded-md text-purple-600 hover:bg-purple-100 transition-all">
                            <i class="fas fa-image mr-1"></i>场景图
                        </button>
                        <button type="button" onclick="switchAiStyle('custom')" id="style-custom"
                            class="flex-1 py-1.5 rounded-md text-purple-600 hover:bg-purple-100 transition-all">
                            <i class="fas fa-language mr-1"></i>中文海报
                        </button>
                    </div>

                    <!-- Scene Style Info -->
                    <div id="ai-style-info" class="text-xs text-gray-500 bg-gray-50 px-3 py-2 rounded-lg">
                        <span id="ai-style-desc">生成英文词汇卡片网格海报 (9:16 竖版)</span>
                    </div>

                    <label id="sceneChineseLabelsWrap"
                        class="hidden items-center justify-between gap-3 text-xs text-gray-600 bg-green-50 border border-green-100 px-3 py-2 rounded-lg">
                        <span>
                            <i class="fas fa-language text-green-600 mr-1"></i>
                            场景图标注显示中文
                        </span>
                        <input id="sceneLabelChinese" type="checkbox"
                            class="w-4 h-4 accent-green-600"
                            onchange="handleSceneLabelChineseChange()">
                    </label>

                    <textarea id="aiPrompt" rows="3"
                        class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm outline-none focus:border-blue-500"
                        placeholder="选择分类后自动填充，也可手动修改..."></textarea>
                    <button type="button" id="btnGenerateImage" onclick="generateSceneImage()"
                        class="w-full py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-colors">
                        <i class="fas fa-magic mr-1"></i> 生成图片
                    </button>
                </div>

                <input type="hidden" name="image_url" id="image_url"
                    value="<%= typeof scene !== 'undefined' ? scene.image_url : '' %>">
            </div>

            <div class="pt-4 border-t border-gray-100">
                <button type="submit"
                    class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-lg shadow-blue-200 font-bold transition-all">保存全部</button>
            </div>
        </form>
    </div>

    <!-- Center Column: Image Editor -->
    <div class="col-span-6 bg-gray-100 rounded-2xl border border-gray-200 overflow-hidden flex flex-col relative">
        <div class="flex items-center justify-between p-3 bg-white border-b border-gray-200 shadow-sm z-10">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Editor Canvas</span>

            <div class="flex space-x-2">
                <% if (typeof scene !== 'undefined' && scene) { %>
                <button onclick="openH5SceneReader()"
                    class="flex items-center space-x-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-mobile-alt"></i>
                    <span>H5点读</span>
                </button>

                <button onclick="copyH5SceneReaderLink()"
                    class="flex items-center space-x-1.5 bg-slate-500 hover:bg-slate-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-link"></i>
                    <span>复制H5</span>
                </button>

                <label class="flex items-center space-x-1.5 bg-rose-50 border border-rose-200 text-rose-700 text-xs px-2.5 py-1.5 rounded-lg cursor-pointer select-none">
                    <input id="sceneReadingVideoChineseToggle" type="checkbox" checked
                        class="w-3.5 h-3.5 rounded border-rose-300 text-rose-500 focus:ring-rose-400">
                    <span>中文+中文发音</span>
                </label>

                <button id="sceneReadingVideoBtn" onclick="generateSceneReadingVideo()"
                    class="flex items-center space-x-1.5 bg-rose-500 hover:bg-rose-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-video"></i>
                    <span>点读视频</span>
                </button>

                <button onclick="generateWxacode()"
                    class="flex items-center space-x-1.5 bg-green-500 hover:bg-green-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-qrcode"></i>
                    <span>小程序码</span>
                </button>
                <% } %>

                <button onclick="smartOCR()"
                    class="flex items-center space-x-1.5 bg-yellow-500 hover:bg-yellow-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-bolt"></i>
                    <span>智能识别(OCR)</span>
                </button>

                <button onclick="autoDetectCards()"
                    class="flex items-center space-x-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-border-all"></i>
                    <span>一键识别卡片</span>
                </button>

                <button id="posterAdjustBtn" type="button" onclick="togglePosterAdjustPanel()"
                    class="flex items-center space-x-1.5 bg-cyan-600 hover:bg-cyan-700 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-sliders-h"></i>
                    <span>模板微调</span>
                </button>

                <button id="drawModeBtn" type="button" onclick="toggleDrawMode()"
                    class="flex items-center space-x-1.5 bg-slate-600 hover:bg-slate-700 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-draw-polygon"></i>
                    <span>手动框选</span>
                </button>

                <select id="ocrEngine"
                    class="text-xs border border-yellow-200 rounded-lg px-2 bg-yellow-50 text-yellow-800 outline-none">
                    <option value="youdao" selected>有道OCR</option>
                    <option value="tencent">腾讯云OCR</option>
                    <option value="gemini">Gemini</option>
                </select>
            </div>
        </div>

        <% if (typeof scene !== 'undefined' && scene) { %>
        <div id="sceneReadingVideoStatus" class="hidden px-3 py-2 bg-rose-50 border-b border-rose-100 text-xs text-rose-800"></div>
        <% } %>

        <div id="posterAdjustPanel" class="hidden px-3 py-2 bg-cyan-50 border-b border-cyan-100">
            <div class="flex items-center justify-between mb-2">
                <div>
                    <div class="text-xs font-semibold text-cyan-900">海报模板百分比微调</div>
                    <div class="text-[11px] text-cyan-700">用于英文海报/中文海报。正数表示往右/往下推，负数表示往左/往上收。</div>
                </div>
                <button type="button" onclick="resetPosterTemplateAdjustments()"
                    class="text-[11px] text-cyan-700 hover:text-cyan-900">重置为 0</button>
            </div>
            <div class="grid grid-cols-4 gap-2">
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">上边距(%)</span>
                    <input id="posterAdjustTop" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">下边界(%)</span>
                    <input id="posterAdjustBottom" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">左边距(%)</span>
                    <input id="posterAdjustLeft" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">右边界(%)</span>
                    <input id="posterAdjustRight" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">框宽增减(%)</span>
                    <input id="posterAdjustCardWidth" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">框高增减(%)</span>
                    <input id="posterAdjustCardHeight" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">横向间距(%)</span>
                    <input id="posterAdjustGapX" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
                <label class="text-[11px] text-gray-700">
                    <span class="block mb-1">纵向间距(%)</span>
                    <input id="posterAdjustGapY" type="number" step="0.1" value="0"
                        class="w-full px-2 py-1 border border-cyan-200 rounded bg-white text-xs outline-none focus:border-cyan-500"
                        oninput="persistPosterTemplateAdjustments()">
                </label>
            </div>
        </div>

        <div class="flex-1 relative overflow-auto flex items-center justify-center p-8 bg-dots">
            <div id="canvasContainer"
                class="relative shadow-2xl bg-white select-none transition-all duration-300 opacity-0 transform scale-95 w-fit h-fit">
                <img id="mainImage" src="<%= typeof scene !== 'undefined' ? scene.image_url : '' %>"
                    class="max-w-full max-h-[600px] object-contain draggable=" false">
                <!-- Hotspots Overlay -->
                <div id="hotspotLayer" class="absolute inset-0"></div>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="absolute inset-0 flex flex-col items-center justify-center text-gray-400">
                <i class="fas fa-image text-5xl mb-4 opacity-30"></i>
                <p>请先上传或生成图片</p>
            </div>
        </div>
    </div>

    <!-- Right Column: Hotspot List -->
    <div class="col-span-3 bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
        <div class="p-5 border-b border-gray-100">
            <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-gray-800">标注列表 <span id="hotspotCount"
                        class="text-xs bg-gray-100 px-2 py-0.5 rounded-full ml-1 text-gray-500">0</span></h3>
                <button onclick="clearAllHotspots()" class="text-xs text-red-500 hover:text-red-700">清空</button>
            </div>
            <button onclick="batchGenerateAll()"
                class="w-full py-2 bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-white rounded-lg text-sm font-medium transition-all shadow-sm">
                <i class="fas fa-magic mr-1"></i> 批量生成全部
            </button>
        </div>

        <div id="hotspotList" class="flex-1 overflow-y-auto p-2 space-y-1">
            <!-- Items injected here -->
        </div>
    </div>
</div>

<!-- 小程序码弹窗 -->
<div id="wxacodeModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center" onclick="this.classList.add('hidden');this.classList.remove('flex')">
    <div class="bg-white rounded-2xl p-6 shadow-2xl text-center max-w-sm" onclick="event.stopPropagation()">
        <h3 class="text-lg font-bold text-gray-800 mb-2">小程序码</h3>
        <p class="text-sm text-gray-500 mb-4">扫码直达该场景点读页面</p>
        <div id="wxacodeLoading" class="py-8 text-gray-400"><i class="fas fa-spinner fa-spin text-2xl"></i><br><span class="text-sm mt-2 inline-block">生成中...</span></div>
        <img id="wxacodeImg" class="hidden mx-auto w-64 h-64 rounded-lg border" alt="小程序码">
        <div id="wxacodeError" class="hidden text-red-500 text-sm py-4"></div>
        <div class="mt-4 flex gap-3 justify-center">
            <button id="wxacodeRegenerate" onclick="generateWxacode(true)" class="bg-orange-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-orange-600"><i class="fas fa-rotate mr-1"></i>重新生成</button>
            <a id="wxacodeDownload" href="#" download class="hidden bg-green-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-green-600"><i class="fas fa-download mr-1"></i>下载</a>
            <button onclick="document.getElementById('wxacodeModal').classList.add('hidden');document.getElementById('wxacodeModal').classList.remove('flex')" class="bg-gray-100 px-4 py-2 rounded-lg text-sm hover:bg-gray-200">关闭</button>
        </div>
    </div>
</div>

<style>
    .bg-dots {
        background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
        background-size: 20px 20px;
    }

    .hotspot-box {
        position: absolute;
        border: 2px solid #3b82f6;
        background-color: rgba(59, 130, 246, 0.2);
        cursor: pointer;
        transition: background-color 0.2s, border-color 0.2s;
        box-sizing: border-box;
    }

    .hotspot-box:hover {
        background-color: rgba(59, 130, 246, 0.4);
        z-index: 10;
    }

    .hotspot-box.active {
        border-color: #ef4444;
        background-color: rgba(239, 68, 68, 0.3);
        z-index: 20;
        cursor: move;
    }

    .hotspot-resize-handle {
        position: absolute;
        width: 10px;
        height: 10px;
        border: 2px solid #ffffff;
        background: #ef4444;
        border-radius: 999px;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.35);
        z-index: 25;
    }

    .hotspot-resize-handle.nw {
        left: -6px;
        top: -6px;
        cursor: nwse-resize;
    }

    .hotspot-resize-handle.n {
        left: 50%;
        top: -6px;
        transform: translateX(-50%);
        cursor: ns-resize;
    }

    .hotspot-resize-handle.ne {
        right: -6px;
        top: -6px;
        cursor: nesw-resize;
    }

    .hotspot-resize-handle.e {
        right: -6px;
        top: 50%;
        transform: translateY(-50%);
        cursor: ew-resize;
    }

    .hotspot-resize-handle.se {
        right: -6px;
        bottom: -6px;
        cursor: nwse-resize;
    }

    .hotspot-resize-handle.s {
        left: 50%;
        bottom: -6px;
        transform: translateX(-50%);
        cursor: ns-resize;
    }

    .hotspot-resize-handle.sw {
        left: -6px;
        bottom: -6px;
        cursor: nesw-resize;
    }

    .hotspot-resize-handle.w {
        left: -6px;
        top: 50%;
        transform: translateY(-50%);
        cursor: ew-resize;
    }

    #hotspotLayer.draw-mode {
        cursor: crosshair;
    }

    #hotspotLayer.draw-mode .hotspot-box {
        pointer-events: none;
    }

    .hotspot-preview {
        position: absolute;
        border: 2px dashed #22c55e;
        background: rgba(34, 197, 94, 0.16);
        pointer-events: none;
        z-index: 30;
    }
</style>

<script>
    // Init Data
    const sceneId = document.getElementById('sceneId').value;
    const initialCategoryId = "<%= typeof scene !== 'undefined' ? scene.category_id : '' %>";
    let hotspots = []; // { id, word_id, custom_label, rect: {x,y,w,h} (percent), audio_url }
    let drawModeEnabled = false;
    let isDrawingHotspot = false;
    let drawStartPoint = null;
    let drawPreviewEl = null;
    let activeHotspotIndex = -1;
    let posterAdjustPreviewTimer = null;
    let posterAdjustPreviewRequestId = 0;
    let hotspotAdjustState = null;
    const MIN_HOTSPOT_SIZE = 1;

    async function fetchH5SceneReaderUrl() {
        if (!sceneId) throw new Error('请先保存场景');
        const res = await fetch(`${API_BASE}/scenes/${sceneId}/h5-link`);
        const result = await res.json();
        if (!result.success || !result.data?.path) {
            throw new Error(result.message || '生成H5链接失败');
        }
        return new URL(result.data.path, window.location.origin).href;
    }

    async function openH5SceneReader() {
        if (!sceneId) return showToast('请先保存场景', 'error');
        try {
            const url = await fetchH5SceneReaderUrl();
            window.open(url, '_blank', 'noopener');
        } catch (e) {
            showToast(e.message || '打开H5失败', 'error');
        }
    }

    async function copyH5SceneReaderLink() {
        if (!sceneId) return showToast('请先保存场景', 'error');
        try {
            const url = await fetchH5SceneReaderUrl();
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(url);
            } else {
                const input = document.createElement('input');
                input.value = url;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                input.remove();
            }
            showToast('H5 点读链接已复制');
        } catch (e) {
            showToast('复制失败，请手动复制链接', 'error');
        }
    }

    let sceneReadingVideoPollTimer = null;

    function setSceneReadingVideoButtonBusy(isBusy) {
        const btn = document.getElementById('sceneReadingVideoBtn');
        if (btn) {
            btn.disabled = !!isBusy;
            btn.classList.toggle('opacity-60', !!isBusy);
            btn.classList.toggle('cursor-not-allowed', !!isBusy);
        }
        const chineseToggle = document.getElementById('sceneReadingVideoChineseToggle');
        if (chineseToggle) chineseToggle.disabled = !!isBusy;
    }

    function renderSceneReadingVideoStatus(job) {
        const box = document.getElementById('sceneReadingVideoStatus');
        if (!box) return;
        if (!job) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }

        box.classList.remove('hidden');
        const statusMap = {
            pending: '排队中',
            processing: `生成中 ${Number(job.progress || 0)}%`,
            done: '已完成',
            failed: '失败'
        };
        const statusText = statusMap[job.status] || job.status || '未知';
        const actions = job.status === 'done' && job.video_url
            ? `<a href="${job.video_url}" target="_blank" class="ml-3 text-green-700 underline">预览</a>
               <a href="${job.video_url}" download class="ml-2 text-green-700 underline">下载</a>`
            : '';
        const error = job.status === 'failed' && job.error_message
            ? `<span class="ml-3 text-red-600">${job.error_message}</span>`
            : '';
        box.innerHTML = `<i class="fas fa-video mr-1"></i> 点读视频：${statusText}${actions}${error}`;
    }

    async function loadSceneReadingVideoStatus({ silent = true } = {}) {
        if (!sceneId) return null;
        try {
            const res = await fetch(`${API_BASE}/scenes/${sceneId}/reading-video/status`);
            const result = await res.json();
            if (!result.success) throw new Error(result.message || '查询点读视频失败');
            renderSceneReadingVideoStatus(result.data);
            const active = result.data && ['pending', 'processing'].includes(result.data.status);
            setSceneReadingVideoButtonBusy(active);
            if (active) startSceneReadingVideoPolling();
            return result.data;
        } catch (e) {
            if (!silent) showToast(e.message || '查询点读视频失败', 'error');
            return null;
        }
    }

    function startSceneReadingVideoPolling() {
        if (sceneReadingVideoPollTimer) return;
        sceneReadingVideoPollTimer = setInterval(async () => {
            const job = await loadSceneReadingVideoStatus({ silent: true });
            if (!job || !['pending', 'processing'].includes(job.status)) {
                clearInterval(sceneReadingVideoPollTimer);
                sceneReadingVideoPollTimer = null;
                setSceneReadingVideoButtonBusy(false);
            }
        }, 5000);
    }

    async function generateSceneReadingVideo() {
        if (!sceneId) return showToast('请先保存场景', 'error');
        const includeChinese = document.getElementById('sceneReadingVideoChineseToggle')?.checked !== false;
        const flowText = includeChinese
            ? '播放顺序：中文词义 → 英文女声 → 英文男声 → 下一个。'
            : '播放顺序：英文女声 → 英文男声 → 下一个，底部不显示中文。';
        if (!confirm(`生成场景自动点读视频？${flowText}`)) return;
        setSceneReadingVideoButtonBusy(true);
        try {
            const saved = await saveSceneData({ silent: true, reloadAfterSave: true });
            if (!saved.success) throw new Error(saved.message || '保存场景失败');

            const res = await fetch(`${API_BASE}/scenes/${sceneId}/reading-video/generate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ includeChinese })
            });
            const result = await res.json();
            if (!result.success) throw new Error(result.message || '创建点读视频任务失败');
            showToast('点读视频任务已创建');
            await loadSceneReadingVideoStatus({ silent: false });
            startSceneReadingVideoPolling();
        } catch (e) {
            setSceneReadingVideoButtonBusy(false);
            showToast(e.message || '创建点读视频任务失败', 'error');
        }
    }

    // --- AI Style & Prompt Builder ---

    let currentAiStyle = 'poster'; // 'poster' | 'scene' | 'custom'

    function getPosterAdjustmentStorageKey() {
        return `scenePosterTemplateAdjustments:${sceneId || initialCategoryId || 'default'}`;
    }

    function getPosterTemplateAdjustmentInputs() {
        return {
            top: document.getElementById('posterAdjustTop'),
            bottom: document.getElementById('posterAdjustBottom'),
            left: document.getElementById('posterAdjustLeft'),
            right: document.getElementById('posterAdjustRight'),
            cardWidth: document.getElementById('posterAdjustCardWidth'),
            cardHeight: document.getElementById('posterAdjustCardHeight'),
            gapX: document.getElementById('posterAdjustGapX'),
            gapY: document.getElementById('posterAdjustGapY')
        };
    }

    function getPosterTemplateAdjustments() {
        const inputs = getPosterTemplateAdjustmentInputs();
        return {
            topPct: Number(inputs.top?.value || 0),
            bottomPct: Number(inputs.bottom?.value || 0),
            leftPct: Number(inputs.left?.value || 0),
            rightPct: Number(inputs.right?.value || 0),
            cardWidthPct: Number(inputs.cardWidth?.value || 0),
            cardHeightPct: Number(inputs.cardHeight?.value || 0),
            gapXPct: Number(inputs.gapX?.value || 0),
            gapYPct: Number(inputs.gapY?.value || 0)
        };
    }

    function setPosterTemplateAdjustments(values = {}) {
        const inputs = getPosterTemplateAdjustmentInputs();
        if (inputs.top) inputs.top.value = Number(values.topPct || 0);
        if (inputs.bottom) inputs.bottom.value = Number(values.bottomPct || 0);
        if (inputs.left) inputs.left.value = Number(values.leftPct || 0);
        if (inputs.right) inputs.right.value = Number(values.rightPct || 0);
        if (inputs.cardWidth) inputs.cardWidth.value = Number(values.cardWidthPct || 0);
        if (inputs.cardHeight) inputs.cardHeight.value = Number(values.cardHeightPct || 0);
        if (inputs.gapX) inputs.gapX.value = Number(values.gapXPct || 0);
        if (inputs.gapY) inputs.gapY.value = Number(values.gapYPct || 0);
    }

    function persistPosterTemplateAdjustments() {
        try {
            localStorage.setItem(getPosterAdjustmentStorageKey(), JSON.stringify(getPosterTemplateAdjustments()));
        } catch (e) {
            console.warn('[PosterTemplateAdjustments] save failed:', e.message);
        }
        schedulePosterTemplatePreview();
    }

    function loadPosterTemplateAdjustments() {
        try {
            const raw = localStorage.getItem(getPosterAdjustmentStorageKey());
            if (!raw) return;
            const parsed = JSON.parse(raw);
            setPosterTemplateAdjustments(parsed);
        } catch (e) {
            console.warn('[PosterTemplateAdjustments] load failed:', e.message);
        }
    }

    function resetPosterTemplateAdjustments() {
        setPosterTemplateAdjustments({
            topPct: 0,
            bottomPct: 0,
            leftPct: 0,
            rightPct: 0,
            cardWidthPct: 0,
            cardHeightPct: 0,
            gapXPct: 0,
            gapYPct: 0
        });
        persistPosterTemplateAdjustments();
        showToast('模板微调已重置为 0', 'info');
    }

    function togglePosterAdjustPanel() {
        const panel = document.getElementById('posterAdjustPanel');
        if (!panel) return;
        panel.classList.toggle('hidden');
    }

    function schedulePosterTemplatePreview() {
        if (currentAiStyle !== 'poster' && currentAiStyle !== 'custom') return;
        if (!hotspots.length) return;
        if (posterAdjustPreviewTimer) clearTimeout(posterAdjustPreviewTimer);
        posterAdjustPreviewTimer = setTimeout(() => {
            previewPosterTemplateAdjustments();
        }, 180);
    }

    async function previewPosterTemplateAdjustments() {
        const imageUrl = document.getElementById('image_url').value;
        if (!imageUrl || (currentAiStyle !== 'poster' && currentAiStyle !== 'custom') || !hotspots.length) return;

        const categoryItems = getSelectedCategoryItems();
        const expectedCount = Math.max(categoryItems.length, hotspots.length, 1);
        const requestId = ++posterAdjustPreviewRequestId;
        const previousHotspots = hotspots.map((h) => ({
            ...h,
            rect: { ...h.rect }
        }));
        const previousActiveIndex = activeHotspotIndex;

        try {
            const res = await fetch(`${API_BASE}/scenes/detect-cards`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    imageUrl,
                    expectedColumns: 4,
                    expectedCount,
                    layoutMode: 'poster_template',
                    layoutAdjustments: getPosterTemplateAdjustments()
                })
            });
            const data = await res.json();
            if (requestId !== posterAdjustPreviewRequestId) return;
            if (!data.success || !data.data || !Array.isArray(data.data.cards) || !data.data.cards.length) {
                return;
            }

            const cards = data.data.cards;
            hotspots = cards.map((card, index) => {
                const existing = previousHotspots[index];
                return {
                    ...(existing || {}),
                    id: existing?.id || (Date.now() + Math.random() + index),
                    custom_label: existing?.custom_label || categoryItems[index] || '',
                    rect: card.rect
                };
            });

            if (previousActiveIndex >= 0 && previousActiveIndex < hotspots.length) {
                activeHotspotIndex = previousActiveIndex;
            } else if (hotspots.length) {
                activeHotspotIndex = 0;
            } else {
                activeHotspotIndex = -1;
            }

            renderHotspots();
            renderHotspotList();
        } catch (e) {
            console.warn('[PosterTemplatePreview] failed:', e.message);
        }
    }

