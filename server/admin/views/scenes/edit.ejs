        const formData = new FormData();
        formData.append('image', input.files[0]);

        try {
            showToast('上传中...', 'info');
            const res = await fetch(`${API_BASE}/scenes/upload`, { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                updateMainImage(data.url);
                const meta = data.data || {};
                if (meta.compressed && meta.original_size && meta.size) {
                    const fromKb = Math.round(meta.original_size / 1024);
                    const toKb = Math.round(meta.size / 1024);
                    showToast(`上传成功，已压缩 ${fromKb}KB → ${toKb}KB`);
                } else {
                    showToast('上传成功');
                }
            } else {
                showToast(data.message, 'error');
            }
        } catch (e) {
            showToast('上传出错', 'error');
        }
