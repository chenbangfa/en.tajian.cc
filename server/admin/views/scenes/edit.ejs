    // OCR Logic
    async function smartOCR() {
        const imageUrl = document.getElementById('image_url').value;
        const engine = document.getElementById('ocrEngine').value;

        if (!imageUrl) return showToast('无图片', 'error');

        try {
            showToast('正在识别...', 'info');
            console.log(`[OCR] Sending request to ${engine}, image: ${imageUrl}`);

            const res = await fetch(`${API_BASE}/scenes/ocr`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ imageUrl, engine })
            });
            const data = await res.json();
            console.log('[OCR] Response:', data);

            if (data.success) {
                // Merge new hotspots
                const startIndex = hotspots.length;
                data.words.forEach(w => {
                    const hotspot = {
                        id: Date.now() + Math.random(),
                        custom_label: w.text,
                        rect: w.rect // {x, y, w, h} in %
                    };
                    hotspots.push(hotspot);
                });
                renderHotspots();
                renderHotspotList();
                const targetIndex = data.words.length > 0 ? startIndex : -1;
                if (sceneId) {
                    const saved = await saveSceneData({ silent: true, reloadAfterSave: true });
                    if (saved.success) {
                        if (targetIndex >= 0 && targetIndex < hotspots.length) {
                            selectHotspot(targetIndex, true);
                        }
                        showToast(`识别成功，找到 ${data.words.length} 个文本，已自动保存`);
                    } else {
                        showToast(`识别成功，找到 ${data.words.length} 个文本，但自动保存失败`, 'error');
                    }
                } else {
                    if (targetIndex >= 0) {
                        selectHotspot(targetIndex, true);
                    }
                    showToast(`识别成功，找到 ${data.words.length} 个文本，请点击保存全部`);
                }
            } else {
                showToast(data.message || data.error || '识别失败', 'error');
            }
        } catch (e) {
            console.error('[OCR] Error:', e);
            showToast('请求出错: ' + e.message, 'error');
        }
    }

    function getSelectedCategoryItems() {
        const select = document.getElementById('categorySelect');
        const opt = select.options[select.selectedIndex];
        if (!opt) return [];
        const itemsStr = opt.getAttribute('data-items') || '';
        return itemsStr
            .split(',')
            .map(item => item.trim())
            .filter(Boolean);
    }

    function getNextFocusIndex(preferredLabelsCount = 0) {
        if (!hotspots.length) return -1;
        if (preferredLabelsCount > 0 && hotspots.length > preferredLabelsCount) {
            return preferredLabelsCount;
        }
        const blankIndex = hotspots.findIndex(h => !String(h.custom_label || '').trim());
        return blankIndex >= 0 ? blankIndex : 0;
    }

    async function autoDetectCards() {
        const imageUrl = document.getElementById('image_url').value;
        if (!imageUrl) return showToast('请先上传或生成图片', 'error');

        const categoryItems = getSelectedCategoryItems();
        const expectedCount = Math.max(categoryItems.length, 1);

        if (hotspots.length > 0) {
            const shouldReplace = confirm('当前已有标注。是否清空现有标注并按卡片自动识别？');
            if (!shouldReplace) return;
        }

        try {
            const usePosterTemplate = currentAiStyle === 'poster' || currentAiStyle === 'custom';
            showToast(usePosterTemplate ? '正在按海报模板识别卡片边框...' : '正在识别卡片边框...', 'info');
            const res = await fetch(`${API_BASE}/scenes/detect-cards`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    imageUrl,
                    expectedColumns: 4,
                    expectedCount,
                    layoutMode: usePosterTemplate ? 'poster_template' : 'projection_only',
                    layoutAdjustments: usePosterTemplate ? getPosterTemplateAdjustments() : null
                })
            });
            const data = await res.json();

            if (!data.success) {
                return showToast(data.message || '卡片识别失败', 'error');
            }

            const cards = (data.data && data.data.cards) || [];
            if (!cards.length) {
                return showToast('没有识别到可用卡片，请继续手动框选', 'error');
            }

            const engineLabel = {
                'projection-valley': '投影兜底',
                'poster_template': '模板'
            }[data.data.engine] || '识别';

            hotspots = cards.map((card, index) => ({
                id: Date.now() + Math.random() + index,
                custom_label: categoryItems[index] || '',
                rect: card.rect
            }));

            activeHotspotIndex = -1;
            renderHotspots();
            renderHotspotList();

            const focusIndex = getNextFocusIndex(categoryItems.length);

            const autoFilledCount = Math.min(categoryItems.length, hotspots.length);
            const remainingCount = Math.max(0, hotspots.length - autoFilledCount);

            if (sceneId) {
                const saved = await saveSceneData({ silent: true, reloadAfterSave: true });
                if (saved.success) {
                    if (focusIndex >= 0 && focusIndex < hotspots.length) {
                        selectHotspot(focusIndex, true);
                    }
                    showToast(`${engineLabel}识别到 ${hotspots.length} 个卡片，已自动预填 ${autoFilledCount} 个标签并保存${remainingCount > 0 ? `，剩余 ${remainingCount} 个待确认` : ''}`);
                } else {
                    showToast(`${engineLabel}识别到 ${hotspots.length} 个卡片，已自动预填 ${autoFilledCount} 个标签，但自动保存失败`, 'error');
                }
            } else {
                if (focusIndex >= 0) {
                    selectHotspot(focusIndex, true);
                }
                showToast(`${engineLabel}识别到 ${hotspots.length} 个卡片，已自动预填 ${autoFilledCount} 个标签${remainingCount > 0 ? `，剩余 ${remainingCount} 个待确认` : ''}，请点击保存全部`);
            }
        } catch (e) {
            console.error('[CardDetect] Error:', e);
            showToast('卡片识别请求失败: ' + e.message, 'error');
        }
    }

    function selectHotspot(index, focusInput = false) {
        if (index < 0 || index >= hotspots.length) return;
        activeHotspotIndex = index;
        renderHotspots();
        renderHotspotList();

        const item = document.getElementById(`hotspot-item-${index}`);
        if (item) {
            item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        if (focusInput) {
            setTimeout(() => {
                const input = document.getElementById(`hotspot-label-${index}`);
                if (input) {
                    input.focus();
                    input.select();
                }
            }, 0);
        }
    }

    function renderHotspots() {
        const layer = document.getElementById('hotspotLayer');
        layer.innerHTML = '';
        if (drawModeEnabled) layer.classList.add('draw-mode');

        hotspots.forEach((h, index) => {
            h.rect = roundRect(h.rect);
            const div = document.createElement('div');
            div.id = `hotspot-box-${index}`;
            div.className = `hotspot-box${index === activeHotspotIndex ? ' active' : ''}`;
            div.style.left = h.rect.x + '%';
            div.style.top = h.rect.y + '%';
            div.style.width = h.rect.w + '%';
            div.style.height = h.rect.h + '%';
            div.title = h.custom_label || `热点 ${index + 1}`;
            div.onmousedown = (e) => startHotspotAdjust(e, index, 'move');
            div.onclick = (e) => {
                e.stopPropagation();
                selectHotspot(index, true);
            };

            if (index === activeHotspotIndex && !drawModeEnabled) {
                ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'].forEach((handle) => {
                    const handleEl = document.createElement('div');
                    handleEl.className = `hotspot-resize-handle ${handle}`;
                    handleEl.title = '拖动调整大小';
                    handleEl.onmousedown = (e) => startHotspotAdjust(e, index, 'resize', handle);
                    div.appendChild(handleEl);
                });
            }

            layer.appendChild(div);
        });
        document.getElementById('hotspotCount').innerText = hotspots.length;
    }

    function renderHotspotList() {
        const list = document.getElementById('hotspotList');
        const escapeAttr = (v) => String(v || '')
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        const jsString = (v) => escapeAttr(JSON.stringify(String(v || '')));
        list.innerHTML = hotspots.map((h, i) => `
            <div id="hotspot-item-${i}" onclick="selectHotspot(${i}, true)"
                class="bg-gray-50 px-2.5 py-2 rounded-lg border transition-colors group cursor-pointer ${i === activeHotspotIndex ? 'border-blue-400 bg-blue-50/70 shadow-sm' : 'border-gray-200 hover:border-blue-300'}">
                <div class="flex items-center gap-2">
                    <span class="text-[10px] text-gray-400 w-4 shrink-0">${i + 1}</span>
                    <input id="hotspot-label-${i}" type="text" value="${escapeAttr(h.custom_label)}" onchange="updateLabel(${i}, this.value)"
                        onclick="event.stopPropagation()"
                        class="bg-transparent border-none outline-none font-medium text-gray-700 flex-1 text-sm min-w-0"
                        placeholder="标签">
                    <div class="flex items-center gap-2.5 shrink-0 ml-1">
                        ${h.translation ? '<i class="fas fa-check-circle text-green-500 text-xs" title="已翻译"></i>' : ''}
                        ${h.audio_url_female ? `
                            <button type="button" onclick="event.preventDefault();event.stopPropagation();playAudio(${jsString(h.audio_url_female)})" class="text-blue-500 hover:text-blue-700 p-0.5" title="播放英文女声">
                                <i class="fas fa-volume-up text-xs"></i>
                            </button>
                        ` : ''}
                        ${h.translation_audio_url ? `
                            <button type="button" onclick="event.preventDefault();event.stopPropagation();playAudio(${jsString(h.translation_audio_url)})" class="text-emerald-500 hover:text-emerald-700 p-0.5" title="播放中文释义">
                                <i class="fas fa-volume-down text-xs"></i>
                            </button>
                        ` : ''}
                        ${h.id ? `
                            <button type="button" onclick="event.preventDefault();event.stopPropagation();generateChineseAudio(${h.id}, ${i})" class="text-orange-500 hover:text-orange-700 p-0.5" title="${h.translation_audio_url ? '重新生成中文音频' : '生成中文音频'}">
                                <i class="fas fa-language text-xs"></i>
                            </button>
                        ` : ''}
                        ${h.id ? `
                            <button type="button" onclick="event.preventDefault();event.stopPropagation();generateHotspotAudio(${h.id}, ${i})" class="text-purple-500 hover:text-purple-700 p-0.5" title="生成音频">
                                <i class="fas fa-magic text-xs"></i>
                            </button>
                        ` : ''}
                        ${h.id ? `
                            <button type="button" onclick="event.preventDefault();event.stopPropagation();openEditFields(${i})" class="text-gray-400 hover:text-blue-600 p-0.5" title="编辑音标/翻译">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                        ` : ''}
                        <button type="button" onclick="event.preventDefault();event.stopPropagation();removeHotspot(${i})" class="text-gray-300 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity p-0.5" title="删除">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                </div>
                <div id="hotspot-display-${i}">
                    ${h.phonetic ? `<div class="text-[11px] text-gray-400 pl-6 cursor-pointer hover:text-blue-500" onclick="event.stopPropagation();openEditFields(${i})">/${h.phonetic}/</div>` : ''}
                    ${h.translation ? `<div class="text-[11px] text-gray-500 pl-6 cursor-pointer hover:text-blue-500" onclick="event.stopPropagation();openEditFields(${i})">${h.translation}</div>` : ''}
                </div>
                <div id="hotspot-edit-${i}" class="hidden pl-6 mt-1 space-y-1">
                    <input type="text" value="${(h.phonetic || '').replace(/"/g, '&quot;')}" placeholder="音标"
                        id="edit-phonetic-${i}"
                        onclick="event.stopPropagation()"
                        class="w-full text-[11px] px-2 py-1 border rounded bg-white focus:ring-1 focus:ring-blue-400 outline-none">
                    <input type="text" value="${(h.translation || '').replace(/"/g, '&quot;')}" placeholder="翻译"
                        id="edit-translation-${i}"
                        onclick="event.stopPropagation()"
                        class="w-full text-[11px] px-2 py-1 border rounded bg-white focus:ring-1 focus:ring-blue-400 outline-none">
                    <div class="flex gap-1.5 pt-0.5">
                        <button type="button" onclick="event.preventDefault();event.stopPropagation();saveEditFields(${i})" class="text-[10px] px-2 py-0.5 bg-blue-500 text-white rounded hover:bg-blue-600">保存</button>
                        <button type="button" onclick="event.preventDefault();event.stopPropagation();cancelEditFields(${i})" class="text-[10px] px-2 py-0.5 bg-gray-200 text-gray-600 rounded hover:bg-gray-300">取消</button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    // 编辑音标/翻译
    function openEditFields(index) {
        document.getElementById(`hotspot-display-${index}`).classList.add('hidden');
        document.getElementById(`hotspot-edit-${index}`).classList.remove('hidden');
    }

    function cancelEditFields(index) {
        document.getElementById(`hotspot-edit-${index}`).classList.add('hidden');
        document.getElementById(`hotspot-display-${index}`).classList.remove('hidden');
    }

    async function saveEditFields(index) {
        const h = hotspots[index];
        if (!h.id) { showToast('请先保存场景', 'error'); return; }

        const phonetic = document.getElementById(`edit-phonetic-${index}`).value.trim();
        const translation = document.getElementById(`edit-translation-${index}`).value.trim();

        try {
            const res = await fetch(`${API_BASE}/scenes/objects/${h.id}/update-fields`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phonetic, translation })
            });
            const data = await res.json();
            if (data.success) {
                hotspots[index].phonetic = phonetic;
                hotspots[index].translation = translation;
                hotspots[index].translation_audio_url = '';
                hotspots[index].translation_audio_text = '';
                renderHotspotList();
                showToast('已保存');
            } else {
                showToast(data.message || '保存失败', 'error');
            }
        } catch (e) {
            showToast('保存失败', 'error');
        }
    }

    // 播放音频预览
    let currentAudio = null;
    function playAudio(url) {
        if (!url) {
            showToast('暂无音频', 'error');
            return;
        }
        if (currentAudio) {
            currentAudio.pause();
        }
        currentAudio = new Audio(url);
        currentAudio.play().catch((error) => {
            console.warn('音频播放失败:', error);
            showToast('音频播放失败，请检查浏览器权限或文件地址', 'error');
        });
    }

    async function generateChineseAudio(objId, index) {
        const h = hotspots[index];
        if (!h || !h.id) { showToast('请先保存场景', 'error'); return; }
        if (!String(h.translation || '').trim()) {
            showToast('请先填写中文翻译', 'error');
            openEditFields(index);
            return;
        }

        try {
            showToast('正在生成中文发音...', 'info');
            const res = await fetch(`${API_BASE}/scenes/objects/${objId}/chinese-audio`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ force: true })
            });
            const data = await res.json();
            if (data.success) {
                hotspots[index].translation_audio_url = data.data.translation_audio_url || '';
                hotspots[index].translation_audio_text = data.data.translation_audio_text || h.translation;
                renderHotspotList();
                showToast('中文发音已生成');
                if (hotspots[index].translation_audio_url) {
                    playAudio(hotspots[index].translation_audio_url);
                }
            } else {
                showToast(data.message || '中文发音生成失败', 'error');
            }
        } catch (e) {
            console.error(e);
            showToast('中文发音生成失败: ' + e.message, 'error');
        }
    }

    // 生成热点音频和翻译
    // 保存单个热点标签（自动保存文本变更）
    async function saveHotspotLabel(objId, newLabel) {
        try {
            await fetch(`${API_BASE}/scenes/objects/${objId}/update-label`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ custom_label: newLabel })
            });
            return true;
        } catch (e) {
            console.error('保存标签失败:', e);
            return false;
        }
    }

    // 生成热点音频和翻译（先保存标签再生成）
    async function generateHotspotAudio(objId, index) {
        try {
            const labelInput = document.getElementById(`hotspot-label-${index}`);
            const currentLabel = (labelInput ? labelInput.value : hotspots[index].custom_label || '').trim();
            if (!currentLabel) {
                showToast('请先填写单词', 'error');
                if (labelInput) labelInput.focus();
                return;
            }
            hotspots[index].custom_label = currentLabel;
            showToast('正在按当前单词重新生成...', 'info');

            // 先保存标签变更
            const labelSaved = await saveHotspotLabel(objId, currentLabel);
            if (!labelSaved) {
                showToast('保存单词失败，请稍后重试', 'error');
                return;
            }

            // 单个“生成音频”按钮用于修正 OCR/识别错误，必须按当前单词强制刷新旧音标、翻译和音频。
            const res = await fetch(`${API_BASE}/scenes/objects/${objId}/generate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ force: true, custom_label: currentLabel })
            });
            const data = await res.json();

            if (data.success) {
                // 更新本地数据
                hotspots[index].phonetic = data.data.phonetic;
                hotspots[index].translation = data.data.translation;
                hotspots[index].audio_url_male = data.data.audio_url_male;
                hotspots[index].audio_url_female = data.data.audio_url_female;
                hotspots[index].translation_audio_url = '';
                hotspots[index].translation_audio_text = '';
                renderHotspotList();
                showToast('生成成功！');
            } else {
                showToast(data.message || '生成失败', 'error');
            }
        } catch (e) {
            console.error(e);
            showToast('生成失败: ' + e.message, 'error');
        }
    }

    // 批量生成全部热点
    async function batchGenerateAll() {
        const hotspotsWithId = hotspots.filter(h => h.id);
        if (hotspotsWithId.length === 0) {
            showToast('请先保存场景后再批量生成', 'error');
            return;
        }

        if (!confirm(`将批量生成 ${hotspotsWithId.length} 个热点的音标、翻译和音频，是否继续？`)) {
            return;
        }

        showToast(`开始批量生成 ${hotspotsWithId.length} 个热点...`, 'info');

        let successCount = 0;
        let failCount = 0;

        for (let i = 0; i < hotspots.length; i++) {
            const h = hotspots[i];
            if (!h.id) continue;

            try {
                // 保存并生成
                await saveHotspotLabel(h.id, h.custom_label);

                const res = await fetch(`${API_BASE}/scenes/objects/${h.id}/generate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    hotspots[i].phonetic = data.data.phonetic;
                    hotspots[i].translation = data.data.translation;
                    hotspots[i].audio_url_male = data.data.audio_url_male;
                    hotspots[i].audio_url_female = data.data.audio_url_female;
                    hotspots[i].translation_audio_url = '';
                    hotspots[i].translation_audio_text = '';
                    successCount++;
                } else {
                    failCount++;
                }
            } catch (e) {
                failCount++;
            }

            // 更新进度
            renderHotspotList();
        }

        if (sceneId) {
            const saved = await saveSceneData({ silent: true, reloadAfterSave: true });
            if (saved.success) {
                showToast(`批量生成完成: 成功 ${successCount} 个, 失败 ${failCount} 个，已自动保存`);
            } else {
                showToast(`批量生成完成: 成功 ${successCount} 个, 失败 ${failCount} 个，但自动保存失败`, 'error');
            }
        } else {
            showToast(`批量生成完成: 成功 ${successCount} 个, 失败 ${failCount} 个，请点击保存全部`);
        }
    }

    function updateLabel(index, val) {
        hotspots[index].custom_label = val;
    }

    function removeHotspot(index) {
        hotspots.splice(index, 1);
        if (activeHotspotIndex >= hotspots.length) {
            activeHotspotIndex = hotspots.length - 1;
        }
        renderHotspots();
        renderHotspotList();
    }

    function clearAllHotspots() {
        if (confirm('清空所有标注？')) {
            hotspots = [];
            activeHotspotIndex = -1;
            renderHotspots();
            renderHotspotList();
        }
    }

    function mapObjectRowToHotspot(o) {
        return {
            id: o.id,
            custom_label: o.custom_label,
            phonetic: o.phonetic || '',
            translation: o.translation || '',
            audio_url_male: o.audio_url_male || '',
            audio_url_female: o.audio_url_female || '',
            translation_audio_url: o.translation_audio_url || '',
            translation_audio_text: o.translation_audio_text || '',
            rect: roundRect({
                x: o.position_x,
                y: o.position_y,
                w: o.label_width,
                h: o.label_height
            })
        };
    }

    async function reloadHotspotsFromServer() {
        if (!sceneId) return;
        const objRes = await fetch(`${API_BASE}/scenes/${sceneId}/objects`);
        const objData = await objRes.json();
        if (objData.success) {
            hotspots = objData.data.map(mapObjectRowToHotspot);
            activeHotspotIndex = hotspots.length ? 0 : -1;
            renderHotspots();
            renderHotspotList();
        }
    }

    function buildScenePayloadFromForm() {
        const form = document.getElementById('sceneForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.objects = hotspots.map(h => {
            const rect = roundRect(h.rect);
            return {
                id: Number.isInteger(h.id) && h.id > 0 ? h.id : undefined,
                custom_label: h.custom_label,
                position_x: rect.x,
                position_y: rect.y,
                label_width: rect.w,
                label_height: rect.h
            };
        });
        return data;
    }

    let saveInFlight = null;
    async function saveSceneData({ silent = false, reloadAfterSave = true } = {}) {
        if (saveInFlight) return saveInFlight;

        const data = buildScenePayloadFromForm();
        const method = sceneId ? 'PUT' : 'POST';
        const url = sceneId ? `${API_BASE}/scenes/${sceneId}` : `${API_BASE}/scenes`;

        saveInFlight = (async () => {
            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (!result.success) {
                    if (!silent) showToast(result.message || '保存失败', 'error');
                    return { success: false, message: result.message || '保存失败' };
                }

                if (!sceneId && result.id) {
                    if (!silent) showToast('保存成功');
                    setTimeout(() => { location.href = '/scenes/edit/' + result.id; }, 1000);
                    return { success: true, createdId: result.id };
                }

                if (sceneId && reloadAfterSave) {
                    await reloadHotspotsFromServer();
                }

                if (!silent) showToast('保存成功');
                return { success: true };
            } catch (err) {
                if (!silent) showToast('保存失败', 'error');
                return { success: false, message: err.message || '保存失败' };
            } finally {
                saveInFlight = null;
            }
        })();

        return saveInFlight;
    }

    function applyCategoryPromptFromSelection({ forcePrompt = false } = {}) {
        const select = document.getElementById('categorySelect');
        const opt = select.options[select.selectedIndex];
        if (!opt) return false;

        const items = opt.getAttribute('data-items');
        const optionNameEn = opt.getAttribute('data-name-en');
        const optionNameCn = opt.getAttribute('data-name');
        const parentName = opt.getAttribute('data-parent-name') || '';
        if (!items || !items.trim()) return false;

        const nameInput = document.querySelector('input[name="name"]');
        const nameEnInput = document.querySelector('input[name="name_en"]');
        if (!nameInput.value) nameInput.value = optionNameCn || '';
        if (!nameEnInput.value) nameEnInput.value = optionNameEn || '';
        const nameCn = nameInput.value.trim() || optionNameCn || optionNameEn;
        const nameEn = nameEnInput.value.trim() || optionNameEn || '';

        const promptInput = document.getElementById('aiPrompt');
        if (forcePrompt || !promptInput.value.trim()) {
            if (currentAiStyle === 'poster') {
                promptInput.value = buildPosterPrompt(nameCn || nameEn, nameEn, items, parentName);
            } else if (currentAiStyle === 'scene') {
                promptInput.value = buildSceneExplorePrompt(nameEn || nameCn, items, { includeChinese: shouldSceneShowChineseLabels() });
            } else if (currentAiStyle === 'custom') {
                promptInput.value = buildPosterPrompt(nameCn || nameEn, nameEn, items, parentName, { includeChinese: true });
            }
        }
        return true;
    }

    // --- Init & Load ---

    (async function init() {
        // Load Categories
        const res = await fetch(`${API_BASE}/scene_categories`);
        const catData = await res.json();
        const select = document.getElementById('categorySelect');
        catData.data.forEach(c => {
            select.innerHTML += `<option value="${c.id}" ${c.id == initialCategoryId ? 'selected' : ''}>${c.name}</option>`;
            if (c.children) {
                c.children.forEach(sub => {
                    select.innerHTML += `<option value="${sub.id}" ${sub.id == initialCategoryId ? 'selected' : ''} data-items="${(sub.items || '').replace(/"/g, '&quot;')}" data-name="${sub.name}" data-name-en="${sub.name_en || ''}" data-parent-name="${c.name}" data-parent-name-en="${c.name_en || ''}">&nbsp;&nbsp;${sub.name}</option>`;
                });
            }
        });

        // 监听分类选择变化，自动填充 AI 提示词
        select.addEventListener('change', function() {
            const ok = applyCategoryPromptFromSelection({ forcePrompt: true });
            if (ok) switchImageTab('ai');
        });

        // Edit 模式：默认 AI tab + 英文海报风格
        if (sceneId) {
            switchImageTab('ai');
            switchAiStyle('poster');
        }

        loadPosterTemplateAdjustments();
        syncPosterAdjustVisibility();
        syncSceneLabelOptionsVisibility();

        // Load Scene Objects if Edit Mode
        if (sceneId) {
            await reloadHotspotsFromServer();
            await loadSceneReadingVideoStatus({ silent: true });
        }

        // 恢复主图显示
        updateMainImage(document.getElementById('image_url').value);

        // 手动框选热点事件
        const layer = document.getElementById('hotspotLayer');
        layer.addEventListener('mousedown', onLayerMouseDown);
        layer.addEventListener('mousemove', onLayerMouseMove);
        layer.addEventListener('mouseup', onLayerMouseUp);
        layer.addEventListener('mouseleave', onLayerMouseUp);
        document.addEventListener('mousemove', onHotspotAdjustMove);
        document.addEventListener('mouseup', onHotspotAdjustEnd);
        setDrawMode(false);
    })();

    // Save Form
    document.getElementById('sceneForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        await saveSceneData({ silent: false, reloadAfterSave: !!sceneId });
    });

</script>
