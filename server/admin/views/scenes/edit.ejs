    function applyPosterPromptFromSelection() {
        const select = document.getElementById('categorySelect');
        const opt = select.options[select.selectedIndex];
        if (!opt) return;
        const items = opt.getAttribute('data-items');
        const optionNameEn = opt.getAttribute('data-name-en');
        const optionNameCn = opt.getAttribute('data-name');
        const parentName = opt.getAttribute('data-parent-name') || '';
        const inputNameCn = document.querySelector('input[name="name"]').value.trim();
        const inputNameEn = document.querySelector('input[name="name_en"]').value.trim();
        const nameCn = inputNameCn || optionNameCn || optionNameEn;
        const nameEn = inputNameEn || optionNameEn || '';
        if (!items || !items.trim()) {
            document.getElementById('aiPrompt').value = '';
            document.getElementById('aiPrompt').placeholder = '请先选择一个有物品列表的分类';
            return;
        }
        document.getElementById('aiPrompt').value = buildPosterPrompt(nameCn || nameEn, nameEn, items, parentName);
    }

    function buildSceneExplorePrompt(theme, itemsStr, options = {}) {
        const includeChinese = options.includeChinese === true;
        const items = itemsStr.split(',').map(s => s.trim()).filter(Boolean).map(item => toTitleCase(item));
        if (!items.length) return '';
        const itemList = items.join(', ');
        const labelContentRule = includeChinese
            ? `Each label must contain three lines in this order: simplified Chinese meaning, English word, IPA phonetic transcription. Example label format: 苹果 / Apple / /ˈæpəl/.`
            : `Each label must contain two lines in this order: English word, IPA phonetic transcription. Example label format: Apple / /ˈæpəl/. Do not include Chinese text.`;

        return `LABELED_SCENE_PROMPT
Create a colorful, cheerful ${theme} scene for children's English learning, square 1:1 composition.

The scene must naturally contain these objects: ${itemList}.

Core goal:
- This is not a plain illustration. It must be a labeled learning scene.
- Every listed object should be clearly visible in the scene and should be labeled once.
- Place labels in nearby blank or low-detail areas around the scene, not directly covering important objects.
- Use thin, clean leader lines to connect each label to the exact object it names.
- The end point of each leader line must touch or clearly enter the correct object area, not a neighboring object.
- Before drawing each label, semantically verify the object: the label text, the line endpoint, and the visual object must all match.
- Leader lines should be subtle, tidy, and easy to follow. Avoid crossing too many lines.

Label content:
- ${labelContentRule}
- Use clean rounded white label boxes with soft shadow or light outline.
- Text must be large, crisp, correctly spelled, and easy for children to read.
- IPA should be accurate and use slash notation, for example /ˈæpəl/.
- Do not invent extra labels for objects not in the list.
- Do not swap labels between visually close objects. If two objects overlap, place the label closer to the correct object and point the line to the center or most recognizable part of that object.

Object matching precision:
- Cushion means a small soft pillow/throw pillow placed on a sofa, chair, or bed. It is not a blanket.
- Blanket means a larger soft cloth or throw draped over a sofa, chair, or bed, or folded as a textile. It is not a cushion.
- Rug means the large textile on the floor under or near furniture. It is not a blanket or cushion.
- Sofa means the large seating furniture itself, not cushions or blankets on top of it.
- Table means the furniture surface and legs, not the objects placed on the table.
- Book means a book/notebook object, not the table underneath it.
- If the scene contains confusing pairs such as cushion vs blanket, rug vs blanket, shelf vs book, or table vs book, label them farther apart and use shorter, clearer leader lines.

Visual style:
- Friendly, inviting children's educational illustration.
- Bright, warm color palette with soft lighting.
- Realistic enough for children to recognize real-life objects, but still cheerful and classroom-friendly.
- Keep the main scene natural and coherent, especially matching the theme "${theme}".
- Make all required objects distinct and recognizable.

Strict rules:
- No watermark, no logo, no signature.
- No messy collage, no random text, no spelling mistakes.
- Do not hide labels inside objects; labels should sit in blank space and connect with a line.
- Do not let a label line point to the wrong object, even if the wrong object is nearby or visually similar.
- Do not use a line endpoint that lands in empty space between two objects.
- Keep the layout clean and suitable for English beginners.`;
    }

    function buildPrimaryCategoryDescriptor(parentName, theme) {
        const raw = String(parentName || '').trim();
        if (!raw) return '日常生活物品';

        const exactMap = {
            '日常生活与场景类': '日常生活物品',
            '食物与饮食类': '食物类物品',
            '自然与动物类': '自然与动物类物品',
            '家庭与学校类': '家庭与学校类物品',
            '交通与城市类': '交通与城市类物品',
            '人体与健康类': '人体与健康类物品'
        };

        if (exactMap[raw]) return exactMap[raw];

        const cleaned = raw
            .replace(/与场景类$/, '')
            .replace(/类$/, '');
        return `${cleaned}物品`;
    }

    function buildTitleDecorationRule(parentName, themeCn = '', themeEn = '') {
        const parent = String(parentName || '').trim();
        const themeText = `${themeCn} ${themeEn}`.toLowerCase();

        if (/超市|购物|shopping|supermarket|market/.test(themeText)) {
            return '标题栏背景需要加入与超市购物相关的极简装饰元素，例如柔和的货架轮廓、价格签、小购物车、购物袋、叶片感点缀；保持极简、干净、轻装饰，不要喧宾夺主。';
        }

        if (/清洁|cleaning|suppl/.test(themeText)) {
            return '标题栏背景需要加入与清洁用品相关的极简装饰元素，例如轻微水滴、泡泡、柔和波纹、清洁工具剪影；保持清爽、留白充足、装饰很轻。';
        }

        if (/水果|fruit/.test(themeText)) {
            return '标题栏背景需要加入与水果相关的极简装饰元素，例如叶片、藤蔓、果实剪影、柔和的自然弧线；保持清新、自然、轻量。';
        }

        if (/蔬菜|vegetable/.test(themeText)) {
            return '标题栏背景需要加入与蔬菜相关的极简装饰元素，例如叶片、菜园感线条、蔬菜剪影、柔和自然纹理；保持清新、轻装饰。';
        }

        if (/文具|stationery|school supplies|school/.test(themeText)) {
            return '标题栏背景需要加入与文具学习相关的极简装饰元素，例如铅笔、尺子、纸张线条、小星点或学习感图形；保持简洁、整齐、有课堂感。';
        }

        const parentMap = {
            '日常生活与场景类': '标题栏背景需要根据日常生活场景加入少量极简装饰元素，例如柔和的物品轮廓、小叶片、轻弧线和生活化图形，保持干净高级。',
            '食物与饮食类': '标题栏背景需要根据食物与饮食主题加入少量极简装饰元素，例如叶片、果蔬剪影、柔和餐具轮廓和轻弧线，保持清新自然。',
            '自然与动物类': '标题栏背景需要根据自然与动物主题加入少量极简装饰元素，例如叶片、云朵、草叶、星点或动物剪影，保持自然轻盈。',
            '家庭与学校类': '标题栏背景需要根据家庭与学校主题加入少量极简装饰元素，例如纸张线条、家具轮廓、学习图形和轻弧线，保持整洁友好。',
            '交通与城市类': '标题栏背景需要根据交通与城市主题加入少量极简装饰元素，例如道路线条、路牌、建筑轮廓或交通图形，保持有秩序感。',
            '人体与健康类': '标题栏背景需要根据人体与健康主题加入少量极简装饰元素，例如柔和曲线、小图标、健康用品剪影和清爽点缀，保持干净舒适。'
        };

        if (parentMap[parent]) return parentMap[parent];

        return '标题栏背景需要根据当前主题加入少量极简装饰元素，保持白底、柔和绿色与浅色系配色，装饰轻量、整洁、不要遮挡标题。';
    }

    function buildPosterLayoutRule(totalCount, options = {}) {
        const safeCount = Math.max(1, Number(totalCount) || 0);
        const includeChinese = options.includeChinese === true;
        const expectedColumns = 4;
        const expectedRows = Math.max(1, Math.ceil(safeCount / expectedColumns));
        const layoutMap = {
            4: {
                titleHeightPct: 15.5,
                gridTopPct: 15.5,
                gridBottomPct: 99.3,
                leftPct: 1.5,
                rightPct: 98.4,
                note: '适合16张卡片的4×4海报'
            },
            3: {
                titleHeightPct: 17.4,
                gridTopPct: 17.4,
                gridBottomPct: 99.9,
                leftPct: 1.8,
                rightPct: 99.9,
                note: '适合12张卡片的4×3海报'
            }
        };
        const layout = layoutMap[expectedRows] || {
            titleHeightPct: 16,
            gridTopPct: 16,
            gridBottomPct: 99,
            leftPct: 1.6,
            rightPct: 98.6,
            note: `适合${expectedColumns}列×${expectedRows}行的固定模板海报`
        };
        const formatPct = (value) => `${Number(value).toFixed(1).replace(/\.0$/, '')}%`;
        const gridWidthPct = layout.rightPct - layout.leftPct;
        const gridHeightPct = layout.gridBottomPct - layout.gridTopPct;
        const cardWidthPct = gridWidthPct / expectedColumns;
        const cardHeightPct = gridHeightPct / expectedRows;
        const rowRanges = Array.from({ length: expectedRows }, (_, index) => {
            const start = layout.gridTopPct + index * cardHeightPct;
            const end = index === expectedRows - 1 ? layout.gridBottomPct : start + cardHeightPct;
            return `第${index + 1}行 ${formatPct(start)}-${formatPct(end)}`;
        }).join('；');
        const colRanges = Array.from({ length: expectedColumns }, (_, index) => {
            const start = layout.leftPct + index * cardWidthPct;
            const end = index === expectedColumns - 1 ? layout.rightPct : start + cardWidthPct;
            return `第${index + 1}列 ${formatPct(start)}-${formatPct(end)}`;
        }).join('；');

        const titleRule = includeChinese
            ? `标题栏固定占整张海报高度${formatPct(layout.titleHeightPct)}，中文标题在上、英文标题在下，中英文整体居中`
            : `标题栏固定占整张海报高度${formatPct(layout.titleHeightPct)}，只显示英文标题，不显示中文标题，英文标题整体居中`;
        const internalStructureRule = includeChinese
            ? '所有卡片内部也必须使用统一结构：物品图片区高度一致，中文名称区域高度一致，英文单词区域高度一致，IPA区域高度一致'
            : '所有卡片内部也必须使用统一结构：物品图片区高度一致，英文单词区域高度一致，IPA区域高度一致';
        const fitRule = includeChinese
            ? '如果某个物品图片、中文名称、英文单词或IPA较长，请缩小物品图或字体来适配固定卡片，不允许改变该卡片宽度或高度'
            : '如果某个物品图片、英文单词或IPA较长，请缩小物品图或字体来适配固定卡片，不允许改变该卡片宽度或高度';
        const cardContentRule = includeChinese
            ? '每张卡片都包含：上方写实物品图，物品图片下方显示简体中文名称，再下方英文单词，再下方IPA，信息层级统一'
            : '每张卡片都包含：上方写实物品图，下方英文单词，再下方IPA，信息层级统一';
        const spacingRule = includeChinese
            ? '卡片内部只能用留白分隔物品图、中文名称、英文单词和IPA，不要画横线、分割线、下划线、表格线或练习本横格'
            : '卡片内部只能用留白分隔物品图、英文单词和IPA，不要画横线、分割线、下划线、表格线或练习本横格';
        const noLineRule = includeChinese
            ? '卡片内除了外边框以外不要再添加任何内部线条，不能在物品与中文、中文与英文、英文与IPA之间加线'
            : '卡片内除了外边框以外不要再添加任何内部线条，不能在物品与单词之间、单词与IPA之间加线';

        return `布局模板约束：
- 必须使用固定模板海报布局，不要自由发挥，不要打乱卡片位置
- ${titleRule}
- 卡片网格固定为${expectedColumns}列 × ${expectedRows}行，${layout.note}
- 卡片区从画面高度${formatPct(layout.gridTopPct)}处开始，到${formatPct(layout.gridBottomPct)}处结束
- 卡片网格左边界固定在画面宽度${formatPct(layout.leftPct)}处，右边界固定在${formatPct(layout.rightPct)}处，左右对齐，不要忽宽忽窄
- 每张卡片外框宽度固定为整张海报宽度的${formatPct(cardWidthPct)}，高度固定为整张海报高度的${formatPct(cardHeightPct)}
- 每行边界必须严格贴近这些百分比：${rowRanges}
- 每列边界必须严格贴近这些百分比：${colRanges}
- 所有卡片必须严格等宽、严格等高、圆角一致，列间距和行间距统一
- 必须像标准 CSS grid / table grid 一样排版：同一列的卡片左边界和右边界完全对齐，同一行的卡片上边界和下边界完全对齐
- 每一行高度必须完全一致，每一列宽度必须完全一致，不能出现某一排更高、某一列更宽、某个卡片因图片或文字而变大
- ${internalStructureRule}
- ${fitRule}
- 不要使用瀑布流、拼贴布局、自由卡片布局、不同大小卡片、错位卡片或自适应内容高度
- 第一排卡片顶部必须与整张卡片网格的起始线严格对齐，不能比后几排更低
- ${cardContentRule}
- ${spacingRule}
- ${noLineRule}
- 卡片底部文字区域高度也要统一，不能有的高有的低
- 请优先保证整体版式精准、整齐、对称，再生成细节`;
    }

    function toTitleCase(value) {
        return String(value || '')
            .trim()
            .split(/\s+/)
            .filter(Boolean)
            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
            .join(' ');
    }

    function buildPosterPrompt(themeCn, themeEn, itemsStr, parentName = '', options = {}) {
        const includeChinese = options.includeChinese === true;
        const items = itemsStr
            .split(',')
            .map(s => s.trim())
            .filter(Boolean)
            .map(item => toTitleCase(item));
        const count = items.length;
        const remainder = count % 4;
        const fillCount = remainder === 0 ? 0 : 4 - remainder;
        const itemList = items.join(', ');
        const primaryDescriptor = buildPrimaryCategoryDescriptor(parentName, themeCn);
        const titleDecorationRule = buildTitleDecorationRule(parentName, themeCn, themeEn);
        const titleCn = themeCn || themeEn || '';
        const titleEn = themeEn || '';
        const titleDisplay = includeChinese
            ? `${titleCn || titleEn || ''}${titleEn ? ` ${titleEn}` : ''}`.trim()
            : (titleEn || titleCn || '');
        const totalCount = count + fillCount;
        const layoutRule = buildPosterLayoutRule(totalCount, { includeChinese });
        const titleModeRule = includeChinese
            ? '标题栏增加中文标题，中文标题在上、英文标题在下，中英双行展示'
            : '标题栏只显示英文标题，不显示中文标题，不要中英双语换行标题';
        const cardItemsRule = includeChinese
            ? `每个卡片包含：
- 写实风格的物品图片
- 物品图片下方显示该物品的简体中文名称（加粗或半粗）
- 中文名称下方显示英文名称（加粗）
- 英文名称下方显示英式或美式音标（IPA）
- 请根据英文物品自动翻译成常用、准确、适合儿童学习的简体中文名称，例如 Apple=苹果，Watermelon=西瓜，Cashier=收银员
- 物品图片、中文名称、英文名称、IPA 之间只用干净留白分层，禁止添加横线、分割线、下划线、表格线、练习本横格
- 每张卡片只保留浅绿色圆角外边框，卡片内部不要任何线条`
            : `每个卡片包含：
- 写实风格的物品图片
- 英文名称（加粗）
- 英式或美式音标（IPA）
- 物品图片、英文名称、IPA 之间只用干净留白分层，禁止添加横线、分割线、下划线、表格线、练习本横格
- 每张卡片只保留浅绿色圆角外边框，卡片内部不要任何线条`;
        const fillRule = fillCount > 0
            ? `\n当前物品共有${count}个，不足4列整齐排版。请你自动补充${fillCount}个与“${titleCn}”强相关、常见、适合儿童学习的同类物品，使总数补足到${totalCount}个；补充项不能重复，不能偏题，必须保持与现有物品同一学习主题。`
            : '';

        return `一张干净的英语学习信息图海报，标题为“${titleDisplay}”(${titleModeRule})，采用整齐的网格布局（4列），每个卡片展示一种${primaryDescriptor},展示物品有:${itemList}${fillRule}
${cardItemsRule}
整体风格：
极简设计，白色背景，柔和的绿色和浅色系配色，
卡片式UI设计，圆角边框，排版整齐，视觉平衡，
适合英语初学者学习，类似课堂教学海报
适合社交媒体传播，高分辨率，4K，信息图风格
标题栏背景要求：
${titleDecorationRule}
${layoutRule}
图片比列：9:16`;
    }

