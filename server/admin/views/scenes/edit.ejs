<div class="grid grid-cols-12 gap-6 h-[calc(100vh-140px)]">
    <!-- Left Column: Settings -->
    <div class="col-span-3 bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
        <div class="p-5 border-b border-gray-100">
            <h2 class="font-bold text-lg text-gray-800">
                <a href="/scenes" class="text-gray-400 hover:text-gray-600 mr-2"><i class="fas fa-arrow-left"></i></a>
                场景设置
            </h2>
        </div>

        <form id="sceneForm" class="p-5 flex-1 overflow-y-auto space-y-5">
            <input type="hidden" name="id" id="sceneId" value="<%= typeof scene !== 'undefined' ? scene.id : '' %>">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">场景名称</label>
                <input type="text" name="name" required value="<%= typeof scene !== 'undefined' ? scene.name : '' %>"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">英文名称</label>
                <input type="text" name="name_en" value="<%= typeof scene !== 'undefined' ? scene.name_en : '' %>"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">所属分类</label>
                <select name="category_id" id="categorySelect"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all bg-white">
                    <option value="">选择分类</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">难度等级 (1-5)</label>
                <div class="flex items-center space-x-4">
                    <input type="range" name="difficulty_level" min="1" max="5"
                        value="<%= typeof scene !== 'undefined' ? scene.difficulty_level : 1 %>"
                        oninput="this.nextElementSibling.innerText = this.value + '级'" class="flex-1">
                    <span class="text-blue-600 font-bold bg-blue-50 px-2 py-1 rounded text-sm w-10 text-center">
                        <%= typeof scene !=='undefined' ? scene.difficulty_level : 1 %>级
                    </span>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">场景图片</label>

                <!-- Toggle Tabs -->
                <div class="flex bg-gray-100 p-1 rounded-xl mb-3 text-sm font-medium">
                    <button type="button" onclick="switchImageTab('upload')" id="tab-upload"
                        class="flex-1 py-1.5 rounded-lg bg-white shadow-sm text-gray-800 transition-all">本地上传</button>
                    <button type="button" onclick="switchImageTab('ai')" id="tab-ai"
                        class="flex-1 py-1.5 rounded-lg text-gray-500 hover:text-gray-800 transition-all">AI生成</button>
                </div>

                <!-- Upload Panel -->
                <div id="panel-upload" class="block">
                    <div class="border-2 border-dashed border-gray-200 rounded-xl p-4 text-center hover:border-blue-300 transition-colors cursor-pointer relative"
                        onclick="document.getElementById('fileInput').click()">
                        <input type="file" id="fileInput" accept="image/*" class="hidden"
                            onchange="handleFileUpload(this)">
                        <i class="fas fa-cloud-upload-alt text-2xl text-gray-300 mb-2"></i>
                        <p class="text-xs text-gray-500">点击上传图片 (JPG/PNG)</p>
                    </div>
                </div>

                <!-- AI Panel -->
                <div id="panel-ai" class="hidden space-y-2">
                    <!-- Style Selector -->
                    <div class="flex bg-purple-50 p-1 rounded-lg text-xs font-medium">
                        <button type="button" onclick="switchAiStyle('poster')" id="style-poster"
                            class="flex-1 py-1.5 rounded-md bg-purple-600 text-white transition-all">
                            <i class="fas fa-th mr-1"></i>词汇海报
                        </button>
                        <button type="button" onclick="switchAiStyle('scene')" id="style-scene"
                            class="flex-1 py-1.5 rounded-md text-purple-600 hover:bg-purple-100 transition-all">
                            <i class="fas fa-image mr-1"></i>场景图
                        </button>
                        <button type="button" onclick="switchAiStyle('custom')" id="style-custom"
                            class="flex-1 py-1.5 rounded-md text-purple-600 hover:bg-purple-100 transition-all">
                            <i class="fas fa-pen mr-1"></i>自定义
                        </button>
                    </div>

                    <!-- Scene Style Info -->
                    <div id="ai-style-info" class="text-xs text-gray-500 bg-gray-50 px-3 py-2 rounded-lg">
                        <span id="ai-style-desc">生成词汇卡片网格海报 (9:16 竖版)</span>
                    </div>

                    <textarea id="aiPrompt" rows="3"
                        class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm outline-none focus:border-blue-500"
                        placeholder="选择分类后自动填充，也可手动修改..."></textarea>
                    <button type="button" id="btnGenerateImage" onclick="generateSceneImage()"
                        class="w-full py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-colors">
                        <i class="fas fa-magic mr-1"></i> 生成图片
                    </button>
                </div>

                <input type="hidden" name="image_url" id="image_url"
                    value="<%= typeof scene !== 'undefined' ? scene.image_url : '' %>">
            </div>

            <div class="pt-4 border-t border-gray-100">
                <button type="submit"
                    class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-lg shadow-blue-200 font-bold transition-all">保存全部</button>
            </div>
        </form>
    </div>

    <!-- Center Column: Image Editor -->
    <div class="col-span-6 bg-gray-100 rounded-2xl border border-gray-200 overflow-hidden flex flex-col relative">
        <div class="flex items-center justify-between p-3 bg-white border-b border-gray-200 shadow-sm z-10">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Editor Canvas</span>

            <div class="flex space-x-2">
                <% if (typeof scene !== 'undefined' && scene) { %>
                <button onclick="generateWxacode()"
                    class="flex items-center space-x-1.5 bg-green-500 hover:bg-green-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-qrcode"></i>
                    <span>小程序码</span>
                </button>
                <% } %>

                <button onclick="smartOCR()"
                    class="flex items-center space-x-1.5 bg-yellow-500 hover:bg-yellow-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-bolt"></i>
                    <span>智能识别(OCR)</span>
                </button>

                <button id="drawModeBtn" type="button" onclick="toggleDrawMode()"
                    class="flex items-center space-x-1.5 bg-slate-600 hover:bg-slate-700 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                    <i class="fas fa-draw-polygon"></i>
                    <span>手动框选</span>
                </button>

                <select id="ocrEngine"
                    class="text-xs border border-yellow-200 rounded-lg px-2 bg-yellow-50 text-yellow-800 outline-none">
                    <option value="youdao" selected>有道OCR</option>
                    <option value="tencent">腾讯云OCR</option>
                    <option value="gemini">Gemini</option>
                </select>
            </div>
        </div>

        <div class="flex-1 relative overflow-auto flex items-center justify-center p-8 bg-dots">
            <div id="canvasContainer"
                class="relative shadow-2xl bg-white select-none transition-all duration-300 opacity-0 transform scale-95 w-fit h-fit">
                <img id="mainImage" src="<%= typeof scene !== 'undefined' ? scene.image_url : '' %>"
                    class="max-w-full max-h-[600px] object-contain draggable=" false">
                <!-- Hotspots Overlay -->
                <div id="hotspotLayer" class="absolute inset-0"></div>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="absolute inset-0 flex flex-col items-center justify-center text-gray-400">
                <i class="fas fa-image text-5xl mb-4 opacity-30"></i>
                <p>请先上传或生成图片</p>
            </div>
        </div>
    </div>

    <!-- Right Column: Hotspot List -->
    <div class="col-span-3 bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col h-full">
        <div class="p-5 border-b border-gray-100">
            <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-gray-800">标注列表 <span id="hotspotCount"
                        class="text-xs bg-gray-100 px-2 py-0.5 rounded-full ml-1 text-gray-500">0</span></h3>
                <button onclick="clearAllHotspots()" class="text-xs text-red-500 hover:text-red-700">清空</button>
            </div>
            <button onclick="batchGenerateAll()"
                class="w-full py-2 bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-white rounded-lg text-sm font-medium transition-all shadow-sm">
                <i class="fas fa-magic mr-1"></i> 批量生成全部
            </button>
        </div>

        <div id="hotspotList" class="flex-1 overflow-y-auto p-2 space-y-1">
            <!-- Items injected here -->
        </div>
    </div>
</div>

<!-- 小程序码弹窗 -->
<div id="wxacodeModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center" onclick="this.classList.add('hidden');this.classList.remove('flex')">
    <div class="bg-white rounded-2xl p-6 shadow-2xl text-center max-w-sm" onclick="event.stopPropagation()">
        <h3 class="text-lg font-bold text-gray-800 mb-2">小程序码</h3>
        <p class="text-sm text-gray-500 mb-4">扫码直达该场景点读页面</p>
        <div id="wxacodeLoading" class="py-8 text-gray-400"><i class="fas fa-spinner fa-spin text-2xl"></i><br><span class="text-sm mt-2 inline-block">生成中...</span></div>
        <img id="wxacodeImg" class="hidden mx-auto w-64 h-64 rounded-lg border" alt="小程序码">
        <div id="wxacodeError" class="hidden text-red-500 text-sm py-4"></div>
        <div class="mt-4 flex gap-3 justify-center">
            <button id="wxacodeRegenerate" onclick="generateWxacode(true)" class="bg-orange-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-orange-600"><i class="fas fa-rotate mr-1"></i>重新生成</button>
            <a id="wxacodeDownload" href="#" download class="hidden bg-green-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-green-600"><i class="fas fa-download mr-1"></i>下载</a>
            <button onclick="document.getElementById('wxacodeModal').classList.add('hidden');document.getElementById('wxacodeModal').classList.remove('flex')" class="bg-gray-100 px-4 py-2 rounded-lg text-sm hover:bg-gray-200">关闭</button>
        </div>
    </div>
</div>

<style>
    .bg-dots {
        background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
        background-size: 20px 20px;
    }

    .hotspot-box {
        position: absolute;
        border: 2px solid #3b82f6;
        background-color: rgba(59, 130, 246, 0.2);
        cursor: pointer;
        transition: all 0.2s;
    }

    .hotspot-box:hover {
        background-color: rgba(59, 130, 246, 0.4);
        z-index: 10;
    }

    .hotspot-box.active {
        border-color: #ef4444;
        background-color: rgba(239, 68, 68, 0.3);
        z-index: 20;
    }

    #hotspotLayer.draw-mode {
        cursor: crosshair;
    }

    #hotspotLayer.draw-mode .hotspot-box {
        pointer-events: none;
    }

    .hotspot-preview {
        position: absolute;
        border: 2px dashed #22c55e;
        background: rgba(34, 197, 94, 0.16);
        pointer-events: none;
        z-index: 30;
    }
</style>

<script>
    // Init Data
    const sceneId = document.getElementById('sceneId').value;
    const initialCategoryId = "<%= typeof scene !== 'undefined' ? scene.category_id : '' %>";
    let hotspots = []; // { id, word_id, custom_label, rect: {x,y,w,h} (percent), audio_url }
    let drawModeEnabled = false;
    let isDrawingHotspot = false;
    let drawStartPoint = null;
    let drawPreviewEl = null;

    // --- AI Style & Prompt Builder ---

    let currentAiStyle = 'poster'; // 'poster' | 'scene' | 'custom'

    function switchAiStyle(style) {
        currentAiStyle = style;
        const styles = ['scene', 'poster', 'custom'];
        styles.forEach(s => {
            const btn = document.getElementById(`style-${s}`);
            btn.className = s === style
                ? 'flex-1 py-1.5 rounded-md bg-purple-600 text-white transition-all'
                : 'flex-1 py-1.5 rounded-md text-purple-600 hover:bg-purple-100 transition-all';
        });

        const descEl = document.getElementById('ai-style-desc');
        const promptInput = document.getElementById('aiPrompt');
        if (style === 'scene') {
            descEl.textContent = '根据分类物品自动生成儿童英语场景探索图 (1:1)';
            promptInput.readOnly = false;
            applyCategoryPromptFromSelection({ forcePrompt: true });
        } else if (style === 'poster') {
            descEl.textContent = '生成词汇卡片网格海报 (9:16 竖版)';
            promptInput.readOnly = false;
            applyPosterPromptFromSelection();
        } else {
            descEl.textContent = '自定义提示词，直接发送给 AI（服务端仍会增强风格）';
            promptInput.readOnly = false;
            promptInput.value = '';
            promptInput.placeholder = '描述场景，例如：A messy bedroom with toys on the floor...';
        }
    }

    function applyPosterPromptFromSelection() {
        const select = document.getElementById('categorySelect');
        const opt = select.options[select.selectedIndex];
        if (!opt) return;
        const items = opt.getAttribute('data-items');
        const nameEn = opt.getAttribute('data-name-en');
        const nameCn = opt.getAttribute('data-name');
        if (!items || !items.trim()) {
            document.getElementById('aiPrompt').value = '';
            document.getElementById('aiPrompt').placeholder = '请先选择一个有物品列表的分类';
            return;
        }
        document.getElementById('aiPrompt').value = buildPosterPrompt(nameEn || nameCn, items);
    }

    function buildSceneExplorePrompt(theme, itemsStr) {
        const items = itemsStr.split(',').map(s => s.trim()).filter(Boolean);
        if (!items.length) return '';
        const itemList = items.join(', ');
        return `A colorful, cheerful ${theme} scene for children's English learning. The scene naturally contains these objects: ${itemList}. Each object should be clearly visible and easy to identify by tapping. Friendly, inviting illustration that makes children want to explore and find objects.`;
    }

    function buildPosterPrompt(theme, itemsStr) {
        const items = itemsStr.split(',').map(s => s.trim()).filter(Boolean);
        const count = items.length;

        let cols;
        if (count <= 4) cols = 2;
        else if (count <= 9) cols = 3;
        else cols = 4;
        const rows = Math.ceil(count / cols);

        const cardDesc = items.map(item => {
            const titleCase = item.charAt(0).toUpperCase() + item.slice(1).toLowerCase();
            return `a photo of a ${item} labeled "${titleCase}"`;
        }).join(', ');

        return `Generate a tall vertical image (9:16 aspect ratio, like a phone screen) of a children's English vocabulary poster.

Solid flat light pastel background. Title "${theme}" centered at top.

Below the title: a ${cols}×${rows} grid of exactly ${count} white rounded cards filling the full width. Each card shows a realistic photograph of the item with its English name in Title Case below.

The ${count} cards in order: ${cardDesc}.

Strict: exactly ${count} cards, no duplicates, no extras, no missing, no numbers, no background scene, no decorations, no Chinese. All cards same size, all photos same style, all labels same font.`;
    }

    // --- Image Handling ---

    function switchImageTab(tab) {
        document.getElementById('tab-upload').className = tab === 'upload' ? 'flex-1 py-1.5 rounded-lg bg-white shadow-sm text-gray-800 transition-all' : 'flex-1 py-1.5 rounded-lg text-gray-500 hover:text-gray-800 transition-all';
        document.getElementById('tab-ai').className = tab === 'ai' ? 'flex-1 py-1.5 rounded-lg bg-white shadow-sm text-gray-800 transition-all' : 'flex-1 py-1.5 rounded-lg text-gray-500 hover:text-gray-800 transition-all';
        document.getElementById('panel-upload').className = tab === 'upload' ? 'block' : 'hidden';
        document.getElementById('panel-ai').className = tab === 'ai' ? 'block space-y-2' : 'hidden';
    }

    function updateMainImage(url) {
        const img = document.getElementById('mainImage');
        const container = document.getElementById('canvasContainer');
        const empty = document.getElementById('emptyState');
        const input = document.getElementById('image_url');

        if (url) {
            img.src = url;
            input.value = url;
            img.onload = () => {
                empty.classList.add('hidden');
                container.classList.remove('opacity-0', 'scale-95', 'hidden');
            };
        }
    }

    async function handleFileUpload(input) {
        if (!input.files || !input.files[0]) return;
        const formData = new FormData();
        formData.append('image', input.files[0]);

        try {
            showToast('上传中...', 'info');
            const res = await fetch(`${API_BASE}/scenes/upload`, { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
                updateMainImage(data.url);
                showToast('上传成功');
            } else {
                showToast(data.message, 'error');
            }
        } catch (e) {
            showToast('上传出错', 'error');
        }
    }

    async function generateSceneImage() {
        const prompt = document.getElementById('aiPrompt').value;
        if (!prompt) return showToast('请输入描述', 'error');

        const btn = document.getElementById('btnGenerateImage');
        const originalHTML = btn.innerHTML;
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> AI 生成中...';

        // 计时器：每秒更新按钮文字显示已等待时间
        let seconds = 0;
        const timer = setInterval(() => {
            seconds++;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i> AI 生成中... (${seconds}s)`;
        }, 1000);

        try {
            const res = await fetch(`${API_BASE}/scenes/generate-image`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    prompt,
                    ai_style: currentAiStyle,
                    name: document.querySelector('input[name="name"]').value,
                    name_en: document.querySelector('input[name="name_en"]').value,
                    category_id: document.querySelector('select[name="category_id"]').value,
                    difficulty_level: document.querySelector('input[name="difficulty_level"]').value
                })
            });
            const data = await res.json();
            if (data.success) {
                updateMainImage(data.imageUrl);
                if (sceneId) {
                    const saved = await saveSceneData({ silent: true, reloadAfterSave: false });
                    if (saved.success) {
                        showToast('生成成功，已自动保存');
                    } else {
                        showToast(`生成成功，但自动保存失败: ${saved.message || '请手动点保存全部'}`, 'error');
                    }
                } else {
                    showToast('生成成功，请点击保存全部');
                }
            } else {
                showToast(data.message, 'error');
            }
        } catch (e) {
            showToast('生成出错', 'error');
        } finally {
            clearInterval(timer);
            btn.disabled = false;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
            btn.innerHTML = originalHTML;
        }
    }

    // --- Hotspot Editor Logic ---

    // Draw Logic (Simplified: Click to add box center, or drag support later)
    // Here we implement: Click on image -> Add default box at raw position -> user can modify text

    function clampPercent(v) {
        return Math.max(0, Math.min(100, v));
    }

    function getLayerPercentPoint(evt) {
        const layer = document.getElementById('hotspotLayer');
        const rect = layer.getBoundingClientRect();
        const x = ((evt.clientX - rect.left) / rect.width) * 100;
        const y = ((evt.clientY - rect.top) / rect.height) * 100;
        return { x: clampPercent(x), y: clampPercent(y) };
    }

    function setDrawMode(enabled) {
        drawModeEnabled = !!enabled;
        const layer = document.getElementById('hotspotLayer');
        const btn = document.getElementById('drawModeBtn');
        layer.classList.toggle('draw-mode', drawModeEnabled);

        if (drawModeEnabled) {
            btn.className = 'flex items-center space-x-1.5 bg-orange-500 hover:bg-orange-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm';
            btn.querySelector('span').innerText = '框选中';
            showToast('拖拽图片可新增热点', 'info');
        } else {
            btn.className = 'flex items-center space-x-1.5 bg-slate-600 hover:bg-slate-700 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm';
            btn.querySelector('span').innerText = '手动框选';
        }
    }

    function toggleDrawMode() {
        setDrawMode(!drawModeEnabled);
    }

    function clearDrawPreview() {
        if (drawPreviewEl && drawPreviewEl.parentNode) {
            drawPreviewEl.parentNode.removeChild(drawPreviewEl);
        }
        drawPreviewEl = null;
    }

    function onLayerMouseDown(evt) {
        if (!drawModeEnabled || evt.button !== 0) return;
        if (!document.getElementById('image_url').value) {
            showToast('请先上传或生成图片', 'error');
            return;
        }
        evt.preventDefault();
        evt.stopPropagation();

        isDrawingHotspot = true;
        drawStartPoint = getLayerPercentPoint(evt);

        clearDrawPreview();
        drawPreviewEl = document.createElement('div');
        drawPreviewEl.className = 'hotspot-preview';
        drawPreviewEl.style.left = `${drawStartPoint.x}%`;
        drawPreviewEl.style.top = `${drawStartPoint.y}%`;
        drawPreviewEl.style.width = '0%';
        drawPreviewEl.style.height = '0%';
        document.getElementById('hotspotLayer').appendChild(drawPreviewEl);
    }

    function onLayerMouseMove(evt) {
        if (!isDrawingHotspot || !drawPreviewEl || !drawStartPoint) return;
        const current = getLayerPercentPoint(evt);
        const x = Math.min(drawStartPoint.x, current.x);
        const y = Math.min(drawStartPoint.y, current.y);
        const w = Math.abs(current.x - drawStartPoint.x);
        const h = Math.abs(current.y - drawStartPoint.y);

        drawPreviewEl.style.left = `${x}%`;
        drawPreviewEl.style.top = `${y}%`;
        drawPreviewEl.style.width = `${w}%`;
        drawPreviewEl.style.height = `${h}%`;
    }

    function onLayerMouseUp(evt) {
        if (!isDrawingHotspot || !drawStartPoint) return;
        const endPoint = getLayerPercentPoint(evt);
        const x = Math.min(drawStartPoint.x, endPoint.x);
        const y = Math.min(drawStartPoint.y, endPoint.y);
        const w = Math.abs(endPoint.x - drawStartPoint.x);
        const h = Math.abs(endPoint.y - drawStartPoint.y);

        isDrawingHotspot = false;
        drawStartPoint = null;
        clearDrawPreview();

        if (w < 1 || h < 1) {
            showToast('拖拽范围太小，请重新框选', 'error');
            return;
        }

        hotspots.push({
            id: Date.now() + Math.random(),
            custom_label: '',
            rect: { x, y, w, h }
        });

        renderHotspots();
        renderHotspotList();

        const newIndex = hotspots.length - 1;
        setTimeout(() => {
            const input = document.getElementById(`hotspot-label-${newIndex}`);
            if (input) {
                input.focus();
                input.select();
            }
        }, 0);

        showToast('已新增热点，请填写单词/句子', 'success');
    }

    // 小程序码
    async function generateWxacode(force = false) {
        if (!sceneId) return showToast('请先保存场景', 'error');
        const modal = document.getElementById('wxacodeModal');
        const loading = document.getElementById('wxacodeLoading');
        const img = document.getElementById('wxacodeImg');
        const errEl = document.getElementById('wxacodeError');
        const dlBtn = document.getElementById('wxacodeDownload');
        const regenBtn = document.getElementById('wxacodeRegenerate');

        modal.classList.remove('hidden'); modal.classList.add('flex');
        loading.classList.remove('hidden'); img.classList.add('hidden'); errEl.classList.add('hidden'); dlBtn.classList.add('hidden');
        regenBtn.disabled = true;
        regenBtn.classList.add('opacity-60', 'cursor-not-allowed');

        try {
            const suffix = force ? '?force=1' : '';
            const res = await fetch(`${API_BASE}/scenes/${sceneId}/wxacode${suffix}`);
            const data = await res.json();
            loading.classList.add('hidden');

            if (data.success) {
                img.src = data.url + '?t=' + Date.now();
                img.classList.remove('hidden');
                dlBtn.href = data.url;
                dlBtn.classList.remove('hidden');
                showToast(force ? '小程序码已重新生成并保存' : (data.cached ? '已读取已保存小程序码' : '小程序码已生成并保存'));
            } else {
                errEl.textContent = data.message || '生成失败';
                errEl.classList.remove('hidden');
            }
        } catch (e) {
            loading.classList.add('hidden');
            errEl.textContent = '请求失败: ' + e.message;
            errEl.classList.remove('hidden');
        } finally {
            regenBtn.disabled = false;
            regenBtn.classList.remove('opacity-60', 'cursor-not-allowed');
        }
    }

    // OCR Logic
    async function smartOCR() {
        const imageUrl = document.getElementById('image_url').value;
        const engine = document.getElementById('ocrEngine').value;

        if (!imageUrl) return showToast('无图片', 'error');

        try {
            showToast('正在识别...', 'info');
            console.log(`[OCR] Sending request to ${engine}, image: ${imageUrl}`);

            const res = await fetch(`${API_BASE}/scenes/ocr`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ imageUrl, engine })
            });
            const data = await res.json();
            console.log('[OCR] Response:', data);

            if (data.success) {
                // Merge new hotspots
                data.words.forEach(w => {
                    const hotspot = {
                        id: Date.now() + Math.random(),
                        custom_label: w.text,
                        rect: w.rect // {x, y, w, h} in %
                    };
                    hotspots.push(hotspot);
                });
                renderHotspots();
                renderHotspotList();
                if (sceneId) {
                    const saved = await saveSceneData({ silent: true, reloadAfterSave: true });
                    if (saved.success) {
                        showToast(`识别成功，找到 ${data.words.length} 个文本，已自动保存`);
                    } else {
                        showToast(`识别成功，找到 ${data.words.length} 个文本，但自动保存失败`, 'error');
                    }
                } else {
                    showToast(`识别成功，找到 ${data.words.length} 个文本，请点击保存全部`);
                }
            } else {
                showToast(data.message || data.error || '识别失败', 'error');
            }
        } catch (e) {
            console.error('[OCR] Error:', e);
            showToast('请求出错: ' + e.message, 'error');
        }
    }

    function renderHotspots() {
        const layer = document.getElementById('hotspotLayer');
        layer.innerHTML = '';
        if (drawModeEnabled) layer.classList.add('draw-mode');

        hotspots.forEach(h => {
            const div = document.createElement('div');
            div.className = 'hotspot-box';
            div.style.left = h.rect.x + '%';
            div.style.top = h.rect.y + '%';
            div.style.width = h.rect.w + '%';
            div.style.height = h.rect.h + '%';
            div.title = h.custom_label;
            div.onclick = (e) => {
                e.stopPropagation();
                // Select Item logic if needed
            };

            // Edit interaction could be added here (Interact.js)

            layer.appendChild(div);
        });
        document.getElementById('hotspotCount').innerText = hotspots.length;
    }

    function renderHotspotList() {
        const list = document.getElementById('hotspotList');
        const escapeAttr = (v) => String(v || '')
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        list.innerHTML = hotspots.map((h, i) => `
            <div class="bg-gray-50 px-2.5 py-2 rounded-lg border border-gray-200 hover:border-blue-300 transition-colors group">
                <div class="flex items-center gap-2">
                    <span class="text-[10px] text-gray-400 w-4 shrink-0">${i + 1}</span>
                    <input id="hotspot-label-${i}" type="text" value="${escapeAttr(h.custom_label)}" onchange="updateLabel(${i}, this.value)"
                        class="bg-transparent border-none outline-none font-medium text-gray-700 flex-1 text-sm min-w-0"
                        placeholder="标签">
                    <div class="flex items-center gap-2.5 shrink-0 ml-1">
                        ${h.translation ? '<i class="fas fa-check-circle text-green-500 text-xs" title="已翻译"></i>' : ''}
                        ${h.audio_url_female ? `
                            <button onclick="playAudio('${h.audio_url_female}')" class="text-blue-500 hover:text-blue-700 p-0.5" title="播放">
                                <i class="fas fa-volume-up text-xs"></i>
                            </button>
                        ` : ''}
                        ${h.id ? `
                            <button onclick="generateHotspotAudio(${h.id}, ${i})" class="text-purple-500 hover:text-purple-700 p-0.5" title="生成音频">
                                <i class="fas fa-magic text-xs"></i>
                            </button>
                        ` : ''}
                        ${h.id ? `
                            <button onclick="openEditFields(${i})" class="text-gray-400 hover:text-blue-600 p-0.5" title="编辑音标/翻译">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                        ` : ''}
                        <button onclick="removeHotspot(${i})" class="text-gray-300 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity p-0.5" title="删除">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                </div>
                <div id="hotspot-display-${i}">
                    ${h.phonetic ? `<div class="text-[11px] text-gray-400 pl-6 cursor-pointer hover:text-blue-500" onclick="openEditFields(${i})">/${h.phonetic}/</div>` : ''}
                    ${h.translation ? `<div class="text-[11px] text-gray-500 pl-6 cursor-pointer hover:text-blue-500" onclick="openEditFields(${i})">${h.translation}</div>` : ''}
                </div>
                <div id="hotspot-edit-${i}" class="hidden pl-6 mt-1 space-y-1">
                    <input type="text" value="${(h.phonetic || '').replace(/"/g, '&quot;')}" placeholder="音标"
                        id="edit-phonetic-${i}"
                        class="w-full text-[11px] px-2 py-1 border rounded bg-white focus:ring-1 focus:ring-blue-400 outline-none">
                    <input type="text" value="${(h.translation || '').replace(/"/g, '&quot;')}" placeholder="翻译"
                        id="edit-translation-${i}"
                        class="w-full text-[11px] px-2 py-1 border rounded bg-white focus:ring-1 focus:ring-blue-400 outline-none">
                    <div class="flex gap-1.5 pt-0.5">
                        <button onclick="saveEditFields(${i})" class="text-[10px] px-2 py-0.5 bg-blue-500 text-white rounded hover:bg-blue-600">保存</button>
                        <button onclick="cancelEditFields(${i})" class="text-[10px] px-2 py-0.5 bg-gray-200 text-gray-600 rounded hover:bg-gray-300">取消</button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    // 编辑音标/翻译
    function openEditFields(index) {
        document.getElementById(`hotspot-display-${index}`).classList.add('hidden');
        document.getElementById(`hotspot-edit-${index}`).classList.remove('hidden');
    }

    function cancelEditFields(index) {
        document.getElementById(`hotspot-edit-${index}`).classList.add('hidden');
        document.getElementById(`hotspot-display-${index}`).classList.remove('hidden');
    }

    async function saveEditFields(index) {
        const h = hotspots[index];
        if (!h.id) { showToast('请先保存场景', 'error'); return; }

        const phonetic = document.getElementById(`edit-phonetic-${index}`).value.trim();
        const translation = document.getElementById(`edit-translation-${index}`).value.trim();

        try {
            const res = await fetch(`${API_BASE}/scenes/objects/${h.id}/update-fields`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phonetic, translation })
            });
            const data = await res.json();
            if (data.success) {
                hotspots[index].phonetic = phonetic;
                hotspots[index].translation = translation;
                renderHotspotList();
                showToast('已保存');
            } else {
                showToast(data.message || '保存失败', 'error');
            }
        } catch (e) {
            showToast('保存失败', 'error');
        }
    }

    // 播放音频预览
    let currentAudio = null;
    function playAudio(url) {
        if (currentAudio) {
            currentAudio.pause();
        }
        currentAudio = new Audio(url);
        currentAudio.play();
    }

    // 生成热点音频和翻译
    // 保存单个热点标签（自动保存文本变更）
    async function saveHotspotLabel(objId, newLabel) {
        try {
            await fetch(`${API_BASE}/scenes/objects/${objId}/update-label`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ custom_label: newLabel })
            });
            return true;
        } catch (e) {
            console.error('保存标签失败:', e);
            return false;
        }
    }

    // 生成热点音频和翻译（先保存标签再生成）
    async function generateHotspotAudio(objId, index) {
        try {
            const currentLabel = hotspots[index].custom_label;
            showToast('正在保存并生成...', 'info');

            // 先保存标签变更
            await saveHotspotLabel(objId, currentLabel);

            // 再调用生成API
            const res = await fetch(`${API_BASE}/scenes/objects/${objId}/generate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();

            if (data.success) {
                // 更新本地数据
                hotspots[index].phonetic = data.data.phonetic;
                hotspots[index].translation = data.data.translation;
                hotspots[index].audio_url_male = data.data.audio_url_male;
                hotspots[index].audio_url_female = data.data.audio_url_female;
                renderHotspotList();
                showToast('生成成功！');
            } else {
                showToast(data.message || '生成失败', 'error');
            }
        } catch (e) {
            console.error(e);
            showToast('生成失败: ' + e.message, 'error');
        }
    }

    // 批量生成全部热点
    async function batchGenerateAll() {
        const hotspotsWithId = hotspots.filter(h => h.id);
        if (hotspotsWithId.length === 0) {
            showToast('请先保存场景后再批量生成', 'error');
            return;
        }

        if (!confirm(`将批量生成 ${hotspotsWithId.length} 个热点的音标、翻译和音频，是否继续？`)) {
            return;
        }

        showToast(`开始批量生成 ${hotspotsWithId.length} 个热点...`, 'info');

        let successCount = 0;
        let failCount = 0;

        for (let i = 0; i < hotspots.length; i++) {
            const h = hotspots[i];
            if (!h.id) continue;

            try {
                // 保存并生成
                await saveHotspotLabel(h.id, h.custom_label);

                const res = await fetch(`${API_BASE}/scenes/objects/${h.id}/generate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    hotspots[i].phonetic = data.data.phonetic;
                    hotspots[i].translation = data.data.translation;
                    hotspots[i].audio_url_male = data.data.audio_url_male;
                    hotspots[i].audio_url_female = data.data.audio_url_female;
                    successCount++;
                } else {
                    failCount++;
                }
            } catch (e) {
                failCount++;
            }

            // 更新进度
            renderHotspotList();
        }

        if (sceneId) {
            const saved = await saveSceneData({ silent: true, reloadAfterSave: true });
            if (saved.success) {
                showToast(`批量生成完成: 成功 ${successCount} 个, 失败 ${failCount} 个，已自动保存`);
            } else {
                showToast(`批量生成完成: 成功 ${successCount} 个, 失败 ${failCount} 个，但自动保存失败`, 'error');
            }
        } else {
            showToast(`批量生成完成: 成功 ${successCount} 个, 失败 ${failCount} 个，请点击保存全部`);
        }
    }

    function updateLabel(index, val) {
        hotspots[index].custom_label = val;
    }

    function removeHotspot(index) {
        hotspots.splice(index, 1);
        renderHotspots();
        renderHotspotList();
    }

    function clearAllHotspots() {
        if (confirm('清空所有标注？')) {
            hotspots = [];
            renderHotspots();
            renderHotspotList();
        }
    }

    function mapObjectRowToHotspot(o) {
        return {
            id: o.id,
            custom_label: o.custom_label,
            phonetic: o.phonetic || '',
            translation: o.translation || '',
            audio_url_male: o.audio_url_male || '',
            audio_url_female: o.audio_url_female || '',
            rect: {
                x: o.position_x,
                y: o.position_y,
                w: o.label_width,
                h: o.label_height
            }
        };
    }

    async function reloadHotspotsFromServer() {
        if (!sceneId) return;
        const objRes = await fetch(`${API_BASE}/scenes/${sceneId}/objects`);
        const objData = await objRes.json();
        if (objData.success) {
            hotspots = objData.data.map(mapObjectRowToHotspot);
            renderHotspots();
            renderHotspotList();
        }
    }

    function buildScenePayloadFromForm() {
        const form = document.getElementById('sceneForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.objects = hotspots.map(h => ({
            id: Number.isInteger(h.id) && h.id > 0 ? h.id : undefined,
            custom_label: h.custom_label,
            position_x: h.rect.x,
            position_y: h.rect.y,
            label_width: h.rect.w,
            label_height: h.rect.h
        }));
        return data;
    }

    let saveInFlight = null;
    async function saveSceneData({ silent = false, reloadAfterSave = true } = {}) {
        if (saveInFlight) return saveInFlight;

        const data = buildScenePayloadFromForm();
        const method = sceneId ? 'PUT' : 'POST';
        const url = sceneId ? `${API_BASE}/scenes/${sceneId}` : `${API_BASE}/scenes`;

        saveInFlight = (async () => {
            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (!result.success) {
                    if (!silent) showToast(result.message || '保存失败', 'error');
                    return { success: false, message: result.message || '保存失败' };
                }

                if (!sceneId && result.id) {
                    if (!silent) showToast('保存成功');
                    setTimeout(() => { location.href = '/scenes/edit/' + result.id; }, 1000);
                    return { success: true, createdId: result.id };
                }

                if (sceneId && reloadAfterSave) {
                    await reloadHotspotsFromServer();
                }

                if (!silent) showToast('保存成功');
                return { success: true };
            } catch (err) {
                if (!silent) showToast('保存失败', 'error');
                return { success: false, message: err.message || '保存失败' };
            } finally {
                saveInFlight = null;
            }
        })();

        return saveInFlight;
    }

    function applyCategoryPromptFromSelection({ forcePrompt = false } = {}) {
        const select = document.getElementById('categorySelect');
        const opt = select.options[select.selectedIndex];
        if (!opt) return false;

        const items = opt.getAttribute('data-items');
        const nameEn = opt.getAttribute('data-name-en');
        const nameCn = opt.getAttribute('data-name');
        if (!items || !items.trim()) return false;

        const nameInput = document.querySelector('input[name="name"]');
        const nameEnInput = document.querySelector('input[name="name_en"]');
        if (!nameInput.value) nameInput.value = nameCn || '';
        if (!nameEnInput.value) nameEnInput.value = nameEn || '';

        const promptInput = document.getElementById('aiPrompt');
        if (forcePrompt || !promptInput.value.trim()) {
            if (currentAiStyle === 'poster') {
                promptInput.value = buildPosterPrompt(nameEn || nameCn, items);
            } else if (currentAiStyle === 'scene') {
                promptInput.value = buildSceneExplorePrompt(nameEn || nameCn, items);
            }
            // custom 模式不自动填充
        }
        return true;
    }

    // --- Init & Load ---

    (async function init() {
        // Load Categories
        const res = await fetch(`${API_BASE}/scene_categories`);
        const catData = await res.json();
        const select = document.getElementById('categorySelect');
        catData.data.forEach(c => {
            select.innerHTML += `<option value="${c.id}" ${c.id == initialCategoryId ? 'selected' : ''}>${c.name}</option>`;
            if (c.children) {
                c.children.forEach(sub => {
                    select.innerHTML += `<option value="${sub.id}" ${sub.id == initialCategoryId ? 'selected' : ''} data-items="${(sub.items || '').replace(/"/g, '&quot;')}" data-name="${sub.name}" data-name-en="${sub.name_en || ''}">&nbsp;&nbsp;${sub.name}</option>`;
                });
            }
        });

        // 监听分类选择变化，自动填充 AI 提示词
        select.addEventListener('change', function() {
            if (currentAiStyle !== 'custom') {
                const ok = applyCategoryPromptFromSelection({ forcePrompt: true });
                if (ok) switchImageTab('ai');
            }
        });

        // Edit 模式：默认 AI tab + 词汇海报风格
        if (sceneId) {
            switchImageTab('ai');
            switchAiStyle('poster');
        }

        // Load Scene Objects if Edit Mode
        if (sceneId) {
            await reloadHotspotsFromServer();
        }

        // 恢复主图显示
        updateMainImage(document.getElementById('image_url').value);

        // 手动框选热点事件
        const layer = document.getElementById('hotspotLayer');
        layer.addEventListener('mousedown', onLayerMouseDown);
        layer.addEventListener('mousemove', onLayerMouseMove);
        layer.addEventListener('mouseup', onLayerMouseUp);
        layer.addEventListener('mouseleave', onLayerMouseUp);
        setDrawMode(false);
    })();

    // Save Form
    document.getElementById('sceneForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        await saveSceneData({ silent: false, reloadAfterSave: !!sceneId });
    });

</script>
