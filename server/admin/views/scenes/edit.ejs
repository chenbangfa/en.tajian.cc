            showToast('生成出错', 'error');
        } finally {
            clearInterval(timer);
            btn.disabled = false;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
            btn.innerHTML = originalHTML;
        }
    }

    // --- Hotspot Editor Logic ---

    // Draw Logic (Simplified: Click to add box center, or drag support later)
    // Here we implement: Click on image -> Add default box at raw position -> user can modify text

    function clampPercent(v) {
        const n = Number(v);
        if (!Number.isFinite(n)) return 0;
        return Math.max(0, Math.min(100, n));
    }

    function toFiniteNumber(value, fallback = 0) {
        const n = Number(value);
        return Number.isFinite(n) ? n : fallback;
    }

    function roundRect(rect) {
        const rawX = toFiniteNumber(rect?.x, 0);
        const rawY = toFiniteNumber(rect?.y, 0);
        const x = clampPercent(rawX);
        const y = clampPercent(rawY);
        const maxW = Math.max(MIN_HOTSPOT_SIZE, 100 - x);
        const maxH = Math.max(MIN_HOTSPOT_SIZE, 100 - y);
        const w = Math.max(MIN_HOTSPOT_SIZE, Math.min(maxW, toFiniteNumber(rect?.w, MIN_HOTSPOT_SIZE)));
        const h = Math.max(MIN_HOTSPOT_SIZE, Math.min(maxH, toFiniteNumber(rect?.h, MIN_HOTSPOT_SIZE)));

        return {
            x: Number(x.toFixed(4)),
            y: Number(y.toFixed(4)),
            w: Number(w.toFixed(4)),
            h: Number(h.toFixed(4))
        };
    }

    function getLayerPercentPoint(evt) {
        const layer = document.getElementById('hotspotLayer');
        const rect = layer.getBoundingClientRect();
        const x = ((evt.clientX - rect.left) / rect.width) * 100;
        const y = ((evt.clientY - rect.top) / rect.height) * 100;
        return { x: clampPercent(x), y: clampPercent(y) };
    }

    function applyHotspotRect(index, rect) {
        if (index < 0 || index >= hotspots.length) return;
        const safeRect = roundRect(rect);
        hotspots[index].rect = safeRect;

        const el = document.getElementById(`hotspot-box-${index}`);
        if (el) {
            el.style.left = `${safeRect.x}%`;
            el.style.top = `${safeRect.y}%`;
            el.style.width = `${safeRect.w}%`;
            el.style.height = `${safeRect.h}%`;
        }
    }

    function buildAdjustedHotspotRect(state, currentPoint) {
        const start = roundRect(state.startRect);
        const dx = currentPoint.x - state.startPoint.x;
        const dy = currentPoint.y - state.startPoint.y;

        let x = start.x;
        let y = start.y;
        let w = start.w;
        let h = start.h;

        if (state.mode === 'move') {
            x = Math.max(0, Math.min(100 - start.w, start.x + dx));
            y = Math.max(0, Math.min(100 - start.h, start.y + dy));
            return { x, y, w, h };
        }

        const handle = state.handle || '';
        const right = start.x + start.w;
        const bottom = start.y + start.h;

        if (handle.includes('e')) {
            w = Math.max(MIN_HOTSPOT_SIZE, Math.min(100 - start.x, start.w + dx));
        }
        if (handle.includes('s')) {
            h = Math.max(MIN_HOTSPOT_SIZE, Math.min(100 - start.y, start.h + dy));
        }
        if (handle.includes('w')) {
            x = Math.max(0, Math.min(right - MIN_HOTSPOT_SIZE, start.x + dx));
            w = right - x;
        }
        if (handle.includes('n')) {
            y = Math.max(0, Math.min(bottom - MIN_HOTSPOT_SIZE, start.y + dy));
            h = bottom - y;
        }

        return { x, y, w, h };
    }

    function startHotspotAdjust(evt, index, mode, handle = '') {
        if (drawModeEnabled || evt.button !== 0 || index < 0 || index >= hotspots.length) return;
        evt.preventDefault();
        evt.stopPropagation();

        activeHotspotIndex = index;
        hotspotAdjustState = {
            index,
            mode,
            handle,
            startPoint: getLayerPercentPoint(evt),
            startRect: roundRect(hotspots[index].rect),
            hasMoved: false
        };
        renderHotspots();
        renderHotspotList();
    }

    function onHotspotAdjustMove(evt) {
        if (!hotspotAdjustState) return;
        evt.preventDefault();
        const currentPoint = getLayerPercentPoint(evt);
        const nextRect = buildAdjustedHotspotRect(hotspotAdjustState, currentPoint);
        const moved = Math.abs(currentPoint.x - hotspotAdjustState.startPoint.x) > 0.05
            || Math.abs(currentPoint.y - hotspotAdjustState.startPoint.y) > 0.05;
        hotspotAdjustState.hasMoved = hotspotAdjustState.hasMoved || moved;
        applyHotspotRect(hotspotAdjustState.index, nextRect);
    }

    function onHotspotAdjustEnd() {
        if (!hotspotAdjustState) return;
        const didMove = hotspotAdjustState.hasMoved;
        hotspotAdjustState = null;
        renderHotspots();
        renderHotspotList();
        if (didMove) {
            showToast('热点框位置/大小已调整，记得保存全部', 'info');
        }
    }

    function setDrawMode(enabled) {
        drawModeEnabled = !!enabled;
        const layer = document.getElementById('hotspotLayer');
        const btn = document.getElementById('drawModeBtn');
        layer.classList.toggle('draw-mode', drawModeEnabled);

        if (drawModeEnabled) {
            btn.className = 'flex items-center space-x-1.5 bg-orange-500 hover:bg-orange-600 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm';
            btn.querySelector('span').innerText = '框选中';
            showToast('拖拽图片可新增热点', 'info');
        } else {
            btn.className = 'flex items-center space-x-1.5 bg-slate-600 hover:bg-slate-700 text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm';
            btn.querySelector('span').innerText = '手动框选';
        }
    }

    function toggleDrawMode() {
        setDrawMode(!drawModeEnabled);
    }

    function clearDrawPreview() {
        if (drawPreviewEl && drawPreviewEl.parentNode) {
            drawPreviewEl.parentNode.removeChild(drawPreviewEl);
        }
        drawPreviewEl = null;
    }

    function onLayerMouseDown(evt) {
        if (!drawModeEnabled || evt.button !== 0) return;
        if (!document.getElementById('image_url').value) {
            showToast('请先上传或生成图片', 'error');
            return;
        }
        evt.preventDefault();
        evt.stopPropagation();

        isDrawingHotspot = true;
        drawStartPoint = getLayerPercentPoint(evt);

        clearDrawPreview();
        drawPreviewEl = document.createElement('div');
        drawPreviewEl.className = 'hotspot-preview';
        drawPreviewEl.style.left = `${drawStartPoint.x}%`;
        drawPreviewEl.style.top = `${drawStartPoint.y}%`;
        drawPreviewEl.style.width = '0%';
        drawPreviewEl.style.height = '0%';
        document.getElementById('hotspotLayer').appendChild(drawPreviewEl);
    }

    function onLayerMouseMove(evt) {
        if (!isDrawingHotspot || !drawPreviewEl || !drawStartPoint) return;
        const current = getLayerPercentPoint(evt);
        const x = Math.min(drawStartPoint.x, current.x);
        const y = Math.min(drawStartPoint.y, current.y);
        const w = Math.abs(current.x - drawStartPoint.x);
        const h = Math.abs(current.y - drawStartPoint.y);

        drawPreviewEl.style.left = `${x}%`;
        drawPreviewEl.style.top = `${y}%`;
        drawPreviewEl.style.width = `${w}%`;
        drawPreviewEl.style.height = `${h}%`;
    }

    function onLayerMouseUp(evt) {
        if (!isDrawingHotspot || !drawStartPoint) return;
        const endPoint = getLayerPercentPoint(evt);
        const x = Math.min(drawStartPoint.x, endPoint.x);
        const y = Math.min(drawStartPoint.y, endPoint.y);
        const w = Math.abs(endPoint.x - drawStartPoint.x);
        const h = Math.abs(endPoint.y - drawStartPoint.y);

        isDrawingHotspot = false;
        drawStartPoint = null;
        clearDrawPreview();

        if (w < 1 || h < 1) {
            showToast('拖拽范围太小，请重新框选', 'error');
            return;
        }

        hotspots.push({
            id: Date.now() + Math.random(),
            custom_label: '',
            rect: { x, y, w, h }
        });

        renderHotspots();
        renderHotspotList();
        selectHotspot(hotspots.length - 1, true);

        showToast('已新增热点，请填写单词/句子', 'success');
    }

