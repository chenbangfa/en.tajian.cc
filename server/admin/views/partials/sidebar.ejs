<script>
    // 侧边栏通用的登出逻辑，虽然 header 上也有
    async function logout() {
        if (!confirm('确定要退出登录吗？')) return;
        try {
            const res = await fetch('/api/admin/auth/logout', { method: 'POST' });
            window.location.href = '/login';
        } catch (e) { window.location.href = '/login'; }
    }
</script>
