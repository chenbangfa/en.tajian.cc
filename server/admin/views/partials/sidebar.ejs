<%
    const currentPage = typeof page !== 'undefined' ? page : '';
    const menuGroups = [
        {
            title: '工作台',
            tone: 'blue',
            items: [
                { href: '/', page: 'dashboard', icon: 'fa-chart-line', label: '数据统计' },
                { href: '/users', page: 'users', icon: 'fa-users', label: '用户管理' },
                { href: '/promoters', page: 'promoters', icon: 'fa-handshake-angle', label: '推广管理' },
                { href: '/categories', page: 'categories', icon: 'fa-folder-tree', label: '分类管理' }
            ]
        },
        {
            title: '词库与课程',
            tone: 'cyan',
            items: [
                { href: '/words', page: 'words', icon: 'fa-book', label: '单词管理' },
                { href: '/words/batch-tts', page: 'words-batch-tts', icon: 'fa-volume-up', label: '批量语音' },
                { href: '/words/batch-enhance', page: 'words-batch-enhance', icon: 'fa-wand-magic-sparkles', label: '批量AI补全' },
                { href: '/checkin/curriculum', page: 'checkin-curriculum', icon: 'fa-road', label: '打卡课程' },
                { href: '/ielts', page: 'ielts', icon: 'fa-graduation-cap', label: 'IELTS课程' }
            ]
        },
        {
            title: '场景学习',
            tone: 'emerald',
            items: [
                { href: '/scenes/categories', page: 'scenes-cat', icon: 'fa-sitemap', label: '场景分类' },
                { href: '/scenes', page: 'scenes-list', icon: 'fa-image', label: '场景内容' }
            ]
        },
        {
            title: '绘本故事',
            tone: 'green',
            items: [
                { href: '/picture-books/categories', page: 'pb-cat', icon: 'fa-tags', label: '绘本分类' },
                { href: '/picture-books', page: 'pb-list', icon: 'fa-book-open', label: '绘本管理' },
                { href: '/picture-books/batch-images', page: 'pb-batch-images', icon: 'fa-images', label: '批量生图' },
                { href: '/picture-books/batch-vocab', page: 'pb-batch-vocab', icon: 'fa-spell-check', label: '词汇分析' },
                { href: '/picturebook-videos', page: 'pb-videos', icon: 'fa-film', label: '绘本视频' }
            ]
        },
        {
            title: '对话口语',
            tone: 'purple',
            items: [
                { href: '/dialogue/categories', page: 'dialogue-cat', icon: 'fa-layer-group', label: '对话分类' },
                { href: '/dialogue/scenes', page: 'dialogue-scenes', icon: 'fa-comments', label: '对话内容' },
                { href: '/dialogue-videos', page: 'dialogue-videos', icon: 'fa-video', label: '对话视频' }
            ]
        },
        {
            title: '音频内容',
            tone: 'sky',
            items: [
                { href: '/podcast/categories', page: 'podcast-cat', icon: 'fa-headphones', label: '磨耳朵分类' },
                { href: '/podcast/contents', page: 'podcast-content', icon: 'fa-microphone', label: '磨耳朵内容' },
                { href: '/podcast-videos', page: 'podcast-videos', icon: 'fa-radio', label: '播客视频' }
            ]
        },
        {
            title: '营销视频',
            tone: 'orange',
            items: [
                { href: '/marketing', page: 'marketing', icon: 'fa-pen-nib', label: '内容工坊' },
                { href: '/marketing/videos', page: 'marketing-videos', icon: 'fa-video', label: '每日一词视频' },
                { href: '/marketing/category-videos', page: 'marketing-category-videos', icon: 'fa-layer-group', label: '分类视频' }
            ]
        },
        {
            title: '工具设置',
            tone: 'slate',
            items: [
                { href: '/prompts', page: 'prompts', icon: 'fa-robot', label: '提示词管理' },
                { href: '/batch/import', page: 'batch-import', icon: 'fa-file-import', label: '批量导入' },
                { href: '/batch/generate', page: 'batch-generate', icon: 'fa-palette', label: '批量生成图片' },
                { href: '/pet-stages', page: 'pet-stages', icon: 'fa-seedling', label: '成长阶段' }
            ]
        }
    ];

    const toneClassMap = {
        blue: { dot: 'bg-blue-400', active: 'border-blue-400 text-blue-50 bg-blue-500/15' },
        cyan: { dot: 'bg-cyan-400', active: 'border-cyan-400 text-cyan-50 bg-cyan-500/15' },
        emerald: { dot: 'bg-emerald-400', active: 'border-emerald-400 text-emerald-50 bg-emerald-500/15' },
        green: { dot: 'bg-green-400', active: 'border-green-400 text-green-50 bg-green-500/15' },
        purple: { dot: 'bg-purple-400', active: 'border-purple-400 text-purple-50 bg-purple-500/15' },
        sky: { dot: 'bg-sky-400', active: 'border-sky-400 text-sky-50 bg-sky-500/15' },
        orange: { dot: 'bg-orange-400', active: 'border-orange-400 text-orange-50 bg-orange-500/15' },
        slate: { dot: 'bg-slate-400', active: 'border-slate-400 text-slate-50 bg-slate-500/15' }
    };
%>

<style>
    .admin-sidebar-nav {
        scrollbar-width: thin;
        scrollbar-color: rgba(148, 163, 184, 0.45) transparent;
    }
    .admin-sidebar-nav::-webkit-scrollbar {
        width: 6px;
    }
    .admin-sidebar-nav::-webkit-scrollbar-track {
        background: transparent;
    }
    .admin-sidebar-nav::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.35);
        border-radius: 999px;
    }
    .admin-sidebar-link {
        position: relative;
    }
    .admin-sidebar-link::before {
        content: '';
        position: absolute;
        left: 0;
        top: 9px;
        bottom: 9px;
        width: 3px;
        border-radius: 999px;
        background: transparent;
    }
    .admin-sidebar-link.is-active::before {
        background: currentColor;
    }
</style>

<aside class="w-64 bg-slate-950 text-white flex flex-col shadow-2xl border-r border-slate-800">
    <div class="h-16 flex items-center px-4 border-b border-slate-800 bg-slate-950/95">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-emerald-400 to-green-700 flex items-center justify-center shadow-lg shadow-emerald-950/40">
            <i class="fas fa-book-open text-white"></i>
        </div>
        <div class="ml-3 min-w-0">
            <div class="text-sm font-black tracking-wide truncate">BookMelo Admin</div>
            <div class="text-[11px] text-slate-400 truncate">English Learning Studio</div>
        </div>
    </div>

    <nav id="adminSidebarNav" class="admin-sidebar-nav flex-1 overflow-y-auto px-3 py-4 space-y-4">
        <% menuGroups.forEach((group) => {
            const tone = toneClassMap[group.tone] || toneClassMap.slate;
            const groupActive = group.items.some(item => item.page === currentPage);
        %>
            <section class="rounded-2xl <%= groupActive ? 'bg-white/[0.045] ring-1 ring-white/10' : '' %>">
                <div class="px-3 pt-3 pb-2 flex items-center justify-between">
                    <div class="flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.16em] text-slate-400">
                        <span class="w-1.5 h-1.5 rounded-full <%= tone.dot %>"></span>
                        <span><%= group.title %></span>
                    </div>
                </div>
                <div class="px-1 pb-2 space-y-1">
                    <% group.items.forEach((item) => {
                        const isActive = item.page === currentPage;
                        const baseClass = 'admin-sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 border border-transparent';
                        const stateClass = isActive
                            ? `is-active ${tone.active} shadow-lg shadow-black/10`
                            : 'text-slate-300 hover:text-white hover:bg-white/[0.065]';
                    %>
                        <a href="<%= item.href %>"
                           data-sidebar-link
                           data-active="<%= isActive ? 'true' : 'false' %>"
                           class="<%= baseClass %> <%= stateClass %>">
                            <i class="fas <%= item.icon %> w-5 text-center text-[13px] opacity-90"></i>
                            <span class="truncate"><%= item.label %></span>
                        </a>
                    <% }) %>
                </div>
            </section>
        <% }) %>
    </nav>

    <div class="p-3 border-t border-slate-800 bg-slate-950">
        <button onclick="logout()" class="flex items-center justify-center gap-2 text-slate-400 hover:text-white hover:bg-white/[0.065] transition-colors duration-200 w-full px-3 py-2.5 rounded-xl text-sm font-semibold">
            <i class="fas fa-sign-out-alt"></i>
            <span>退出登录</span>
        </button>
    </div>
</aside>

<script>
    (function setupSidebarState() {
        const nav = document.getElementById('adminSidebarNav');
        if (!nav) return;

        const storageKey = 'bookmelo-admin-sidebar-scroll-top';
        const activeLink = nav.querySelector('[data-active="true"]');
        const savedTop = Number(sessionStorage.getItem(storageKey) || 0);
        if (Number.isFinite(savedTop) && savedTop > 0) {
            nav.scrollTop = savedTop;
        }

        requestAnimationFrame(() => {
            if (!activeLink) return;
            const top = activeLink.offsetTop;
            const bottom = top + activeLink.offsetHeight;
            const visibleTop = nav.scrollTop + 12;
            const visibleBottom = nav.scrollTop + nav.clientHeight - 24;
            if (top < visibleTop || bottom > visibleBottom) {
                activeLink.scrollIntoView({ block: 'center' });
            }
        });

        let scrollTimer = null;
        nav.addEventListener('scroll', () => {
            clearTimeout(scrollTimer);
            scrollTimer = setTimeout(() => {
                sessionStorage.setItem(storageKey, String(nav.scrollTop));
            }, 80);
        }, { passive: true });

        nav.querySelectorAll('[data-sidebar-link]').forEach((link) => {
            link.addEventListener('click', () => {
                sessionStorage.setItem(storageKey, String(nav.scrollTop));
            });
        });
    })();

    async function logout() {
        if (!confirm('确定要退出登录吗？')) return;
        try {
            await fetch('/api/admin/auth/logout', { method: 'POST' });
            window.location.href = '/login';
        } catch (e) {
            window.location.href = '/login';
        }
    }
</script>
