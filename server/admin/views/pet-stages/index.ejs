<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <h2 class="text-2xl font-bold bg-gradient-to-r from-green-700 to-emerald-500 bg-clip-text text-transparent">
                成长阶段管理</h2>
            <p class="text-gray-500 mt-1">管理伙伴类型和成长阶段，上传图片和动画</p>
        </div>
        <div class="flex space-x-3">
            <button onclick="showAddTypeModal()"
                class="flex items-center space-x-2 border-2 border-green-500 text-green-600 hover:bg-green-50 px-5 py-2.5 rounded-xl transition-all">
                <i class="fas fa-paw"></i>
                <span>管理类型</span>
            </button>
            <button onclick="showAddModal()"
                class="flex items-center space-x-2 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white px-6 py-3 rounded-xl shadow-lg shadow-green-200 transition-all duration-300 hover:-translate-y-0.5">
                <i class="fas fa-plus"></i>
                <span>新增阶段</span>
            </button>
        </div>
    </div>

    <!-- 伙伴类型 Tab（动态渲染） -->
    <div id="typeTabs" class="flex flex-wrap gap-2 bg-white p-2 rounded-xl shadow-sm border border-gray-100">
        <div class="text-gray-400 p-3">加载中...</div>
    </div>

    <!-- 阶段卡片网格 -->
    <div id="stageGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="col-span-full text-center py-12 text-gray-400">加载中...</div>
    </div>
</div>

<!-- 阶段编辑弹窗 -->
<div id="editModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl">
        <div class="p-6 border-b border-gray-100">
            <h3 id="modalTitle" class="text-lg font-bold text-gray-800">编辑阶段</h3>
        </div>
        <div class="p-6 space-y-4">
            <input type="hidden" id="editId">
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">伙伴类型</label>
                <select id="editPetType" class="w-full px-4 py-2 border rounded-lg bg-gray-50">
                    <!-- 动态填充 -->
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">阶段编号</label>
                    <input type="number" id="editStage" class="w-full px-4 py-2 border rounded-lg bg-gray-50" min="1">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">所需成长值</label>
                    <input type="number" id="editPoints" class="w-full px-4 py-2 border rounded-lg bg-gray-50" min="0">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">阶段名称</label>
                <input type="text" id="editName" class="w-full px-4 py-2 border rounded-lg bg-gray-50" placeholder="如：种子、发芽...">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">进化提示语</label>
                <input type="text" id="editMessage" class="w-full px-4 py-2 border rounded-lg bg-gray-50" placeholder="如：你的努力开始生根发芽了！">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">阶段描述</label>
                <input type="text" id="editDesc" class="w-full px-4 py-2 border rounded-lg bg-gray-50" placeholder="简短描述">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">动画类型</label>
                <select id="editAnimType" class="w-full px-4 py-2 border rounded-lg bg-gray-50">
                    <option value="image">静态图片</option>
                    <option value="gif">GIF 动画</option>
                    <option value="apng">APNG 动画</option>
                    <option value="lottie">Lottie 动画</option>
                </select>
            </div>
            <!-- 阶段图片：上传 / AI 生成 -->
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">阶段图片</label>
                <!-- Tab 切换 -->
                <div class="flex bg-gray-100 p-1 rounded-lg mb-3 text-sm font-medium">
                    <button type="button" onclick="switchImgTab('upload')" id="imgTab-upload"
                        class="flex-1 py-1.5 rounded-md bg-white shadow-sm text-gray-800 transition-all">本地上传</button>
                    <button type="button" onclick="switchImgTab('ai')" id="imgTab-ai"
                        class="flex-1 py-1.5 rounded-md text-gray-500 hover:text-gray-800 transition-all">AI 生成</button>
                </div>
                <!-- 上传面板 -->
                <div id="imgPanel-upload">
                    <div class="flex items-center gap-4">
                        <img id="editImagePreview" class="w-24 h-24 object-contain rounded-lg border bg-gray-50 hidden" src="">
                        <label class="cursor-pointer bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-lg text-sm text-gray-600 transition-colors">
                            <i class="fas fa-cloud-upload-alt mr-1"></i> 上传图片
                            <input type="file" id="editImageFile" accept="image/*" class="hidden" onchange="previewFile(this, 'editImagePreview')">
                        </label>
                    </div>
                </div>
                <!-- AI 生成面板 -->
                <div id="imgPanel-ai" class="hidden space-y-2">
                    <div class="flex gap-2">
                        <button type="button" onclick="buildStagePrompt()"
                            class="shrink-0 px-3 py-2 bg-indigo-100 text-indigo-700 hover:bg-indigo-200 rounded-lg text-xs font-medium transition-colors">
                            <i class="fas fa-wand-magic-sparkles mr-1"></i>智能生成提示词
                        </button>
                        <span class="text-[11px] text-gray-400 leading-tight self-center">根据伙伴名称/阶段名称/描述自动构建</span>
                    </div>
                    <textarea id="aiImagePrompt" rows="4"
                        class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm outline-none focus:border-green-500 resize-none"
                        placeholder="描述你想要的阶段图片，或点击上方按钮自动生成..."></textarea>
                    <div class="flex gap-2">
                        <button type="button" onclick="generateStageImage()"
                            class="flex-1 py-2 bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-white rounded-lg text-sm font-medium transition-all shadow-sm">
                            <i class="fas fa-magic mr-1"></i> 生成图片
                        </button>
                    </div>
                    <div id="aiImageResult" class="hidden">
                        <img id="aiImagePreview" class="w-full max-h-48 object-contain rounded-lg border bg-gray-50" src="">
                    </div>
                </div>
            </div>
            <!-- 动画上传 -->
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">动画文件（可选）</label>
                <div class="flex items-center gap-4">
                    <img id="editAnimPreview" class="w-24 h-24 object-contain rounded-lg border bg-gray-50 hidden" src="">
                    <label class="cursor-pointer bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-lg text-sm text-gray-600 transition-colors">
                        <i class="fas fa-film mr-1"></i> 上传动画
                        <input type="file" id="editAnimFile" accept="image/*,.json" class="hidden" onchange="previewFile(this, 'editAnimPreview')">
                    </label>
                </div>
            </div>
        </div>
        <div class="p-6 border-t border-gray-100 flex justify-end space-x-3">
            <button onclick="closeModal()" class="px-6 py-2 rounded-lg border text-gray-600 hover:bg-gray-50">取消</button>
            <button onclick="saveStage()" class="px-6 py-2 rounded-lg bg-green-600 text-white hover:bg-green-700">保存</button>
        </div>
    </div>
</div>

<!-- 类型管理弹窗 -->
<div id="typeModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-lg font-bold text-gray-800">伙伴类型管理</h3>
            <button onclick="closeTypeModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
        </div>
        <div class="p-6">
            <!-- 已有类型列表 -->
            <div id="typeList" class="space-y-3 mb-6"></div>

            <!-- 新增类型表单 -->
            <div class="border-t pt-4">
                <h4 class="text-sm font-bold text-gray-600 mb-3">添加新类型</h4>
                <div class="grid grid-cols-12 gap-3">
                    <input type="text" id="newTypeKey" placeholder="标识(英文)" class="col-span-3 px-3 py-2 border rounded-lg bg-gray-50 text-sm">
                    <input type="text" id="newTypeName" placeholder="显示名称" class="col-span-3 px-3 py-2 border rounded-lg bg-gray-50 text-sm">
                    <input type="text" id="newTypeIcon" placeholder="图标emoji" class="col-span-2 px-3 py-2 border rounded-lg bg-gray-50 text-sm text-center">
                    <input type="number" id="newTypeSort" placeholder="排序" value="0" class="col-span-2 px-3 py-2 border rounded-lg bg-gray-50 text-sm">
                    <button onclick="addType()" class="col-span-2 bg-green-600 text-white rounded-lg text-sm hover:bg-green-700">添加</button>
                </div>
                <p class="text-xs text-gray-400 mt-2">标识仅支持英文字母和下划线，创建后不可修改。如：panda, tiger, giraffe</p>
            </div>
        </div>
    </div>
</div>

<style>
    .tab-btn { color: #9CA3AF; background: transparent; }
    .tab-btn.active { color: #fff; background: linear-gradient(135deg, #10B981, #059669); box-shadow: 0 4px 12px rgba(16,185,129,0.3); }
    .tab-btn:not(.active):hover { background: #F3F4F6; color: #374151; }
</style>

<script>
    let currentType = '';
    let petTypes = [];

    // ── 类型管理 ──

    async function loadTypes() {
        try {
            const res = await fetch(`${API_BASE}/pet-stages/api/types`);
            const result = await res.json();
            petTypes = result.data || [];
            renderTabs();
            fillTypeSelect();
            // 默认选中第一个
            if (petTypes.length > 0 && !currentType) {
                currentType = petTypes[0].type_key;
            }
            if (currentType) {
                switchType(currentType);
            }
        } catch (e) {
            showToast('加载类型失败', 'error');
        }
    }

    function renderTabs() {
        const container = document.getElementById('typeTabs');
        if (petTypes.length === 0) {
            container.innerHTML = '<div class="text-gray-400 p-3">暂无类型，请先添加</div>';
            return;
        }
        container.innerHTML = petTypes.map(t => `
            <button onclick="switchType('${t.type_key}')" id="tab-${t.type_key}"
                class="tab-btn ${currentType === t.type_key ? 'active' : ''} px-5 py-3 rounded-lg text-center font-medium transition-all">
                ${t.icon || ''} ${t.name}
            </button>
        `).join('');
    }

    function fillTypeSelect() {
        const sel = document.getElementById('editPetType');
        sel.innerHTML = petTypes.map(t =>
            `<option value="${t.type_key}">${t.icon || ''} ${t.name}</option>`
        ).join('');
    }

    function switchType(type) {
        currentType = type;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        const tab = document.getElementById('tab-' + type);
        if (tab) tab.classList.add('active');
        loadStages();
    }

    function showAddTypeModal() {
        renderTypeList();
        document.getElementById('typeModal').classList.remove('hidden');
    }

    function closeTypeModal() {
        document.getElementById('typeModal').classList.add('hidden');
        loadTypes(); // 刷新
    }

    function renderTypeList() {
        const container = document.getElementById('typeList');
        if (petTypes.length === 0) {
            container.innerHTML = '<p class="text-gray-400 text-sm">暂无类型</p>';
            return;
        }
        container.innerHTML = petTypes.map(t => `
            <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-3">
                <span class="text-2xl">${t.icon || '❓'}</span>
                <div class="flex-1">
                    <span class="font-medium text-gray-800">${t.name}</span>
                    <span class="text-xs text-gray-400 ml-2">${t.type_key}</span>
                </div>
                <input type="text" value="${t.name}" class="w-20 px-2 py-1 border rounded text-sm" id="tn-${t.id}">
                <input type="text" value="${t.icon || ''}" class="w-12 px-2 py-1 border rounded text-sm text-center" id="ti-${t.id}">
                <input type="number" value="${t.sort_order || 0}" class="w-14 px-2 py-1 border rounded text-sm" id="ts-${t.id}">
                <button onclick="updateType(${t.id})" class="text-blue-600 hover:text-blue-800 text-sm"><i class="fas fa-save"></i></button>
                <button onclick="deleteType(${t.id}, '${t.name}')" class="text-red-500 hover:text-red-700 text-sm"><i class="fas fa-trash-alt"></i></button>
            </div>
        `).join('');
    }

    async function addType() {
        const type_key = document.getElementById('newTypeKey').value.trim();
        const name = document.getElementById('newTypeName').value.trim();
        const icon = document.getElementById('newTypeIcon').value.trim();
        const sort_order = parseInt(document.getElementById('newTypeSort').value) || 0;

        if (!type_key || !name) { showToast('请填写标识和名称', 'error'); return; }

        try {
            const res = await fetch(`${API_BASE}/pet-stages/api/types`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type_key, name, icon, sort_order })
            });
            const result = await res.json();
            if (result.success) {
                showToast('添加成功');
                document.getElementById('newTypeKey').value = '';
                document.getElementById('newTypeName').value = '';
                document.getElementById('newTypeIcon').value = '';
                // 刷新类型列表
                await loadTypes();
                renderTypeList();
            } else {
                showToast(result.message || '添加失败', 'error');
            }
        } catch (e) {
            showToast('添加失败', 'error');
        }
    }

    async function updateType(id) {
        const name = document.getElementById('tn-' + id).value;
        const icon = document.getElementById('ti-' + id).value;
        const sort_order = parseInt(document.getElementById('ts-' + id).value) || 0;

        try {
            await fetch(`${API_BASE}/pet-stages/api/types/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, icon, sort_order, is_active: 1 })
            });
            showToast('已保存');
            await loadTypes();
            renderTypeList();
        } catch (e) {
            showToast('保存失败', 'error');
        }
    }

    async function deleteType(id, name) {
        if (!confirm(`确定删除「${name}」类型吗？该类型下的所有阶段数据不会被删除。`)) return;
        try {
            const res = await fetch(`${API_BASE}/pet-stages/api/types/${id}`, { method: 'DELETE' });
            const result = await res.json();
            if (result.success) {
                showToast('已删除');
                await loadTypes();
                renderTypeList();
            } else {
                showToast(result.message || '删除失败', 'error');
            }
        } catch (e) {
            showToast('删除失败', 'error');
        }
    }

    // ── 阶段管理 ──

    async function loadStages() {
        try {
            const res = await fetch(`${API_BASE}/pet-stages/api/list?pet_type=${currentType}`);
            const result = await res.json();
            renderStages(result.data || []);
        } catch (e) {
            showToast('加载失败', 'error');
        }
    }

    function getTypeIcon(typeKey) {
        const t = petTypes.find(x => x.type_key === typeKey);
        return t ? (t.icon || '❓') : '❓';
    }

    function renderStages(stages) {
        const grid = document.getElementById('stageGrid');
        if (stages.length === 0) {
            grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-400 bg-white rounded-2xl border border-dashed">
                <i class="fas fa-seedling text-3xl mb-3 opacity-50"></i>
                <p>暂无阶段数据，点击"新增阶段"添加</p>
            </div>`;
            return;
        }

        const icon = getTypeIcon(currentType);
        grid.innerHTML = stages.map(s => `
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden group hover:shadow-lg transition-all">
                <div class="relative h-48 bg-gradient-to-br from-green-50 to-emerald-50 flex items-center justify-center overflow-hidden">
                    ${s.image_url
                        ? `<img src="${s.image_url}" class="max-h-full max-w-full object-contain">`
                        : `<div class="text-6xl opacity-30">${icon}</div>`
                    }
                    <div class="absolute top-3 left-3 flex gap-2">
                        <span class="bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded">阶段 ${s.stage}</span>
                        <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded">${s.animation_type}</span>
                    </div>
                    <div class="absolute top-3 right-3 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button onclick="editStage(${s.id})" class="p-2 bg-white/90 rounded-lg text-blue-600 hover:bg-blue-50 shadow-sm">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteStage(${s.id})" class="p-2 bg-white/90 rounded-lg text-red-500 hover:bg-red-50 shadow-sm">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="p-4">
                    <h3 class="font-bold text-gray-800 text-lg">${s.stage_name}</h3>
                    <p class="text-sm text-gray-500 mt-1">${s.description || ''}</p>
                    <div class="flex items-center justify-between mt-3">
                        <span class="text-xs bg-amber-50 text-amber-700 px-2 py-1 rounded font-medium">
                            <i class="fas fa-star mr-1"></i>${s.required_points} 成长值
                        </span>
                        ${s.animation_url ? '<span class="text-xs text-green-600"><i class="fas fa-check-circle mr-1"></i>有动画</span>' : '<span class="text-xs text-gray-400">无动画</span>'}
                    </div>
                    ${s.unlock_message ? `<p class="text-xs text-gray-400 mt-2 italic">"${s.unlock_message}"</p>` : ''}
                </div>
            </div>
        `).join('');
    }

    let allStages = [];
    async function loadAllForEdit() {
        const res = await fetch(`${API_BASE}/pet-stages/api/list`);
        const result = await res.json();
        allStages = result.data || [];
    }

    function showAddModal() {
        document.getElementById('editId').value = '';
        document.getElementById('editPetType').value = currentType;
        document.getElementById('editPetType').disabled = false;
        document.getElementById('editStage').value = '';
        document.getElementById('editStage').disabled = false;
        document.getElementById('editPoints').value = '0';
        document.getElementById('editName').value = '';
        document.getElementById('editMessage').value = '';
        document.getElementById('editDesc').value = '';
        document.getElementById('editAnimType').value = 'image';
        document.getElementById('editImagePreview').classList.add('hidden');
        document.getElementById('editAnimPreview').classList.add('hidden');
        document.getElementById('editImageFile').value = '';
        document.getElementById('editAnimFile').value = '';
        document.getElementById('aiImagePrompt').value = '';
        document.getElementById('aiImageResult').classList.add('hidden');
        _aiGeneratedUrl = '';
        switchImgTab('upload');
        document.getElementById('modalTitle').textContent = '新增阶段';
        document.getElementById('editModal').classList.remove('hidden');
    }

    async function editStage(id) {
        await loadAllForEdit();
        const s = allStages.find(x => x.id === id);
        if (!s) return;
        document.getElementById('editId').value = s.id;
        document.getElementById('editPetType').value = s.pet_type;
        document.getElementById('editPetType').disabled = true;
        document.getElementById('editStage').value = s.stage;
        document.getElementById('editStage').disabled = true;
        document.getElementById('editPoints').value = s.required_points;
        document.getElementById('editName').value = s.stage_name;
        document.getElementById('editMessage').value = s.unlock_message || '';
        document.getElementById('editDesc').value = s.description || '';
        document.getElementById('editAnimType').value = s.animation_type || 'image';

        const imgPrev = document.getElementById('editImagePreview');
        if (s.image_url) { imgPrev.src = s.image_url; imgPrev.classList.remove('hidden'); }
        else imgPrev.classList.add('hidden');

        const animPrev = document.getElementById('editAnimPreview');
        if (s.animation_url) { animPrev.src = s.animation_url; animPrev.classList.remove('hidden'); }
        else animPrev.classList.add('hidden');

        document.getElementById('editImageFile').value = '';
        document.getElementById('editAnimFile').value = '';
        document.getElementById('aiImagePrompt').value = '';
        document.getElementById('aiImageResult').classList.add('hidden');
        _aiGeneratedUrl = '';
        switchImgTab('upload');
        document.getElementById('modalTitle').textContent = '编辑阶段';
        document.getElementById('editModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('editModal').classList.add('hidden');
    }

    function previewFile(input, previewId) {
        const preview = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => { preview.src = e.target.result; preview.classList.remove('hidden'); };
            reader.readAsDataURL(input.files[0]);
        }
    }

    async function saveStage() {
        const id = document.getElementById('editId').value;
        const data = {
            pet_type: document.getElementById('editPetType').value,
            stage: parseInt(document.getElementById('editStage').value),
            stage_name: document.getElementById('editName').value,
            required_points: parseInt(document.getElementById('editPoints').value) || 0,
            unlock_message: document.getElementById('editMessage').value,
            description: document.getElementById('editDesc').value,
            animation_type: document.getElementById('editAnimType').value
        };

        if (!data.stage_name) { showToast('请输入阶段名称', 'error'); return; }
        if (!data.stage) { showToast('请输入阶段编号', 'error'); return; }

        try {
            let stageId = id;

            if (id) {
                await fetch(`${API_BASE}/pet-stages/api/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
            } else {
                const res = await fetch(`${API_BASE}/pet-stages/api/create`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (!result.success) { showToast(result.message || '创建失败', 'error'); return; }
                stageId = result.data.id;
            }

            // 上传图片
            const imageFile = document.getElementById('editImageFile').files[0];
            if (imageFile && stageId) {
                const fd = new FormData();
                fd.append('file', imageFile);
                fd.append('stage_id', stageId);
                fd.append('field', 'image');
                await fetch(`${API_BASE}/pet-stages/upload`, { method: 'POST', body: fd });
            }

            // 上传动画
            const animFile = document.getElementById('editAnimFile').files[0];
            if (animFile && stageId) {
                const fd = new FormData();
                fd.append('file', animFile);
                fd.append('stage_id', stageId);
                fd.append('field', 'animation');
                await fetch(`${API_BASE}/pet-stages/upload`, { method: 'POST', body: fd });
            }

            showToast('保存成功');
            closeModal();
            loadStages();
        } catch (e) {
            showToast('保存失败', 'error');
        }
    }

    async function deleteStage(id) {
        if (!confirm('确定要删除该阶段吗？')) return;
        try {
            await fetch(`${API_BASE}/pet-stages/api/${id}`, { method: 'DELETE' });
            showToast('删除成功');
            loadStages();
        } catch (e) {
            showToast('删除失败', 'error');
        }
    }

    // ── 图片 Tab 切换 & AI 生成 ──

    function switchImgTab(tab) {
        document.getElementById('imgTab-upload').className = tab === 'upload'
            ? 'flex-1 py-1.5 rounded-md bg-white shadow-sm text-gray-800 transition-all'
            : 'flex-1 py-1.5 rounded-md text-gray-500 hover:text-gray-800 transition-all';
        document.getElementById('imgTab-ai').className = tab === 'ai'
            ? 'flex-1 py-1.5 rounded-md bg-white shadow-sm text-gray-800 transition-all'
            : 'flex-1 py-1.5 rounded-md text-gray-500 hover:text-gray-800 transition-all';
        document.getElementById('imgPanel-upload').className = tab === 'upload' ? '' : 'hidden';
        document.getElementById('imgPanel-ai').className = tab === 'ai' ? 'space-y-2' : 'hidden space-y-2';
    }

    function buildStagePrompt() {
        const petType = document.getElementById('editPetType');
        const petName = petType.options[petType.selectedIndex]?.text?.trim() || '';
        const stageName = document.getElementById('editName').value.trim();
        const stageDesc = document.getElementById('editDesc').value.trim();
        const unlockMsg = document.getElementById('editMessage').value.trim();
        const stageNum = document.getElementById('editStage').value;

        if (!petName && !stageName) {
            showToast('请先填写伙伴类型和阶段名称', 'error');
            return;
        }

        const prompt = `Create a hyper-realistic, photorealistic digital illustration of a cute ${petName} character at the "${stageName}" growth stage (stage ${stageNum || '?'}).

${stageDesc ? `Stage description: ${stageDesc}.` : ''}
${unlockMsg ? `Evolution context: ${unlockMsg}.` : ''}

Art direction:
- Photorealistic 3D rendering with subsurface scattering and soft studio lighting
- Adorable character design appealing to children aged 5-10
- Rich micro-details: realistic fur/petal/leaf textures, tiny water droplets, soft shadows
- Warm, inviting color palette with gentle bokeh background
- The character should feel alive — expressive eyes, natural pose
- Square composition (1:1), centered subject, clean background gradient
- Quality reference: Pixar/Disney character render quality`;

        document.getElementById('aiImagePrompt').value = prompt;
    }

    let _aiGeneratedUrl = '';

    async function generateStageImage() {
        const prompt = document.getElementById('aiImagePrompt').value.trim();
        if (!prompt) { showToast('请输入提示词', 'error'); return; }

        const stageId = document.getElementById('editId').value;

        try {
            showToast('AI 图片生成中，请耐心等待...', 'info');
            const res = await fetch(`${API_BASE}/pet-stages/api/generate-image`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ prompt, stage_id: stageId || undefined })
            });
            const data = await res.json();

            if (data.success) {
                _aiGeneratedUrl = data.url;
                document.getElementById('aiImagePreview').src = data.url;
                document.getElementById('aiImageResult').classList.remove('hidden');
                // 同步更新左侧上传面板的预览
                const uploadPreview = document.getElementById('editImagePreview');
                uploadPreview.src = data.url;
                uploadPreview.classList.remove('hidden');
                showToast('图片生成成功！');
            } else {
                showToast(data.message || '生成失败', 'error');
            }
        } catch (e) {
            showToast('生成失败: ' + e.message, 'error');
        }
    }

    // Init
    loadTypes();
</script>
