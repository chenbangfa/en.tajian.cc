<script>
    let currentPage = 1;
    let searchTimeout;
    let allCategories = [];
    let currentEditWord = null;
    let currentWordList = [];
    let currentSort = 'id';     // 当前排序字段
    let currentOrder = 'desc';  // 排序方向

    // ==================== Helper ====================

    function escHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // 对用于 onclick JS 字符串内的值做安全转义（替换 ' \ 和换行）
    function escJs(str) {
        if (!str) return '';
        return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n').replace(/\r/g, '');
    }

    function playAudio(url) {
        let fullUrl = url;
        if (url && url.startsWith('/')) fullUrl = window.location.origin + url;
        new Audio(fullUrl).play().catch(e => showToast('播放失败: ' + e.message, 'error'));
    }

    function renderAudioChip(label, url, { color = 'green', missingLabel = '+生成', onMissing = '', disabled = false } = {}) {
        const chipClass = url ? 'audio-chip has-audio' : `audio-chip missing-audio${disabled ? ' disabled-chip' : ''}`;
        const playClass = color === 'pink' ? 'text-pink-600 hover:text-pink-700'
            : color === 'blue' ? 'text-blue-600 hover:text-blue-700'
            : 'text-green-600 hover:text-green-700';
        const addClass = color === 'pink' ? 'text-pink-500 hover:text-pink-700'
            : color === 'blue' ? 'text-blue-500 hover:text-blue-700'
            : 'text-slate-500 hover:text-slate-700';

        if (url) {
            const regenBtn = onMissing
                ? `<button class="${addClass} audio-regen-btn" onclick="${onMissing}" title="重新生成并覆盖当前发音">重生</button>`
                : '';
            return `<span class="${chipClass}">
                <span class="audio-chip-label"><i class="fas fa-check-circle"></i>${label}</span>
                <span class="audio-chip-actions">
                    <button class="${playClass}" onclick="playAudio('${escJs(url)}')" title="播放"><i class="fas fa-play-circle"></i></button>
                    ${regenBtn}
                </span>
            </span>`;
        }
        if (disabled || !onMissing) {
            return `<span class="${chipClass}"><span class="audio-chip-label">${label}</span><span class="text-gray-300">—</span></span>`;
        }
        return `<span class="${chipClass}"><span class="audio-chip-label">${label}</span><button class="${addClass} audio-regen-btn" onclick="${onMissing}" title="生成">${missingLabel}</button></span>`;
    }

    function renderStatCard(label, value, theme = 'gray') {
        const colorClass = theme === 'blue'
            ? 'text-blue-600'
            : theme === 'green'
                ? 'text-green-600'
                : 'text-slate-600';
        return `<div class="stat-pill"><span>${label}</span><strong class="${colorClass}">${value || 0}</strong></div>`;
    }

    function hasText(value) {
        return !!(value && String(value).trim());
    }

    function needsAiEnhance(word) {
        const contentType = word.content_type || 'word';
        const hasExample = hasText(word.example_sentence);
        const needPhonetic = contentType === 'word' && !hasText(word.phonetic);
        const needExample = contentType !== 'sentence' && !hasExample;
        const needExampleTranslation = !hasText(word.example_translation);
        const needGrammar = !hasText(word.grammar_explanation);
        return needPhonetic || needExample || needExampleTranslation || needGrammar;
    }

    function buildWordsListUrl(page = 1, limit = 20) {
        const category = document.getElementById('filter-category').value;
        const search = document.getElementById('filter-search').value;
        let url = `${API_BASE}/words?page=${page}&limit=${limit}&sort=${currentSort}&order=${currentOrder}`;
        if (category) url += `&category_id=${category}`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        return url;
    }

    // ==================== Categories ====================

    async function loadCategories() {
        try {
            const res = await fetch(`${API_BASE}/categories`);
            const data = await res.json();
            if (data.success) {
                allCategories = data.data;
                populateCategorySelects();
            }
        } catch (e) { }
    }

    function populateCategorySelects() {
        const parents = allCategories.filter(c => !c.parent_id || c.parent_id === 0);
        const children = allCategories.filter(c => c.parent_id && c.parent_id !== 0);
        let options = '';
        parents.forEach(p => {
            options += `<option value="${p.id}">${p.icon || ''} ${p.name}</option>`;
            children.filter(c => c.parent_id === p.id).forEach(c => {
                options += `<option value="${c.id}">　↳ ${c.icon || ''} ${c.name}</option>`;
            });
        });

        const filterEl = document.getElementById('filter-category');
        filterEl.innerHTML = '<option value="">全部分类</option>' + options;

        const wordCatEl = document.getElementById('word-category');
        wordCatEl.innerHTML = '<option value="">未分类</option>' + options;
    }

    // ==================== Words List ====================

    async function loadWords(page = 1) {
        currentPage = page;
        const category = document.getElementById('filter-category').value;
        const search = document.getElementById('filter-search').value;
        const imageFilter = document.getElementById('filter-image').value;

        let url = buildWordsListUrl(page, 20);

        try {
            const res = await fetch(url);
            const data = await res.json();
            if (data.success) {
                let words = data.data.list;
                if (imageFilter === 'with') words = words.filter(w => w.image_url);
                if (imageFilter === 'without') words = words.filter(w => !w.image_url);
                currentWordList = words;
                renderWords(words, data.data.pagination);
            }
        } catch (e) { showToast('加载单词失败', 'error'); }
    }

    async function fetchAllFilteredWordsForEnhance() {
        const limit = 200;
        let page = 1;
        let totalPages = 1;
        const allWords = [];

        while (page <= totalPages) {
            const res = await fetch(buildWordsListUrl(page, limit));
            const data = await res.json();
            if (!data.success) {
                throw new Error(data.message || '加载筛选结果失败');
            }
            const list = data.data?.list || [];
            allWords.push(...list);
            const total = Number(data.data?.pagination?.total || list.length || 0);
            totalPages = Math.max(1, Math.ceil(total / limit));
            page += 1;
        }

        return allWords;
    }

    async function runBatchEnhance(wordIds, sourceLabel) {
        const uniqueIds = Array.from(new Set(wordIds.map(id => parseInt(id, 10)).filter(Boolean)));
        const defaultEnhanceEngine = 'deepseek';
        if (uniqueIds.length === 0) {
            showToast('当前没有需要补全的单词', 'error');
            return;
        }

        if (!confirm(`确定开始为${sourceLabel}的 ${uniqueIds.length} 个单词批量 AI 补全吗？\n\n将使用 DeepSeek 自动补齐缺失的音标、例句、中文翻译和语法详解，并按每批 10 个顺序执行；已有字段不会被覆盖。`)) {
            return;
        }

        const triggerBtn = document.getElementById('btn-enhance-filtered');
        const originalText = triggerBtn ? triggerBtn.innerHTML : '';
        if (triggerBtn) {
            triggerBtn.disabled = true;
            triggerBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> 正在批量补全...';
        }

        const chunks = [];
        for (let i = 0; i < uniqueIds.length; i += 10) {
            chunks.push(uniqueIds.slice(i, i + 10));
        }

        let success = 0;
        let failed = 0;
        let skipped = 0;

        try {
            for (let i = 0; i < chunks.length; i++) {
                if (triggerBtn) {
                    triggerBtn.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i> 补全中 ${i + 1}/${chunks.length}`;
                }

                const res = await fetch(`${API_BASE}/batch/enhance-existing`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ word_ids: chunks[i], engine: defaultEnhanceEngine })
                });
                const result = await res.json();
                if (!result.success) {
                    throw new Error(result.message || '批量补全失败');
                }

                success += result.data?.success?.length || 0;
                failed += result.data?.failed?.length || 0;
                skipped += result.data?.skipped?.length || 0;
            }

            await loadWords(currentPage);
            clearSelection();
            showToast(`批量补全完成：成功 ${success}，跳过 ${skipped}，失败 ${failed}`);
        } catch (error) {
            showToast(`批量补全失败: ${error.message}`, 'error');
        } finally {
            if (triggerBtn) {
                triggerBtn.disabled = false;
                triggerBtn.innerHTML = originalText;
            }
        }
    }

    async function batchEnhanceSelectedWords() {
        const ids = getSelectedIds();
        if (ids.length === 0) {
            showToast('请先选择要补全的单词', 'error');
            return;
        }
        await runBatchEnhance(ids, '已选');
    }

    async function batchEnhanceCurrentFilter() {
        try {
            let filteredWords = await fetchAllFilteredWordsForEnhance();
            const imageFilter = document.getElementById('filter-image').value;
            if (imageFilter === 'with') filteredWords = filteredWords.filter(w => w.image_url);
            if (imageFilter === 'without') filteredWords = filteredWords.filter(w => !w.image_url);
            const ids = filteredWords.filter(needsAiEnhance).map(item => item.id);
            await runBatchEnhance(ids, '当前筛选结果');
        } catch (error) {
            showToast(`加载筛选结果失败: ${error.message}`, 'error');
        }
    }

    function renderWords(words, pagination) {
        const tbody = document.querySelector('#words-table tbody');
        // 重置全选
        document.getElementById('select-all').checked = false;
        updateBatchActions();

        if (words.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-8 text-center text-gray-500">暂无单词数据</td></tr>';
            return;
        }

        tbody.innerHTML = words.map(w => {
            const sw = escHtml(w.word || '');
            const st = escHtml(w.translation || '');
            const se = escHtml(w.example_sentence || '');
            const set = escHtml(w.example_translation || '');
            // onclick 内 JS 字符串需要独立转义
            const jsw = escJs(w.word || '');
            const jse = escJs(w.example_sentence || '');
            const categoryName = escHtml(w.category_name || '未分类');
            const imageThumb = w.image_url
                ? `<img src="${escHtml(w.image_url)}" class="word-cover" onerror="this.outerHTML='<div class=&quot;word-cover-placeholder&quot;>📷</div>'">`
                : `<div class="word-cover-placeholder">📷</div>`;
            const exampleThumb = w.example_image_url
                ? `<img src="${escHtml(w.example_image_url)}" class="example-thumb cursor-pointer hover:border-orange-400" onclick="previewFullImage('${escJs(w.example_image_url)}')" title="点击查看大图">`
                : `<div class="example-thumb flex items-center justify-center text-gray-300 border-dashed">${w.example_sentence ? '<button class="text-orange-500 hover:text-orange-700 text-xs" onclick="quickGenExImage(' + w.id + ', this)">🎨+</button>' : '—'}</div>`;
            const audioChips = [
                renderAudioChip('中词', w.translation_audio_url, {
                    color: 'blue',
                    onMissing: `quickGenCnAudio(${w.id}, 'translation', this)`,
                    disabled: !w.translation
                }),
                renderAudioChip('女声', w.audio_url_female, {
                    color: 'pink',
                    onMissing: `quickGenAudio(${w.id}, '${jsw}', 'female', this)`
                }),
                renderAudioChip('男声', w.audio_url_male, {
                    color: 'blue',
                    onMissing: `quickGenAudio(${w.id}, '${jsw}', 'male', this)`
                }),
                renderAudioChip('中句', w.example_translation_audio_url, {
                    color: 'blue',
                    onMissing: `quickGenCnAudio(${w.id}, 'example_translation', this)`,
                    disabled: !w.example_translation
                }),
                renderAudioChip('例♀', w.example_audio_female, {
                    color: 'pink',
                    onMissing: `quickGenExAudio(${w.id}, '${jse}', 'female', this)`,
                    disabled: !w.example_sentence
                }),
                renderAudioChip('例♂', w.example_audio_male, {
                    color: 'blue',
                    onMissing: `quickGenExAudio(${w.id}, '${jse}', 'male', this)`,
                    disabled: !w.example_sentence
                })
            ].join('');

            return `
            <tr class="hover:bg-gray-50 transition-colors" data-word-id="${w.id}">
                <td class="px-2 py-3 text-center">
                    <input type="checkbox" class="word-checkbox w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer" value="${w.id}" onchange="updateBatchActions()">
                </td>
                <td class="px-4 py-4 align-top">
                    <div class="word-row-card">
                        ${imageThumb}
                        <div class="min-w-0">
                            <div class="word-meta-title">
                                <span class="text-lg font-bold text-slate-900">${sw}</span>
                                ${w.phonetic ? `<span class="font-mono text-xs text-slate-500 bg-slate-100 rounded-full px-3 py-1">${escHtml(w.phonetic)}</span>` : '<span class="font-mono text-xs text-slate-300 bg-slate-50 rounded-full px-3 py-1">无音标</span>'}
                            </div>
                            <div class="text-sm text-slate-700">${st}</div>
                            <div class="word-meta-badges">
                                <span class="mini-badge">${categoryName}</span>
                                <span class="mini-badge bg-orange-50 text-orange-600">ID ${w.id}</span>
                            </div>
                        </div>
                    </div>
                </td>
                <td class="px-4 py-4 align-top">
                    <div class="word-section-title">音频资源</div>
                    <div class="audio-chip-grid">${audioChips}</div>
                </td>
                <td class="px-4 py-4 align-top">
                    <div class="example-card">
                        <div class="word-section-title">例句内容</div>
                        <div class="flex gap-3 items-start">
                            ${exampleThumb}
                            <div class="min-w-0 flex-1">
                                <div class="text-sm text-slate-800 font-medium break-words">${se || '<span class="text-slate-300">暂无例句</span>'}</div>
                                <div class="text-xs text-slate-500 mt-2 break-words">${set || '<span class="text-slate-300">暂无中文例句</span>'}</div>
                            </div>
                        </div>
                    </div>
                </td>
                <td class="px-3 py-4 align-top">
                    <div class="stats-stack">
                        ${renderStatCard('浏览量', w.view_count, 'blue')}
                    </div>
                </td>
                <td class="px-3 py-4 align-top">
                    <div class="stats-stack">
                        ${renderStatCard('评测数', w.assess_count, 'green')}
                    </div>
                </td>
                <td class="px-4 py-4 text-right align-top" style="white-space:nowrap;">
                    <button class="text-blue-600 hover:text-blue-800 mr-2" onclick="openWordModal(${w.id})" title="编辑"><i class="fas fa-edit"></i></button>
                    <button class="text-red-500 hover:text-red-700" onclick="deleteWord(${w.id})" title="删除"><i class="fas fa-trash"></i></button>
                </td>
            </tr>
        `}).join('');

        // Pagination
        const totalPages = Math.ceil(pagination.total / pagination.limit);
        let pgHtml = '';
        if (totalPages > 1) {
            pgHtml = '<div class="flex items-center space-x-1">';

            // 上一页
            pgHtml += `<button onclick="loadWords(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}
                class="px-2.5 py-1 rounded-md text-sm transition-colors ${currentPage === 1 ? 'text-gray-300 cursor-not-allowed' : 'text-gray-600 hover:bg-gray-100'}">
                <i class="fas fa-chevron-left"></i></button>`;

            // 页码逻辑：显示首页 ... 当前附近 ... 尾页
            const pages = [];
            pages.push(1);
            let start = Math.max(2, currentPage - 2);
            let end = Math.min(totalPages - 1, currentPage + 2);
            if (start > 2) pages.push('...');
            for (let i = start; i <= end; i++) pages.push(i);
            if (end < totalPages - 1) pages.push('...');
            if (totalPages > 1) pages.push(totalPages);

            pages.forEach(p => {
                if (p === '...') {
                    pgHtml += `<span class="px-2 py-1 text-gray-400 text-sm">…</span>`;
                } else {
                    pgHtml += `<button onclick="loadWords(${p})"
                        class="px-3 py-1 rounded-md text-sm font-medium transition-colors ${p === currentPage ? 'bg-blue-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50'}">${p}</button>`;
                }
            });

            // 下一页
            pgHtml += `<button onclick="loadWords(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}
                class="px-2.5 py-1 rounded-md text-sm transition-colors ${currentPage === totalPages ? 'text-gray-300 cursor-not-allowed' : 'text-gray-600 hover:bg-gray-100'}">
                <i class="fas fa-chevron-right"></i></button>`;

            // 总数信息
            pgHtml += `<span class="text-xs text-gray-400 ml-3">共 ${pagination.total} 条 / ${totalPages} 页</span>`;
            pgHtml += '</div>';
        }
        document.getElementById('words-pagination').innerHTML = pgHtml;

        // 更新排序图标
        updateSortIcons();
    }

    function toggleSort(field) {
        if (currentSort === field) {
            // 同一字段切换方向
            currentOrder = currentOrder === 'desc' ? 'asc' : 'desc';
        } else {
            currentSort = field;
            currentOrder = 'desc'; // 新字段默认降序
        }
        loadWords(1);
    }

    function updateSortIcons() {
        // 重置所有排序图标
        ['view_count', 'assess_count'].forEach(field => {
            const icon = document.getElementById(`sort-icon-${field}`);
            if (icon) {
                if (currentSort === field) {
                    icon.className = currentOrder === 'desc'
                        ? 'fas fa-sort-down text-blue-600'
                        : 'fas fa-sort-up text-blue-600';
                } else {
                    icon.className = 'fas fa-sort text-gray-300';
                }
            }
        });
    }

    function debounceSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => loadWords(1), 300);
    }

