<div id="podcast-list-summary" class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
        <div class="text-xs tracking-wide text-gray-400 uppercase">当前结果</div>
        <div id="podcast-summary-total" class="mt-2 text-3xl font-bold text-gray-800">-</div>
        <div id="podcast-summary-path" class="mt-2 text-sm text-gray-500">全部课程包</div>
    </div>
    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
        <div class="text-xs tracking-wide text-gray-400 uppercase">涉及课程包</div>
        <div id="podcast-summary-packs" class="mt-2 text-3xl font-bold text-blue-600">-</div>
        <div class="mt-2 text-sm text-gray-500">按当前筛选统计</div>
    </div>
    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
        <div class="text-xs tracking-wide text-gray-400 uppercase">已分析内容</div>
        <div id="podcast-summary-analyzed" class="mt-2 text-3xl font-bold text-emerald-600">-</div>
        <div class="mt-2 text-sm text-gray-500">可直接查看句子拆分</div>
    </div>
    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
        <div class="text-xs tracking-wide text-gray-400 uppercase">缺音频内容</div>
        <div id="podcast-summary-missing-audio" class="mt-2 text-3xl font-bold text-amber-500">-</div>
        <div class="mt-2 text-sm text-gray-500">优先补齐可听资源</div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl">
        <div class="flex items-center space-x-4">
            <div>
                <h2 class="text-lg font-bold text-gray-800">内容列表</h2>
                <p class="text-xs text-gray-400 mt-1">按课程包筛选、补分析和音频，让磨耳朵内容更像可以直接学习的产品</p>
            </div>
            <select id="podcast-filter-cat" onchange="loadPodcastContents(1)"
                class="px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
                <option value="">全部分类</option>
            </select>
            <label class="inline-flex items-center gap-2 px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-sm text-gray-600 cursor-pointer">
                <input id="podcast-filter-unanalyzed" type="checkbox" onchange="loadPodcastContents(1)"
                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                <span>只看未分析</span>
            </label>
            <label class="inline-flex items-center gap-2 px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-sm text-gray-600 cursor-pointer">
                <input id="podcast-filter-missing-audio" type="checkbox" onchange="loadPodcastContents(1)"
                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                <span>只看缺音频</span>
            </label>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
                <span class="text-sm text-gray-500">每页</span>
                <select id="podcast-page-size" onchange="changePodcastPageSize(this.value)"
                    class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white">
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-sm text-gray-500">AI模型</span>
                <select id="podcast-analyze-engine"
                    class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none bg-white">
                    <option value="deepseek" selected>DeepSeek</option>
                    <option value="gemini">Gemini</option>
                </select>
            </div>
            <button onclick="batchAnalyzeSelected()"
                class="px-3 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors shadow-sm flex items-center text-sm">
                <i class="fas fa-layer-group mr-2"></i> 批量AI分析
            </button>
            <button onclick="batchAnalyzeCurrentFilter()"
                class="px-3 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors shadow-sm flex items-center text-sm">
                <i class="fas fa-filter mr-2"></i> 当前筛选批量AI分析
            </button>
            <button onclick="openPodcastContentModal()"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm flex items-center">
                <i class="fas fa-plus mr-2"></i> 新增内容
            </button>
            <a href="/podcast-videos"
                class="px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors shadow-sm flex items-center">
                <i class="fas fa-radio mr-2"></i> 播客视频
            </a>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left" id="podcast-contents-table">
            <thead>
                <tr class="bg-gray-50 text-gray-600 text-sm uppercase tracking-wider">
                    <th class="px-4 py-4 font-semibold w-14 text-center">
                        <input id="podcast-select-all" type="checkbox" onchange="toggleSelectAllPodcast(this.checked)"
                            class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                    </th>
                    <th class="px-6 py-4 font-semibold w-20">ID</th>
                    <th class="px-6 py-4 font-semibold w-56">标题</th>
                    <th class="px-6 py-4 font-semibold w-64">课程包</th>
                    <th class="px-6 py-4 font-semibold w-28">定位</th>
                    <th class="px-6 py-4 font-semibold w-48">音频状态</th>
                    <th class="px-6 py-4 font-semibold text-right">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <!-- Data loaded via JS -->
            </tbody>
        </table>
    </div>

    <div id="podcast-pagination"
        class="px-6 py-4 border-t border-gray-100 bg-gray-50 rounded-b-xl flex items-center justify-between gap-4 flex-wrap">
        <div class="text-sm text-gray-500" id="podcast-pagination-summary">共 0 条</div>
        <div class="flex items-center gap-2 flex-wrap" id="podcast-pagination-controls"></div>
    </div>
</div>

<!-- Modal -->
