                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">排序</label>
                    <input type="number" id="pcontent-sort" value="0"
                        class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
                </div>
                <div class="pb-2">
                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input type="checkbox" id="pcontent-free" checked
                            class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500 border-gray-300">
                        <span class="text-gray-700 text-sm">免费内容</span>
                    </label>
                </div>
            </div>

            <div class="flex justify-end space-x-3 mt-6 pt-4 border-t border-gray-100">
                <button type="button" onclick="closePodcastContentModal()"
                    class="px-4 py-2 text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">取消</button>
                <button type="submit"
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm">保存</button>
            </div>
        </form>
    </div>
</div>

<!-- 句子分析弹窗 -->
<div id="sentences-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-3xl max-h-[88vh] flex flex-col">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl flex-shrink-0">
            <div>
                <h3 class="text-lg font-bold text-gray-800" id="sentences-modal-title">句子分析</h3>
                <p class="text-xs text-gray-400 mt-0.5" id="sentences-modal-sub"></p>
            </div>
            <button onclick="closeSentencesModal()" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
        </div>
        <div id="sentences-list" class="overflow-y-auto p-6 space-y-4 flex-1"></div>
    </div>
</div>

<script>
    let podcastContents = [];
    let podcastCategories = [];
    let selectedPodcastIds = new Set();
    let podcastBatchRunning = false;
    let podcastCategoryPayload = null;
    let podcastListMeta = null;
    let podcastPagination = {
        page: 1,
        limit: 20,
        total: 0
    };

    async function loadPodcastCategories() {
        try {
            const res = await fetch(`${API_BASE}/podcast_categories`);
            const data = await res.json();
            if (data.success) {
                podcastCategoryPayload = data.data || {};
                podcastCategories = podcastCategoryPayload.tree || [];
                populateSelects();
            }
        } catch (e) { console.error('加载分类失败:', e); }
    }

    function getPodcastCategoryFilter() {
        return document.getElementById('podcast-filter-cat').value || '';
    }

    function isPodcastUnanalyzedFilterEnabled() {
        return !!document.getElementById('podcast-filter-unanalyzed')?.checked;
    }

    function isPodcastMissingAudioFilterEnabled() {
        return !!document.getElementById('podcast-filter-missing-audio')?.checked;
    }

    function buildPodcastListUrl(page = podcastPagination.page, limit = podcastPagination.limit) {
        const params = new URLSearchParams();
        params.set('page', String(page));
        params.set('limit', String(limit));
        const categoryId = getPodcastCategoryFilter();
        if (categoryId) params.set('category_id', categoryId);
        if (isPodcastUnanalyzedFilterEnabled()) params.set('filter_unanalyzed', '1');
        if (isPodcastMissingAudioFilterEnabled()) params.set('filter_missing_audio', '1');
        return `${API_BASE}/podcast?${params.toString()}`;
    }

    async function loadPodcastContents(page = 1) {
        try {
            const url = buildPodcastListUrl(page);
            const res = await fetch(url);
            const data = await res.json();
            if (data.success) {
                podcastListMeta = data.data;
                const total = Number(data.data.total || 0);
                const limit = Number(data.data.limit || podcastPagination.limit || 20);
                const totalPages = Math.max(1, Math.ceil(total / limit));
                if (total > 0 && page > totalPages) {
                    return loadPodcastContents(totalPages);
                }
                podcastContents = data.data.list;
                podcastPagination.page = Number(data.data.page || page || 1);
                podcastPagination.limit = limit;
                podcastPagination.total = total;
                selectedPodcastIds = new Set();
                renderPodcastSummary();
                renderPodcastContents();
                renderPodcastPagination();
            }
        } catch (e) {
            console.error('加载内容失败:', e);
            showToast('加载内容失败', 'error');
        }
    }

    function populateSelects() {
        const buildOptions = (categories, level = 0) => {
            let options = '';
            categories.forEach(c => {
                const indent = '&nbsp;&nbsp;&nbsp;&nbsp;'.repeat(level);
                const icon = c.icon || '';
                const prefix = level > 0 ? '└─ ' : '';
                const suffix = c.total_content_count ? ` (${c.total_content_count})` : '';
                options += `<option value="${c.id}">${indent}${prefix}${icon} ${c.name}${suffix}</option>`;
                if (c.children && c.children.length > 0) {
                    options += buildOptions(c.children, level + 1);
                }
            });
            return options;
        };

        const options = buildOptions(podcastCategories);
        document.getElementById('podcast-filter-cat').innerHTML = '<option value="">全部分类</option>' + options;
        document.getElementById('pcontent-category').innerHTML = '<option value="">选择分类</option>' + options;
    }

    function renderPodcastSummary() {
        const stats = podcastListMeta?.stats || {};
        const selected = podcastListMeta?.selected_category || null;
        document.getElementById('podcast-summary-total').textContent = stats.total || 0;
        document.getElementById('podcast-summary-packs').textContent = stats.course_pack_count || 0;
        document.getElementById('podcast-summary-analyzed').textContent = stats.analyzed_count || 0;
        document.getElementById('podcast-summary-missing-audio').textContent = stats.missing_audio_count || 0;
        document.getElementById('podcast-summary-path').textContent = selected?.path_names?.join(' / ') || '全部课程包';
    }

    function buildCategoryBreadcrumb(c) {
        return [c.grand_category_name, c.parent_category_name, c.category_name].filter(Boolean);
    }

    function renderDifficultyBadge(level) {
        const value = Number(level || 1);
        return `<span class="inline-flex items-center px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">Lv.${value}</span>`;
    }

    function renderPodcastContents() {
        const tbody = document.querySelector('#podcast-contents-table tbody');
        const selectAll = document.getElementById('podcast-select-all');
        if (podcastContents.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-8 text-center text-gray-500">暂无内容数据</td></tr>';
            if (selectAll) selectAll.checked = false;
            renderPodcastPagination();
            return;
        }

        tbody.innerHTML = podcastContents.map(c => {
            const hasF = c.female_audio_url ? '<span class="text-pink-500" title="女声">♀</span>' : '<span class="text-gray-300">♀</span>';
            const hasC = c.chinese_audio_url ? '<span class="text-red-500" title="中文">中</span>' : '<span class="text-gray-300">中</span>';
            const isChecked = selectedPodcastIds.has(String(c.id));
            const breadcrumb = buildCategoryBreadcrumb(c);

            return `
            <tr class="hover:bg-gray-50 transition-colors group">
                <td class="px-4 py-4 text-center">
                    <input type="checkbox" ${isChecked ? 'checked' : ''} onchange="togglePodcastSelection(${c.id}, this.checked)"
                        class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                </td>
                <td class="px-6 py-4 text-gray-500">#${c.id}</td>
                <td class="px-6 py-4">
                    <div class="font-medium text-gray-900 max-w-[16rem]"><span class="block truncate" title="${c.title_en || c.title}">${c.title_en || c.title}</span></div>
                    ${c.title_zh ? `<div class="text-xs text-emerald-600 mt-1 max-w-[16rem] truncate" title="${c.title_zh}">${c.title_zh}</div>` : ''}
                    ${(!c.title_zh && c.title && /[\u3400-\u9fff]/.test(c.title)) ? `<div class="text-xs text-emerald-600 mt-1 max-w-[16rem] truncate" title="${c.title}">${c.title}</div>` : ''}
                </td>
                <td class="px-6 py-4">
                    <div class="text-xs text-gray-400">${breadcrumb.join(' / ') || '未分类'}</div>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <span class="px-2 py-1 bg-blue-50 text-blue-600 rounded text-xs font-medium">${c.category_name || '-'}</span>
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">课包共 ${c.pack_item_count || 0} 篇</span>
                    </div>
                </td>
                <td class="px-6 py-4">
                    ${renderDifficultyBadge(c.difficulty_level)}
                    <div class="mt-2 text-xs text-gray-400">${c.is_free ? '免费内容' : '付费内容'}</div>
                </td>
                <td class="px-6 py-4 text-lg space-x-1">
                    ${hasF} ${hasC}
                    ${c.has_sentences === 1 ? '<span class="ml-1 px-1.5 py-0.5 bg-green-100 text-green-700 rounded text-xs font-medium">✦ 已分析</span>'
                      : c.has_sentences === -1 ? '<span class="ml-1 px-1.5 py-0.5 bg-yellow-100 text-yellow-700 rounded text-xs font-medium animate-pulse">分析中...</span>'
                      : ''}
                </td>
                <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                    ${c.has_sentences === 1 ? `<button class="text-teal-600 hover:text-teal-800 transition-colors" onclick="viewSentences(${c.id})"><i class="fas fa-list"></i> 查看分析</button>` : ''}
                    <button class="text-green-600 hover:text-green-800 transition-colors" onclick="analyzePodcastSentences(${c.id}, this)"><i class="fas fa-robot"></i> AI分析</button>
                    <button class="text-purple-600 hover:text-purple-800 transition-colors" onclick="generatePodcastAudio(${c.id})"><i class="fas fa-volume-up"></i> 生成音频</button>
                    <button class="text-blue-600 hover:text-blue-800 transition-colors" onclick="editPodcastContent(${c.id})"><i class="fas fa-edit"></i> 编辑</button>
                    <button class="text-red-600 hover:text-red-800 transition-colors" onclick="deletePodcastContent(${c.id})"><i class="fas fa-trash"></i> 删除</button>
                </td>
            </tr>
        `}).join('');
        syncPodcastSelectAllState();
    }

    function getPodcastTotalPages() {
        return Math.max(1, Math.ceil((podcastPagination.total || 0) / (podcastPagination.limit || 20)));
    }

    function buildPodcastPageNumbers(current, total) {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

        const pages = new Set([1, total, current]);
        if (current - 1 > 1) pages.add(current - 1);
        if (current + 1 < total) pages.add(current + 1);
        if (current - 2 > 1) pages.add(current - 2);
        if (current + 2 < total) pages.add(current + 2);

        const sorted = Array.from(pages).sort((a, b) => a - b);
        const result = [];
        for (let i = 0; i < sorted.length; i++) {
            result.push(sorted[i]);
            if (sorted[i + 1] && sorted[i + 1] - sorted[i] > 1) result.push('...');
        }
        return result;
    }

    function renderPodcastPagination() {
        const summaryEl = document.getElementById('podcast-pagination-summary');
        const controlsEl = document.getElementById('podcast-pagination-controls');
        if (!summaryEl || !controlsEl) return;

        const total = podcastPagination.total || 0;
        const current = podcastPagination.page || 1;
        const totalPages = getPodcastTotalPages();
        const start = total === 0 ? 0 : (current - 1) * podcastPagination.limit + 1;
        const end = total === 0 ? 0 : Math.min(current * podcastPagination.limit, total);

        summaryEl.textContent = `共 ${total} 条，当前第 ${current} / ${totalPages} 页，显示 ${start}-${end} 条`;

        if (totalPages <= 1) {
            controlsEl.innerHTML = '';
            return;
        }

        const pages = buildPodcastPageNumbers(current, totalPages);
        controlsEl.innerHTML = `
            <button onclick="changePodcastPage(${current - 1})" ${current <= 1 ? 'disabled' : ''}
                class="px-3 py-1.5 rounded-lg text-sm border ${current <= 1 ? 'border-gray-200 text-gray-300 bg-white cursor-not-allowed' : 'border-gray-300 text-gray-600 bg-white hover:bg-gray-100'}">
                上一页
            </button>
            ${pages.map(page => {
                if (page === '...') {
                    return '<span class="px-2 text-gray-400 text-sm">...</span>';
                }
                const active = page === current;
                return `<button onclick="changePodcastPage(${page})"
                    class="min-w-[2.4rem] px-3 py-1.5 rounded-lg text-sm border ${active ? 'border-blue-600 bg-blue-600 text-white' : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-100'}">
                    ${page}
                </button>`;
            }).join('')}
            <button onclick="changePodcastPage(${current + 1})" ${current >= totalPages ? 'disabled' : ''}
                class="px-3 py-1.5 rounded-lg text-sm border ${current >= totalPages ? 'border-gray-200 text-gray-300 bg-white cursor-not-allowed' : 'border-gray-300 text-gray-600 bg-white hover:bg-gray-100'}">
                下一页
            </button>
        `;
    }

    function changePodcastPage(page) {
        const totalPages = getPodcastTotalPages();
        if (page < 1 || page > totalPages || page === podcastPagination.page) return;
        loadPodcastContents(page);
    }

    function changePodcastPageSize(size) {
        const parsed = parseInt(size, 10) || 20;
        podcastPagination.limit = parsed;
        loadPodcastContents(1);
    }

    async function collectPodcastIdsForCurrentFilter({ onlyPending = false } = {}) {
        const limit = 200;
        const firstUrl = buildPodcastListUrl(1, limit);
        const firstRes = await fetch(firstUrl);
        const firstData = await firstRes.json();
        if (!firstData.success) throw new Error(firstData.message || '加载筛选内容失败');

        let allItems = Array.isArray(firstData.data.list) ? [...firstData.data.list] : [];
        const total = Number(firstData.data.total || allItems.length || 0);
        const totalPages = Math.max(1, Math.ceil(total / limit));

        for (let page = 2; page <= totalPages; page++) {
            const res = await fetch(buildPodcastListUrl(page, limit));
            const data = await res.json();
            if (!data.success) throw new Error(data.message || `加载第 ${page} 页失败`);
            allItems = allItems.concat(Array.isArray(data.data.list) ? data.data.list : []);
        }

        if (onlyPending) {
            allItems = allItems.filter(item => item.has_sentences === 0);
        }
        return allItems.map(item => item.id);
    }

    function getSelectedPodcastEngine() {
        return document.getElementById('podcast-analyze-engine')?.value || 'deepseek';
    }

    function togglePodcastSelection(id, checked) {
        const key = String(id);
        if (checked) selectedPodcastIds.add(key);
        else selectedPodcastIds.delete(key);
        syncPodcastSelectAllState();
    }

    function toggleSelectAllPodcast(checked) {
        const ids = podcastContents.map(item => String(item.id));
        if (checked) ids.forEach(id => selectedPodcastIds.add(id));
        else ids.forEach(id => selectedPodcastIds.delete(id));
        renderPodcastContents();
    }

    function syncPodcastSelectAllState() {
        const selectAll = document.getElementById('podcast-select-all');
        if (!selectAll) return;
        if (!podcastContents.length) {
            selectAll.checked = false;
            selectAll.indeterminate = false;
            return;
        }
        const ids = podcastContents.map(item => String(item.id));
        const selectedCount = ids.filter(id => selectedPodcastIds.has(id)).length;
        selectAll.checked = selectedCount > 0 && selectedCount === ids.length;
        selectAll.indeterminate = selectedCount > 0 && selectedCount < ids.length;
    }

    async function batchAnalyzeSelected() {
        if (podcastBatchRunning) return;
        const ids = Array.from(selectedPodcastIds).map(id => parseInt(id, 10)).filter(Boolean);
        if (!ids.length) {
            showToast('请先勾选要分析的内容', 'error');
            return;
        }
        const engine = getSelectedPodcastEngine();
        if (!confirm(`将使用 ${engine === 'deepseek' ? 'DeepSeek' : 'Gemini'} 批量分析选中的 ${ids.length} 条内容。已存在分析内容也会重新分析，是否继续？`)) return;
        await runPodcastBatchAnalyze(ids, { skipExisting: false });
    }

    async function batchAnalyzeCurrentFilter() {
        if (podcastBatchRunning) return;
        const engine = getSelectedPodcastEngine();
        try {
            const pending = await collectPodcastIdsForCurrentFilter({ onlyPending: true });
            if (!pending.length) {
                showToast('当前筛选下没有待分析内容', 'error');
                return;
            }
            if (!confirm(`将使用 ${engine === 'deepseek' ? 'DeepSeek' : 'Gemini'} 批量分析当前筛选下待分析的 ${pending.length} 条内容，是否继续？`)) return;
            await runPodcastBatchAnalyze(pending, { skipExisting: true });
        } catch (e) {
            console.error('批量加载筛选内容失败:', e);
            showToast('加载当前筛选内容失败: ' + e.message, 'error');
        }
    }

    async function runPodcastBatchAnalyze(ids, options = {}) {
        const engine = getSelectedPodcastEngine();
        const selectedBtn = document.querySelector('button[onclick="batchAnalyzeSelected()"]');
        const filterBtn = document.querySelector('button[onclick="batchAnalyzeCurrentFilter()"]');
        const previousSelected = selectedBtn ? selectedBtn.innerHTML : '';
        const previousFilter = filterBtn ? filterBtn.innerHTML : '';
        podcastBatchRunning = true;
        if (selectedBtn) selectedBtn.disabled = true;
        if (filterBtn) filterBtn.disabled = true;

        let successCount = 0;
        let failureCount = 0;
        const failedIds = [];

        try {
            for (let i = 0; i < ids.length; i++) {
                const id = ids[i];
                const content = podcastContents.find(item => item.id === id);
                const name = content?.title || `#${id}`;
                if (selectedBtn) selectedBtn.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i>分析中 ${i + 1}/${ids.length}`;
                if (filterBtn) filterBtn.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i>分析中 ${i + 1}/${ids.length}`;

                if (options.skipExisting && content && content.has_sentences !== 0) {
                    continue;
                }

                try {
                    const result = await analyzePodcastSentences(id, null, { engine, silent: true });
                    if (result && result.success) {
                        successCount++;
                    } else {
                        failureCount++;
                        failedIds.push(name);
                    }
                } catch (e) {
                    failureCount++;
                    failedIds.push(name);
                }
            }
        } finally {
            podcastBatchRunning = false;
            if (selectedBtn) {
                selectedBtn.disabled = false;
                selectedBtn.innerHTML = previousSelected;
            }
            if (filterBtn) {
                filterBtn.disabled = false;
                filterBtn.innerHTML = previousFilter;
            }
        }

        await loadPodcastContents(podcastPagination.page);
        if (failureCount > 0) {
            showToast(`批量分析完成：成功 ${successCount} 条，失败 ${failureCount} 条`, 'error');
            console.warn('[Podcast Batch Analyze] failed:', failedIds);
            return;
        }
        showToast(`批量分析完成：成功 ${successCount} 条`);
    }

    function openPodcastContentModal() {
        document.getElementById('pcontent-id').value = '';
        document.getElementById('pcontent-title-en').value = '';
        document.getElementById('pcontent-title-zh').value = '';
        document.getElementById('pcontent-text').value = '';
        document.getElementById('pcontent-category').value = '';
        document.getElementById('pcontent-difficulty').value = '1';
        document.getElementById('pcontent-sort').value = '0';
        document.getElementById('pcontent-free').checked = true;
        document.getElementById('podcast-content-modal-title').textContent = '新增内容';

        const modal = document.getElementById('podcast-content-modal');
        const content = document.getElementById('modal-content');
        modal.classList.remove('hidden');
        requestAnimationFrame(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        });
    }

    function closePodcastContentModal() {
        const modal = document.getElementById('podcast-content-modal');
        const content = document.getElementById('modal-content');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => modal.classList.add('hidden'), 300);
    }

    async function editPodcastContent(id) {
        try {
            const res = await fetch(`${API_BASE}/podcast/${id}`);
            const data = await res.json();
            if (data.success) {
                const c = data.data;
                document.getElementById('pcontent-id').value = c.id;
                const titleValue = c.title || '';
                const titleLooksChinese = /[\u3400-\u9fff]/.test(titleValue);
                document.getElementById('pcontent-title-en').value = c.title_en || (titleLooksChinese ? '' : titleValue);
                document.getElementById('pcontent-title-zh').value = c.title_zh || (titleLooksChinese ? titleValue : '');
                document.getElementById('pcontent-text').value = c.content_text || '';
                document.getElementById('pcontent-category').value = c.category_id || '';
                document.getElementById('pcontent-difficulty').value = c.difficulty_level || 1;
                document.getElementById('pcontent-sort').value = c.sort_order || 0;
                document.getElementById('pcontent-free').checked = c.is_free;
                document.getElementById('podcast-content-modal-title').textContent = '编辑内容';

                const modal = document.getElementById('podcast-content-modal');
                const content = document.getElementById('modal-content');
                modal.classList.remove('hidden');
                requestAnimationFrame(() => {
                    content.classList.remove('scale-95', 'opacity-0');
                    content.classList.add('scale-100', 'opacity-100');
                });
            }
        } catch (e) { showToast('获取详情失败', 'error'); }
    }

    async function deletePodcastContent(id) {
        if (!confirm('确定删除此内容？')) return;
        try {
            const res = await fetch(`${API_BASE}/podcast/${id}`, { method: 'DELETE' });
            if (res.ok) {
                showToast('删除成功');
                loadPodcastContents(podcastPagination.page);
            } else {
                showToast('删除失败', 'error');
            }
        } catch (e) { showToast('删除失败', 'error'); }
    }

    document.getElementById('podcast-content-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('pcontent-id').value;
        const titleEn = document.getElementById('pcontent-title-en').value.trim();
        const titleZh = document.getElementById('pcontent-title-zh').value.trim();
        const data = {
            title: titleZh || titleEn,
            title_en: titleEn,
            title_zh: titleZh,
            content_text: document.getElementById('pcontent-text').value,
            category_id: document.getElementById('pcontent-category').value || null,
            difficulty_level: parseInt(document.getElementById('pcontent-difficulty').value) || 1,
            sort_order: parseInt(document.getElementById('pcontent-sort').value) || 0,
            is_free: document.getElementById('pcontent-free').checked
        };
        try {
            const url = id ? `${API_BASE}/podcast/${id}` : `${API_BASE}/podcast`;
            const res = await fetch(url, {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                showToast('保存成功');
                closePodcastContentModal();
                loadPodcastContents(podcastPagination.page);
            } else {
                showToast('保存失败', 'error');
            }
        } catch (e) { showToast('保存失败', 'error'); }
    });

    async function generatePodcastAudio(id) {
        if (!confirm('将生成 Google 女声音频和中文音频，是否继续？')) return;
        try {
            const btn = event.target.closest('button');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 生成中...';

            const res = await fetch(`${API_BASE}/podcast/generate-all-audio`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content_id: id })
            });
            const data = await res.json();

            if (data.success) {
                showToast('音频生成完成！');
                loadPodcastContents(podcastPagination.page);
            } else {
                showToast('生成失败: ' + (data.message || '未知错误'), 'error');
            }
        } catch (e) {
            showToast('生成失败: ' + e.message, 'error');
        } finally {
            // Restore button state is handled by reload, but if reload fails/not called immediately:
            // btn.disabled = false; btn.innerHTML = originalText;
        }
    }

    async function analyzePodcastSentences(id, btn, options = {}) {
        const engine = options.engine || getSelectedPodcastEngine();
        if (!options.silent && !confirm(`将使用 ${engine === 'deepseek' ? 'DeepSeek' : 'Gemini'} 分析句子、翻译和关键词，并为每句生成音频，可能需要几十秒，是否继续？`)) return null;
        const originalHtml = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 分析中...';
        }
        try {
            const res = await fetch(`${API_BASE}/podcast/analyze-sentences/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ engine })
            });
            const data = await res.json();
            if (data.success) {
                if (!options.silent) {
                    const engineLabel = (data.data?.engine || engine) === 'deepseek' ? 'DeepSeek' : 'Gemini';
                    showToast(`${data.message || 'AI分析完成！'}（${engineLabel}）`);
                }
                if (!options.silent) await loadPodcastContents(podcastPagination.page);
                return data;
            } else {
                if (!options.silent) showToast('分析失败: ' + (data.message || '未知错误'), 'error');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
                return data;
            }
        } catch (e) {
            if (!options.silent) showToast('分析失败: ' + e.message, 'error');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
            throw e;
        } finally {
            if (btn && options.silent) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    }

    // ── 句子分析弹窗 ──
    let _sentenceAudio = null;

    async function viewSentences(id) {
        document.getElementById('sentences-modal-title').textContent = '句子分析';
        document.getElementById('sentences-modal-sub').textContent = '加载中...';
        document.getElementById('sentences-list').innerHTML = '<div class="text-center text-gray-400 py-8">加载中...</div>';
        document.getElementById('sentences-modal').classList.remove('hidden');

        try {
            const res = await fetch(`${API_BASE}/podcast/${id}`);
            const data = await res.json();
            if (!data.success || !data.data.sentences_data || !data.data.sentences_data.sentences) {
                document.getElementById('sentences-list').innerHTML = '<div class="text-center text-gray-400 py-8">暂无分析数据</div>';
                return;
            }
            const content = data.data;
            const sentences = content.sentences_data.sentences;
            document.getElementById('sentences-modal-title').textContent = content.title;
            document.getElementById('sentences-modal-sub').textContent = `共 ${sentences.length} 句`;
            renderSentencesList(sentences);
        } catch (e) {
            document.getElementById('sentences-list').innerHTML = `<div class="text-center text-red-400 py-8">加载失败: ${e.message}</div>`;
        }
    }

    function renderSentencesList(sentences) {
        const BASE = 'https://english.tajian.cc';
        const fmtUrl = u => u && !u.startsWith('http') ? BASE + u : u;

        document.getElementById('sentences-list').innerHTML = sentences.map((s, i) => {
            const femaleUrl = fmtUrl(s.female_audio_url || s.male_audio_url);
            const wordsHtml = (s.words || []).map(w => {
                const wUrl = fmtUrl(w.audio_url);
                return `<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-blue-50 text-blue-700 rounded-full text-xs">
                    <span class="font-medium">${w.word}</span>
                    <span class="text-blue-400">${w.phonetic || ''}</span>
                    <span class="text-gray-500">${w.pos || ''}</span>
                    <span class="text-gray-700">${w.translation || ''}</span>
                    ${wUrl ? `<button onclick="playAudio('${wUrl}')" title="播放" class="text-blue-500 hover:text-blue-700 ml-0.5">🔊</button>` : ''}
                </span>`;
            }).join('');

            return `<div class="border border-gray-100 rounded-xl p-4 hover:border-blue-200 transition-colors">
                <div class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-7 h-7 flex items-center justify-center bg-gray-100 text-gray-500 rounded-full text-xs font-bold">${i + 1}</span>
                    <div class="flex-1 min-w-0">
                        <p class="text-gray-900 font-medium text-sm leading-relaxed">${s.text}</p>
                        <p class="text-gray-500 text-xs mt-1 leading-relaxed">${s.translation || ''}</p>
                        ${s.grammar ? `<p class="text-teal-600 text-xs mt-1.5 bg-teal-50 px-2 py-1 rounded">📝 ${s.grammar}</p>` : ''}
                        ${wordsHtml ? `<div class="flex flex-wrap gap-1.5 mt-2">${wordsHtml}</div>` : ''}
                    </div>
                    <div class="flex gap-1.5 flex-shrink-0">
                        ${femaleUrl ? `<button onclick="playAudio('${femaleUrl}')" class="px-2 py-1 bg-pink-100 text-pink-700 rounded text-xs hover:bg-pink-200 transition-colors" title="女声">♀</button>` : ''}
                    </div>
                </div>
            </div>`;
        }).join('');
    }

    function playAudio(url) {
        if (_sentenceAudio) { _sentenceAudio.pause(); _sentenceAudio = null; }
        _sentenceAudio = new Audio(url);
        _sentenceAudio.play();
    }

    function closeSentencesModal() {
        if (_sentenceAudio) { _sentenceAudio.pause(); _sentenceAudio = null; }
        document.getElementById('sentences-modal').classList.add('hidden');
    }

    document.getElementById('sentences-modal').addEventListener('click', function(e) {
        if (e.target === this) closeSentencesModal();
    });

    document.addEventListener('DOMContentLoaded', () => {
        loadPodcastCategories();
        loadPodcastContents(1);
    });
</script>
