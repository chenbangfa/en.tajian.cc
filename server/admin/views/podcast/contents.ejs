    class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50 flex items-center justify-center transition-opacity duration-300">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl transform transition-all duration-300 scale-95 opacity-0"
        id="modal-content">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl">
            <h3 class="text-lg font-bold text-gray-800" id="podcast-content-modal-title">新增内容</h3>
            <button onclick="closePodcastContentModal()"
                class="text-gray-400 hover:text-gray-600 transition-colors text-xl">&times;</button>
        </div>

        <form id="podcast-content-form" class="p-6 space-y-4 max-h-[80vh] overflow-y-auto">
            <input type="hidden" id="pcontent-id">

            <div class="grid grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">英文标题 *</label>
                    <input type="text" id="pcontent-title-en" required placeholder="A dentist came to school!"
                        class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">中文标题</label>
                    <input type="text" id="pcontent-title-zh" placeholder="牙医来到学校"
                        class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">分类</label>
                    <select id="pcontent-category"
                        class="w-full px-4 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"></select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">英文内容 *</label>
