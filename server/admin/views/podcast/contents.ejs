<div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/80 overflow-hidden">
    <!-- 头部栏 -->
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gradient-to-r from-gray-50/80 to-white">
        <div class="flex items-center space-x-4">
            <h2 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600 tracking-tight">内容列表</h2>
            <div class="relative">
                <select id="podcast-filter-cat" onchange="loadPodcastContents()"
                    class="appearance-none pl-4 pr-10 py-2 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:border-blue-400 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none shadow-sm cursor-pointer">
                    <option value="">全部分类</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                    <i class="fas fa-chevron-down text-xs"></i>
                </div>
            </div>
        </div>
        <button onclick="openPodcastContentModal()"
            class="group px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-medium rounded-xl hover:shadow-lg hover:shadow-blue-500/30 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center">
            <i class="fas fa-plus mr-2 group-hover:rotate-90 transition-transform duration-300"></i> 新增内容
        </button>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="podcast-contents-table">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-100 text-gray-500 text-xs font-semibold uppercase tracking-wider">
                    <th class="px-6 py-4 w-20">ID</th>
                    <th class="px-6 py-4">标题</th>
                    <th class="px-6 py-4 w-32">分类</th>
                    <th class="px-6 py-4 w-24">难度</th>
                    <th class="px-6 py-4 w-40">音频状态</th>
                    <th class="px-6 py-4 w-72 text-right">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 bg-white">
                <!-- Data loaded via JS -->
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div id="podcast-content-modal"
    class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm hidden z-[100] flex items-center justify-center transition-opacity duration-300">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl transform transition-all duration-300 scale-95 opacity-0 border border-gray-100 flex flex-col max-h-[90vh]"
        id="modal-content">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 rounded-t-2xl flex-shrink-0">
            <h3 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-700" id="podcast-content-modal-title">新增内容</h3>
            <button onclick="closePodcastContentModal()"
                class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-200">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form id="podcast-content-form" class="p-6 space-y-5 overflow-y-auto flex-1">
            <input type="hidden" id="pcontent-id">

            <div class="grid grid-cols-2 gap-5">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">标题 <span class="text-red-500">*</span></label>
                    <input type="text" id="pcontent-title" required
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 text-gray-900 rounded-xl focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">分类</label>
                    <div class="relative">
                        <select id="pcontent-category"
                            class="appearance-none w-full pl-4 pr-10 py-2.5 bg-gray-50 border border-gray-200 text-gray-900 rounded-xl focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none cursor-pointer">
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-500">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">英文内容 <span class="text-red-500">*</span></label>
                <textarea id="pcontent-text" rows="10" required placeholder="英文对话或句子"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 text-gray-900 rounded-xl focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none resize-y"></textarea>
            </div>

            <div class="grid grid-cols-3 gap-5 items-end">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">难度等级 (1-5)</label>
                    <input type="number" id="pcontent-difficulty" min="1" max="5" value="1"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 text-gray-900 rounded-xl focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">排序</label>
                    <input type="number" id="pcontent-sort" value="0"
                        class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 text-gray-900 rounded-xl focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none">
                </div>
                <div class="pb-2.5 pl-2">
                    <label class="inline-flex items-center cursor-pointer group">
                        <div class="relative flex items-center">
                            <input type="checkbox" id="pcontent-free" checked class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-500/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-blue-600 peer-checked:to-indigo-600"></div>
                        </div>
                        <span class="ml-3 text-sm font-medium text-gray-700 group-hover:text-blue-600 transition-colors">免费内容</span>
                    </label>
                </div>
            </div>

            <div class="flex justify-end space-x-4 mt-8 pt-5 border-t border-gray-100 flex-shrink-0">
                <button type="button" onclick="closePodcastContentModal()"
                    class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-200 transition-all">取消</button>
                <button type="submit"
                    class="px-5 py-2.5 text-sm font-medium bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-xl hover:shadow-lg hover:shadow-blue-500/30 transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">保存</button>
            </div>
        </form>
    </div>
</div>

<!-- 句子分析弹窗 -->
<div id="sentences-modal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm hidden z-[100] flex items-center justify-center transition-opacity duration-300">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[88vh] flex flex-col transform transition-all duration-300 scale-95 opacity-0 border border-gray-100" id="sentences-modal-content">
        <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 rounded-t-2xl flex-shrink-0">
            <div>
                <h3 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-700" id="sentences-modal-title">句子分析</h3>
                <p class="text-sm text-gray-500 mt-1 font-medium" id="sentences-modal-sub"></p>
            </div>
            <button onclick="closeSentencesModal()" class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-200">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="sentences-list" class="overflow-y-auto p-6 space-y-4 flex-1 bg-gray-50/30"></div>
    </div>
</div>

<script>
    let podcastContents = [];
    let podcastCategories = [];

    async function loadPodcastCategories() {
        try {
            const res = await fetch(`${API_BASE}/podcast_categories`);
            const data = await res.json();
            if (data.success) {
                podcastCategories = data.data;
                populateSelects();
            }
        } catch (e) { console.error('加载分类失败:', e); }
    }

    async function loadPodcastContents() {
        try {
            const categoryId = document.getElementById('podcast-filter-cat').value;
            const url = categoryId ? `${API_BASE}/podcast?category_id=${categoryId}` : `${API_BASE}/podcast`;
            const res = await fetch(url);
            const data = await res.json();
            if (data.success) {
                podcastContents = data.data.list;
                renderPodcastContents();
            }
        } catch (e) {
            console.error('加载内容失败:', e);
            showToast('加载内容失败', 'error');
        }
    }

    function populateSelects() {
        const buildOptions = (categories, level = 0) => {
            let options = '';
            categories.forEach(c => {
                const indent = '&nbsp;&nbsp;&nbsp;&nbsp;'.repeat(level);
                const icon = c.icon || '';
                const prefix = level > 0 ? '└─ ' : '';
                options += `<option value="${c.id}">${indent}${prefix}${icon} ${c.name}</option>`;
                if (c.children && c.children.length > 0) {
                    options += buildOptions(c.children, level + 1);
                }
            });
            return options;
        };

        const options = buildOptions(podcastCategories);
        document.getElementById('podcast-filter-cat').innerHTML = '<option value="">全部分类</option>' + options;
        document.getElementById('pcontent-category').innerHTML = '<option value="">选择分类</option>' + options;
    }

    function renderPodcastContents() {
        const tbody = document.querySelector('#podcast-contents-table tbody');
        if (podcastContents.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">暂无内容数据</td></tr>';
            return;
        }

        tbody.innerHTML = podcastContents.map(c => {
            const hasM = c.male_audio_url ? '<span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-50 text-blue-500 text-xs shadow-sm ring-1 ring-blue-100" title="男声">♂</span>' : '<span class="flex items-center justify-center w-6 h-6 rounded-full bg-gray-50 text-gray-300 text-xs">♂</span>';
            const hasF = c.female_audio_url ? '<span class="flex items-center justify-center w-6 h-6 rounded-full bg-pink-50 text-pink-500 text-xs shadow-sm ring-1 ring-pink-100" title="女声">♀</span>' : '<span class="flex items-center justify-center w-6 h-6 rounded-full bg-gray-50 text-gray-300 text-xs">♀</span>';
            const hasC = c.chinese_audio_url ? '<span class="flex items-center justify-center w-6 h-6 rounded-full bg-red-50 text-red-500 text-xs shadow-sm ring-1 ring-red-100" title="中文">中</span>' : '<span class="flex items-center justify-center w-6 h-6 rounded-full bg-gray-50 text-gray-300 text-xs">中</span>';

            return `
            <tr class="hover:bg-blue-50/30 transition-colors duration-200 group">
                <td class="px-6 py-4 text-sm text-gray-400 font-medium">#${c.id}</td>
                <td class="px-6 py-4">
                    <span class="text-sm font-semibold text-gray-800 group-hover:text-blue-600 transition-colors">${c.title}</span>
                </td>
                <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">${c.category_name || '-'}</span>
                </td>
                <td class="px-6 py-4">
                    <div class="flex text-yellow-400 text-xs drop-shadow-sm">${'⭐'.repeat(c.difficulty_level || 1)}</div>
                </td>
                <td class="px-6 py-4">
                    <div class="flex items-center space-x-1.5">
                        ${hasM} ${hasF} ${hasC}
                        ${c.has_sentences === 1 ? '<span class="ml-2 px-2 py-1 bg-gradient-to-r from-emerald-50 to-teal-50 text-teal-600 border border-teal-100 rounded-md text-[10px] font-bold uppercase tracking-wide">已分析</span>'
                          : c.has_sentences === -1 ? '<span class="ml-2 px-2 py-1 bg-amber-50 text-amber-600 border border-amber-100 rounded-md text-[10px] font-bold uppercase tracking-wide animate-pulse">分析中...</span>'
                          : ''}
                    </div>
                </td>
                <td class="px-6 py-4 text-right transform opacity-0 group-hover:opacity-100 transition-all duration-200 translate-x-2 group-hover:translate-x-0">
                    <div class="flex justify-end items-center space-x-2">
                        ${c.has_sentences === 1 ? `<button class="p-2 text-teal-600 hover:bg-teal-50 rounded-lg transition-colors" title="查看分析" onclick="viewSentences(${c.id})"><i class="fas fa-list"></i></button>` : ''}
                        <button class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="AI分析" onclick="analyzePodcastSentences(${c.id}, this)"><i class="fas fa-robot"></i></button>
                        <button class="p-2 text-purple-600 hover:bg-purple-50 rounded-lg transition-colors" title="生成音频" onclick="generatePodcastAudio(${c.id})"><i class="fas fa-volume-up"></i></button>
                        <button class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="编辑" onclick="editPodcastContent(${c.id})"><i class="fas fa-edit"></i></button>
                        <button class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="删除" onclick="deletePodcastContent(${c.id})"><i class="fas fa-trash"></i></button>
                    </div>
                </td>
            </tr>
        `}).join('');
    }

    function openPodcastContentModal() {
        document.getElementById('pcontent-id').value = '';
        document.getElementById('pcontent-title').value = '';
        document.getElementById('pcontent-text').value = '';
        document.getElementById('pcontent-category').value = '';
        document.getElementById('pcontent-difficulty').value = '1';
        document.getElementById('pcontent-sort').value = '0';
        document.getElementById('pcontent-free').checked = true;
        document.getElementById('podcast-content-modal-title').textContent = '新增内容';

        const modal = document.getElementById('podcast-content-modal');
        const content = document.getElementById('modal-content');
        modal.classList.remove('hidden');
        requestAnimationFrame(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        });
    }

    function closePodcastContentModal() {
        const modal = document.getElementById('podcast-content-modal');
        const content = document.getElementById('modal-content');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => modal.classList.add('hidden'), 300);
    }

    async function editPodcastContent(id) {
        try {
            const res = await fetch(`${API_BASE}/podcast/${id}`);
            const data = await res.json();
            if (data.success) {
                const c = data.data;
                document.getElementById('pcontent-id').value = c.id;
                document.getElementById('pcontent-title').value = c.title;
                document.getElementById('pcontent-text').value = c.content_text || '';
                document.getElementById('pcontent-category').value = c.category_id || '';
                document.getElementById('pcontent-difficulty').value = c.difficulty_level || 1;
                document.getElementById('pcontent-sort').value = c.sort_order || 0;
                document.getElementById('pcontent-free').checked = c.is_free;
                document.getElementById('podcast-content-modal-title').textContent = '编辑内容';

                const modal = document.getElementById('podcast-content-modal');
                const content = document.getElementById('modal-content');
                modal.classList.remove('hidden');
                requestAnimationFrame(() => {
                    content.classList.remove('scale-95', 'opacity-0');
                    content.classList.add('scale-100', 'opacity-100');
                });
            }
        } catch (e) { showToast('获取详情失败', 'error'); }
    }

    async function deletePodcastContent(id) {
        if (!confirm('确定删除此内容？')) return;
        try {
            const res = await fetch(`${API_BASE}/podcast/${id}`, { method: 'DELETE' });
            if (res.ok) {
                showToast('删除成功');
                loadPodcastContents();
            } else {
                showToast('删除失败', 'error');
            }
        } catch (e) { showToast('删除失败', 'error'); }
    }

    document.getElementById('podcast-content-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('pcontent-id').value;
        const data = {
            title: document.getElementById('pcontent-title').value,
            content_text: document.getElementById('pcontent-text').value,
            category_id: document.getElementById('pcontent-category').value || null,
            difficulty_level: parseInt(document.getElementById('pcontent-difficulty').value) || 1,
            sort_order: parseInt(document.getElementById('pcontent-sort').value) || 0,
            is_free: document.getElementById('pcontent-free').checked
        };
        try {
            const url = id ? `${API_BASE}/podcast/${id}` : `${API_BASE}/podcast`;
            const res = await fetch(url, {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                showToast('保存成功');
                closePodcastContentModal();
                loadPodcastContents();
            } else {
                showToast('保存失败', 'error');
            }
        } catch (e) { showToast('保存失败', 'error'); }
    });

    async function generatePodcastAudio(id) {
        if (!confirm('将生成男声、女声和中文三个音频，是否继续？')) return;
        try {
            const btn = event.target.closest('button');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 生成中...';

            const res = await fetch(`${API_BASE}/podcast/generate-all-audio`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content_id: id })
            });
            const data = await res.json();

            if (data.success) {
                showToast('音频生成完成！');
                loadPodcastContents();
            } else {
                showToast('生成失败: ' + (data.message || '未知错误'), 'error');
            }
        } catch (e) {
            showToast('生成失败: ' + e.message, 'error');
        } finally {
            // Restore button state is handled by reload, but if reload fails/not called immediately:
            // btn.disabled = false; btn.innerHTML = originalText;
        }
    }

    async function analyzePodcastSentences(id, btn) {
        if (!confirm('将用 AI 分析句子、翻译和关键词，并为每句生成音频，可能需要几十秒，是否继续？')) return;
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 分析中...';
        try {
            const res = await fetch(`${API_BASE}/podcast/analyze-sentences/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                showToast(data.message || 'AI分析完成！');
                loadPodcastContents();
            } else {
                showToast('分析失败: ' + (data.message || '未知错误'), 'error');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        } catch (e) {
            showToast('分析失败: ' + e.message, 'error');
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    // ── 句子分析弹窗 ──
    let _sentenceAudio = null;

    async function viewSentences(id) {
        document.getElementById('sentences-modal-title').textContent = '句子分析';
        document.getElementById('sentences-modal-sub').textContent = '加载中...';
        document.getElementById('sentences-list').innerHTML = '<div class="flex flex-col items-center justify-center py-12 text-gray-400"><i class="fas fa-spinner fa-spin text-3xl mb-3 text-blue-500"></i><p>分析数据加载中...</p></div>';
        
        const modal = document.getElementById('sentences-modal');
        const content = document.getElementById('sentences-modal-content');
        modal.classList.remove('hidden');
        requestAnimationFrame(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        });

        try {
            const res = await fetch(`${API_BASE}/podcast/${id}`);
            const data = await res.json();
            if (!data.success || !data.data.sentences_data || !data.data.sentences_data.sentences) {
                document.getElementById('sentences-list').innerHTML = '<div class="text-center text-gray-400 py-8">暂无分析数据</div>';
                return;
            }
            const content = data.data;
            const sentences = content.sentences_data.sentences;
            document.getElementById('sentences-modal-title').textContent = content.title;
            document.getElementById('sentences-modal-sub').textContent = `共 ${sentences.length} 句`;
            renderSentencesList(sentences);
        } catch (e) {
            document.getElementById('sentences-list').innerHTML = `<div class="text-center text-red-400 py-8">加载失败: ${e.message}</div>`;
        }
    }

    function renderSentencesList(sentences) {
        const BASE = 'https://english.tajian.cc';
        const fmtUrl = u => u && !u.startsWith('http') ? BASE + u : u;

        document.getElementById('sentences-list').innerHTML = sentences.map((s, i) => {
            const maleUrl = fmtUrl(s.male_audio_url);
            const femaleUrl = fmtUrl(s.female_audio_url);
            const wordsHtml = (s.words || []).map(w => {
                const wUrl = fmtUrl(w.audio_url);
                return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white border border-blue-100 shadow-sm text-blue-800 rounded-lg text-xs hover:border-blue-300 transition-colors group/word">
                    <span class="font-bold">${w.word}</span>
                    <span class="text-blue-400/80 font-mono text-[11px]">${w.phonetic || ''}</span>
                    <span class="text-gray-400 text-[10px] uppercase font-bold tracking-wider">${w.pos || ''}</span>
                    <span class="text-gray-600 font-medium">${w.translation || ''}</span>
                    ${wUrl ? `<button onclick="playAudio('${wUrl}')" title="播放" class="text-blue-400 hover:text-blue-600 ml-1 bg-blue-50 hover:bg-blue-100 rounded p-1 transition-colors flex items-center justify-center"><i class="fas fa-volume-up text-[10px]"></i></button>` : ''}
                </span>`;
            }).join('');

            return `<div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-5 hover:shadow-md hover:border-blue-200 transition-all duration-300 group/sentence">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-50 text-indigo-600 rounded-full text-sm font-bold shadow-inner ring-1 ring-indigo-100/50">${i + 1}</div>
                    <div class="flex-1 min-w-0">
                        <p class="text-gray-900 font-medium text-lg leading-relaxed">${s.text}</p>
                        <p class="text-gray-500 text-sm mt-1.5 leading-relaxed font-medium">${s.translation || ''}</p>
                        ${s.grammar ? `<div class="mt-3"><span class="inline-flex text-teal-700 text-xs bg-teal-50 border border-teal-100 px-3 py-1.5 rounded-lg shadow-sm font-medium"><i class="fas fa-book-open mr-1.5 opacity-70"></i> ${s.grammar}</span></div>` : ''}
                        ${wordsHtml ? `<div class="flex flex-wrap gap-2 mt-3 pt-3 border-t border-gray-50">${wordsHtml}</div>` : ''}
                    </div>
                    <div class="flex flex-col gap-2 flex-shrink-0 opacity-100">
                        ${maleUrl ? `<button onclick="playAudio('${maleUrl}')" class="flex items-center justify-center w-8 h-8 bg-blue-50 text-blue-600 rounded-full hover:bg-blue-500 hover:text-white hover:shadow-lg hover:shadow-blue-500/30 transition-all duration-300" title="播放男声音频"><i class="fas fa-male text-sm"></i></button>` : ''}
                        ${femaleUrl ? `<button onclick="playAudio('${femaleUrl}')" class="flex items-center justify-center w-8 h-8 bg-pink-50 text-pink-600 rounded-full hover:bg-pink-500 hover:text-white hover:shadow-lg hover:shadow-pink-500/30 transition-all duration-300" title="播放女声音频"><i class="fas fa-female text-sm"></i></button>` : ''}
                    </div>
                </div>
            </div>`;
        }).join('');
    }

    function playAudio(url) {
        if (_sentenceAudio) { _sentenceAudio.pause(); _sentenceAudio = null; }
        _sentenceAudio = new Audio(url);
        _sentenceAudio.play();
    }

    function closeSentencesModal() {
        if (_sentenceAudio) { _sentenceAudio.pause(); _sentenceAudio = null; }
        const modal = document.getElementById('sentences-modal');
        const content = document.getElementById('sentences-modal-content');
        if (content && modal) {
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        } else if (modal) {
            modal.classList.add('hidden');
        }
    }

    document.getElementById('sentences-modal').addEventListener('click', function(e) {
        if (e.target === this) closeSentencesModal();
    });

    document.addEventListener('DOMContentLoaded', () => {
        loadPodcastCategories();
        loadPodcastContents();
    });
</script>