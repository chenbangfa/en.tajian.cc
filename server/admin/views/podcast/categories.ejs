<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <h2 class="text-2xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent">
                磨耳朵分类管理</h2>
            <p class="text-gray-500 mt-1">按学段、学期和课程包整理磨耳朵内容，让它更像可以直接使用的产品结构</p>
        </div>
        <button onclick="openModal()"
            class="flex items-center space-x-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-6 py-3 rounded-xl shadow-lg shadow-blue-200 transition-all duration-300 hover:-translate-y-0.5">
            <i class="fas fa-plus"></i>
            <span>新增分类</span>
        </button>
    </div>

    <div id="categoryOverview" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
            <div class="text-xs tracking-wide text-gray-400 uppercase">总分类数</div>
            <div id="overview-total-categories" class="mt-2 text-3xl font-bold text-gray-800">-</div>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
            <div class="text-xs tracking-wide text-gray-400 uppercase">课程包数</div>
            <div id="overview-course-packs" class="mt-2 text-3xl font-bold text-blue-600">-</div>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
            <div class="text-xs tracking-wide text-gray-400 uppercase">内容总数</div>
            <div id="overview-total-contents" class="mt-2 text-3xl font-bold text-emerald-600">-</div>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
            <div class="text-xs tracking-wide text-gray-400 uppercase">缺音频内容</div>
            <div id="overview-missing-audio" class="mt-2 text-3xl font-bold text-amber-500">-</div>
        </div>
    </div>

    <!-- Category List -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div id="categoryList" class="space-y-4">
            <!-- Loading -->
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-spinner fa-spin text-3xl mb-4 text-blue-500"></i>
                <p>加载分类中...</p>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div id="editModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl transform transition-all scale-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800" id="modalTitle">新增分类</h3>
            <button onclick="closeModal()"
                class="text-gray-400 hover:text-gray-600 transition-colors w-8 h-8 rounded-full hover:bg-white flex items-center justify-center">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <form id="editForm" class="p-6 space-y-5">
            <input type="hidden" name="id">

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">分类名称</label>
                    <input type="text" name="name" required
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                        placeholder="如：家庭">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">英文名称</label>
                    <input type="text" name="name_en"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                        placeholder="如：Family">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">上级分类</label>
                <select name="parent_id"
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all bg-white">
                    <option value="0">顶级分类</option>
                    <!-- Options populated by JS -->
                </select>
                <p class="text-xs text-gray-400 mt-1">选择顶级分类则创建一级分类，否则创建为该分类的子分类</p>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">图标 (Emoji)</label>
                    <input type="text" name="icon"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                        placeholder="如：👨‍👩‍👧‍👦">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">排序</label>
                    <input type="number" name="sort_order" value="0"
                        class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
                </div>
            </div>

            <div class="flex items-center space-x-2 pt-2">
                <input type="checkbox" name="is_active" id="is_active"
                    class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" checked>
                <label for="is_active" class="text-sm text-gray-700">启用该分类</label>
            </div>
        </form>

        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end space-x-3">
            <button onclick="closeModal()"
                class="px-5 py-2.5 text-gray-600 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors font-medium">取消</button>
            <button onclick="saveCategory()"
                class="px-5 py-2.5 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-200 font-medium">保存</button>
        </div>
    </div>
</div>

<script>
    let categories = [];
    let flatCategories = [];
    let categorySummary = null;
    const toneClasses = [
        {
            rootBg: 'from-blue-50 to-indigo-50',
            rootBorder: 'border-blue-100',
            badge: 'bg-blue-100 text-blue-700',
            subTitle: 'text-blue-700'
        },
        {
            rootBg: 'from-emerald-50 to-teal-50',
            rootBorder: 'border-emerald-100',
            badge: 'bg-emerald-100 text-emerald-700',
            subTitle: 'text-emerald-700'
        },
        {
            rootBg: 'from-violet-50 to-fuchsia-50',
            rootBorder: 'border-violet-100',
            badge: 'bg-violet-100 text-violet-700',
            subTitle: 'text-violet-700'
        },
        {
            rootBg: 'from-amber-50 to-orange-50',
            rootBorder: 'border-amber-100',
            badge: 'bg-amber-100 text-amber-700',
            subTitle: 'text-amber-700'
        }
    ];

    // Load Categories
    async function loadCategories() {
        try {
            const res = await fetch(`${API_BASE}/podcast_categories`);
            const data = await res.json();
            if (data.success) {
                categories = data.data.tree || [];
                flatCategories = data.data.flat || [];
                categorySummary = data.data.summary || null;
                renderOverview();
                renderCategories();
            }
        } catch (err) {
            showToast('加载失败', 'error');
        }
    }

    function renderOverview() {
        if (!categorySummary) return;
        document.getElementById('overview-total-categories').textContent = categorySummary.total_category_count || 0;
        document.getElementById('overview-course-packs').textContent = categorySummary.course_pack_count || 0;
        document.getElementById('overview-total-contents').textContent = categorySummary.total_content_count || 0;
        document.getElementById('overview-missing-audio').textContent = categorySummary.total_missing_audio_count || 0;
    }

    function renderNodeMeta(node, tone, extraClass = '') {
        return `
            <div class="flex flex-wrap items-center gap-2 text-xs ${extraClass}">
                <span class="px-2 py-1 rounded-full ${tone.badge}">${node.total_content_count || 0} 篇内容</span>
                <span class="px-2 py-1 rounded-full bg-white/70 text-gray-600">${node.course_pack_count || 0} 个课包</span>
                ${node.total_missing_audio_count ? `<span class="px-2 py-1 rounded-full bg-amber-100 text-amber-700">${node.total_missing_audio_count} 条缺音频</span>` : ''}
            </div>
        `;
    }

    function renderActionButtons(node, compact = false) {
        const baseClass = compact ? 'p-1.5' : 'p-2';
        return `
            <div class="flex items-center space-x-1">
                <button onclick='editCategory(${JSON.stringify(node)})' class="text-blue-500 hover:text-blue-700 ${baseClass} rounded-lg hover:bg-blue-50 transition-colors" title="编辑">
                    <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteCategory(${node.id})" class="text-red-400 hover:text-red-600 ${baseClass} rounded-lg hover:bg-red-50 transition-colors" title="删除">
                    <i class="fas fa-trash-alt"></i>
                </button>
                <button onclick="openModal(${node.id})" class="ml-1 bg-white border border-gray-200 text-gray-600 hover:text-blue-600 hover:border-blue-200 px-3 py-1.5 rounded-lg text-sm shadow-sm transition-all flex items-center space-x-1">
                    <i class="fas fa-plus text-xs"></i>
                    <span>添加下级</span>
                </button>
            </div>
        `;
    }

    function renderLeafCard(node, tone) {
        return `
            <div class="rounded-2xl border border-gray-100 bg-white p-4 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xl">${node.icon || '🎧'}</span>
                            <h4 class="font-semibold text-gray-800">${node.name}</h4>
                        </div>
                        ${node.name_en ? `<p class="text-xs text-gray-400 mt-1">${node.name_en}</p>` : ''}
                    </div>
                    ${renderActionButtons(node, true)}
                </div>
                <div class="mt-4 flex flex-wrap gap-2 text-xs">
                    <span class="px-2 py-1 rounded-full ${tone.badge}">${node.total_content_count || 0} 篇</span>
                    <span class="px-2 py-1 rounded-full bg-gray-100 text-gray-600">排序 ${node.sort_order || 0}</span>
                    ${node.total_analyzed_count ? `<span class="px-2 py-1 rounded-full bg-emerald-100 text-emerald-700">已分析 ${node.total_analyzed_count}</span>` : ''}
                </div>
            </div>
        `;
    }

    function renderIntermediateNode(node, tone) {
        if (!node.children || !node.children.length) {
            return renderLeafCard(node, tone);
        }

        return `
            <div class="rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xl">${node.icon || '📂'}</span>
                            <h4 class="font-semibold text-gray-800">${node.name}</h4>
                        </div>
                        ${node.name_en ? `<p class="text-xs text-gray-400 mt-1">${node.name_en}</p>` : ''}
                    </div>
                    ${renderActionButtons(node, true)}
                </div>
                <div class="mt-3">${renderNodeMeta(node, tone)}</div>
                <div class="mt-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                    ${node.children.map(child => renderLeafCard(child, tone)).join('')}
                </div>
            </div>
        `;
    }

    // Render Categories Tree
    function renderCategories() {
        const container = document.getElementById('categoryList');
        if (categories.length === 0) {
            container.innerHTML = '<div class="text-center py-8 text-gray-400">暂无分类数据</div>';
            return;
        }

        let html = '';
        categories.forEach((cat, index) => {
            const tone = toneClasses[index % toneClasses.length];
            html += `
                <section class="rounded-3xl border ${tone.rootBorder} bg-gradient-to-br ${tone.rootBg} p-6 shadow-sm">
                    <div class="flex items-start justify-between gap-6">
                        <div>
                            <div class="flex items-center gap-3">
                                <span class="text-3xl">${cat.icon || '📚'}</span>
                                <div>
                                    <h3 class="text-xl font-bold text-gray-800">${cat.name}</h3>
                                    ${cat.name_en ? `<p class="text-sm text-gray-500 mt-1">${cat.name_en}</p>` : ''}
                                </div>
                            </div>
                            <div class="mt-4">${renderNodeMeta(cat, tone)}</div>
                        </div>
                        ${renderActionButtons(cat)}
                    </div>
                    <div class="mt-5 grid grid-cols-1 xl:grid-cols-2 gap-4">
                        ${(cat.children || []).map(child => renderIntermediateNode(child, tone)).join('')}
                    </div>
                </section>
            `;
        });

        container.innerHTML = html;
    }

    // Modal Logic
    function openModal(parentId = 0) {
        document.getElementById('editForm').reset();
        document.querySelector('input[name="id"]').value = '';
        document.getElementById('modalTitle').textContent = '新增分类';
        document.getElementById('editModal').classList.remove('hidden');

        // Update Parent Select
        const select = document.querySelector('select[name="parent_id"]');
        select.innerHTML = '<option value="0">顶级分类</option>';
        const appendOptions = (nodes, depth = 0) => {
            nodes.forEach(node => {
                const indent = '&nbsp;&nbsp;&nbsp;&nbsp;'.repeat(depth);
                const prefix = depth > 0 ? '└─ ' : '';
                select.innerHTML += `<option value="${node.id}">${indent}${prefix}${node.name}</option>`;
                if (node.children && node.children.length > 0) {
                    appendOptions(node.children, depth + 1);
                }
            });
        };
        appendOptions(categories);

        select.value = parentId;
    }

    function editCategory(cat) {
        openModal();
        document.getElementById('modalTitle').textContent = '编辑分类';

        const form = document.getElementById('editForm');
        form.querySelector('input[name="id"]').value = cat.id;
        form.querySelector('input[name="name"]').value = cat.name;
        form.querySelector('input[name="name_en"]').value = cat.name_en || '';
        form.querySelector('select[name="parent_id"]').value = cat.parent_id;
        form.querySelector('input[name="icon"]').value = cat.icon || '';
        form.querySelector('input[name="sort_order"]').value = cat.sort_order;
        form.querySelector('input[name="is_active"]').checked = cat.is_active;
    }

    function closeModal() {
        document.getElementById('editModal').classList.add('hidden');
    }

    async function saveCategory() {
        const form = document.getElementById('editForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.is_active = form.querySelector('input[name="is_active"]').checked ? 1 : 0;

        const id = data.id;
        const method = id ? 'PUT' : 'POST';
        const url = id ? `${API_BASE}/podcast_categories/${id}` : `${API_BASE}/podcast_categories`;

        try {
            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();

            if (result.success) {
                showToast('保存成功');
                closeModal();
                loadCategories();
            } else {
                showToast(result.message, 'error');
            }
        } catch (err) {
            showToast('请求失败', 'error');
        }
    }

    async function deleteCategory(id) {
        if (!confirm('确定要删除该分类吗？')) return;

        try {
            const res = await fetch(`${API_BASE}/podcast_categories/${id}`, {
                method: 'DELETE'
            });
            const result = await res.json();

            if (result.success) {
                showToast('删除成功');
                loadCategories();
            } else {
                showToast(result.message, 'error');
            }
        } catch (err) {
            showToast('请求失败', 'error');
        }
    }

    // Init
    loadCategories();
</script>
