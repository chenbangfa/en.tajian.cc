<style>
    .form-input { width: 100%; border: 1px solid #e5e7eb; border-radius: 0.9rem; padding: 0.72rem 0.9rem; outline: none; background: #fff; }
    .form-input:focus { border-color: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12); }
</style>

<script>
    let courses = [];
    let days = [];
    let modules = [];
    let currentCourse = null;
    let currentDay = null;
    let currentModule = null;
    let moduleVocabularyWords = [];
    let moduleGrammarItems = [];
    let vocabSearchCandidates = [];
    let podcastSearchCandidates = [];
    let modulePodcastContent = null;

    function prettyJson(value) {
        return JSON.stringify(value || {}, null, 2);
    }

    function readJson(id) {
        const raw = document.getElementById(id).value.trim();
        if (!raw) return {};
        return JSON.parse(raw);
    }

    function normalizeVocabularyEntry(entry) {
        if (Array.isArray(entry)) {
            return {
                word_id: entry[4] || null,
                word: entry[0] || '',
                translation: entry[1] || '',
                example_sentence: entry[2] || '',
                example_translation: entry[3] || ''
            };
        }
        if (typeof entry === 'string') return { word_id: null, word: entry, translation: '' };
        const raw = entry || {};
        return {
            word_id: raw.word_id || raw.wordId || raw.id || null,
            word: raw.word || raw.text || raw.title || '',
            translation: raw.translation || raw.meaning || raw.cn || '',
            phonetic: raw.phonetic || '',
            example_sentence: raw.example_sentence || raw.example || raw.sentence || '',
            example_translation: raw.example_translation || raw.exampleTranslation || raw.example_cn || '',
            grammar_explanation: raw.grammar_explanation || raw.grammarExplanation || raw.grammar || '',
            audio_url_female: raw.audio_url_female || '',
            audio_url_male: raw.audio_url_male || '',
            example_audio_female: raw.example_audio_female || '',
            example_audio_male: raw.example_audio_male || ''
        };
    }

    function getVocabularyWordsFromContent(content) {
        const source = Array.isArray(content.words) ? content.words : (Array.isArray(content.word_refs) ? content.word_refs : []);
        return source.map(normalizeVocabularyEntry).filter(item => item.word_id || item.word);
    }

    function isDuplicateVocabularyWord(word) {
        const key = String(word.word || '').trim().toLowerCase();
        const id = Number(word.word_id || 0);
        return moduleVocabularyWords.some(item => (id && Number(item.word_id) === id) || (key && String(item.word || '').trim().toLowerCase() === key));
    }

    function addVocabularyWord(word) {
        const normalized = normalizeVocabularyEntry(word);
        if (!normalized.word) return showToast('请先输入英文单词', 'error');
        if (isDuplicateVocabularyWord(normalized)) return showToast('这个单词已在列表中', 'error');
        moduleVocabularyWords.push(normalized);
        renderVocabularyWords();
        syncVocabularyToJson();
    }

    function addVocabularyWordFromInputs() {
        addVocabularyWord({
            word: document.getElementById('vocabWordInput').value.trim(),
            translation: document.getElementById('vocabTranslationInput').value.trim()
        });
        document.getElementById('vocabWordInput').value = '';
        document.getElementById('vocabTranslationInput').value = '';
    }

    function addVocabularyCandidate(index) {
        const candidate = vocabSearchCandidates[Number(index)];
        if (candidate) addVocabularyWord(candidate);
    }

