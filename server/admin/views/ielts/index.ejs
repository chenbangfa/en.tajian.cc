    function isGrammarModuleType(type) {
        return type === 'grammar' || type === 'grammar_drill';
    }

    function normalizeGrammarEntry(entry, index = 0) {
        const raw = entry || {};
        const exampleSentence = raw.example_sentence || raw.exampleSentence || raw.sentence || raw.prompt || '';
        return {
            id: raw.id || null,
            sort_order: Number(raw.sort_order || raw.sortOrder || index + 1),
            title: raw.title || raw.pattern || exampleSentence || `语法训练 ${index + 1}`,
            pattern: raw.pattern || raw.structure || '',
            meaning: raw.meaning || raw.translation || raw.cn || '',
            explanation: raw.explanation || raw.grammar_explanation || raw.grammar || '',
            example_sentence: exampleSentence,
            example_translation: raw.example_translation || raw.exampleTranslation || raw.translation || '',
            target_output: raw.target_output || raw.targetOutput || exampleSentence,
            pass_score: Number(raw.pass_score || raw.passScore || 80),
            is_active: raw.is_active === 0 || raw.is_active === false ? 0 : 1,
            metadata: raw.metadata || {}
        };
    }

    function getGrammarItemsFromContent(content) {
        if (Array.isArray(content.grammar_items)) {
            return content.grammar_items.map(normalizeGrammarEntry).filter(item => item.title || item.example_sentence || item.pattern);
        }
        if (!Array.isArray(content.patterns)) return [];
        const items = [];
        content.patterns.forEach((pattern) => {
            if (Array.isArray(pattern.examples) && pattern.examples.length) {
                pattern.examples.forEach((example) => {
                    const en = Array.isArray(example) ? example[0] : (example.text || example.en || example.sentence || '');
                    const cn = Array.isArray(example) ? example[1] : (example.translation || example.cn || '');
                    items.push(normalizeGrammarEntry({
                        title: pattern.title || en,
                        pattern: pattern.structure || pattern.pattern || '',
                        meaning: pattern.meaning || '',
                        explanation: pattern.explanation || pattern.grammar_explanation || '',
                        example_sentence: en,
                        example_translation: cn,
                        target_output: en
                    }, items.length));
                });
            } else {
                items.push(normalizeGrammarEntry({
                    title: pattern.title || pattern.structure || '',
                    pattern: pattern.structure || pattern.pattern || '',
                    meaning: pattern.meaning || '',
                    explanation: pattern.explanation || pattern.grammar_explanation || '',
                    example_sentence: pattern.example_sentence || '',
                    example_translation: pattern.example_translation || '',
                    target_output: pattern.target_output || pattern.example_sentence || pattern.structure || ''
                }, items.length));
            }
        });
        return items;
    }

    function addGrammarItem(item) {
        const normalized = normalizeGrammarEntry(item, moduleGrammarItems.length);
        if (!normalized.title && !normalized.example_sentence && !normalized.pattern) {
            return showToast('请至少填写语法点、结构或例句', 'error');
        }
        moduleGrammarItems.push(normalized);
        renderGrammarItems();
    }

