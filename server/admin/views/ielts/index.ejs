                    <div>
                        <div class="text-sm text-emerald-700 font-bold">Day ${day.day_number}</div>
                        <div class="font-semibold text-gray-900 mt-1">${escapeHtml(day.title)}</div>
                        <div class="text-xs text-gray-400 mt-1 line-clamp-2">${escapeHtml(day.theme || '')}</div>
                    </div>
                    <span class="text-xs text-gray-400">${day.module_count || 0} 模块</span>
                </div>
            </button>
        `).join('');
    }

    async function selectDay(id) {
        const data = await requestJson(`/api/admin/ielts/days/${id}`);
        currentDay = data.data.day;
        modules = data.data.modules || [];
        renderDays();
        renderModules();
    }

    function renderModules() {
        const title = document.getElementById('detailTitle');
        const sub = document.getElementById('detailSub');
        const box = document.getElementById('moduleList');
        if (!currentDay) {
            title.textContent = 'Day 内容';
            sub.textContent = '选择 Day 后编辑模块';
            box.innerHTML = '<div class="rounded-2xl border border-dashed border-gray-200 p-8 text-center text-gray-400">请先选择 Day</div>';
            return;
        }
        title.textContent = `Day ${currentDay.day_number} · ${currentDay.title}`;
        sub.textContent = currentDay.objective || currentDay.theme || '编辑本日学习目标与模块内容';
        if (!modules.length) {
            box.innerHTML = '<div class="rounded-2xl border border-dashed border-gray-200 p-8 text-center text-gray-400">这个 Day 还没有模块。</div>';
            return;
        }
        const getPodcast = (mod) => {
            if (mod.podcast_content && mod.podcast_content.title) return mod.podcast_content;
            const content = mod.content_json || {};
            const id = content.podcast_content_id || content.podcast_id;
            return id ? { id, title: `磨耳朵文章 #${id}`, content_text: '' } : null;
        };
        box.innerHTML = modules.map(mod => `
            <div class="rounded-2xl border border-gray-100 p-4 hover:border-emerald-200 hover:bg-emerald-50/30 transition">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">${mod.sort_order}</span>
                            <span class="px-2 py-1 rounded-lg bg-gray-100 text-gray-500 text-xs">${mod.module_type}</span>
                            ${mod.is_required ? '<span class="px-2 py-1 rounded-lg bg-amber-50 text-amber-600 text-xs">必修</span>' : '<span class="px-2 py-1 rounded-lg bg-gray-50 text-gray-400 text-xs">选修</span>'}
                        </div>
                        <div class="mt-3 font-bold text-gray-900">${escapeHtml(mod.title)}</div>
                        <div class="mt-1 text-xs text-gray-400">预计 ${mod.estimated_minutes || 0} 分钟</div>
                        ${getPodcast(mod) ? `<div class="mt-3 rounded-xl bg-sky-50 border border-sky-100 px-3 py-2 text-sm text-sky-800"><span class="font-semibold">绑定文章：</span>${escapeHtml(getPodcast(mod).title || '')}</div>` : ''}
                    </div>
                    <button onclick="openModuleModal(${mod.id})" class="px-3 py-2 rounded-xl bg-white border border-gray-200 text-gray-600 hover:text-emerald-700 hover:border-emerald-200 text-sm">
                        <i class="fas fa-pen mr-1"></i>编辑
                    </button>
                </div>
                ${getPodcast(mod) ? '' : `<pre class="mt-4 p-3 rounded-xl bg-gray-50 text-xs text-gray-500 overflow-x-auto max-h-32">${escapeHtml(prettyJson(mod.content_json))}</pre>`}
            </div>
        `).join('');
    }

    function openCourseModal(createNew = false) {
        const course = createNew ? null : currentCourse;
        if (!createNew && !course) return showToast('请先选择课程', 'error');
        document.getElementById('courseModalTitle').textContent = course ? '编辑 IELTS 课程' : '新增 IELTS 课程';
        document.getElementById('courseId').value = course ? course.id : '';
        document.getElementById('courseCode').value = course ? course.code : '';
        document.getElementById('courseCode').disabled = !!course;
        document.getElementById('courseTitle').value = course ? course.title : '';
        document.getElementById('courseTitleEn').value = course ? (course.title_en || '') : '';
        document.getElementById('courseDescription').value = course ? (course.description || '') : '';
        document.getElementById('courseTarget').value = course ? (course.target_score || '') : '';
        document.getElementById('courseLevel').value = course ? (course.level_label || '') : '';
        document.getElementById('courseDuration').value = course ? course.duration_days : 30;
        document.getElementById('courseMinutes').value = course ? course.daily_minutes : 120;
        document.getElementById('courseSort').value = course ? course.sort_order : 0;
        document.getElementById('courseActive').value = course && !course.is_active ? '0' : '1';
        document.getElementById('courseMetadata').value = course ? prettyJson(course.metadata) : '{}';
        openModal('courseModal');
    }

    async function saveCourse() {
        try {
            const id = document.getElementById('courseId').value;
            const payload = {
                code: document.getElementById('courseCode').value.trim(),
                title: document.getElementById('courseTitle').value.trim(),
                title_en: document.getElementById('courseTitleEn').value.trim(),
                description: document.getElementById('courseDescription').value.trim(),
                target_score: document.getElementById('courseTarget').value.trim(),
                level_label: document.getElementById('courseLevel').value.trim(),
                duration_days: Number(document.getElementById('courseDuration').value || 30),
                daily_minutes: Number(document.getElementById('courseMinutes').value || 120),
                sort_order: Number(document.getElementById('courseSort').value || 0),
                is_active: document.getElementById('courseActive').value === '1' ? 1 : 0,
                metadata: readJson('courseMetadata')
            };
            const url = id ? `/api/admin/ielts/courses/${id}` : '/api/admin/ielts/courses';
            await requestJson(url, { method: id ? 'PUT' : 'POST', body: JSON.stringify(payload) });
            closeModal('courseModal');
            currentCourse = null;
            await loadCourses();
            showToast('课程已保存');
        } catch (error) {
            showToast(error.message, 'error');
        }
    }

    function openDayModal(editCurrent = false) {
        if (!currentCourse) return showToast('请先选择课程', 'error');
        const day = editCurrent ? currentDay : null;
        document.getElementById('dayModalTitle').textContent = day ? '编辑 Day' : '新增 Day';
        document.getElementById('dayId').value = day ? day.id : '';
        document.getElementById('dayNumber').value = day ? day.day_number : (days.length ? Math.max(...days.map(item => Number(item.day_number) || 0)) + 1 : 1);
        document.getElementById('dayMinutes').value = day ? day.estimated_minutes : 120;
        document.getElementById('dayTitle').value = day ? day.title : '';
        document.getElementById('dayTheme').value = day ? (day.theme || '') : '';
        document.getElementById('dayObjective').value = day ? (day.objective || '') : '';
        document.getElementById('dayPreview').value = day ? (day.preview_next || '') : '';
        document.getElementById('dayActive').value = day && !day.is_active ? '0' : '1';
        document.getElementById('dayMetadata').value = day ? prettyJson(day.metadata) : '{}';
        openModal('dayModal');
    }

    async function saveDay() {
        try {
            const id = document.getElementById('dayId').value;
            const payload = {
                day_number: Number(document.getElementById('dayNumber').value || 1),
                title: document.getElementById('dayTitle').value.trim(),
                theme: document.getElementById('dayTheme').value.trim(),
                objective: document.getElementById('dayObjective').value.trim(),
                estimated_minutes: Number(document.getElementById('dayMinutes').value || 120),
                preview_next: document.getElementById('dayPreview').value.trim(),
                is_active: document.getElementById('dayActive').value === '1' ? 1 : 0,
                metadata: readJson('dayMetadata')
            };
            const url = id ? `/api/admin/ielts/days/${id}` : `/api/admin/ielts/courses/${currentCourse.id}/days`;
            await requestJson(url, { method: id ? 'PUT' : 'POST', body: JSON.stringify(payload) });
            closeModal('dayModal');
            await selectCourse(currentCourse.id);
            showToast('Day 已保存');
        } catch (error) {
            showToast(error.message, 'error');
        }
    }

    async function deleteCurrentDay() {
        const id = document.getElementById('dayId').value;
        if (!id) return closeModal('dayModal');
        if (!confirm('确定删除这个 Day 吗？模块和学习进度会一起删除。')) return;
        try {
            await requestJson(`/api/admin/ielts/days/${id}`, { method: 'DELETE' });
            closeModal('dayModal');
            await selectCourse(currentCourse.id);
            showToast('Day 已删除');
        } catch (error) {
            showToast(error.message, 'error');
        }
    }

    function openModuleModal(id) {
        if (!currentDay) return showToast('请先选择 Day', 'error');
        const mod = id ? modules.find(item => item.id === Number(id)) : null;
        const content = mod ? (mod.content_json || {}) : {};
        currentModule = mod;
        document.getElementById('moduleModalTitle').textContent = mod ? '编辑模块' : '新增模块';
        document.getElementById('moduleId').value = mod ? mod.id : '';
        document.getElementById('moduleType').value = mod ? mod.module_type : 'goal';
        document.getElementById('moduleTitle').value = mod ? mod.title : '';
        document.getElementById('moduleSort').value = mod ? mod.sort_order : (modules.length ? Math.max(...modules.map(item => Number(item.sort_order) || 0)) + 1 : 1);
        document.getElementById('moduleMinutes').value = mod ? mod.estimated_minutes : 10;
        document.getElementById('moduleRequired').value = mod && !mod.is_required ? '0' : '1';
        document.getElementById('moduleContent').value = mod ? prettyJson(content) : '{\n  "items": []\n}';
        modulePodcastContent = mod && mod.podcast_content ? mod.podcast_content : null;
        moduleVocabularyWords = mod && ['vocabulary', 'pronunciation'].includes(mod.module_type) ? getVocabularyWordsFromContent(content) : [];
        moduleGrammarItems = mod && isGrammarModuleType(mod.module_type)
            ? ((mod.grammar_items && mod.grammar_items.length) ? mod.grammar_items.map(normalizeGrammarEntry) : getGrammarItemsFromContent(content))
            : [];
        document.getElementById('vocabWordInput').value = '';
        document.getElementById('vocabTranslationInput').value = '';
        document.getElementById('vocabSearchInput').value = '';
        document.getElementById('vocabSearchResults').innerHTML = '';
        document.getElementById('podcastSearchInput').value = '';
        document.getElementById('podcastSearchResults').innerHTML = '';
        ['grammarTitleInput', 'grammarPatternInput', 'grammarMeaningInput', 'grammarExplanationInput', 'grammarExampleInput', 'grammarTranslationInput'].forEach(inputId => {
            const input = document.getElementById(inputId);
            if (input) input.value = '';
        });
        document.getElementById('grammarPassScoreInput').value = 80;
        toggleModuleEditors();
        openModal('moduleModal');
    }

    function formatModuleJson() {
        try {
            document.getElementById('moduleContent').value = prettyJson(readJson('moduleContent'));
        } catch (error) {
            showToast('JSON 格式不正确', 'error');
        }
    }

    async function saveModule() {
        try {
            const id = document.getElementById('moduleId').value;
            const moduleType = document.getElementById('moduleType').value;
            let contentJson = readJson('moduleContent');
            if (['vocabulary', 'pronunciation'].includes(moduleType) && moduleVocabularyWords.length) {
                contentJson = {
                    ...contentJson,
                    words: moduleVocabularyWords.map(word => ({
                        word_id: word.word_id || null,
                        word: word.word || '',
                        translation: word.translation || '',
                        phonetic: word.phonetic || '',
                        example_sentence: word.example_sentence || '',
                        example_translation: word.example_translation || '',
                        grammar_explanation: word.grammar_explanation || ''
                    }))
                };
            }
            const grammarItems = isGrammarModuleType(moduleType)
                ? moduleGrammarItems.map((item, index) => ({
                    sort_order: index + 1,
                    title: item.title || '',
                    pattern: item.pattern || '',
                    meaning: item.meaning || '',
                    explanation: item.explanation || '',
                    example_sentence: item.example_sentence || '',
                    example_translation: item.example_translation || '',
                    target_output: item.target_output || item.example_sentence || '',
                    pass_score: Number(item.pass_score || 80),
                    is_active: item.is_active === 0 ? 0 : 1,
                    metadata: item.metadata || {}
                }))
                : [];
            const payload = {
                module_type: moduleType,
                title: document.getElementById('moduleTitle').value.trim(),
                sort_order: Number(document.getElementById('moduleSort').value || 0),
                estimated_minutes: Number(document.getElementById('moduleMinutes').value || 10),
                is_required: document.getElementById('moduleRequired').value === '1' ? 1 : 0,
                content_json: contentJson,
                grammar_items: grammarItems
            };
            const url = id ? `/api/admin/ielts/modules/${id}` : `/api/admin/ielts/days/${currentDay.id}/modules`;
            await requestJson(url, { method: id ? 'PUT' : 'POST', body: JSON.stringify(payload) });
            closeModal('moduleModal');
            await selectDay(currentDay.id);
            showToast('模块已保存');
        } catch (error) {
            showToast(error.message, 'error');
        }
    }

    async function deleteCurrentModule() {
        const id = document.getElementById('moduleId').value;
        if (!id) return closeModal('moduleModal');
        if (!confirm('确定删除这个模块吗？相关学习进度会一起删除。')) return;
        try {
            await requestJson(`/api/admin/ielts/modules/${id}`, { method: 'DELETE' });
            closeModal('moduleModal');
            await selectDay(currentDay.id);
            showToast('模块已删除');
        } catch (error) {
            showToast(error.message, 'error');
        }
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('moduleType').addEventListener('change', toggleModuleEditors);
        document.getElementById('vocabWordInput').addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                addVocabularyWordFromInputs();
            }
        });
        document.getElementById('vocabSearchInput').addEventListener('input', () => {
            clearTimeout(vocabSearchTimer);
            vocabSearchTimer = setTimeout(searchVocabularyWords, 300);
        });
        document.getElementById('podcastSearchInput').addEventListener('input', () => {
            clearTimeout(podcastSearchTimer);
            podcastSearchTimer = setTimeout(searchPodcastContents, 300);
        });
        loadCourses().catch(error => showToast(error.message, 'error'));
    });
</script>
