# Proxy-only runtime environment
PROXY_PORT=3005
PROXY_API_KEY=replace_with_strong_random_key

# Google Vertex AI
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/vertex-ai-sa.json
GOOGLE_CLOUD_PROJECT=your_google_project_id
GOOGLE_CLOUD_REGION=us-central1

# Google / Vertex only
AI_ANALYZE_ENGINE=gemini

# Optional Veo model
VEO_MODEL_ID=veo-3.1-fast-generate-001

# Rate limits
PROXY_TTS_MIN_INTERVAL_MS=15000
PROXY_TTS_COOLDOWN_MS=600000
PROXY_IMAGE_MIN_INTERVAL_MS=10000
PROXY_IMAGE_COOLDOWN_MS=60000
PROXY_ANALYZE_MIN_INTERVAL_MS=20000
PROXY_ANALYZE_COOLDOWN_MS=120000
